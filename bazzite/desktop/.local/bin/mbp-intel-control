#!/usr/bin/env python3
"""Bazzite command deck without Alpine privacy or firewall controls."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


HOME = Path.home()
BIN = HOME / '.local/bin'


def run(args, **kwargs):
    return subprocess.run([str(arg) for arg in args], check=False, **kwargs)


def notify(title, body):
    run(['notify-send', title, body])


def choose(title, options):
    answer = run(['fuzzel', '--dmenu', '--prompt', f' {title} › ', '--width', '62',
                  '--lines', str(min(12, len(options)))],
                 input='\n'.join(options) + '\n', text=True, capture_output=True)
    return answer.stdout.strip() if answer.returncode == 0 else ''


def launch(args):
    if not shutil.which(str(args[0])):
        notify('Transmission unavailable', f'{args[0]} is not installed.')
        return
    subprocess.Popen([str(arg) for arg in args], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def windows():
    answer = run(['swaymsg', '-t', 'get_tree', '-r'], capture_output=True, text=True)
    if answer.returncode:
        return
    options = {}

    def walk(node, workspace=''):
        if node.get('type') == 'workspace':
            workspace = node.get('name', '')
        app = node.get('app_id') or node.get('window_properties', {}).get('class')
        if app:
            title = ' '.join(str(node.get('name', app)).split())[:70]
            label = f"{workspace}  ·  {app}  ·  {title}  [{node['id']}]"
            options[label] = int(node['id'])
        for child in node.get('nodes', []) + node.get('floating_nodes', []):
            walk(child, workspace)

    walk(json.loads(answer.stdout))
    if not options:
        notify('Transmission standby', 'No open windows. Super+Enter opens a terminal.')
        return
    selected = choose('SWITCH TRANSMISSION', list(options))
    if selected in options:
        run(['swaymsg', f'[con_id={options[selected]}] focus'])


def network_report():
    print('\033[1;35mSPACE GHOST · TRANSMISSION REPORT\033[0m\n')
    print('Read-only interface and route information. No Wi-Fi scan is requested.\n')
    run(['ip', '-brief', 'address'])
    print('\nRoutes:')
    run(['ip', 'route'])
    print('\nPress Enter to return to the control room.')
    try:
        input()
    except EOFError:
        pass


def suspend():
    if run([BIN / 'mbp-intel-lock']).returncode == 0:
        run(['loginctl', 'suspend'])


def logout():
    if choose('LEAVE THE GHOST PLANET?', ['Stay on air', 'End this Sway session']) == 'End this Sway session':
        run(['swaymsg', 'exit'])


def power():
    options = {
        '󰌾  Lock the Ghost Planet': lambda: launch([BIN / 'mbp-intel-lock']),
        '󰒲  Lock and suspend': suspend,
        '󰍃  End Sway session…': logout,
    }
    selected = choose('SESSION CONTROL', list(options))
    if selected in options:
        options[selected]()


def menu():
    options = {
        '󰊠  Applications                              Super+D': lambda: launch([BIN / 'mbp-intel-menu']),
        '▦  Expo · all workspaces                  Super+E': lambda: launch([BIN / 'mbp-intel-expo']),
        '󰖯  Switch window': windows,
        '󰸉  Artwork gallery': lambda: launch([BIN / 'mbp-intel-wallpaper', 'pick']),
        '▶  YouTube · desktop player & PiP': lambda: launch([BIN / 'mbp-intel-youtube', 'menu']),
        '▷  Video background · choose or stop': lambda: launch([BIN / 'mbp-intel-video-background', 'picker']),
        '◈  Ghostty terminal': lambda: launch(['ghostty']),
        '󰍛  Reactor · CPU, memory, processes': lambda: launch(['foot', '--title=Ghost Reactor', '-e', 'btop']),
        '󰤨  Transmission report · no scanning': lambda: launch(['foot', '--title=Transmission Status', '-e', BIN / 'mbp-intel-control', 'network-report']),
        '󰕾  Sound studio · mixer and microphone': lambda: launch(['pavucontrol']),
        '󰂚  Notifications': lambda: run(['swaync-client', '-t', '-sw']),
        '󰘧  Edit the Ghost Planet · checkout': lambda: launch(['thunar', HOME / '.files']),
        '󰌾  Session · lock, suspend, logout': power,
        '?  Help · desktop commands and shortcuts': lambda: launch(['foot', '--title=Ghost Planet Help', '-e', 'less', HOME / '.files/bazzite/README.md']),
    }
    selected = choose('SPACE GHOST · CONTROL DECK', list(options))
    if selected in options:
        options[selected]()


if __name__ == '__main__':
    action = sys.argv[1] if len(sys.argv) > 1 else 'main'
    if action == 'main':
        menu()
    elif action in ('windows', 'network-report', 'power'):
        {'windows': windows, 'network-report': network_report, 'power': power}[action]()
    else:
        raise SystemExit('usage: mbp-intel-control [windows|network-report|power]')
