#!/usr/bin/env python3
"""Compile the desktop's LayerShellQt bridge into the user's cache.

One translation unit against headers that are already installed. It is not a
package: nothing is signed, nothing enters the apk closure, and the result is a
cache entry named after the hash of its own source, so an unchanged source is a
no-op and a changed one never loads a stale library. `alpine/bin/remote-build`
stays the route for anything that is genuinely a package.
"""
import argparse
import hashlib
import os
from pathlib import Path
import shlex
import subprocess
import sys

REPO = Path(__file__).resolve().parents[2]
SOURCE = REPO / 'alpine/desktop/.local/lib/oldbook/native/layer_shell_bridge.cpp'
NAME = 'liboldbook-layer-shell'


def cache_directory():
    base = os.environ.get('XDG_CACHE_HOME') or str(Path.home() / '.cache')
    directory = Path(base) / 'oldbook/layer-shell'
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    return directory


def library_path(source=SOURCE):
    identity = hashlib.sha256(source.read_bytes()).hexdigest()[:12]
    return cache_directory() / f'{NAME}.{identity}.so'


def compiler_flags():
    result = subprocess.run(['pkg-config', '--cflags', '--libs', 'Qt6Gui', 'Qt6Core'],
                            capture_output=True, text=True, check=True)
    return shlex.split(result.stdout)


def build(source=SOURCE, force=False):
    """Return the library path, compiling only when that exact source has none."""
    target = library_path(source)
    if target.is_file() and not force:
        return target
    temporary = target.with_name(f'{target.name}.{os.getpid()}.tmp')
    command = ['c++', '-std=c++17', '-O2', '-fPIC', '-shared', '-Wall', '-Wextra',
               '-fvisibility=hidden', str(source), '-o', str(temporary),
               *compiler_flags(), '-lLayerShellQtInterface']
    try:
        subprocess.run(command, check=True)
        temporary.replace(target)
    finally:
        temporary.unlink(missing_ok=True)
    for stale in cache_directory().glob(f'{NAME}.*.so'):
        if stale != target:
            stale.unlink(missing_ok=True)
    return target


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--force', action='store_true', help='rebuild even when cached')
    parser.add_argument('--path', action='store_true', help='print the path and build nothing')
    arguments = parser.parse_args(argv)
    print(library_path() if arguments.path else build(force=arguments.force))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(f'build-layer-shell-bridge: {error}', file=sys.stderr)
        sys.exit(1)
