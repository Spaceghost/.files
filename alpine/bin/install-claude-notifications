#!/usr/bin/env python3
"""Safely install or roll back MBP Intel's supported Claude Code hooks."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shlex
import stat
import sys
import time


NOTIFICATION_MATCHER = (
    'permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|'
    'agent_needs_input|quota_auto_resume_stale|quota_auto_resume_disabled'
)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def read_regular(path):
    if not path.exists() and not path.is_symlink():
        return None, 0o600
    info = path.stat(follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError(f'refusing non-regular file: {path}')
    return path.read_bytes(), stat.S_IMODE(info.st_mode)


def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write(path, data, mode):
    temporary = path.with_name(f'.{path.name}.{os.getpid()}.{time.time_ns()}.tmp')
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
        mode,
    )
    try:
        with os.fdopen(descriptor, 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def parse_settings(data):
    if data is None:
        return {}
    try:
        document = json.loads(data)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise RuntimeError(f'cannot parse existing Claude settings: {error}') from error
    if not isinstance(document, dict):
        raise RuntimeError('existing Claude settings must be a JSON object')
    hooks = document.setdefault('hooks', {})
    if not isinstance(hooks, dict):
        raise RuntimeError('existing Claude settings hooks must be a JSON object')
    return document


def add_hook(document, event, handler, matcher=None):
    hooks = document.setdefault('hooks', {})
    groups = hooks.setdefault(event, [])
    if not isinstance(groups, list):
        raise RuntimeError(f'existing Claude {event} hooks must be a list')
    for group in groups:
        if not isinstance(group, dict) or not isinstance(group.get('hooks'), list):
            continue
        if group.get('matcher') == matcher and handler in group['hooks']:
            return
    group = {'hooks': [dict(handler)]}
    if matcher is not None:
        group['matcher'] = matcher
    groups.append(group)


def make_backup(target, original, original_mode, replacement):
    root = target / '.local/state/mbp-intel/claude-notifications/backups'
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(root, 0o700)
    backup = root / str(time.time_ns())
    backup.mkdir(mode=0o700)
    if original is not None:
        atomic_write(backup / 'settings.json', original, 0o600)
    manifest = {
        'version': 1,
        'settings': {
            'existed': original is not None,
            'mode': original_mode,
            'before_sha256': digest(original) if original is not None else None,
            'after_sha256': digest(replacement),
        },
    }
    atomic_write(
        backup / 'manifest.json',
        json.dumps(manifest, indent=2).encode() + b'\n',
        0o600,
    )
    return backup


def install(target, helper):
    target = target.resolve()
    helper = helper.expanduser()
    if not helper.is_absolute():
        helper = Path.cwd() / helper
    if not helper.is_file() or not os.access(helper, os.X_OK):
        raise RuntimeError(f'notification helper is not executable: {helper}')

    claude = target / '.claude'
    claude.mkdir(parents=True, exist_ok=True, mode=0o700)
    settings = claude / 'settings.json'
    original, original_mode = read_regular(settings)
    document = parse_settings(original)
    handler = {
        'type': 'command',
        'command': shlex.quote(str(helper)),
        'timeout': 3,
    }
    add_hook(document, 'PermissionRequest', handler)
    add_hook(document, 'Notification', handler, NOTIFICATION_MATCHER)
    add_hook(document, 'Stop', handler)
    replacement = json.dumps(document, indent=2).encode() + b'\n'
    backup = make_backup(target, original, original_mode, replacement)
    try:
        atomic_write(settings, replacement, original_mode)
    except Exception:
        if original is None:
            settings.unlink(missing_ok=True)
        else:
            atomic_write(settings, original, original_mode)
        raise
    return backup


def rollback(target, backup):
    target = target.resolve()
    backup = backup.resolve()
    allowed = target / '.local/state/mbp-intel/claude-notifications/backups'
    if not backup.is_relative_to(allowed):
        raise RuntimeError('backup must belong to the target HOME')
    try:
        manifest = json.loads((backup / 'manifest.json').read_bytes())
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise RuntimeError(f'cannot read backup manifest: {error}') from error
    if not isinstance(manifest, dict) or manifest.get('version') != 1:
        raise RuntimeError('unsupported backup manifest')
    entry = manifest.get('settings')
    if not isinstance(entry, dict):
        raise RuntimeError('invalid backup manifest')

    settings = target / '.claude/settings.json'
    current, _ = read_regular(settings)
    if current is None or digest(current) != entry.get('after_sha256'):
        raise RuntimeError('settings.json changed since installation; refusing rollback')
    if entry.get('existed'):
        original, _ = read_regular(backup / 'settings.json')
        if original is None or digest(original) != entry.get('before_sha256'):
            raise RuntimeError('backup copy changed: settings.json')
        atomic_write(settings, original, entry['mode'])
    else:
        settings.unlink()
        sync_directory(settings.parent)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--target', type=Path, default=Path.home())
    parser.add_argument('--helper', type=Path)
    parser.add_argument('--rollback', type=Path)
    args = parser.parse_args()
    if args.rollback:
        rollback(args.target, args.rollback)
        return
    helper = args.helper or args.target / '.local/bin/mbp-intel-claude-notify'
    print(install(args.target, helper))


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError) as error:
        sys.exit(f'install-claude-notifications: {error}')
