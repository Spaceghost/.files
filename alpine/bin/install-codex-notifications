#!/usr/bin/env python3
"""Safely install or roll back MBP Intel's supported Codex callbacks."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shlex
import stat
import sys
import time
import tomllib


def digest(data):
    return hashlib.sha256(data).hexdigest()


def read_regular(path):
    if not path.exists() and not path.is_symlink():
        return None, 0o600
    info = path.stat(follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode):
        raise RuntimeError(f'refusing non-regular file: {path}')
    return path.read_bytes(), stat.S_IMODE(info.st_mode)


def sync_directory(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write(path, data, mode):
    temporary = path.with_name(f'.{path.name}.{os.getpid()}.{time.time_ns()}.tmp')
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         mode)
    try:
        with os.fdopen(descriptor, 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        sync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def parse_config(data):
    if data is None:
        return '', {}
    try:
        text = data.decode()
        return text, tomllib.loads(text)
    except (UnicodeError, tomllib.TOMLDecodeError) as error:
        raise RuntimeError(f'cannot parse existing Codex config: {error}') from error


def parse_hooks(data):
    if data is None:
        return {'description': 'MBP Intel content-free Codex desktop notifications.',
                'hooks': {}}
    try:
        document = json.loads(data)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise RuntimeError(f'cannot parse existing Codex hooks: {error}') from error
    if not isinstance(document, dict):
        raise RuntimeError('existing Codex hooks must be a JSON object')
    hooks = document.setdefault('hooks', {})
    if not isinstance(hooks, dict):
        raise RuntimeError('existing Codex hooks.hooks must be a JSON object')
    return document


def add_hook(document, event, handler):
    groups = document['hooks'].setdefault(event, [])
    if not isinstance(groups, list):
        raise RuntimeError(f'existing Codex {event} hooks must be a list')
    for group in groups:
        if isinstance(group, dict) and isinstance(group.get('hooks'), list):
            if handler in group['hooks']:
                return
    groups.append({'hooks': [dict(handler)]})


def backup_files(target, originals, replacements):
    backup_root = target / '.local/state/mbp-intel/codex-notifications/backups'
    backup_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(backup_root, 0o700)
    backup = backup_root / str(time.time_ns())
    backup.mkdir(mode=0o700)
    files = {}
    for name, (data, mode) in originals.items():
        entry = {
            'existed': data is not None,
            'mode': mode,
            'before_sha256': digest(data) if data is not None else None,
            'after_sha256': digest(replacements[name]),
        }
        files[name] = entry
        if data is not None:
            atomic_write(backup / name, data, 0o600)
    manifest = json.dumps({'version': 1, 'files': files}, indent=2).encode() + b'\n'
    atomic_write(backup / 'manifest.json', manifest, 0o600)
    return backup


def install(target, helper):
    target = target.resolve()
    helper = helper.expanduser()
    if not helper.is_absolute():
        helper = Path.cwd() / helper
    if not helper.is_file() or not os.access(helper, os.X_OK):
        raise RuntimeError(f'notification helper is not executable: {helper}')
    codex = target / '.codex'
    codex.mkdir(parents=True, exist_ok=True, mode=0o700)
    config_path = codex / 'config.toml'
    hooks_path = codex / 'hooks.json'
    config_data, config_mode = read_regular(config_path)
    hooks_data, hooks_mode = read_regular(hooks_path)
    config_text, parsed_config = parse_config(config_data)
    if 'notify' in parsed_config:
        raise RuntimeError('existing notify handler is preserved; remove or chain it manually')

    notify = 'notify = [' + json.dumps(str(helper)) + ', "--notify"]\n'
    new_config = (notify + config_text).encode()
    document = parse_hooks(hooks_data)
    handler = {
        'type': 'command',
        'command': shlex.quote(str(helper)) + ' --hook',
        'timeout': 3,
        'async': True,
    }
    add_hook(document, 'PermissionRequest', handler)
    add_hook(document, 'UserPromptSubmit', handler)
    new_hooks = json.dumps(document, indent=2).encode() + b'\n'
    originals = {
        'config.toml': (config_data, config_mode),
        'hooks.json': (hooks_data, hooks_mode),
    }
    replacements = {'config.toml': new_config, 'hooks.json': new_hooks}
    backup = backup_files(target, originals, replacements)
    try:
        atomic_write(config_path, new_config, config_mode)
        atomic_write(hooks_path, new_hooks, hooks_mode)
    except Exception:
        if config_data is None:
            config_path.unlink(missing_ok=True)
        else:
            atomic_write(config_path, config_data, config_mode)
        if hooks_data is None:
            hooks_path.unlink(missing_ok=True)
        else:
            atomic_write(hooks_path, hooks_data, hooks_mode)
        raise
    return backup


def rollback(target, backup):
    target = target.resolve()
    backup = backup.resolve()
    allowed = target / '.local/state/mbp-intel/codex-notifications/backups'
    if not backup.is_relative_to(allowed):
        raise RuntimeError('backup must belong to the target HOME')
    try:
        manifest = json.loads((backup / 'manifest.json').read_bytes())
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise RuntimeError(f'cannot read backup manifest: {error}') from error
    if not isinstance(manifest, dict) or manifest.get('version') != 1:
        raise RuntimeError('unsupported backup manifest')
    codex = target / '.codex'
    files = manifest.get('files')
    if not isinstance(files, dict) or set(files) != {'config.toml', 'hooks.json'}:
        raise RuntimeError('invalid backup manifest')
    originals = {}
    for name, entry in files.items():
        path = codex / name
        current, _ = read_regular(path)
        if current is None or digest(current) != entry.get('after_sha256'):
            raise RuntimeError(f'{name} changed since installation; refusing rollback')
        if entry.get('existed'):
            original, _ = read_regular(backup / name)
            if original is None or digest(original) != entry.get('before_sha256'):
                raise RuntimeError(f'backup copy changed: {name}')
            originals[name] = original
        else:
            originals[name] = None
    for name, original in originals.items():
        path = codex / name
        if original is None:
            path.unlink()
            sync_directory(codex)
        else:
            atomic_write(path, original, files[name]['mode'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--target', type=Path, default=Path.home())
    parser.add_argument('--helper', type=Path)
    parser.add_argument('--rollback', type=Path)
    args = parser.parse_args()
    if args.rollback:
        rollback(args.target, args.rollback)
        return
    helper = args.helper or args.target / '.local/bin/mbp-intel-codex-notify'
    print(install(args.target, helper))


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError) as error:
        sys.exit(f'install-codex-notifications: {error}')
