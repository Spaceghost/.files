#!/usr/bin/env python3
"""Render the power deck's Nerd Font glyph tiles as PNG button backgrounds.

wlogout draws each button's icon from a CSS background image and cannot load
SVG without a pixbuf loader, so the deck's glyphs are rasterised from the
installed JetBrains Mono Nerd Font and versioned beside the layout. Re-run this
after changing a glyph or the palette; the output is deterministic for the same
font build and libraries.

The two variants are palette roles, not chosen shades: the resting tile paints
the glyph in `foreground` over the deck's surface, and the hover and focus tile
paints it in `background_hard` over the accent the stylesheet fills the tile
with. Each theme profile therefore carries its own tiles, written by
`desktop_theme.render_assets`, so the deck stops being the one surface that
kept Gruvbox's cream and charcoal under every theme.
"""
import argparse
import hashlib
import io
import json
from pathlib import Path
import sys

import cairo
import gi

gi.require_version('Pango', '1.0')
gi.require_version('PangoCairo', '1.0')
from gi.repository import Pango, PangoCairo  # noqa: E402

REPO = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO / 'alpine/desktop/.local/lib/oldbook'))
import loading
ICONS = REPO / 'alpine/desktop/.config/wlogout/icons'
DEFAULT_THEME = REPO / 'alpine/themes/gruvbox-dark.json'
FONT = 'JetBrainsMono Nerd Font 112'
SIZE = 192
# nf-md-lock, nf-md-sleep, nf-md-logout, nf-md-restart, nf-md-power
GLYPHS = {'lock': '\U000f033e', 'suspend': '\U000f04b2', 'logout': '\U000f0343',
          'reboot': '\U000f0709', 'shutdown': '\U000f0425'}
# Foreground on the resting surface tile; the hard ground on the accent tile.
VARIANT_ROLES = {'': 'foreground', '-active': 'background_hard'}
# Gruvbox Dark's own values, so a call with no theme draws what it always drew.
VARIANTS = {'': '#ebdbb2', '-active': '#1d2021'}


def tile_colors(roles):
    """The two glyph colours for one theme's palette roles."""
    return {suffix: roles.get(role, VARIANTS[suffix])
            for suffix, role in VARIANT_ROLES.items()}


def draw(glyph, color):
    surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, SIZE, SIZE)
    context = cairo.Context(surface)
    layout = PangoCairo.create_layout(context)
    layout.set_font_description(Pango.FontDescription(FONT))
    layout.set_text(glyph, -1)
    ink, _ = layout.get_pixel_extents()
    if ink.width <= 0 or ink.height <= 0:
        raise RuntimeError(f'{FONT} did not render {glyph!r}; install font-jetbrains-mono-nerd')
    context.move_to((SIZE - ink.width) / 2 - ink.x, (SIZE - ink.height) / 2 - ink.y)
    context.set_source_rgb(*(int(color.lstrip('#')[i:i + 2], 16) / 255 for i in (0, 2, 4)))
    PangoCairo.show_layout(context, layout)
    surface.flush()
    stream = io.BytesIO()
    surface.write_to_png(stream)
    return stream.getvalue()


def tiles(variants=None):
    """Every glyph tile for one theme, keyed by its file name."""
    variants = VARIANTS if variants is None else variants
    return {f'{name}{suffix}.png': draw(glyph, color)
            for name, glyph in GLYPHS.items() for suffix, color in variants.items()}


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--output', type=Path, default=ICONS)
    parser.add_argument('--theme', type=Path, default=None,
                        help='draw the tiles in this theme descriptor\'s colours')
    args = parser.parse_args()
    variants = VARIANTS
    if args.theme is not None:
        sys.path.insert(0, str(REPO / 'alpine/wallpapers'))
        from desktop_theme import colors
        variants = tile_colors(colors(json.loads(args.theme.read_text())))
    drawn = tiles(variants)
    # The digests on stdout are this script's real output and are checked
    # against elsewhere, so the bar goes to stderr and leaves them byte for byte.
    with loading.Progress('drawing tiles', len(drawn)) as bar:
        for name, data in drawn.items():
            bar.update(bar.done, name)
            path = args.output / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(data)
            digest = hashlib.sha256(data).hexdigest()
            print(f'{digest[:12]}  '
                  f'{path.relative_to(REPO) if path.is_relative_to(REPO) else path}')
            bar.advance()
    return 0


if __name__ == '__main__':
    sys.exit(main())
