#!/usr/bin/env python3
"""Install the desktop entrypoint and shared palette, preserving conflicts."""
import os
from pathlib import Path
import shutil
import subprocess
import time

REPO = Path(__file__).resolve().parents[2]


def main():
    if os.geteuid() != 0:
        raise SystemExit('Run with doas to install the desktop entrypoint.')
    backup = Path('/var/backups/alpine-rice') / ('desktop-' + str(time.time_ns()))
    wrapper = '''#!/bin/sh
# The user overlay selects SwayFX; a user without it gets stock Sway.
if [ -x "$HOME/.local/bin/oldbook-sway" ]; then
    exec "$HOME/.local/bin/oldbook-sway" "$@"
fi
exec /usr/bin/sway "$@"
'''
    desktop = '''[Desktop Entry]
Name=Space Ghost
Comment=The Oldbook desktop: SwayFX, Gruvbox Dark, and late-night transmissions
Exec=/usr/local/bin/sway
Type=Application
DesktopNames=sway
'''
    backlight = '''# Desktop video-group access to kernel brightness; no privileged shell helper.
ACTION=="add", SUBSYSTEM=="backlight", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"
'''
    priority = (REPO / 'alpine/bin/oldbook-ui-priority').read_text()
    # The fan hold must be a file the desktop user cannot rewrite, because it is
    # run as root: oldbook-cat refuses any helper that is not root-owned.
    fans = (REPO / 'alpine/bin/oldbook-fan-hold').read_text()
    remote = (REPO / 'alpine/bin/oldbook-remote-access').read_text()
    remote_library = (REPO / 'alpine/security/remote_access.py').read_text()
    remote_service = (REPO / 'alpine/security/remote-access/oldbook-remote-access.initd').read_text()
    firewall_policy = (REPO / 'alpine/security/firewall/oldbook.nft').read_text()
    remote_doas = '''# Incoming Transmissions may request only these validated transitions.
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args reconcile
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args mode off
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args mode tailnet
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args mode lan
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args trust home
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args trust friend
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args trust untrusted
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args password on
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args password off
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args key-add
permit nopass jack as root cmd /usr/local/sbin/oldbook-remote-access args key-remove
'''
    for dest, content, mode in [(Path('/usr/local/sbin/oldbook-ui-priority'), priority, 0o755),
                                (Path('/usr/local/sbin/oldbook-fan-hold'), fans, 0o755),
                                (Path('/usr/local/sbin/oldbook-remote-access'), remote, 0o755),
                                (Path('/usr/local/lib/oldbook/remote_access.py'), remote_library, 0o644),
                                (Path('/etc/init.d/oldbook-remote-access'), remote_service, 0o755),
                                (Path('/etc/oldbook/firewall.nft'), firewall_policy, 0o600),
                                (Path('/etc/doas.d/oldbook-remote-access.conf'), remote_doas, 0o400),
                                (Path('/etc/udev/rules.d/90-oldbook-backlight.rules'), backlight, 0o644),
                                (Path('/usr/local/bin/sway'), wrapper, 0o755),
                                (Path('/usr/share/wayland-sessions/oldbook.desktop'), desktop, 0o644)]:
        if dest.is_file() and not dest.is_symlink() and dest.read_bytes() == content.encode():
            dest.chmod(mode)
            os.chown(dest, 0, 0)
            continue
        dest.parent.mkdir(parents=True, exist_ok=True)
        if dest.exists() or dest.is_symlink():
            saved = backup / dest.relative_to('/')
            saved.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(dest), str(saved))
        dest.write_text(content)
        dest.chmod(mode)
        os.chown(dest, 0, 0)
    palettes = {'spaceghost.conf': REPO / 'alpine/theme/spaceghost.conf',
                'gruvbox-dark.conf': REPO / 'alpine/desktop/.config/qt6ct/colors/gruvbox-dark.conf'}
    for name, source in palettes.items():
        if not source.is_file():
            raise RuntimeError('Missing versioned Qt palette: ' + str(source))
        palette = Path('/usr/share/qt6ct/colors') / name
        if not (palette.is_symlink() and palette.resolve() == source):
            palette.parent.mkdir(parents=True, exist_ok=True)
            if palette.exists() or palette.is_symlink():
                backup.mkdir(parents=True, exist_ok=True)
                shutil.move(str(palette), str(backup / name))
            palette.symlink_to(source)
    # The previous binary switch cannot express trust or distinguish Tailscale
    # SSH from LAN OpenSSH. Remove only those two exact obsolete artifacts.
    for obsolete in (Path('/usr/local/sbin/oldbook-sshd-toggle'),
                     Path('/etc/doas.d/oldbook-sshd.conf')):
        if obsolete.exists() or obsolete.is_symlink():
            obsolete.unlink()
    subprocess.run(['/sbin/rc-update', 'add', 'oldbook-remote-access', 'default'], check=True)
    remote_was_running = subprocess.run(
        ['/sbin/rc-service', 'oldbook-remote-access', 'status'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0
    subprocess.run(['/sbin/rc-service', 'oldbook-firewall', 'restart'], check=True)
    if not remote_was_running:
        subprocess.run(['/sbin/rc-service', 'oldbook-remote-access', 'start'], check=True)
    else:
        # Restarting a dependency restarts its running dependents. Wait for
        # OpenRC's transaction instead of racing it with a second start.
        for _attempt in range(50):
            status = subprocess.run(
                ['/sbin/rc-service', 'oldbook-remote-access', 'status'],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            if status.returncode == 0:
                break
            time.sleep(0.1)
        else:
            raise RuntimeError('oldbook-remote-access did not recover after firewall restart')
    subprocess.run(['udevadm', 'control', '--reload-rules'], check=True)
    subprocess.run(['udevadm', 'trigger', '--subsystem-match=backlight', '--action=add'], check=True)
    print('Desktop entrypoint installed. Existing sessions continue; next sway launch uses the overlay.')
    if backup.exists():
        print('Previous files:', backup)


if __name__ == '__main__':
    main()
