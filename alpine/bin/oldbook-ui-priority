#!/usr/bin/python3 -I
"""Put the caller's desktop first, once; child applications retain normal priority.

Installed as a root-owned file by install-desktop-system. Invoke through doas
after session/daemon startup, never in a gesture or animation callback.

Jack: "I need animation to take absolute priority." Three levers, every one
bounded to the desktop's own processes and reset in anything they fork:

- the compositor's main thread, which renders every frame, runs SCHED_RR at
  the lowest realtime priority, as upstream sway does when it is allowed to;
  the kernel's realtime throttle keeps even a spinning thread from taking the
  whole machine, and SCHED_RESET_ON_FORK returns every application it
  launches to an ordinary process at nice 0;
- the desktop's own threads run well below nice 0;
- the desktop's session groups are weighted far above every other session.
  With kernel autogroups on, a nice value only ranks threads inside one
  session; against an agent, a shell or a build in a session of its own the
  compositor otherwise gets one fair share of the machine, however low its
  own threads sit, which is exactly what a choppy flight under load is.
"""
import argparse
import ctypes
import errno
import json
import os
from pathlib import Path
import pwd
import re
import socket
import stat
import struct
import sys


COMPOSITORS = ('sway', 'swayfx')
# The compositor's rendering thread: SCHED_RR at the lowest realtime priority.
COMPOSITOR_REALTIME = 1
# The compositor's other threads (Mesa's helpers), the panels, the notifier,
# the shortcut guide and the reading cards.
NATIVE = {'/usr/bin/' + name: (-10 if name in COMPOSITORS else -15)
          for name in ('sway', 'swayfx', 'waybar', 'swaync', 'superhold', 'conky')}
# The desktop's own daemons that draw: verified by exact path, not by name.
DAEMONS = {'oldbook-carousel', 'oldbook-showdesktop', 'oldbook-decoration',
           'oldbook-background', 'oldbook-osd', 'oldbook-workspaces', 'oldbook-wallpaper'}
DAEMON_NICE = -15
# The weight of a desktop session group against every other session.
GROUP_NICE = -20
# A group holding any of these is somebody's workspace -- a terminal, a shell,
# an agent -- and is never weighted, even if a desktop daemon was started by
# hand inside it. Matched on the kernel's comm, which nothing here trusts for
# more than this refusal.
WORKSPACE_COMMS = {'zsh', 'bash', 'fish', 'sh', 'tmux: server', 'foot', 'ghostty',
                   'claude', 'codex', 'node'}
# The one shell that is the desktop's own: oldbook-session runs under /bin/sh
# and its group holds the daemons it starts.
SESSION_SCRIPT = 'oldbook-session'


def session_owner(session, uid):
    path = Path(session)
    metadata = path.lstat()
    if not path.is_absolute() or metadata.st_uid != uid or not stat.S_ISSOCK(metadata.st_mode):
        raise ValueError('Session must be an absolute caller-owned Unix socket')
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(2)
        connection.connect(session)
        pid, peer_uid, _gid = struct.unpack('3i', connection.getsockopt(
            socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize('3i')))
    if peer_uid != uid or pid <= 1:
        raise ValueError('Compositor socket peer must belong to the desktop caller')
    return pid


def in_session(pid, session, compositor_pid, proc=Path('/proc')):
    if pid == compositor_pid:
        return True
    try:
        return os.fsencode('SWAYSOCK=' + session) in (proc / str(pid) / 'environ').read_bytes().split(b'\0')
    except OSError:
        return False


def status_fields(path):
    return dict(line.split(':', 1) for line in (path / 'status').read_text().splitlines()
                if ':' in line)


def owned(path, uid, tgid):
    fields = status_fields(path)
    return (list(map(int, fields['Uid'].split())) == [uid] * 4
            and int(fields['Tgid']) == tgid)


def stat_fields(path):
    # comm may contain spaces or parentheses; the fields follow its last ')'.
    return (path / 'stat').read_text().rsplit(')', 1)[1].split()


def start_time(path):
    return stat_fields(path)[19]


def session_leader(path):
    """The pid that called setsid for this process's session: the process
    whose autogroup every process in the session shares."""
    return int(stat_fields(path)[3])


def group_of(path):
    """The autogroup id, from the kernel's own '/autogroup-N nice M' line."""
    return (path / 'autogroup').read_text().split()[0].rsplit('-', 1)[1]


def comm_of(path):
    return (path / 'comm').read_text().rstrip('\n')


def identify(pid, uid, home, proc=Path('/proc')):
    """Return safe identifying data only; do not retain or print command lines."""
    path = proc / str(pid)
    try:
        if not owned(path, uid, pid):
            return None
        executable = os.readlink(path / 'exe').removesuffix(' (deleted)')
        binary = (path / 'exe').stat()
        if binary.st_uid != 0 or binary.st_mode & 0o022 or not stat.S_ISREG(binary.st_mode):
            return None
        if executable in NATIVE:
            return {'name': Path(executable).name, 'nice': NATIVE[executable],
                    'start': start_time(path)}
        if not re.fullmatch(r'/usr/bin/python3(?:\.\d+)?', executable):
            return None
        args = (path / 'cmdline').read_bytes().rstrip(b'\0').split(b'\0')
        if args[1:2] == [b'-S']:
            del args[1]
        if len(args) != 3 or args[2] != b'daemon':
            return None
        script = Path(os.fsdecode(args[1]))
        if not script.is_absolute():
            return None
        name = script.name
        source = script.resolve(strict=True)
        checkout = home / '.files/alpine/desktop/.local/bin'
        allowed = (name in DAEMONS
                   and script in (home / '.local/bin' / name, checkout / name)
                   and source == (checkout / name).resolve(strict=True)
                   and source.stat().st_uid == uid)
        if name == 'superhold':
            versions = home / '.local/share/superhold/versions'
            relative = source.relative_to(versions) if source.is_relative_to(versions) else None
            allowed = ((script == Path('/usr/bin/superhold') and source.stat().st_uid == 0)
                       or (relative is not None and len(relative.parts) == 3
                           and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', relative.parts[0])
                           and relative.parts[1:] == ('bin', 'superhold')
                           and script == source and source.stat().st_uid == uid))
        if allowed:
            return {'name': name, 'nice': DAEMON_NICE, 'start': start_time(path)}
    except (OSError, ValueError, KeyError, IndexError):
        pass
    return None


def session_script(path):
    """Whether this process is the desktop's own session script under its shell."""
    try:
        args = (path / 'cmdline').read_bytes().rstrip(b'\0').split(b'\0')
        return any(Path(os.fsdecode(arg)).name == SESSION_SCRIPT for arg in args[:3])
    except (OSError, ValueError):
        return False


def desktop_groups(uid, home, session, compositor_pid, proc=Path('/proc')):
    """The autogroups that are the desktop's own, and so may be weighted.

    A group is the desktop's when the compositor is in it, when a desktop
    process leads it (a daemon started in a session of its own), or when
    every member belongs to this desktop session, none of them is somebody's
    shell, terminal or agent, and at least one is a recognised desktop
    process. A daemon started by hand inside a terminal therefore never
    drags that terminal's group up with it.
    """
    members = {}
    for entry in proc.iterdir():
        if not entry.name.isdecimal():
            continue
        pid = int(entry.name)
        try:
            if not owned(entry, uid, pid):
                continue
            group = group_of(entry)
            leader = session_leader(entry) == pid
            comm = comm_of(entry)
        except (OSError, ValueError, IndexError, KeyError):
            continue
        identity = identify(pid, uid, home, proc)
        workspace = comm in WORKSPACE_COMMS and not session_script(entry)
        members.setdefault(group, []).append({
            'pid': pid, 'desktop': identity is not None, 'leader': leader,
            'workspace': workspace,
            'inside': session is None or in_session(pid, session, compositor_pid, proc)})
    chosen = set()
    for group, rows in members.items():
        if compositor_pid is not None and any(row['pid'] == compositor_pid for row in rows):
            chosen.add(group)
        elif any(row['desktop'] and row['leader'] for row in rows):
            chosen.add(group)
        elif (any(row['desktop'] for row in rows)
              and all(row['inside'] and not row['workspace'] for row in rows)):
            chosen.add(group)
    return chosen


def linux_scheduler_call(number, *arguments):
    # musl deliberately stubs the process-wide POSIX API with ENOSYS. Linux's
    # per-thread ABI is what this helper needs (also used by util-linux chrt).
    # This laptop is x86_64: values are from asm/unistd_64.h. Refuse to guess on
    # another ABI; libc remains the first choice everywhere.
    if os.uname().machine != 'x86_64':
        raise OSError(errno.ENOSYS, 'Scheduling syscall fallback requires x86_64')
    libc = ctypes.CDLL(None, use_errno=True)
    libc.syscall.restype = ctypes.c_long
    result = libc.syscall(ctypes.c_long(number), *arguments)
    if result == -1:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))
    return result


def scheduler_policy(tid):
    try:
        return os.sched_getscheduler(tid)
    except OSError as error:
        if error.errno != errno.ENOSYS:
            raise
        return linux_scheduler_call(145, ctypes.c_int(tid))


def set_policy(tid, policy, priority=0):
    try:
        os.sched_setscheduler(tid, policy, os.sched_param(priority))
    except OSError as error:
        if error.errno != errno.ENOSYS:
            raise
        parameter = ctypes.c_int(priority)
        linux_scheduler_call(144, ctypes.c_int(tid), ctypes.c_int(policy),
                             ctypes.byref(parameter))


def arm_child_reset(tid):
    set_policy(tid, os.SCHED_OTHER | os.SCHED_RESET_ON_FORK)


def boost_thread(tid, nice):
    """Arm child reset before boosting; preserve realtime and explicit policies."""
    current = scheduler_policy(tid)
    if current & ~os.SCHED_RESET_ON_FORK != os.SCHED_OTHER:
        return False
    arm_child_reset(tid)
    os.setpriority(os.PRIO_PROCESS, tid, nice)
    return True


def realtime_thread(tid, priority):
    """Put one thread on the round-robin realtime class, children reset.

    Only an ordinary thread, or one already round-robin from an earlier run,
    is touched; a FIFO or deadline thread was somebody's explicit choice and
    keeps it. SCHED_RESET_ON_FORK goes on with the policy, so a process forked
    from this thread starts as an ordinary one at nice 0.
    """
    current = scheduler_policy(tid) & ~os.SCHED_RESET_ON_FORK
    if current not in (os.SCHED_OTHER, os.SCHED_RR):
        return False
    set_policy(tid, os.SCHED_RR | os.SCHED_RESET_ON_FORK, priority)
    return True


def weight_group(pid, nice, proc=Path('/proc')):
    """Give the whole session group pid belongs to this nice value."""
    (proc / str(pid) / 'autogroup').write_text(str(nice) + '\n')


def apply(pid, uid, home, check=False, session=None, compositor_pid=None, groups=None,
          proc=Path('/proc')):
    identity = identify(pid, uid, home, proc)
    if identity is None or (session is not None and not in_session(pid, session, compositor_pid, proc)):
        return None
    compositor = identity['name'] in COMPOSITORS
    result = {'pid': pid, 'name': identity['name'], 'target_nice': identity['nice'],
              'group': None, 'threads': []}
    path = proc / str(pid)
    try:
        group = group_of(path)
        result['group'] = {'id': group, 'weighted': False,
                           'reported': (path / 'autogroup').read_text().strip()}
        if not check and groups is not None and group in groups:
            weight_group(pid, GROUP_NICE, proc)
            result['group']['weighted'] = True
            result['group']['reported'] = (path / 'autogroup').read_text().strip()
    except OSError as error:
        result['group'] = {'error': error.errno}
    try:
        tasks = list((path / 'task').iterdir())
    except OSError:
        return None
    for task in tasks:
        try:
            tid = int(task.name)
            if not owned(task, uid, pid) or identify(pid, uid, home, proc) != identity:
                continue
            if check:
                changed = False
            elif compositor and tid == pid:
                changed = realtime_thread(tid, COMPOSITOR_REALTIME)
            else:
                changed = boost_thread(tid, identity['nice'])
            result['threads'].append({'tid': tid, 'nice': os.getpriority(os.PRIO_PROCESS, tid),
                                      'policy': scheduler_policy(tid), 'applied': changed})
        except ProcessLookupError:
            continue
        except OSError as error:
            result['threads'].append({'tid': tid, 'error': error.errno})
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true', help='report only; leave scheduling untouched')
    parser.add_argument('--session', help='limit all targets to this caller-owned Sway IPC socket')
    parser.add_argument('pids', nargs='*', type=int, help='optional desktop process IDs')
    args = parser.parse_args()
    if not args.pids and not args.session:
        parser.error('A session socket is required when scanning desktop processes')
    if any(pid <= 1 for pid in args.pids):
        parser.error('Process IDs must be greater than one')
    try:
        caller = pwd.getpwnam(os.environ['DOAS_USER'])
    except (KeyError, ValueError):
        parser.error('Run through doas as a desktop user')
    if os.geteuid() != 0 or caller.pw_uid == 0:
        parser.error('Run through doas as a non-root desktop user')
    home = Path(caller.pw_dir)
    if not home.is_absolute() or not home.is_dir():
        parser.error('The desktop user must have an existing absolute HOME')
    try:
        compositor_pid = session_owner(args.session, caller.pw_uid) if args.session else None
    except (OSError, ValueError) as error:
        parser.error(str(error))
    groups = desktop_groups(caller.pw_uid, home, args.session, compositor_pid)
    pids = args.pids or sorted(int(path.name) for path in Path('/proc').iterdir()
                               if path.name.isdecimal())
    results = [result for pid in pids
               if (result := apply(pid, caller.pw_uid, home, args.check,
                                   args.session, compositor_pid, groups)) is not None]
    print(json.dumps({'check': args.check, 'uid': caller.pw_uid,
                      'groups': sorted(groups), 'processes': results}, indent=2))
    return int(any('error' in thread for result in results for thread in result['threads']))


if __name__ == '__main__':
    sys.exit(main())
