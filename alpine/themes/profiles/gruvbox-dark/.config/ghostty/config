# Gruvbox Dark: generated from this theme's Foot palette by oldbook-theme sync.
# Edit the Foot colours, then rerun sync; this file is derived.
copy-on-select = clipboard
font-family = JetBrainsMono Nerd Font
font-size = 9.5
command = /bin/zsh
window-padding-x = 3
window-padding-y = 3
window-decoration = server
window-theme = dark
custom-shader = ~/.config/ghostty/shaders/warm-bloom.glsl
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
custom-shader-animation = true

background = 282828
foreground = ebdbb2
selection-background = 504945
selection-foreground = fbf1c7
background-opacity = 0.78
cursor-text = 282828
cursor-color = fabd2f

palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
