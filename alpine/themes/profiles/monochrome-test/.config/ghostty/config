copy-on-select = clipboard
# Monochrome Test, matching Foot and the shared desktop painting.
font-family = JetBrainsMono Nerd Font
font-size = 9.5
command = /bin/zsh
background = 000000
foreground = ffffff
background-opacity = 0.78
selection-background = ffffff
selection-foreground = ffffff
cursor-color = ffffff
cursor-text = 000000
window-padding-x = 6
window-padding-y = 6
window-decoration = server
window-theme = dark
palette = 0=#000000
palette = 1=#ffffff
palette = 2=#ffffff
palette = 3=#ffffff
palette = 4=#ffffff
palette = 5=#ffffff
palette = 6=#ffffff
palette = 7=#ffffff
palette = 8=#ffffff
palette = 9=#ffffff
palette = 10=#ffffff
palette = 11=#ffffff
palette = 12=#ffffff
palette = 13=#ffffff
palette = 14=#ffffff
palette = 15=#ffffff

# Shaders: a short cursor smear and a faint warm bloom, both cheap. Ghostty
# animates them only while the surface is focused. Paths may start with ~/.
custom-shader = ~/.config/ghostty/shaders/warm-bloom.glsl
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
custom-shader-animation = true
