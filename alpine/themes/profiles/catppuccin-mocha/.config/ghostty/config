# Catppuccin Mocha: generated from this theme's Foot palette by oldbook-theme sync.
# Edit the Foot colours, then rerun sync; this file is derived.
copy-on-select = clipboard
font-family = JetBrainsMono Nerd Font
font-size = 9.5
command = /bin/zsh
window-padding-x = 6
window-padding-y = 6
window-decoration = server
window-theme = dark
custom-shader = ~/.config/ghostty/shaders/warm-bloom.glsl
custom-shader = ~/.config/ghostty/shaders/cursor-smear.glsl
custom-shader-animation = true

background = 1e1e2e
foreground = cdd6f4
selection-background = 45475a
selection-foreground = d7def6
background-opacity = 0.92
cursor-text = 1e1e2e
cursor-color = f9e2af

palette = 0=#1e1e2e
palette = 1=#af6881
palette = 2=#7aa47c
palette = 3=#b3a386
palette = 4=#6784b9
palette = 5=#947ab7
palette = 6=#6ea3a0
palette = 7=#a6adc8
palette = 8=#6c7086
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#cba6f7
palette = 14=#94e2d5
palette = 15=#cdd6f4
