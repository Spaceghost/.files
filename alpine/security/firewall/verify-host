#!/usr/bin/env python3
"""Probe live-host TCP filtering using a temporary veth peer, without editing rules."""
import argparse
import http.server
import ipaddress
import json
import os
from pathlib import Path
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b'MBP_INTEL_PACKET_PROBE\n')

    def log_message(self, *args):
        pass


class IPv6Server(http.server.HTTPServer):
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        super().server_bind()


def run(*args, **kw):
    return subprocess.run(args, check=True, capture_output=True, text=True, timeout=10, **kw)


def curl(host, port, prefix=(), uid=None, executable='/usr/bin/curl', max_time=3):
    url_host = f'[{host}]' if ':' in host else host
    result = subprocess.run([*prefix, executable, '--disable', '--noproxy', '*',
        '--silent', '--fail', '--max-time', str(max_time), '--write-out',
        '\nMBP_INTEL_CONNECTS:%{num_connects}', f'http://{url_host}:{port}/'],
        capture_output=True, text=True, timeout=max_time + 2,
        **({'user': uid, 'group': uid, 'extra_groups': ()} if uid is not None else {}))
    if result.returncode not in (0, 28):
        raise RuntimeError(f'Probe failed unexpectedly: curl exit {result.returncode}')
    body, separator, connections = result.stdout.rpartition('\nMBP_INTEL_CONNECTS:')
    if not separator or not connections.isdecimal():
        raise RuntimeError('Missing curl connection-count evidence')
    if result.returncode == 0:
        if int(connections) != 1 or body.strip() != 'MBP_INTEL_PACKET_PROBE':
            raise RuntimeError('HTTP succeeded but returned an unexpected probe body')
        return True
    if int(connections) != 0:
        raise RuntimeError('TCP connected before the HTTP timeout; denial is unproven')
    return False


def serve(ready, port):
    while not ready.exists():
        time.sleep(.02)
    servers = [http.server.HTTPServer(('0.0.0.0', port), Handler), IPv6Server(('::', port), Handler)]
    for server in servers:
        threading.Thread(target=server.serve_forever, daemon=True).start()
    ready.with_suffix('.listening').touch()
    threading.Event().wait()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--expect', required=True, choices=('allow', 'deny'))
    parser.add_argument('--expect-output', choices=('allow', 'deny', 'either'),
                        help='Override output expectation; either records a real interactive choice')
    parser.add_argument('--port', type=int, default=443,
                        help='Peer destination port; use a non-443 port to test retained HTTPS exceptions')
    parser.add_argument('--timeout', type=int, default=3,
                        help='Output wait in seconds; allow time for the real GUI prompt')
    parser.add_argument('--uid', required=True, type=int)
    parser.add_argument('--output', required=True, type=Path, help='New private evidence directory')
    args = parser.parse_args()
    if os.geteuid() != 0 or args.uid <= 0:
        parser.error('Run as root with the non-root desktop UID')
    if not 1 <= args.port <= 65535 or not 1 <= args.timeout <= 90:
        parser.error('Port must be 1–65535 and timeout 1–90 seconds')
    args.output.mkdir(mode=0o700, exist_ok=False)
    # Reject overlap with any existing non-default route before adding a peer.
    routes = json.loads(run('ip', '-j', 'route', 'show', 'table', 'all').stdout)
    occupied = [ipaddress.ip_network(r['dst'], strict=False) for r in routes
                if r.get('dst') not in (None, 'default')]
    for _ in range(100):
        network = ipaddress.ip_network(f'198.19.{secrets.randbelow(256)}.{secrets.randbelow(64)*4}/30')
        if not any(network.overlaps(existing) for existing in occupied):
            break
    else:
        raise RuntimeError('No unused private test subnet')
    ipv4 = [str(network.network_address + n) for n in (1, 2)]
    v6prefix = f'fd{secrets.token_hex(1)}:{secrets.token_hex(2)}:{secrets.token_hex(2)}:{secrets.token_hex(2)}'
    ipv6 = [v6prefix + f'::{n}' for n in (1, 2)]
    link = 'obp' + secrets.token_hex(4)
    peer = link + 'p'
    process = None
    created = False
    servers = []
    results = []
    with tempfile.TemporaryDirectory(prefix='mbp-intel-host-packets-') as work:
        # Use a new executable path so an existing interactive curl permission
        # cannot invalidate this unknown-application check. This directory has
        # only the probe executable and readiness markers, and stays root-writable.
        os.chmod(work, 0o755)
        client = Path(work) / 'mbp-intel-unapproved-network-probe'
        shutil.copyfile('/usr/bin/curl', client)
        client.chmod(0o755)
        ready = Path(work) / 'ready'
        try:
            process = subprocess.Popen(['unshare', '--net', sys.executable, str(Path(__file__).resolve()),
                                        '_serve', str(ready), str(args.port)], stdin=subprocess.DEVNULL,
                                       stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            for _ in range(250):
                if process.poll() is not None:
                    raise RuntimeError('Peer namespace failed to start')
                if os.readlink(f'/proc/{process.pid}/ns/net') != os.readlink('/proc/self/ns/net'):
                    break
                time.sleep(.02)
            else:
                raise RuntimeError('Peer did not enter its own network namespace')
            ns = ('nsenter', f'--net=/proc/{process.pid}/ns/net')
            run('ip', 'link', 'add', link, 'type', 'veth', 'peer', 'name', peer)
            created = True
            run('ip', 'link', 'set', peer, 'netns', str(process.pid))
            for prefix, name, index in (((), link, 0), (ns, peer, 1)):
                run(*prefix, 'ip', 'addr', 'add', ipv4[index] + '/30', 'dev', name)
                run(*prefix, 'ip', 'addr', 'add', ipv6[index] + '/64', 'dev', name, 'nodad')
                run(*prefix, 'ip', 'link', 'set', name, 'up')
            run(*ns, 'ip', 'link', 'set', 'lo', 'up')
            ready.touch()
            for _ in range(250):
                if ready.with_suffix('.listening').exists():
                    break
                if process.poll() is not None:
                    raise RuntimeError('Peer server failed to bind')
                time.sleep(.02)
            else:
                raise RuntimeError('Peer server was not ready')
            expected = args.expect == 'allow'
            output_expected = args.expect_output or args.expect
            for family, addresses, server_class in ((4, ipv4, http.server.HTTPServer),
                                                     (6, ipv6, IPv6Server)):
                if not curl(addresses[1], args.port, ns, executable=str(client)):
                    raise RuntimeError('Peer-local server control failed')
                allowed = curl(addresses[1], args.port, uid=args.uid, executable=str(client),
                               max_time=args.timeout)
                if output_expected != 'either' and allowed != (output_expected == 'allow'):
                    raise RuntimeError(f'Unexpected IPv{family} output verdict: allowed={allowed}')
                verdict = 'allow' if allowed else 'deny'
                results.append(f'IPv{family} new output {verdict}, fresh executable path UID {args.uid}, port {args.port}')
                server = server_class((addresses[0], 0), Handler)
                servers.append(server)
                threading.Thread(target=server.serve_forever, daemon=True).start()
                if not curl(addresses[0], server.server_port):
                    raise RuntimeError('Host-local server control failed')
                allowed = curl(addresses[0], server.server_port, ns)
                if allowed != expected:
                    raise RuntimeError(f'Unexpected IPv{family} input verdict: allowed={allowed}')
                results.append(f'IPv{family} unsolicited input {args.expect}')
        finally:
            for server in servers:
                server.shutdown()
                server.server_close()
            if process is not None:
                process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=3)
                process.stderr.close()
            if created:
                subprocess.run(['ip', 'link', 'del', link], capture_output=True, timeout=5)
    evidence = {'results': results, 'local_server_controls_passed': True,
                'output_expectation': output_expected, 'output_port': args.port,
                'output_timeout_seconds': args.timeout, 'probe_executable': str(client),
                'firewall_rules_modified': False, 'external_network_used': False,
                'temporary_link_removed': subprocess.run(['ip', 'link', 'show', link],
                    capture_output=True).returncode != 0}
    (args.output / 'evidence.json').write_text(json.dumps(evidence, indent=2) + '\n')
    print(json.dumps(evidence), flush=True)


if __name__ == '__main__':
    if len(sys.argv) == 4 and sys.argv[1] == '_serve':
        serve(Path(sys.argv[2]), int(sys.argv[3]))
    else:
        main()
