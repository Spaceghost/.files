#!/usr/bin/python3 -I
"""Fail-closed root radio controller; it never reads credential material."""
import fcntl
from collections import deque
from contextlib import contextmanager
import json
import os
from pathlib import Path
import re
import secrets
import select
import signal
import socket
import stat
import subprocess
import sys
import time

RFKILL = "/usr/sbin/rfkill"
IP = "/sbin/ip"
UDHCPC = "/sbin/udhcpc"
INTERFACE = "wlan0"
CONTROL_SOCKET = "/run/wpa_supplicant/wlan0"
CONTROL_DIR = "/run/wpa_supplicant"
PROFILE_FILE = Path("/etc/privacyctl/profiles")
LOCK_FILE = Path("/run/privacyctl.lock")
SESSION_FILE = Path("/run/privacyctl/session.json")
ALLOWED = {"shmecklebucket", "iphone-hotspot"}
CONNECT_DEADLINE = 20
SCAN_DEADLINE = 15
COMMAND_DEADLINE = 5
DHCP_DEADLINE = 20
OPERATION_DEADLINE = 45
LOCK_DEADLINE = 60


class PrivacyError(RuntimeError):
    pass


def stop_process_group(process):
    """Stop a command and its ordinary hook children, then reap the leader."""
    if process.returncode is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    try:
        process.communicate(timeout=1)
    except subprocess.TimeoutExpired:
        # A child which deliberately starts another session is outside this
        # group. Do not wait forever on descriptors it might have inherited.
        for stream in (process.stdout, process.stderr):
            if stream is not None:
                stream.close()
        process.wait(timeout=1)


def run_checked(args, timeout=COMMAND_DEADLINE):
    try:
        process = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, text=True, start_new_session=True)
    except OSError as error:
        raise PrivacyError("command unavailable: " + args[0]) from error
    try:
        output, _errors = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as error:
        stop_process_group(process)
        raise PrivacyError("command deadline exceeded: " + args[0]) from error
    except BaseException:
        stop_process_group(process)
        raise
    if process.returncode:
        raise PrivacyError("command failed: " + args[0])
    return output


@contextmanager
def operation_deadline(seconds=OPERATION_DEADLINE):
    """Bound one main-thread transaction; cleanup runs after this timer ends."""
    previous_handler = signal.getsignal(signal.SIGALRM)
    previous_timer = signal.getitimer(signal.ITIMER_REAL)
    started = time.monotonic()

    def expired(_signum, _frame):
        raise PrivacyError("radio operation deadline exceeded")

    signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)
        if previous_timer[0]:
            remaining = max(.001, previous_timer[0] - (time.monotonic() - started))
            signal.setitimer(signal.ITIMER_REAL, remaining, previous_timer[1])


class RadioLock:
    def __init__(self, blocking=True, timeout=LOCK_DEADLINE):
        self.blocking = blocking
        self.timeout = timeout

    def __enter__(self):
        self.fd = os.open(LOCK_FILE, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
        try:
            info = os.fstat(self.fd)
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                    or info.st_mode & 0o077):
                raise PrivacyError("radio lock must be owned by the controller and private")
            deadline = time.monotonic() + self.timeout
            while True:
                try:
                    fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if not self.blocking:
                        raise
                    if time.monotonic() >= deadline:
                        raise PrivacyError("radio lock deadline exceeded") from None
                    time.sleep(min(.05, max(0, deadline - time.monotonic())))
        except BaseException:
            os.close(self.fd)
            raise
        return self

    def __exit__(self, _type, _value, _traceback):
        fcntl.flock(self.fd, fcntl.LOCK_UN)
        os.close(self.fd)


class WpaControl:
    """Minimal wpa_ctrl client: unsolicited events never count as replies."""
    check = staticmethod(lambda: None)

    def __init__(self, endpoint=CONTROL_SOCKET, directory=CONTROL_DIR, *, check=lambda: None):
        self.check = check
        self.events = deque()
        self.scan_id = None
        self.local = os.path.join(directory, ".privacyctl-" + secrets.token_hex(12))
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        try:
            self.sock.bind(self.local)
            self.sock.connect(endpoint)
            self.expect_ok("ATTACH")
        except BaseException as error:
            self.close()
            if isinstance(error, OSError):
                raise PrivacyError("wpa control socket unavailable") from error
            raise

    def close(self):
        try:
            self.sock.close()
        finally:
            try:
                os.unlink(self.local)
            except FileNotFoundError:
                pass

    def __enter__(self):
        return self

    def __exit__(self, _type, _value, _traceback):
        self.close()

    def request(self, command, deadline=3):
        end = time.monotonic() + deadline
        while True:
            self.check()
            remaining = end - time.monotonic()
            if remaining <= 0:
                raise PrivacyError("wpa control send failed or timed out")
            self.sock.settimeout(min(.025, remaining))
            try:
                self.sock.send(command.encode("ascii"))
                break
            except TimeoutError:
                continue
            except OSError as error:
                raise PrivacyError("wpa control send failed or timed out") from error
        while True:
            self.check()
            remaining = end - time.monotonic()
            if remaining <= 0:
                raise PrivacyError("wpa command timed out")
            self.sock.settimeout(min(.025, remaining))
            try:
                message = self.sock.recv(65535).decode("utf-8", "strict").strip()
            except TimeoutError:
                continue
            except (OSError, UnicodeError) as error:
                raise PrivacyError("wpa control protocol failed") from error
            self.check()
            if not message.startswith("<"):
                return message
            if len(self.events) >= 128:
                raise PrivacyError("wpa event queue overflow")
            self.events.append(message)

    def expect_ok(self, command):
        if self.request(command) != "OK":
            raise PrivacyError("wpa rejected " + command.split(" ", 1)[0])

    def read_event(self, timeout=0):
        """Consume one attached event, including events received before an OK."""
        if timeout < 0:
            raise ValueError("event timeout must be nonnegative")
        self.check()
        if self.events:
            return self.events.popleft()
        end = time.monotonic() + timeout
        try:
            while not select.select([self.sock], [], [], min(.025, max(0, end - time.monotonic())))[0]:
                self.check()
                if time.monotonic() >= end:
                    return None
            self.check()
            self.sock.setblocking(False)
            message = self.sock.recv(65535).decode("utf-8", "strict").strip()
        except (OSError, UnicodeError) as error:
            raise PrivacyError("wpa event stream failed") from error
        if not message.startswith("<"):
            raise PrivacyError("unexpected wpa reply outside a command")
        return message

    def start_scan(self):
        # Attached events from earlier commands must not satisfy this scan.
        # Bound the drain so an event flood cannot keep the radio clear forever.
        self.scan_id = None
        self.events.clear()
        for _ in range(128):
            if self.read_event() is None:
                # Native wpa_supplicant 2.11 tags this request's completion,
                # including an event delivered before its numeric reply.
                reply = self.request("SCAN use_id=1")
                if not re.fullmatch(r"[0-9]{1,10}", reply) or int(reply) > 0xffffffff:
                    raise PrivacyError("wpa rejected scan identifier")
                self.scan_id = int(reply)
                return self.scan_id
        raise PrivacyError("wpa event stream did not become idle before scan")

    def wait_scan(self, deadline):
        """Wait for this scan's exact completion ID, never an older result."""
        if self.scan_id is None:
            raise PrivacyError("no pending wpa scan identifier")
        expected = self.scan_id
        end = time.monotonic() + deadline
        try:
            while True:
                remaining = end - time.monotonic()
                if remaining <= 0:
                    raise PrivacyError("expected wpa scan event did not arrive")
                message = self.read_event(remaining)
                if message is None:
                    continue
                match = re.fullmatch(r"<[0-9]+>CTRL-EVENT-SCAN-RESULTS id=([0-9]{1,10})", message)
                if match and int(match[1]) == expected:
                    return expected
        finally:
            self.scan_id = None

    def wait_event(self, fragment, deadline):
        end = time.monotonic() + deadline
        while True:
            remaining = end - time.monotonic()
            if remaining <= 0:
                raise PrivacyError("expected wpa event did not arrive")
            message = self.read_event(remaining)
            if message is not None and fragment in message:
                return

    def status(self):
        values = {}
        for line in self.request("STATUS").splitlines():
            key, separator, value = line.partition("=")
            if separator and key in {"wpa_state", "id", "ssid"}:
                values[key] = value
        return values

    def network_ssid(self, network_id):
        found = []
        for line in self.request("LIST_NETWORKS").splitlines()[1:]:
            columns = line.split("\t")
            if len(columns) >= 2 and columns[0] == str(network_id):
                found.append(columns[1])
        if len(found) != 1:
            raise PrivacyError("configured network id is absent or ambiguous")
        return found[0]


class System:
    def _block_values(self, kind, attribute):
        states = []
        for entry in Path("/sys/class/rfkill").glob("rfkill*"):
            try:
                if (entry / "type").read_text().strip() == kind:
                    value = (entry / attribute).read_text().strip()
                    if value not in {"0", "1"}:
                        raise PrivacyError("invalid rfkill " + attribute + " state: " + kind)
                    states.append(value)
            except OSError as error:
                # Skipping one unreadable adapter could make the remaining
                # blocked adapters appear to prove a block of the whole class.
                raise PrivacyError("rfkill " + attribute + " state unavailable: " + kind) from error
        if not states:
            raise PrivacyError("rfkill device missing: " + kind)
        return states

    def states(self, kind):
        """Return the controller's 0=blocked/1=clear view of software blocks."""
        # Linux's deprecated /state reports 2 whenever hard-blocked and cannot
        # distinguish soft=0/hard=1 from soft=1/hard=1. Read /soft directly.
        # ABI: Documentation/ABI/stable/sysfs-class-rfkill in the Linux tree.
        return ["0" if value == "1" else "1" for value in self._block_values(kind, "soft")]

    def hard_states(self, kind):
        """Return kernel hard-block bits independently of software policy."""
        return self._block_values(kind, "hard")

    def block_all(self):
        errors = []
        for kind in ("wlan", "bluetooth"):
            try:
                run_checked([RFKILL, "block", kind])
            except PrivacyError as error:
                errors.append(str(error))
        for kind in ("wlan", "bluetooth"):
            try:
                if any(value != "0" for value in self.states(kind)):
                    errors.append("rfkill soft block is not set: " + kind)
            except PrivacyError as error:
                errors.append(str(error))
        if errors:
            raise PrivacyError("; ".join(errors))

    def unblock_wifi(self):
        run_checked([RFKILL, "unblock", "wlan"])
        if any(value != "1" for value in self.states("wlan")):
            raise PrivacyError("rfkill soft block remains set: wlan")
        if any(value != "0" for value in self.states("bluetooth")):
            raise PrivacyError("bluetooth software block is not set")

    def block_bluetooth(self):
        run_checked([RFKILL, "block", "bluetooth"])
        if any(value != "0" for value in self.states("bluetooth")):
            raise PrivacyError("rfkill soft block is not set: bluetooth")

    def prepare_addresses(self, profile):
        run_checked([IP, "-4", "route", "flush", "dev", INTERFACE])
        run_checked([IP, "-4", "addr", "flush", "dev", INTERFACE, "scope", "global"])
        if profile == "iphone-hotspot":
            run_checked([IP, "-6", "route", "flush", "dev", INTERFACE])
            run_checked([IP, "-6", "addr", "flush", "dev", INTERFACE, "scope", "global"])
        run_checked([UDHCPC, "-i", INTERFACE, "-n", "-q", "-t", "5", "-T", "3"], timeout=DHCP_DEADLINE)


def read_profile(profile, path=PROFILE_FILE):
    if profile not in ALLOWED:
        raise PrivacyError("unsupported profile")
    try:
        info = path.lstat()
    except OSError as error:
        raise PrivacyError("profile policy is unavailable") from error
    if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
        raise PrivacyError("profile policy must be root-owned and private")
    matches = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        if raw and not raw.startswith("#"):
            fields = raw.split("|")
            if len(fields) == 4 and fields[:2] == ["profile", profile] and fields[2].isdigit() and fields[3]:
                matches.append((int(fields[2]), fields[3]))
    if len(matches) != 1:
        raise PrivacyError("profile is absent or invalid")
    network_id, ssid = matches[0]
    if profile == "shmecklebucket" and ssid != "shmecklebucket":
        raise PrivacyError("home profile must use the exact home SSID")
    return network_id, ssid


def session_directory(create=False):
    """Open the private runtime directory without following a directory symlink."""
    directory = SESSION_FILE.parent
    descriptor = None
    try:
        if create:
            directory.mkdir(mode=0o700, exist_ok=True)
        descriptor = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        info = os.fstat(descriptor)
        if info.st_uid != os.geteuid() or info.st_mode & 0o077:
            raise PrivacyError("session directory must be owned by the controller and private")
        return descriptor
    except Exception as error:
        if descriptor is not None:
            os.close(descriptor)
        if isinstance(error, FileNotFoundError):
            raise
        if isinstance(error, OSError):
            raise PrivacyError("session directory is unavailable or unsafe") from error
        raise


def write_session(profile, network_id, ssid):
    directory = session_directory(create=True)
    temporary = ".privacyctl-" + secrets.token_hex(12)
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
                     0o600, dir_fd=directory)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            json.dump({"profile": profile, "id": network_id, "ssid": ssid}, output)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, SESSION_FILE.name, src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)
    finally:
        try:
            try:
                os.unlink(temporary, dir_fd=directory)
            except FileNotFoundError:
                pass
        finally:
            os.close(directory)


def read_session():
    directory = session_directory()
    try:
        descriptor = os.open(SESSION_FILE.name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
                             dir_fd=directory)
        with os.fdopen(descriptor, "r", encoding="utf-8") as source:
            info = os.fstat(source.fileno())
            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
                    or info.st_mode & 0o077 or info.st_size > 4096):
                raise PrivacyError("session file is unsafe")
            session = json.load(source)
        if (not isinstance(session, dict) or session.get("profile") not in ALLOWED
                or type(session.get("id")) is not int or session["id"] < 0
                or not isinstance(session.get("ssid"), str) or not session["ssid"]):
            raise PrivacyError("session identity is malformed")
        return session
    finally:
        os.close(directory)


def clear_session():
    try:
        directory = session_directory()
    except FileNotFoundError:
        return
    try:
        try:
            os.unlink(SESSION_FILE.name, dir_fd=directory)
        except FileNotFoundError:
            pass
    finally:
        os.close(directory)


class Controller:
    def __init__(self, system=None, wpa_factory=WpaControl):
        self.system = system or System()
        self.wpa_factory = wpa_factory

    def off(self):
        try:
            clear_session()
        finally:
            # A broken or unreadable session file must never prevent blocking.
            self.system.block_all()

    def scan(self):
        try:
            self.system.block_all()
            with self.wpa_factory() as wpa:
                wpa.expect_ok("DISCONNECT")
                wpa.expect_ok("DISABLE_NETWORK all")
                self.system.unblock_wifi()
                wpa.start_scan()
                wpa.wait_scan(SCAN_DEADLINE)
                results = wpa.request("SCAN_RESULTS")
                if not results.startswith("bssid"):
                    raise PrivacyError("fresh scan results rejected")
                return results
        except Exception:
            self.off()
            raise
        finally:
            self.system.block_all()

    def connect(self, profile):
        try:
            self.system.block_all()
            clear_session()
            network_id, expected_ssid = read_profile(profile, PROFILE_FILE)
            with self.wpa_factory() as wpa:
                wpa.expect_ok("DISCONNECT")
                wpa.expect_ok("DISABLE_NETWORK all")
                if wpa.network_ssid(network_id) != expected_ssid:
                    raise PrivacyError("configured network does not match policy")
                wpa.expect_ok("SELECT_NETWORK " + str(network_id))
                wpa.expect_ok("ENABLE_NETWORK " + str(network_id))
                self.system.unblock_wifi()
                wpa.expect_ok("RECONNECT")
                end = time.monotonic() + CONNECT_DEADLINE
                while time.monotonic() < end:
                    status = wpa.status()
                    if (status.get("wpa_state") == "COMPLETED" and status.get("id") == str(network_id)
                            and status.get("ssid") == expected_ssid):
                        self.system.prepare_addresses(profile)
                        write_session(profile, network_id, expected_ssid)
                        return
                    time.sleep(0.25)
                raise PrivacyError("trusted association did not complete")
        except Exception:
            self.off()
            raise

    def status(self):
        data = {"wifi": {"interface": INTERFACE}, "bluetooth": {}}
        for kind, output in (("wlan", data["wifi"]), ("bluetooth", data["bluetooth"])):
            try:
                output["soft_blocked"] = all(value == "0" for value in self.system.states(kind))
            except PrivacyError:
                output["soft_blocked"] = None
            try:
                output["hard_blocked"] = all(value == "1" for value in self.system.hard_states(kind))
            except PrivacyError:
                output["hard_blocked"] = None
        data["wifi"]["wpa_state"] = "UNAVAILABLE"
        return data

    def supervise(self):
        while True:
            try:
                # Scan/connect hold this lock through their intentional radio
                # transitions. Skip that cycle rather than interrupting them.
                with RadioLock(blocking=False):
                    try:
                        session = read_session()
                        with self.wpa_factory() as wpa:
                            status = wpa.status()
                        if (status.get("wpa_state") != "COMPLETED"
                                or status.get("id") != str(session["id"])
                                or status.get("ssid") != session["ssid"]):
                            raise PrivacyError("trusted session lost")
                        if any(value != "0" for value in self.system.states("bluetooth")):
                            self.system.block_bluetooth()
                    except (PrivacyError, OSError, ValueError, KeyError, TypeError):
                        self.off()
            except BlockingIOError:
                pass
            except (PrivacyError, OSError) as error:
                # Continue retrying the fail-off action if a transient device
                # or runtime failure kept the previous attempt from completing.
                print("privacyctl: supervisor check failed: " + str(error), file=sys.stderr)
            time.sleep(1)


def run_locked(controller, action, *args):
    with RadioLock():
        succeeded = False
        try:
            with operation_deadline():
                result = getattr(controller, action)(*args)
            succeeded = True
            return result
        finally:
            if not succeeded:
                # If the transaction deadline interrupted an inner cleanup,
                # retry both blocks with the timer disarmed before unlocking.
                controller.off()


def owner_library():
    # Installed beside this root-owned executable; isolated Python ignores
    # caller PYTHONPATH and the working directory for privileged execution.
    library = str(Path(__file__).resolve().parents[1] / 'lib')
    if library not in sys.path:
        sys.path.insert(0, library)


def request_owner(command, profile=None, *, timeout=50):
    owner_library()
    from privacyctl_runtime.ipc import IPCError, request
    try:
        return request(command, profile, timeout=timeout)
    except IPCError as error:
        raise PrivacyError(str(error)) from error


def emergency_off():
    owner_library()
    from privacyctl_runtime.adapter import NativeAdapter
    NativeAdapter(sys.modules[__name__]).emergency_off()


def serve_owner():
    owner_library()
    from privacyctl_runtime.runner import run
    run(sys.modules[__name__])


def main(argv):
    try:
        if not argv:
            raise PrivacyError("usage: privacyctl {status [--json]|off|scan|connect PROFILE|supervise}")
        command, *args = argv
        controller = Controller()
        if command == "status" and args in ([], ["--json"]):
            result = controller.status()
            print(json.dumps(result, separators=(",", ":") if args else None, indent=None if args else 2))
        elif os.geteuid() != 0:
            raise PrivacyError("radio changes require the privileged controller")
        elif command == "off" and not args:
            try:
                request_owner("off", timeout=5)
            except PrivacyError:
                emergency_off()
        elif command == "scan" and not args:
            print(request_owner("scan"))
        elif command == "connect" and len(args) == 1:
            request_owner("connect", args[0])
        elif command == "supervise" and not args and os.geteuid() == 0:
            serve_owner()
        else:
            raise PrivacyError("usage: privacyctl {status [--json]|off|scan|connect PROFILE|supervise}")
        return 0
    except (RuntimeError, OSError, ValueError) as error:
        print("privacyctl: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
