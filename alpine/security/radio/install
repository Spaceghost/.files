#!/usr/bin/python3 -I
"""Restrict rfkill writes to root without changing either radio state.

Install a reviewed copy and the adjacent 72-privacy-rfkill.rules as root-owned
regular files in a root-owned directory before running --prepare-permissions.
Only that udev rule and /dev/rfkill permissions are changed. An exact private
journal is retained under /var/lib/mbp_intel/radio-permissions; failures restore
the previous rule, device mode and access ACL. No services are started.
"""
import argparse
import base64
import errno
import hashlib
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import sys
import tempfile


ACL = 'system.posix_acl_access'
RULE = '72-privacy-rfkill.rules'


def owned_path(path, owner=0):
    """Reject symlinks and writable ancestors before privileged file access."""
    path = Path(path).absolute()
    for candidate in (path, *path.parents):
        info = candidate.lstat()
        if (stat.S_ISLNK(info.st_mode) or info.st_uid != owner
                or info.st_mode & 0o022):
            raise RuntimeError(f'unsafe privileged path: {candidate}')
    return path


def write_private(path, data):
    with path.open('x', encoding='utf-8') as stream:
        os.fchmod(stream.fileno(), 0o600)
        json.dump(data, stream, indent=2)
        stream.write('\n')
        stream.flush()
        os.fsync(stream.fileno())


class Host:
    device = Path('/dev/rfkill')

    def link_identity(self):
        link = subprocess.run(['/usr/sbin/iw', 'dev', 'wlan0', 'link'],
                              capture_output=True, text=True, check=True, timeout=5)
        connected = re.search(r'^Connected to ([0-9a-f:]+) ', link.stdout, re.MULTILINE)
        ssid = re.search(r'^\s*SSID: (.*)$', link.stdout, re.MULTILINE)
        if not connected or not ssid:
            raise RuntimeError('existing wlan0 association is unavailable')
        address = subprocess.run(['/sbin/ip', '-j', 'address', 'show', 'dev', 'wlan0'],
                                 capture_output=True, text=True, check=True, timeout=5)
        interfaces = json.loads(address.stdout)
        if len(interfaces) != 1 or interfaces[0]['ifname'] != 'wlan0':
            raise RuntimeError('wlan0 address identity is ambiguous')
        addresses = sorted((item['family'], item['local'], item['prefixlen'], item['scope'])
                           for item in interfaces[0]['addr_info'])
        return {'interface': 'wlan0', 'bssid': connected.group(1), 'ssid': ssid.group(1),
                'addresses': addresses}

    def state(self):
        result = {}
        for path in Path('/sys/class/rfkill').glob('rfkill*'):
            result[path.name] = {key: (path / key).read_text().strip()
                                 for key in ('type', 'soft', 'hard')}
        if not result:
            raise RuntimeError('no rfkill devices found')
        return result

    def permissions(self):
        info = self.device.lstat()
        if (not stat.S_ISCHR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
                or (os.major(info.st_rdev), os.minor(info.st_rdev)) != (10, 242)):
            raise RuntimeError('unexpected rfkill device identity')
        try:
            acl = os.getxattr(self.device, ACL, follow_symlinks=False)
        except OSError as error:
            if error.errno != errno.ENODATA:
                raise
            acl = None
        return {'mode': stat.S_IMODE(info.st_mode),
                'acl_base64': base64.b64encode(acl).decode() if acl is not None else None}

    def apply_permissions(self, saved=None):
        try:
            os.removexattr(self.device, ACL, follow_symlinks=False)
        except OSError as error:
            if error.errno != errno.ENODATA:
                raise
        os.chmod(self.device, saved['mode'] if saved else 0o644)
        if saved and saved['acl_base64'] is not None:
            os.setxattr(self.device, ACL, base64.b64decode(saved['acl_base64']),
                        follow_symlinks=False)

    def udev(self):
        for arguments in (
                ['control', '--reload-rules'],
                ['trigger', '--action=change', '--subsystem-match=misc', '--sysname-match=rfkill'],
                ['settle', '--timeout=10']):
            subprocess.run(['/sbin/udevadm', *arguments], check=True,
                           capture_output=True, timeout=15)

    def verify(self):
        if self.permissions() != {'mode': 0o644, 'acl_base64': None}:
            raise RuntimeError('rfkill mode or ACL remains writable by other users')
        user = pwd.getpwnam('jack')
        subprocess.run(
            [sys.executable, '-I', '-c',
             'import os; raise SystemExit(0 if os.access("/dev/rfkill", os.R_OK) '
             'and not os.access("/dev/rfkill", os.W_OK) else 1)'],
            user=user.pw_uid, group=user.pw_gid,
            extra_groups=os.getgrouplist(user.pw_name, user.pw_gid),
            capture_output=True, check=True, timeout=5)
        if not os.access(self.device, os.W_OK):
            raise RuntimeError('root lost rfkill write access')
        result = subprocess.run(
            ['/sbin/udevadm', 'info', '--query=property', '--name=/dev/rfkill'],
            capture_output=True, text=True, check=True, timeout=5)
        for line in result.stdout.splitlines():
            if line.startswith(('TAGS=', 'CURRENT_TAGS=')) and 'uaccess' in line.split('=', 1)[1].split(':'):
                raise RuntimeError('udev still grants the rfkill uaccess tag')


def prepare(source, target, journal_root, host):
    """The caller validates privileged paths; tests supply a private fake host."""
    content = source.read_bytes()
    baseline = None
    if target.exists():
        if target.is_symlink() or not target.is_file() or target.read_bytes() != content:
            raise RuntimeError('refusing to replace a different existing rfkill rule')
        baseline = {'content_base64': base64.b64encode(content).decode(),
                    'mode': stat.S_IMODE(target.stat().st_mode)}
    before = host.state()
    link_before = host.link_identity()
    permissions = host.permissions()
    journal = Path(tempfile.mkdtemp(prefix='attempt-', dir=journal_root))
    journal.chmod(0o700)
    write_private(journal / 'before.json', {
        'rule_path': str(target), 'rule_before': baseline,
        'rule_sha256': hashlib.sha256(content).hexdigest(),
        'device_permissions': permissions, 'radio_state': before, 'wifi_link': link_before,
    })
    created = False
    try:
        if baseline is None:
            temporary = None
            try:
                with tempfile.NamedTemporaryFile(dir=target.parent, prefix='.rfkill-', delete=False) as stream:
                    temporary = Path(stream.name)
                    os.fchmod(stream.fileno(), 0o644)
                    stream.write(content)
                    stream.flush()
                    os.fsync(stream.fileno())
                os.link(temporary, target)
                created = True
            finally:
                if temporary is not None:
                    temporary.unlink()
        host.apply_permissions()
        host.udev()
        host.verify()
        if host.state() != before:
            raise RuntimeError('radio state changed during permissions preparation')
        if host.link_identity() != link_before:
            raise RuntimeError('Wi-Fi identity changed during permissions preparation')
        write_private(journal / 'result.json', {
            'status': 'prepared', 'radio_state_unchanged': True,
            'services_started': False, 'wpa_configuration_changed': False,
            'wifi_link_unchanged': True, 'wifi_link': link_before,
            'jack_can_read_rfkill': True, 'jack_cannot_write_rfkill': True,
            'root_can_write_rfkill': True,
        })
    except Exception as error:
        failures = []
        if created:
            try:
                if target.is_symlink() or target.read_bytes() != content:
                    raise RuntimeError('installed rule changed concurrently; preserving it')
                target.unlink()
            except Exception as recovery:
                failures.append(str(recovery))
        try:
            host.udev()
        except Exception as recovery:
            failures.append(str(recovery))
        try:
            host.apply_permissions(permissions)
            if host.permissions() != permissions:
                raise RuntimeError('exact prior device permissions were not restored')
        except Exception as recovery:
            failures.append(str(recovery))
        try:
            after = {'radio_state': host.state(), 'wifi_link': host.link_identity()}
        except Exception as recovery:
            after = {'state_unavailable': str(recovery)}
        write_private(journal / 'result.json', {
            'status': 'rollback_failed' if failures else 'rolled_back',
            'failure': str(error), 'recovery_failures': failures,
            **after,
        })
        raise RuntimeError(f'permissions preparation failed; see {journal}') from error
    return journal


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--prepare-permissions', action='store_true', required=True)
    parser.parse_args()
    if os.geteuid() != 0:
        parser.error('run the reviewed root-owned installed helper as root')
    os.umask(0o077)
    executable = owned_path(Path(__file__))
    source = owned_path(executable.with_name(RULE))
    if not source.is_file() or not executable.is_file():
        parser.error('helper and adjacent rule must be regular files')
    target = Path('/etc/udev/rules.d') / RULE
    owned_path(target.parent)
    if target.exists() or target.is_symlink():
        owned_path(target)
    parent = owned_path(Path('/var/lib/mbp_intel'))
    journal_root = parent / 'radio-permissions'
    journal_root.mkdir(mode=0o700, exist_ok=True)
    owned_path(journal_root)
    if stat.S_IMODE(journal_root.stat().st_mode) != 0o700:
        parser.error('journal directory must be private mode 0700')
    print(prepare(source, target, journal_root, Host()))


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit(f'radio permissions: {error}')
