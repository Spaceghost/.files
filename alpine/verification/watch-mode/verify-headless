#!/usr/bin/env python3
"""Drive watch mode in a private headless SwayFX session and record what it did.

The live desktop is never touched and never locked: a throwaway compositor on
the headless backend runs the real bindings and the real `oldbook-watch`, and a
virtual keyboard plays the release chord at it — cleanly, and the way a cat
would. Captures show the desktop still visible underneath the guard, which is
the whole point of watch mode and the one thing a unit test cannot check.

    alpine/verification/watch-mode/verify-headless --output /tmp/watch-preview
"""
import argparse
import hashlib
import json
import os
from pathlib import Path
import runpy
import signal
import subprocess
import time

BASE = Path(__file__).resolve().parent
REPO = BASE.parents[2]
WATCH = REPO / 'alpine/desktop/.local/bin/oldbook-watch'
HARNESS = REPO / 'alpine/verification/lock-screen/render-headless'
CLIENT = REPO / 'alpine/themes/concepts/ghost-observatory/client.py'


def binding_state(session):
    try:
        return session.ipc(None, 'get_binding_state').get('name')
    except (subprocess.SubprocessError, ValueError, RuntimeError):
        return None


def wait_for(predicate, seconds=15):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if predicate():
            return True
        time.sleep(0.1)
    return False


def chord(session, hold_ms, extra=None):
    """Hold Super+Shift+Escape, optionally with a stray key a cat would add.

    wtype calls the Super modifier `logo`; `super` is rejected outright, which
    is worth keeping in a comment because a silently mistyped modifier looks
    exactly like a guard that will not release.
    """
    command = ['wtype', '-M', 'logo', '-M', 'shift', '-P', 'Escape']
    command += ['-P', extra] if extra else []
    command += ['-s', str(hold_ms)]
    command += ['-p', extra] if extra else []
    command += ['-p', 'Escape', '-m', 'shift', '-m', 'logo']
    result = subprocess.run(command, env=session.env, capture_output=True, text=True, timeout=30)
    if result.returncode:
        raise RuntimeError(f'wtype refused the chord: {result.stderr.strip()}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--binary', type=Path, default=Path('/usr/bin/swayfx'))
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--mode', default='1440x900')
    parser.add_argument('--scale', type=int, default=1)
    args = parser.parse_args()
    output = args.output.absolute()
    output.mkdir(parents=True, exist_ok=False)
    width, height = (int(value) for value in args.mode.split('x'))
    painting = (Path.home() / '.local/share/oldbook/current-wallpaper.png').resolve()
    Session = runpy.run_path(str(HARNESS))['Session']
    config = output / 'sway.conf'
    config.write_text(f'''xwayland disable
set $mod Mod4
output HEADLESS-1 mode {args.mode} scale {args.scale}
output * bg "{painting}" fill
seat seat0 fallback true
focus_follows_mouse no
mouse_warping none
default_border pixel 0
for_window [app_id="lock-preview-.*"] floating enable
include "{REPO / 'alpine/desktop/.config/sway/local.d/watch.conf'}"
''')
    evidence = {'status': 'started', 'binary': str(args.binary), 'mode': args.mode,
                'scale': args.scale, 'steps': {}}
    base_env = os.environ.copy()
    base_env.update(WLR_BACKENDS='headless', WLR_HEADLESS_OUTPUTS='1', WLR_RENDERER='pixman',
                    WLR_RENDERER_ALLOW_SOFTWARE='1', NO_AT_BRIDGE='1', GTK_USE_PORTAL='0')
    # The guard under test must not reach the live session: no notification on
    # its bus, no cue through its speakers, and no hold on its power keys or
    # its SysRq, which the real policy would take through elogind and doas.
    quiet = output / 'quiet'
    quiet.mkdir()
    (quiet / 'catbed.json').write_text('{"version": 1, "keys": [], "sysrq": {"guard": false}}\n')
    base_env.update(DBUS_SESSION_BUS_ADDRESS='unix:path=' + str(quiet / 'no-bus'),
                    OLDBOOK_SOUND_DIR=str(quiet), CATBED_GUARD_CONFIG=str(quiet / 'catbed.json'))
    for key in ('SWAYSOCK', 'WAYLAND_DISPLAY', 'DISPLAY', 'XDG_RUNTIME_DIR'):
        base_env.pop(key, None)
    with (output / 'runtime.log').open('w') as log:
        with Session(args.binary, config, base_env, log, width, height, args.scale) as session:
            environment = dict(session.env, PATH=str(REPO / 'alpine/desktop/.local/bin')
                               + ':' + session.env.get('PATH', '/usr/bin:/bin'))
            # A headless seat has no keyboard until something creates one, and
            # a seat with no keyboard never sends wl_keyboard.enter, so the
            # guard would have nothing to prove it holds. One long-lived wtype
            # keeps a virtual keyboard on the seat for the whole run, which is
            # what the real machine always has.
            keyboard = subprocess.Popen(['wtype', '-s', '120000', '-k', 'space'],
                                        env=session.env, stdout=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL)
            time.sleep(2)
            evidence['steps']['seat'] = {'virtual_keyboard_alive': keyboard.poll() is None}
            session.shot(output / 'desktop.png')
            evidence['steps']['before'] = {'binding_state': binding_state(session)}

            guard = subprocess.Popen([str(WATCH), 'start'], env=environment,
                                     stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                     text=True, start_new_session=True)
            engaged = wait_for(lambda: binding_state(session) == 'watch')
            evidence['steps']['engaged'] = {
                'binding_state': binding_state(session), 'engaged': engaged,
                'record': json.loads((Path(session.runtime) / 'oldbook/watch.json').read_text())
                if (Path(session.runtime) / 'oldbook/watch.json').exists() else None}
            if not engaged:
                guard.kill()
                evidence['status'] = 'failed: the guard never engaged'
                evidence['guard_output'] = guard.communicate(timeout=10)
                (output / 'evidence.json').write_text(json.dumps(evidence, indent=2) + '\n')
                raise SystemExit(json.dumps(evidence['guard_output']))
            session.shot(output / 'watching.png')
            # The card at native resolution: the band under the top edge where
            # it sits, so its words can be read without opening the full frame.
            subprocess.run(['grim', '-g', f'0,0 {width}x160', str(output / 'indicator.png')],
                           env=session.env, check=True, timeout=90)

            # A cat's hold: the chord plus a stray key. This must never leave.
            chord(session, 1400, extra='a')
            time.sleep(0.6)
            evidence['steps']['dirty_hold'] = {
                'binding_state': binding_state(session),
                'still_engaged': guard.poll() is None and binding_state(session) == 'watch'}

            # A reload returns every binding mode to default and announces it
            # only as a workspace event. The guard must notice, re-enter its
            # own mode, count the re-entry in its record, and still be there
            # to be released by hand afterwards.
            session.ipc('reload')
            reentered = wait_for(lambda: binding_state(session) == 'watch'
                                 and (Path(session.runtime) / 'oldbook/watch.json').exists()
                                 and json.loads((Path(session.runtime) / 'oldbook/watch.json')
                                                .read_text()).get('reentries', 0) >= 1, 15)
            evidence['steps']['reload'] = {
                'reentered': reentered, 'guard_alive': guard.poll() is None,
                'binding_state': binding_state(session),
                'reentries': json.loads((Path(session.runtime) / 'oldbook/watch.json').read_text())
                .get('reentries') if (Path(session.runtime) / 'oldbook/watch.json').exists() else None}

            # A person's hold: the chord alone, held for over a second.
            chord(session, 1400)
            released = wait_for(lambda: guard.poll() is not None, 10)
            out, err = guard.communicate(timeout=10)
            evidence['steps']['clean_hold'] = {
                'released': released, 'returncode': guard.returncode,
                'binding_state': binding_state(session),
                'record_removed': not (Path(session.runtime) / 'oldbook/watch.json').exists(),
                'stdout': out.strip(), 'stderr': err.strip()}
            session.shot(output / 'released.png')

            # Killed outright: the watchdog, not the guard, restores the mode.
            again = subprocess.Popen([str(WATCH), 'start'], env=environment,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                     text=True, start_new_session=True)
            reengaged = wait_for(lambda: binding_state(session) == 'watch')
            os.killpg(again.pid, signal.SIGKILL)
            again.wait(timeout=10)
            recovered = wait_for(lambda: binding_state(session) == 'default', 10)
            evidence['steps']['killed'] = {'reengaged': reengaged, 'recovered': recovered,
                                           'binding_state': binding_state(session)}
            keyboard.kill()
            keyboard.wait(timeout=10)
    evidence['status'] = 'verified'
    evidence['screenshots'] = {name: hashlib.sha256((output / name).read_bytes()).hexdigest()
                               for name in ('desktop.png', 'watching.png', 'released.png')}
    (output / 'evidence.json').write_text(json.dumps(evidence, indent=2) + '\n')
    print(json.dumps(evidence['steps'], indent=2))


if __name__ == '__main__':
    main()
