#!/usr/bin/env python3
"""Open or close the Mission Control workspace overview."""
import os
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib/oldbook'))
if __name__ == '__main__':
    os.umask(0o077)
    action = sys.argv[1] if len(sys.argv) > 1 else 'toggle'
    if action not in ('toggle', 'show', 'close'):
        sys.exit('Usage: oldbook-mission-control [toggle|show|close]')
    from mission_control import main
    main(action)
