#!/usr/bin/env python3
"""Advance one quiet Conky card after an explicit desktop click."""
import argparse
import fcntl
import os
from pathlib import Path
import subprocess
import sys

BIN = Path(__file__).resolve().parent
ACTIONS = {'scripture': ('oldbook-scripture', 'next'),
           'witness': ('oldbook-scripture', 'witness-next'),
           'ghost': ('oldbook-journal', 'next'),
           'gallery': ('oldbook-wallpaper', 'next')}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('card', choices=ACTIONS)
    args = parser.parse_args()
    directory = Path.home() / '.local/state/oldbook/conky'
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    if directory.is_symlink() or directory.stat().st_uid != os.getuid():
        raise RuntimeError('Conky state directory must be an owned regular directory')
    # Keep rapid clicks ordered through saving the choice and replacing its card.
    with (directory / 'click.lock').open('a+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if (directory / 'disabled').exists():
            return 0
        helper, action = ACTIONS[args.card]
        subprocess.run([str(BIN / helper), action], check=True)
        if args.card == 'ghost':
            subprocess.run([str(BIN / 'oldbook-scripture'), 'refresh', 'ghost'], check=True)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(f'oldbook-conky-click: {error}', file=sys.stderr)
        sys.exit(1)
