#!/usr/bin/env python3
"""Run one muted, looping mpvpaper video below application windows."""

import fcntl
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import stat
import subprocess
import sys
import time
from urllib.parse import urlsplit


MPV_OPTIONS = (
    "config=no no-audio loop-file=inf hwdec=auto-safe input-default-bindings=no "
    "input-cursor=no osc=no terminal=no"
)
STOP_PICKER_LABEL = "Stop video background"
VIDEO_SUFFIXES = {".avi", ".m4v", ".mkv", ".mov", ".mp4", ".webm", ".y4m"}


class UserError(Exception):
    pass


def runtime_paths():
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        raise UserError("XDG_RUNTIME_DIR is unavailable")
    base = Path(runtime) / "oldbook" / "video-background"
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    if base.stat().st_uid != os.getuid() or stat.S_IMODE(base.stat().st_mode) & 0o077:
        raise UserError("video background runtime directory is not private")
    return base / "state.json", base / "lock"


def process_identity(pid):
    try:
        proc = Path("/proc") / str(pid)
        if proc.stat().st_uid != os.getuid():
            return None
        fields = (proc / "stat").read_text().rsplit(") ", 1)[1].split()
        return {
            "state": fields[0],
            "pgid": int(fields[2]),
            "start_time": int(fields[19]),
        }
    except (FileNotFoundError, IndexError, OSError, ValueError):
        return None


def read_state(path):
    try:
        value = json.loads(path.read_text())
        return {
            "pid": int(value["pid"]),
            "pgid": int(value["pgid"]),
            "start_time": int(value["start_time"]),
        }
    except (FileNotFoundError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return None


def write_state(path, process):
    identity = process_identity(process.pid)
    if not identity or identity["pgid"] != process.pid:
        raise UserError("mpvpaper did not create its isolated process group")
    value = {
        "version": 1,
        "pid": process.pid,
        "pgid": identity["pgid"],
        "start_time": identity["start_time"],
    }
    temporary = path.with_suffix(".tmp")
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as stream:
        json.dump(value, stream, separators=(",", ":"))
        stream.write("\n")
    os.replace(temporary, path)


def is_owned_process(state):
    if not state or state["pid"] <= 1 or state["pgid"] != state["pid"]:
        return False
    identity = process_identity(state["pid"])
    return bool(
        identity
        and identity["state"] != "Z"
        and identity["pgid"] == state["pgid"]
        and identity["start_time"] == state["start_time"]
    )


def stop_owned(state_path):
    state = read_state(state_path)
    if is_owned_process(state):
        try:
            os.killpg(state["pgid"], signal.SIGTERM)
        except ProcessLookupError:
            pass
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline and is_owned_process(state):
            time.sleep(0.025)
        if is_owned_process(state):
            try:
                os.killpg(state["pgid"], signal.SIGKILL)
            except ProcessLookupError:
                pass
            deadline = time.monotonic() + 1
            while time.monotonic() < deadline and is_owned_process(state):
                time.sleep(0.025)
    state_path.unlink(missing_ok=True)
    state_path.with_name("mpv.sock").unlink(missing_ok=True)


def resolve_program(environment_name, default):
    configured = os.environ.get(environment_name, default)
    resolved = shutil.which(configured)
    if not resolved:
        raise UserError(f"required command is unavailable: {default}")
    return resolved


def normalize_source(source):
    if not source or len(source) > 4096:
        raise UserError("choose one local video or HTTPS URL")
    if source.startswith("https://"):
        if any(ord(character) < 32 or ord(character) == 127 for character in source):
            raise UserError("the HTTPS URL contains control characters")
        try:
            parsed = urlsplit(source)
            hostname = parsed.hostname
        except ValueError:
            raise UserError("the HTTPS URL is malformed") from None
        if not hostname or parsed.username is not None or parsed.password is not None:
            raise UserError("the HTTPS URL must not contain credentials")
        return source
    if "://" in source:
        raise UserError("only explicit HTTPS URLs are supported")
    try:
        path = Path(source).expanduser().resolve(strict=True)
    except (OSError, RuntimeError):
        raise UserError("the selected local video does not exist") from None
    if not path.is_file():
        raise UserError("the selected local video is not a regular file")
    return str(path)


def mpv_property(socket_path, name):
    request_id = 1
    request = json.dumps(
        {"command": ["get_property", name], "request_id": request_id},
        separators=(",", ":"),
    ).encode() + b"\n"
    connection = socket.socket(socket.AF_UNIX)
    connection.settimeout(0.25)
    try:
        connection.connect(str(socket_path))
        connection.sendall(request)
        with connection.makefile("rb") as stream:
            while True:
                line = stream.readline()
                if not line:
                    return None
                response = json.loads(line)
                if response.get("request_id") == request_id:
                    if response.get("error") != "success":
                        return None
                    return response.get("data")
    except (FileNotFoundError, ConnectionError, OSError, json.JSONDecodeError):
        return None
    finally:
        connection.close()


def wait_for_video(socket_path, process):
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline:
        if process.poll() is not None:
            raise UserError("mpvpaper could not start this video")
        configured = mpv_property(socket_path, "vo-configured")
        position = mpv_property(socket_path, "time-pos") if configured else None
        if configured is True and isinstance(position, (int, float)) and not isinstance(position, bool):
            return
        time.sleep(0.05)
    raise UserError("the video did not produce a frame within 20 seconds")


def reload_waybar(proc_root=Path("/proc"), send_signal=os.kill, settle_seconds=0.25):
    sway_socket = os.environ.get("SWAYSOCK")
    wayland_display = os.environ.get("WAYLAND_DISPLAY")
    executable = shutil.which("waybar")
    if not sway_socket or not wayland_display or not executable:
        return 0
    try:
        executable = Path(executable).resolve(strict=True)
    except OSError:
        return 0
    count = 0
    for proc in proc_root.iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            if (proc / "exe").resolve(strict=True) != executable:
                continue
            environment = {}
            for item in (proc / "environ").read_bytes().split(b"\0"):
                if b"=" in item:
                    key, value = item.split(b"=", 1)
                    environment[key] = value
            if environment.get(b"SWAYSOCK") != os.fsencode(sway_socket):
                continue
            if environment.get(b"WAYLAND_DISPLAY") != os.fsencode(wayland_display):
                continue
            send_signal(int(proc.name), signal.SIGUSR2)
            count += 1
        except (FileNotFoundError, PermissionError, ProcessLookupError, OSError):
            continue
    if count and settle_seconds:
        time.sleep(settle_seconds)
    return count


def terminate_started_process(process):
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=2)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait(timeout=2)


def start_video(state_path, source):
    source = normalize_source(source)
    mpvpaper = resolve_program("OLDBOOK_VIDEO_MPV_PAPER", "mpvpaper")
    stop_owned(state_path)
    ipc_path = state_path.with_name("mpv.sock")
    ipc_path.unlink(missing_ok=True)
    mpv_options = f"{MPV_OPTIONS} input-ipc-server={ipc_path}"
    command = [
        mpvpaper,
        "--layer",
        "bottom",
        "--mpv-options",
        mpv_options,
        "ALL",
        source,
    ]
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    try:
        write_state(state_path, process)
        wait_for_video(ipc_path, process)
        reload_waybar()
    except Exception:
        terminate_started_process(process)
        state_path.unlink(missing_ok=True)
        ipc_path.unlink(missing_ok=True)
        raise


def picker_selection():
    candidates = []
    home = Path.home()
    for root in (home / "Videos", home / "Downloads"):
        if not root.is_dir():
            continue
        for directory, names, filenames in os.walk(root, followlinks=False):
            names[:] = [name for name in names if not name.startswith(".")]
            for filename in filenames:
                path = Path(directory) / filename
                if path.suffix.lower() not in VIDEO_SUFFIXES:
                    continue
                rendered = str(path)
                if "\n" not in rendered and "\r" not in rendered:
                    candidates.append(rendered)
                if len(candidates) >= 500:
                    break
            if len(candidates) >= 500:
                break
    menu = STOP_PICKER_LABEL + "\n" + "\n".join(sorted(candidates))
    if not menu.endswith("\n"):
        menu += "\n"
    fuzzel = resolve_program("OLDBOOK_VIDEO_FUZZEL", str(Path(__file__).resolve().parent / "oldbook-fuzzel"))
    result = subprocess.run(
        [fuzzel, "--dmenu", "--prompt", "Video background> "],
        input=menu,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        return None
    lines = result.stdout.splitlines()
    return lines[0] if lines else None


def run(arguments):
    state_path, lock_path = runtime_paths()
    with lock_path.open("a+") as lock:
        os.chmod(lock_path, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        if arguments == ["stop"]:
            stop_owned(state_path)
            print("Video background stopped.")
            return 0
        if arguments == ["picker"]:
            source = picker_selection()
            if source is None:
                return 0
            if source == STOP_PICKER_LABEL:
                stop_owned(state_path)
                print("Video background stopped.")
                return 0
        elif len(arguments) == 1:
            source = arguments[0]
        else:
            raise UserError(
                "usage: oldbook-video-background FILE_OR_HTTPS_URL | stop | picker"
            )
        start_video(state_path, source)
        print("Video background started.")
        return 0


def main():
    try:
        return run(sys.argv[1:])
    except UserError as error:
        print(f"oldbook-video-background: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
