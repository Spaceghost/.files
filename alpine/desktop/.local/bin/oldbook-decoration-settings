#!/usr/bin/env python3
"""Edit the desktop decoration and its JSON configuration together."""
import argparse
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib/oldbook'))
from decoration import SETTINGS_DEFAULTS, load_settings, save_settings, validate_settings
from overlay_theme import gtk_css, read_palette

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state')))


def create_window(config_path):
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    from gi.repository import Gdk, GLib, Gtk

    class Preferences(Gtk.Window):
        def __init__(self):
            super().__init__(title='Desktop decoration settings')
            self.set_default_size(920, 540)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.set_name('decoration-settings')
            self.config_path = config_path
            self.legacy_position = (STATE / 'oldbook/decoration/position'
                                    if config_path == CONFIG / 'oldbook/decoration.json' else None)
            self.loaded_content = None
            self.palette = None
            header = Gtk.HeaderBar(title='Desktop decoration')
            header.set_subtitle('A little atmosphere at the edge of your workspace')
            header.set_show_close_button(True)
            self.set_titlebar(header)

            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            body.set_border_width(18)
            viewport = Gtk.ScrolledWindow()
            viewport.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            viewport.add(body)
            self.add(viewport)
            intro = self.label('Your theme supplies the colors. You choose where the caption lives.')
            body.pack_start(intro, False, False, 0)
            panels = Gtk.Box(spacing=18, homogeneous=True)
            body.pack_start(panels, True, True, 0)
            controls = self.card('Make yourself at home')
            panels.pack_start(controls, True, True, 0)

            self.position = Gtk.ComboBoxText()
            self.position.append('bottom', 'Bottom edge')
            self.position.append('right', 'Right edge')
            self.position.set_tooltip_text('Low orbit or the starboard side: both placements are always available. Right-click the caption to swap edges.')
            controls.pack_start(self.field('_Placement', self.position), False, False, 0)

            self.opacity = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 20, 100, 1)
            self.opacity.set_digits(0)
            self.opacity.connect('format-value', lambda _scale, value: f'{value:.0f}%')
            self.opacity.set_tooltip_text('Let the desktop breathe through the caption. Lower values reveal more of what is behind it.')
            controls.pack_start(self.field('_Opacity', self.opacity), False, False, 0)

            self.radius = Gtk.SpinButton.new_with_range(0, 24, 1)
            self.radius.set_numeric(True)
            self.radius.set_tooltip_text('A softer landing for ordinary and floating windows. Fullscreen tiled windows always use square corners.')
            controls.pack_start(self.field('_Corner radius · pixels', self.radius), False, False, 0)
            note = self.label('Blended theme colors, without an outline.\nFullscreen tiled windows keep square corners.')
            note.get_style_context().add_class('muted')
            controls.pack_start(note, False, False, 0)
            controls.pack_start(Gtk.Box(), True, True, 0)
            apply_controls = Gtk.Button.new_with_mnemonic('_Apply controls')
            apply_controls.get_style_context().add_class('suggested-action')
            apply_controls.set_tooltip_text('Save these controls, update the JSON, and refresh the desktop caption in a moment.')
            apply_controls.connect('clicked', self.apply_controls)
            controls.pack_start(apply_controls, False, False, 0)

            source = self.card('The config, in plain sight')
            panels.pack_start(source, True, True, 0)
            path = self.label(str(config_path))
            path.set_selectable(True)
            path.get_style_context().add_class('muted')
            source.pack_start(path, False, False, 0)
            self.editor = Gtk.TextView()
            self.editor.set_monospace(True)
            self.editor.set_left_margin(14)
            self.editor.set_right_margin(14)
            self.editor.set_top_margin(14)
            self.editor.set_bottom_margin(14)
            self.editor.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            self.editor.set_tooltip_text('Edit the same settings directly. Apply JSON checks the values before saving; incomplete edits stay here until you apply them.')
            self.buffer = self.editor.get_buffer()
            scroll = Gtk.ScrolledWindow()
            scroll.set_shadow_type(Gtk.ShadowType.NONE)
            scroll.add(self.editor)
            source.pack_start(scroll, True, True, 0)
            apply_json = Gtk.Button.new_with_mnemonic('Apply _JSON')
            apply_json.set_tooltip_text('Validate and save this JSON, then bring the controls into agreement.')
            apply_json.connect('clicked', self.apply_json)
            source.pack_start(apply_json, False, False, 0)

            self.status = self.label('')
            self.status.set_selectable(True)
            body.pack_start(self.status, False, False, 0)
            footer = Gtk.Box(spacing=12)
            hint = self.label('Shift + right-click the caption to return here.')
            hint.get_style_context().add_class('muted')
            footer.pack_start(hint, True, True, 0)
            reload_button = Gtk.Button.new_with_mnemonic('_Reload file')
            reload_button.set_tooltip_text('Read the saved file again. This discards unapplied changes in both panels.')
            reload_button.connect('clicked', lambda _button: self.reload())
            footer.pack_end(reload_button, False, False, 0)
            body.pack_start(footer, False, False, 0)
            self.provider = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_screen(self.get_screen(), self.provider,
                                                    Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.refresh_theme()
            self.theme_timer = GLib.timeout_add_seconds(1, self.refresh_theme)
            self.connect('destroy', self.cleanup)
            self.connect('key-press-event', self.keypress)
            self.reload()

        def label(self, text):
            label = Gtk.Label(label=text, xalign=0)
            label.set_line_wrap(True)
            label.set_max_width_chars(48)
            return label

        def card(self, title):
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            card.set_border_width(14)
            card.get_style_context().add_class('settings-card')
            heading = self.label(title)
            heading.get_style_context().add_class('heading')
            card.pack_start(heading, False, False, 0)
            return card

        def field(self, text, widget):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            label = Gtk.Label.new_with_mnemonic(text)
            label.set_xalign(0)
            label.set_mnemonic_widget(widget)
            box.pack_start(label, False, False, 0)
            box.pack_start(widget, False, False, 0)
            return box

        def set_controls(self, settings):
            self.position.set_active_id(settings['position'])
            self.opacity.set_value(settings['opacity'] * 100)
            self.radius.set_value(settings['corner_radius'])

        def message(self, text, error=False):
            self.status.set_text(text)
            context = self.status.get_style_context()
            (context.add_class if error else context.remove_class)('error')

        def reload(self):
            try:
                settings = load_settings(self.config_path, self.legacy_position)
                self.loaded_content = self.config_path.read_bytes()
                content = self.loaded_content.decode('utf-8')
            except FileNotFoundError:
                settings = dict(SETTINGS_DEFAULTS)
                self.loaded_content = None
                content = json.dumps(settings, indent=2) + '\n'
            except (OSError, UnicodeError) as error:
                self.set_controls(SETTINGS_DEFAULTS)
                self.message(f'Could not read the config: {error}', error=True)
                return
            self.set_controls(settings)
            self.buffer.set_text(content)
            try:
                validate_settings(json.loads(content))
            except (ValueError, TypeError) as error:
                self.message(f'Fix the JSON before applying: {error}', error=True)
                return
            self.message('Ready. Apply either panel to save and refresh the caption.')

        def save(self, settings):
            try:
                try:
                    current_content = self.config_path.read_bytes()
                except FileNotFoundError:
                    current_content = None
                if current_content != self.loaded_content:
                    self.message('The config changed on disk. Reload the file before applying your edits.', error=True)
                    return
                saved = save_settings(self.config_path, settings, self.legacy_position)
            except (OSError, ValueError, TypeError) as error:
                self.message(f'Could not save: {error}', error=True)
                return
            self.set_controls(saved)
            content = json.dumps(saved, indent=2) + '\n'
            self.loaded_content = content.encode('utf-8')
            self.buffer.set_text(content)
            self.message('Saved. The desktop caption picks up your settings automatically.')

        def apply_controls(self, _button):
            self.save({'position': self.position.get_active_id(),
                       'opacity': round(self.opacity.get_value() / 100, 2),
                       'corner_radius': self.radius.get_value_as_int()})

        def apply_json(self, _button):
            try:
                values = json.loads(self.buffer.get_text(*self.buffer.get_bounds(), True))
                settings = validate_settings(values)
            except (ValueError, TypeError) as error:
                self.message(f'Could not apply JSON: {error}', error=True)
                return
            self.save(settings)

        def keypress(self, _widget, event):
            if event.keyval == Gdk.KEY_Escape:
                self.destroy()
                return True
            return False

        def refresh_theme(self):
            palette = read_palette()
            if palette != self.palette:
                self.provider.load_from_data(gtk_css('''
                    #decoration-settings, headerbar { background: @theme_background; color: @theme_foreground; }
                    headerbar { background-image: none; border: none; box-shadow: none; }
                    .settings-card { background: alpha(@theme_surface, 0.75); border-radius: 16px; }
                    label { color: @theme_foreground; }
                    .heading { font-size: 1.15em; font-weight: bold; color: @theme_accent; }
                    .muted { color: @theme_muted; }
                    textview, textview text { background: @theme_background_hard; color: @theme_foreground; }
                    button, combobox button, spinbutton { background: @theme_surface; color: @theme_foreground; border: none; box-shadow: none; }
                    button:hover { background: alpha(@theme_accent, 0.22); }
                    button.suggested-action { background: @theme_accent; color: @theme_background_hard; }
                    button.suggested-action label { color: @theme_background_hard; }
                    scale highlight { background: @theme_accent; border-color: @theme_accent; }
                    .error { color: @theme_accent; font-weight: bold; }
                ''', palette))
                self.palette = palette
            return True

        def cleanup(self, _window):
            GLib.source_remove(self.theme_timer)
            Gtk.StyleContext.remove_provider_for_screen(self.get_screen(), self.provider)

    return Preferences()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--config', type=Path, default=CONFIG / 'oldbook/decoration.json')
    args = parser.parse_args()
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import GLib, Gtk
    GLib.set_prgname('oldbook-decoration-settings')
    GLib.set_application_name('Desktop decoration settings')
    window = create_window(args.config)
    window.connect('destroy', Gtk.main_quit)
    window.show_all()
    Gtk.main()


if __name__ == '__main__':
    main()
