#!/usr/bin/env python3
"""Show and switch the active desktop theme.

`alpine/themes/current` names the palette every overlay reads, and
`alpine/themes/profiles/<id>/` holds that theme's HOME overlay: Sway and SwayFX
chrome, Waybar, Foot, GTK, Qt, btop and the shell prompts.  Both existed before
this command and neither had anything that wrote to them, so choosing a theme in
the gallery only ever offered to *generate* artwork in its style and nothing
actually changed.  This applies a theme: it repoints the deployed HOME symlinks
at the theme's profile, records the selection, and reloads what is already
running so the change is visible without logging out.
"""
import argparse
import os
from pathlib import Path
import runpy
import signal
import subprocess
import sys

REPO = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO / 'alpine/wallpapers'))
from theme_catalog import available_themes, has_symlink, load_theme, safe_theme_id

THEMES = REPO / 'alpine/themes'


def base_ghostty(repo):
    """Ghostty's non-colour settings, shared by every theme."""
    source = repo / 'alpine/desktop/.config/ghostty/config'
    keep = []
    for line in source.read_text().splitlines():
        key = line.split('=', 1)[0].strip()
        if key in ('palette', 'background', 'foreground', 'selection-background',
                   'selection-foreground', 'cursor-color', 'cursor-text',
                   'background-opacity'):
            continue
        if line.lstrip().startswith('#'):
            # The shared file's banner names its own colours; each theme gets one.
            continue
        keep.append(line)
    return keep


def ghostty_from_foot(foot_ini, base, name=None):
    """Derive Ghostty colours from the theme's Foot palette.

    Foot already carries a full sixteen-colour terminal palette for every theme,
    including generated ones, so deriving from it means a new theme themes both
    terminals without anyone hand-writing a second palette.
    """
    import configparser
    parser = configparser.ConfigParser(interpolation=None, strict=False,
                                       inline_comment_prefixes=('#',))
    with foot_ini.open() as stream:
        parser.read_file(stream)
    if not parser.has_section('colors-dark'):
        return None
    colors = parser['colors-dark']
    header = [f'# {name}: generated from this theme\'s Foot palette by oldbook-theme sync.',
              '# Edit the Foot colours, then rerun sync; this file is derived.'] if name else []
    lines = header + [line for line in base if line.strip()] + ['']
    for name, key in (('background', 'background'), ('foreground', 'foreground'),
                      ('selection-background', 'selection-background'),
                      ('selection-foreground', 'selection-foreground')):
        if key in colors:
            lines.append(f'{name} = {colors[key].strip()}')
    if 'alpha' in colors:
        lines.append(f'background-opacity = {colors["alpha"].strip()}')
    cursor = colors.get('cursor', '').split()
    if len(cursor) == 2:
        lines.append(f'cursor-text = {cursor[0]}')
        lines.append(f'cursor-color = {cursor[1]}')
    lines.append('')
    for index in range(16):
        key = ('regular' if index < 8 else 'bright') + str(index % 8)
        if key in colors:
            lines.append(f'palette = {index}=#{colors[key].strip().lstrip("#")}')
    return '\n'.join(lines).rstrip('\n') + '\n'


def sync_profiles(repo):
    """Materialise the per-theme files that are derived rather than authored."""
    written = []
    base = base_ghostty(repo)
    for profile in sorted((repo / 'alpine/themes/profiles').glob('*')):
        if not profile.is_dir() or has_symlink(profile, repo):
            continue
        foot_ini = profile / '.config/foot/foot.ini'
        if not foot_ini.is_file():
            continue
        try:
            name = load_theme(repo, profile.name)['name']
        except (OSError, ValueError, RuntimeError):
            name = profile.name
        body = ghostty_from_foot(foot_ini, base, name)
        if body is None:
            continue
        target = profile / '.config/ghostty/config'
        if target.is_file() and target.read_text() == body:
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(body)
        written.append(str(target.relative_to(repo)))
    return written


def profile_directory(identity):
    """Return the theme's HOME overlay, or None when it only carries a palette."""
    profile = THEMES / 'profiles' / identity
    if not safe_theme_id(identity) or has_symlink(profile, REPO) or not profile.is_dir():
        return None
    return profile


def current_identity():
    try:
        return (THEMES / 'current').read_text().strip() or 'none'
    except OSError:
        return 'none'


def describe(theme, active):
    mark = '●' if theme['id'] == active else '○'
    profile = '' if profile_directory(theme['id']) else '   (palette only)'
    return f'{mark} {theme["name"]}{profile}'


def record(identity):
    """Write the selection where every palette-aware overlay reads it."""
    target = THEMES / 'current'
    if has_symlink(target, REPO):
        raise RuntimeError('The active theme must be a regular file in the checkout')
    temporary = target.with_name(target.name + f'.{os.getpid()}.tmp')
    temporary.write_text(identity + '\n')
    temporary.replace(target)


def owned_processes(*names):
    """Yield this user's processes whose executable matches one of `names`."""
    uid = os.getuid()
    wanted = {name.encode() for name in names}
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        process = Path('/proc') / entry
        try:
            if process.stat().st_uid != uid:
                continue
            argv = (process / 'cmdline').read_bytes().split(b'\0')
        except OSError:
            continue
        if argv and argv[0] and argv[0].split(b'/')[-1] in wanted:
            yield int(entry)


def signal_processes(names, number):
    delivered = 0
    for pid in owned_processes(*names):
        try:
            os.kill(pid, number)
            delivered += 1
        except OSError:
            continue
    return delivered


def run(command, timeout=20):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout,
                                stdin=subprocess.DEVNULL)
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def tmux_reload():
    """Every live server rereads the theme's tmux configuration."""
    reloaded = 0
    for socket in (Path(os.environ.get('TMUX_TMPDIR', '/tmp')) / f'tmux-{os.getuid()}').glob('*'):
        if socket.is_socket() and run(['tmux', '-S', str(socket), 'source-file',
                                       str(Path.home() / '.tmux.conf')], timeout=10):
            reloaded += 1
    return reloaded


def refresh_session():
    """Push the active theme into everything already running that can take it.

    Each application is asked in the way it actually supports.  Anything that
    only reads its configuration at startup is reported rather than restarted,
    because silently killing a user's windows is worse than a stale colour.
    """
    notes = []
    here = Path(__file__).resolve().parent

    notes.append('sway reloaded' if run(['swaymsg', 'reload']) else 'sway reload FAILED')

    count = signal_processes(('waybar',), signal.SIGUSR2)
    notes.append(f'waybar reloaded ({count})')

    # Foot repaints in place over its own pty, keeping running programs intact.
    terminals = here / 'oldbook-refresh-terminal-theme'
    if terminals.is_file():
        notes.append('foot terminals repainted' if run(['/usr/bin/python3', str(terminals)])
                     else 'foot terminals unchanged')

    # Ghostty rereads its configuration on SIGUSR2 and restyles open surfaces.
    count = signal_processes(('ghostty',), signal.SIGUSR2)
    if count:
        notes.append(f'ghostty reloaded ({count})')

    if signal_processes(('swaync',), 0):
        ok = run(['swaync-client', '--reload-config']) and run(['swaync-client', '--reload-css'])
        notes.append('swaync reloaded' if ok else 'swaync reload FAILED')

    conky = here / 'oldbook-conky'
    if conky.is_file() and signal_processes(('conky',), 0):
        notes.append('conky panels restarted' if run(['/usr/bin/python3', str(conky), 'restart'], 60)
                     else 'conky restart FAILED')

    count = tmux_reload()
    if count:
        notes.append(f'tmux servers reloaded ({count})')

    # Cava has no reload channel; it is ours and cheap, so it comes back itself
    # through its supervisor rather than being left in the previous palette.
    count = signal_processes(('cava',), signal.SIGTERM)
    if count:
        notes.append(f'cava restarted ({count})')

    stale = sorted({name for name, procs in (
        ('Firefox', ('firefox',)), ('btop', ('btop',)), ('Neovim', ('nvim',)))
        if any(True for _ in owned_processes(*procs))})
    if stale:
        notes.append('reads its theme only at startup, so still on the old palette: '
                     + ', '.join(stale))
    return notes


def use(identity, *, reload=True):
    theme = load_theme(REPO, identity)
    profile = profile_directory(theme['id'])
    deployed = None
    if profile is not None:
        # The deployer owns the symlink journal and its rollback, so switching
        # themes reuses it rather than inventing a second way to write HOME.
        deployer = runpy.run_path(str(REPO / 'alpine/bin/deploy-home'))
        deployed = deployer['deploy'](Path.home(), profile)
    record(theme['id'])
    notes = refresh_session() if reload else []
    return theme, profile, deployed, notes


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('list', 'current', 'use', 'refresh', 'sync'))
    parser.add_argument('theme', nargs='?')
    parser.add_argument('--no-reload', action='store_true',
                        help='apply the files without touching the running session')
    args = parser.parse_args()
    active = current_identity()
    if args.action == 'current':
        print(active)
        return 0
    if args.action == 'list':
        for theme in available_themes(REPO):
            print(theme['id'] + '\t' + describe(theme, active))
        return 0
    if args.action == 'refresh':
        for note in refresh_session():
            print(note)
        return 0
    if args.action == 'sync':
        written = sync_profiles(REPO)
        print('\n'.join(written) if written else 'Every theme profile is already complete')
        return 0
    if not args.theme:
        parser.error('use requires a theme ID')
    theme, profile, deployed, notes = use(args.theme, reload=not args.no_reload)
    print(f'Switched to {theme["name"]}')
    if profile is None:
        print('  This collection carries only a palette, so overlays follow it '
              'but application configuration is unchanged.')
    elif deployed is None:
        print('  Configuration already matched this theme.')
    else:
        print(f'  Previous configuration backed up to {deployed}')
    for note in notes:
        print('  ' + note)
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError) as error:
        sys.exit(f'oldbook-theme: {error}')
