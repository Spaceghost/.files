#!/usr/bin/env python3
"""Show and switch the active desktop theme.

`alpine/themes/current` names the palette every overlay reads, and
`alpine/themes/profiles/<id>/` holds that theme's HOME overlay: Sway and SwayFX
chrome, Waybar, Foot, GTK, Qt, btop and the shell prompts.  Both existed before
this command and neither had anything that wrote to them, so choosing a theme in
the gallery only ever offered to *generate* artwork in its style and nothing
actually changed.  This applies a theme: it repoints the deployed HOME symlinks
at the theme's profile, records the selection, and reloads what is already
running so the change is visible without logging out.

The selection reaches past the session too.  The power deck is part of the
profile like any other surface, and the console palette every text-mode screen
reads is regenerated here so GRUB, the kernel console, the initramfs passphrase
prompt and the rescue gettys are brought up to date immediately: a theme is not
considered complete while any of them still needs a human to remember a
follow-up command, so this runs the GRUB theme render and the root install
itself rather than only printing a reminder.
"""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import signal
import socket
import struct
import subprocess
import sys
import time

REPO = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO / 'alpine/wallpapers'))
from theme_catalog import available_themes, has_symlink, load_theme, safe_theme_id
from desktop_theme import ensure_profile

THEMES = REPO / 'alpine/themes'


def base_ghostty(repo):
    """Ghostty's non-colour settings, shared by every theme."""
    source = repo / 'alpine/desktop/.config/ghostty/config'
    keep = []
    for line in source.read_text().splitlines():
        key = line.split('=', 1)[0].strip()
        if key in ('palette', 'background', 'foreground', 'selection-background',
                   'selection-foreground', 'cursor-color', 'cursor-text',
                   'background-opacity'):
            continue
        if line.lstrip().startswith('#'):
            # The shared file's banner names its own colours; each theme gets one.
            continue
        keep.append(line)
    return keep


def ghostty_from_foot(foot_ini, base, name=None):
    """Derive Ghostty typography and colours from a theme's Foot config.

    Foot already carries a full sixteen-colour terminal palette for every theme,
    including generated ones, as well as the terminal font.  Deriving both means
    a new theme keeps the two terminals aligned without duplicate authoring.
    """
    import configparser
    parser = configparser.ConfigParser(interpolation=None, strict=False,
                                       inline_comment_prefixes=('#',))
    with foot_ini.open() as stream:
        parser.read_file(stream)
    if not parser.has_section('colors-dark'):
        return None
    shared = list(base)
    font = parser.get('main', 'font', fallback='').split(',', 1)[0].strip()
    family = font.split(':', 1)[0].strip()
    size = re.search(r'(?:^|:)size=([^:]+)', font)
    typography = {
        'font-family': family,
        'font-size': size.group(1).strip() if size else '',
    }
    for index, line in enumerate(shared):
        key = line.split('=', 1)[0].strip()
        if typography.get(key):
            shared[index] = f'{key} = {typography[key]}'
    colors = parser['colors-dark']
    header = [f'# {name}: generated from this theme\'s Foot palette by oldbook-theme sync.',
              '# Edit the Foot colours, then rerun sync; this file is derived.'] if name else []
    lines = header + [line for line in shared if line.strip()] + ['']
    for name, key in (('background', 'background'), ('foreground', 'foreground'),
                      ('selection-background', 'selection-background'),
                      ('selection-foreground', 'selection-foreground')):
        if key in colors:
            lines.append(f'{name} = {colors[key].strip()}')
    if 'alpha' in colors:
        lines.append(f'background-opacity = {colors["alpha"].strip()}')
    cursor = colors.get('cursor', '').split()
    if len(cursor) == 2:
        lines.append(f'cursor-text = {cursor[0]}')
        lines.append(f'cursor-color = {cursor[1]}')
    lines.append('')
    for index in range(16):
        key = ('regular' if index < 8 else 'bright') + str(index % 8)
        if key in colors:
            lines.append(f'palette = {index}=#{colors[key].strip().lstrip("#")}')
    return '\n'.join(lines).rstrip('\n') + '\n'


def sync_ghostty_profile(repo, profile, theme, base=None):
    """Refresh one derived terminal config before it becomes the active theme."""
    foot_ini = profile / '.config/foot/foot.ini'
    target = profile / '.config/ghostty/config'
    if has_symlink(foot_ini, repo) or has_symlink(target, repo):
        raise RuntimeError('Theme terminal configuration must not follow symlinks')
    if not foot_ini.is_file():
        return None
    local_base = list(base if base is not None else base_ghostty(repo))
    if theme.get('design'):
        spacing = theme['design']['spacing']
        local_base = [re.sub(r'^(window-padding-[xy])\s*=.*', rf'\1 = {spacing}', line)
                      for line in local_base]
    body = ghostty_from_foot(foot_ini, local_base, theme.get('name', profile.name))
    if body is None or (target.is_file() and target.read_text() == body):
        return None
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(body)
    return str(target.relative_to(repo))


def sync_profiles(repo):
    """Materialise the per-theme files that are derived rather than authored."""
    written = []
    for theme in available_themes(repo):
        ensure_profile(repo, theme)
    base = base_ghostty(repo)
    for profile in sorted((repo / 'alpine/themes/profiles').glob('*')):
        if not profile.is_dir() or has_symlink(profile, repo):
            continue
        theme = {}
        try:
            theme = load_theme(repo, profile.name)
        except (OSError, ValueError, RuntimeError):
            pass
        changed = sync_ghostty_profile(repo, profile, theme, base)
        if changed is not None:
            written.append(changed)
    return written


def run_boot_step(command, timeout):
    """Run one boot-chain step, keeping its own words on failure.

    A generic "FAILED" note here would be exactly the failure this desktop's
    other notifications were built to stop producing: something broke and the
    person seeing it has no way to tell what. install-boot-console and
    build-grub-theme already say precisely what went wrong on stderr, so that
    text is what a failure note carries, not a label standing in for it.
    """
    try:
        result = subprocess.run(command, capture_output=True, text=True,
                                stdin=subprocess.DEVNULL, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as error:
        return False, str(error)
    if result.returncode:
        return False, (result.stderr or result.stdout).strip()[:2000]
    return True, result.stdout


def refresh_boot_palette(theme):
    """Regenerate the console palette and carry it all the way to the boot chain.

    The lock reads the active palette already, and there is no login screen --
    greetd autologins into Sway, because the LUKS passphrase is the real gate --
    so the surfaces a theme switch used to miss are the ones on either side of
    the session: the GRUB menu, the kernel console, the initramfs passphrase
    prompt and the rescue gettys.  All four read one generated file.

    A theme is not complete while any of these still needs a human to remember
    a follow-up command -- that is the same failure as no coverage at all, just
    quieter, and it is exactly how every theme but the one whose boot chain was
    once built by hand stayed on that one's GRUB menu regardless of what was
    selected everywhere else. So this runs the whole chain itself: the console
    palette (a checkout-only write, like the Ghostty sync above), the GRUB
    theme render (also checkout-only, no root), and finally the root install
    that actually publishes both to /etc and /boot. install-boot-console keeps
    its own backups and rolls itself back on any failure, including a grub.cfg
    it cannot validate, so a failure here leaves the previous boot chain intact
    -- it is reported, not silently retried or forced through.
    """
    builder = REPO / 'alpine/bin/build-console-palette'
    if not builder.is_file():
        return []
    try:
        _path, changed, _palette = runpy.run_path(str(builder))['build'](REPO, theme['id'])
    except (OSError, ValueError, RuntimeError, ImportError) as error:
        return ['boot console palette FAILED: ' + str(error)]
    if not changed:
        return []
    notes = ['boot console palette updated']
    grub_builder = REPO / 'alpine/bin/build-grub-theme'
    if grub_builder.is_file():
        ok, detail = run_boot_step(['/usr/bin/python3', str(grub_builder)], 120)
        if not ok:
            notes.append('GRUB theme render FAILED: ' + detail)
            return notes
        notes.append('GRUB theme rendered')
    installer = REPO / 'alpine/bin/install-boot-console'
    if installer.is_file():
        ok, detail = run_boot_step(['doas', '/usr/bin/python3', str(installer)], 600)
        notes.append('boot console installed for next boot' if ok
                     else 'boot console install FAILED: ' + detail)
    return notes


def profile_directory(identity):
    """Return an existing authored or rendered HOME overlay."""
    profile = THEMES / 'profiles' / identity
    if not safe_theme_id(identity) or has_symlink(profile, REPO) or not profile.is_dir():
        return None
    return profile


def current_identity():
    try:
        return (THEMES / 'current').read_text().strip() or 'none'
    except OSError:
        return 'none'


def describe(theme, active):
    mark = '●' if theme['id'] == active else '○'
    return f'{mark} {theme["name"]}'


def record(identity):
    """Write the selection where every palette-aware overlay reads it."""
    target = THEMES / 'current'
    if has_symlink(target, REPO):
        raise RuntimeError('The active theme must be a regular file in the checkout')
    temporary = target.with_name(target.name + f'.{os.getpid()}.tmp')
    temporary.write_text(identity + '\n')
    temporary.replace(target)


def owned_processes(*names):
    """Yield matching processes in this HOME and explicitly identified Sway session."""
    uid = os.getuid()
    wanted = {name.encode() for name in names}
    session = {b'HOME': os.fsencode(Path.home()),
               b'SWAYSOCK': os.fsencode(os.environ.get('SWAYSOCK', ''))}
    if not session[b'SWAYSOCK']:
        return
    for entry in os.listdir('/proc'):
        if not entry.isdigit():
            continue
        process = Path('/proc') / entry
        try:
            if process.stat().st_uid != uid:
                continue
            argv = (process / 'cmdline').read_bytes().split(b'\0')
            if not argv or not argv[0] or argv[0].split(b'/')[-1] not in wanted:
                continue
            environment = dict(item.split(b'=', 1) for item in
                               (process / 'environ').read_bytes().split(b'\0') if b'=' in item)
        except OSError:
            continue
        if all(environment.get(key) == value for key, value in session.items()):
            yield int(entry)


def signal_processes(names, number):
    delivered = 0
    for pid in owned_processes(*names):
        try:
            os.kill(pid, number)
            delivered += 1
        except OSError:
            continue
    return delivered


def run(command, timeout=20):
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout,
                                stdin=subprocess.DEVNULL)
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def sway_command(payload, timeout=20):
    """Send one command and await its reply beyond swaymsg's fixed three seconds."""
    address = os.environ.get('SWAYSOCK')
    if not address:
        raise RuntimeError('SWAYSOCK is not set; the desktop session is unknown')
    path = Path(address)
    if not path.is_socket() or path.stat().st_uid != os.getuid():
        raise RuntimeError('SWAYSOCK is not an owned Sway session socket')
    header = struct.Struct('=6sII')
    deadline = time.monotonic() + timeout

    def remaining():
        value = deadline - time.monotonic()
        if value <= 0:
            raise TimeoutError('Sway reload deadline expired')
        return value

    try:
        with socket.socket(socket.AF_UNIX) as connection:
            while True:
                connection.settimeout(remaining())
                try:
                    connection.connect(address)
                    break
                except BlockingIOError:
                    # A full UNIX listen backlog is retryable before any command
                    # is sent. Never resubmit after sending the reload itself.
                    time.sleep(min(.01, remaining()))
            connection.settimeout(remaining())
            body = payload.encode()
            connection.sendall(header.pack(b'i3-ipc', len(body), 0) + body)

            def read(size):
                data = bytearray()
                while len(data) < size:
                    connection.settimeout(remaining())
                    chunk = connection.recv(size - len(data))
                    if not chunk:
                        raise ConnectionError('Sway disconnected before confirming the reload')
                    data.extend(chunk)
                return bytes(data)

            magic, length, kind = header.unpack(read(header.size))
            if magic != b'i3-ipc' or kind != 0 or length > 32 * 1024 * 1024:
                raise ValueError('Invalid Sway IPC reload response')
            response = json.loads(read(length))
    except TimeoutError as error:
        raise RuntimeError(f'Sway reply to {payload!r} not confirmed '
                           f'within {timeout:g} seconds') from error
    if (not isinstance(response, list) or not response
            or any(not isinstance(item, dict) or not isinstance(item.get('success'), bool)
                   for item in response)):
        raise ValueError('Invalid Sway IPC command result')
    errors = [str(item.get('error', 'Sway rejected ' + payload))
              for item in response if not item['success']]
    if errors:
        raise RuntimeError('; '.join(errors))


def sway_reload(timeout=20):
    sway_command('reload', timeout)


def cursor_settings():
    """The pointer set and size the deployed Sway theme asks the seat for."""
    try:
        theme = (Path.home() / '.config/sway/theme.conf').read_text()
    except OSError:
        return None
    found = re.search(r'(?m)^seat\s+\S+\s+xcursor_theme\s+(\S+)(?:\s+(\d+))?', theme)
    return (found.group(1), found.group(2) or '24') if found else None


def refresh_cursor():
    """Reload the pointer set, and say plainly what a reload cannot reach.

    Sway rebuilds its own xcursor manager when the seat command is applied, so
    the compositor's pointer -- the one over the desktop, the bar and every
    server-side surface -- follows immediately. A Wayland client that loads the
    theme itself, which is every GTK and Qt application, keeps the shapes it
    loaded at startup until it is restarted; XCURSOR_THEME in the session
    environment is likewise fixed until the next login. Neither is worth
    killing a user's windows over, so both are reported.
    """
    chosen = cursor_settings()
    if chosen is None:
        return ['cursor theme refresh FAILED: no seat xcursor_theme is deployed']
    name, size = chosen
    notes = []
    try:
        sway_command(f'seat * xcursor_theme {name} {size}')
        notes.append(f'cursor theme reloaded ({name} {size})')
    except (OSError, ValueError, RuntimeError) as error:
        return ['cursor theme refresh FAILED: ' + str(error)]
    inherited = None
    index = Path.home() / '.local/share/icons' / name / 'index.theme'
    try:
        found = re.search(r'(?m)^Inherits=(\S+)', index.read_text())
        inherited = found.group(1) if found else None
    except OSError:
        pass
    if inherited:
        roots = [Path.home() / '.local/share/icons', Path.home() / '.icons',
                 Path('/usr/local/share/icons'), Path('/usr/share/icons')]
        if not any((root / inherited / 'cursors').is_dir() for root in roots):
            notes.append(f'cursor set {inherited} is not installed; every shape this '
                         f'theme does not draw falls back to the default pointer '
                         f'(doas apk add {inherited})')
    notes.append('running GTK and Qt windows keep the pointer they loaded until they restart')
    return notes


def tmux_reload():
    """Every live server rereads the theme's tmux configuration."""
    reloaded = 0
    for socket in (Path(os.environ.get('TMUX_TMPDIR', '/tmp')) / f'tmux-{os.getuid()}').glob('*'):
        if socket.is_socket() and run(['tmux', '-S', str(socket), 'source-file',
                                       str(Path.home() / '.tmux.conf')], timeout=10):
            reloaded += 1
    return reloaded


def refresh_accent():
    """Re-elect the bar accent for the theme now selected, before the bar reloads.

    The accent stylesheet Waybar imports is a runtime file, not part of any
    profile, and it was only ever rewritten when the gallery happened to hold a
    painting in the new theme. A theme with no artwork yet therefore kept the
    previous theme's accent on the clock, the focused workspace and the AI
    indicator. The overlays are protected from a stale record by
    `overlay_theme.accent_override`, which refuses one that names another
    theme; the stylesheet had no such guard. Running this here, and waiting for
    it, also removes the race against the SIGUSR2 that follows.
    """
    palette = Path(__file__).resolve().parent / 'oldbook-palette'
    if not palette.is_file():
        return []
    for action in (['apply', '--force', '--quiet'], ['clear']):
        if run(['/usr/bin/python3', str(palette), *action], 30):
            return ['bar accent re-elected for this theme']
    return ['bar accent refresh FAILED; the bar may keep the previous accent']


CLAUDE_THEME_NAME = 'oldbook'


def refresh_claude():
    """Report whether Claude Code will take the palette that was just deployed.

    Claude Code watches its own themes directory and repaints running sessions
    when the file changes, so the deployed symlink is the whole mechanism and
    there is nothing to signal. What it cannot do is choose the theme: that is
    one line in the user's settings, which this reads and never edits, because
    a theme command silently rewriting an application's settings file is not a
    trade anyone offered.
    """
    theme = Path.home() / '.claude/themes' / (CLAUDE_THEME_NAME + '.json')
    settings = Path.home() / '.claude/settings.json'
    if not theme.exists():
        return ['Claude Code theme NOT deployed; sessions keep their own colours']
    try:
        selected = json.loads(settings.read_text()).get('theme')
    except (OSError, ValueError):
        return ['Claude Code theme deployed; its settings could not be read']
    if selected == 'custom:' + CLAUDE_THEME_NAME:
        return ['Claude Code repainted (its themes directory is watched)']
    return ['Claude Code theme deployed but not selected; set '
            f'"theme": "custom:{CLAUDE_THEME_NAME}" in ~/.claude/settings.json']


def refresh_session():
    """Push the active theme into everything already running that can take it.

    Each application is asked in the way it actually supports.  Anything that
    only reads its configuration at startup is reported rather than restarted,
    because silently killing a user's windows is worse than a stale colour.
    """
    notes = []
    here = Path(__file__).resolve().parent

    reloaded = True
    try:
        sway_reload()
        notes.append('sway reloaded')
    except (OSError, ValueError, RuntimeError) as error:
        reloaded = False
        notes.append('sway reload FAILED: ' + str(error))
    if reloaded:
        # A compositor that would not take the reload will not take this either,
        # and waiting out a second deadline only delays the rest of the refresh.
        notes.extend(refresh_cursor())
    gtk_settings = here / 'oldbook-gtk-settings'
    if gtk_settings.is_file():
        # This carries the theme, icon-theme, font, cursor theme and cursor size
        # the profile declares into org.gnome.desktop.interface, which is what a
        # running GTK application watches. Its own gtk.css has no reload channel.
        notes.append('GTK settings applied' if run(['/usr/bin/python3', str(gtk_settings)])
                     else 'GTK settings refresh FAILED')

    count = signal_processes(('waybar',), signal.SIGUSR2)
    notes.append(f'waybar reloaded ({count})')

    # Foot repaints in place over its own pty, keeping running programs intact.
    terminals = here / 'oldbook-refresh-terminal-theme'
    if terminals.is_file():
        notes.append('foot terminals repainted' if run(['/usr/bin/python3', str(terminals)])
                     else 'foot terminal theme refresh FAILED')

    # Ghostty rereads its configuration on SIGUSR2 and restyles open surfaces.
    count = signal_processes(('ghostty',), signal.SIGUSR2)
    if count:
        notes.append(f'ghostty reloaded ({count})')

    if signal_processes(('swaync',), 0):
        ok = run(['swaync-client', '--reload-config']) and run(['swaync-client', '--reload-css'])
        notes.append('swaync reloaded' if ok else 'swaync reload FAILED')

    conky = here / 'oldbook-conky'
    if conky.is_file() and signal_processes(('conky',), 0):
        notes.append('conky panels restarted' if run(['/usr/bin/python3', str(conky), 'restart'], 60)
                     else 'conky restart FAILED')

    count = tmux_reload()
    if count:
        notes.append(f'tmux servers reloaded ({count})')

    notes.extend(refresh_claude())

    applications = here / 'oldbook-refresh-application-theme'
    if applications.is_file():
        helper = runpy.run_path(str(applications))
        app_notes, _failed = helper['refresh_applications'](
            list(owned_processes('btop', 'nvim')))
        notes.extend(app_notes)

    # Cava has no reload channel; it is ours and cheap, so it comes back itself
    # through its supervisor rather than being left in the previous palette.
    count = signal_processes(('cava',), signal.SIGTERM)
    if count:
        notes.append(f'cava restarted ({count})')

    # Qt has no reload channel of its own: qt6ct and the LXQt plugin are read at
    # startup. Oldbook's own Qt surfaces follow the palette on a one-second
    # timer through overlay_theme.follow_qt_theme, so this is only about
    # third-party windows, and restarting them is the user's call.
    if any(True for _ in owned_processes('qt6ct', 'lximage-qt', 'pcmanfm-qt')):
        notes.append('Qt applications read their colours at startup; '
                     'open Qt windows keep the previous theme until restarted')

    # oldbook-firefox-theme-host, a native messaging host Firefox itself keeps
    # alive for as long as a themed window is open, watches this file's mtime
    # and relays a fresh copy -- the same "nothing to signal, just something to
    # watch" shape refresh_claude already uses. Writing it here needs no
    # process to actually be running: a window that opens later still gets
    # today's theme the moment it connects.
    try:
        sys.path.insert(0, str(REPO / 'alpine/desktop/.local/lib/oldbook'))
        import firefox_theme
        firefox_theme.write_state()
        notes.append('Firefox theme file updated'
                     + (' (live within a few seconds)' if any(True for _ in owned_processes('firefox'))
                        else ''))
    except (OSError, ValueError, RuntimeError, ImportError, KeyError) as error:
        notes.append('Firefox theme FAILED: ' + str(error))
    return notes


def use(identity, *, reload=True):
    theme = load_theme(REPO, identity)
    # Binary surfaces -- the pointer shapes and the power deck's glyph tiles --
    # are written beside the text ones, and a failure to draw them is reported
    # rather than leaving the previous theme's cursors quietly in place.
    asset_notes = []
    profile = ensure_profile(REPO, theme, notes=asset_notes)
    deployed = None
    if profile is not None:
        sync_ghostty_profile(REPO, profile, theme)
        # The deployer owns the symlink journal and its rollback, so switching
        # themes reuses it rather than inventing a second way to write HOME.
        deployer = runpy.run_path(str(REPO / 'alpine/bin/deploy-home'))
        deployed = deployer['deploy'](Path.home(), profile)
    record(theme['id'])
    notes = asset_notes + refresh_boot_palette(theme)
    if reload:
        try:
            gallery = runpy.run_path(str(REPO / 'alpine/desktop/.local/bin/oldbook-wallpaper'))
            entries, _interval = gallery['load_gallery']()
            matching = [entry for entry in entries if entry.get('theme') == theme['id']]
            if matching:
                gallery['update']('select', matching[-1]['id'])
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
            notes.append('wallpaper selection FAILED: ' + str(error))
        notes.extend(refresh_accent())
        # A wallpaper failure must not strand already-deployed application files
        # on disk while running clients retain the previous theme.
        notes.extend(refresh_session())
    return theme, profile, deployed, notes


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=('list', 'current', 'use', 'refresh', 'sync'))
    parser.add_argument('theme', nargs='?')
    parser.add_argument('--no-reload', action='store_true',
                        help='apply the files without touching the running session')
    parser.add_argument('--notify', action='store_true',
                        help='show the result in a desktop notification')
    args = parser.parse_args()
    active = current_identity()
    if args.action == 'current':
        print(active)
        return 0
    if args.action == 'list':
        for theme in available_themes(REPO):
            print(theme['id'] + '\t' + describe(theme, active))
        return 0
    if args.action == 'refresh':
        notes = refresh_session()
        for note in notes:
            print(note)
        return 1 if any('FAILED' in note for note in notes) else 0
    if args.action == 'sync':
        written = sync_profiles(REPO)
        print('\n'.join(written) if written else 'Every theme profile is already complete')
        return 0
    if not args.theme:
        parser.error('use requires a theme ID')
    try:
        theme, profile, deployed, notes = use(args.theme, reload=not args.no_reload)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        if args.notify:
            run(['notify-send', '--app-name=Desktop themes', '--urgency=critical',
                 'Could not switch theme', str(error)])
        print(f'oldbook-theme: {error}', file=sys.stderr)
        return 1
    print(f'Switched to {theme["name"]}')
    if deployed is None:
        print('  Configuration already matched this theme.')
    else:
        print(f'  Previous configuration backed up to {deployed}')
    for note in notes:
        print('  ' + note)
    failures = [note for note in notes if 'FAILED' in note]
    if args.notify:
        title = 'Theme needs attention' if failures else 'Theme applied'
        details = failures + [note for note in notes if 'not managed' in note]
        body = theme['name'] + ('\n' + '\n'.join(details) if details else '')
        run(['notify-send', '--app-name=Desktop themes', title, body])
    return 1 if failures else 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, RuntimeError) as error:
        sys.exit(f'oldbook-theme: {error}')
