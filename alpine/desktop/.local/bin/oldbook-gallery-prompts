#!/usr/bin/env python3
"""Edit the shared style and scene text used by the wallpaper gallery."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import time


REPO = Path(__file__).resolve().parents[4]
DEFAULT_PROMPTS = REPO / 'alpine/wallpapers/prompts.json'
DEFAULT_BACKUPS = Path.home() / '.local/state/oldbook/prompt-backups'


class FileChangedError(RuntimeError):
    """The source no longer matches the version opened by the editor."""


def _stable_stat(info):
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
            info.st_ctime_ns, info.st_mode, info.st_uid)


def _read_snapshot(path):
    flags = os.O_RDONLY | os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    with os.fdopen(descriptor, 'rb') as source:
        before = os.fstat(source.fileno())
        if not stat.S_ISREG(before.st_mode):
            raise ValueError('prompt source must be a regular file')
        content = source.read()
        after = os.fstat(source.fileno())
    signature = _stable_stat(after) + (hashlib.sha256(content).digest(),)
    if _stable_stat(before) != _stable_stat(after) or len(content) != after.st_size:
        raise FileChangedError('Prompt file changed outside the editor while reading it.')
    return content, signature, stat.S_IMODE(after.st_mode)


def _write_all(descriptor, content):
    view = memoryview(content)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            raise OSError('could not write prompt data')
        view = view[written:]


def _private_backup(directory, source_name, content):
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(directory, 0o700)
    stamp = time.time_ns()
    digest = hashlib.sha256(content).hexdigest()[:12]
    path = directory / f'{source_name}.{stamp}-{digest}.bak'
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600)
    try:
        _write_all(descriptor, content)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    return path


def _atomic_replace(path, content, mode):
    temporary = path.with_name(f'.{path.name}.{os.getpid()}.{time.time_ns()}.tmp')
    descriptor = os.open(temporary,
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600)
    try:
        _write_all(descriptor, content)
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
    except Exception:
        os.close(descriptor)
        temporary.unlink(missing_ok=True)
        raise
    else:
        os.close(descriptor)
    try:
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise


class PromptDocument:
    def __init__(self, path, backup_root, data, original, signature, mode):
        self.path = path
        self.backup_root = backup_root
        self.data = data
        self.original = original
        self.signature = signature
        self.mode = mode

    @classmethod
    def load(cls, path, backup_root=DEFAULT_BACKUPS):
        path = Path(path).resolve()
        original, signature, mode = _read_snapshot(path)
        try:
            data = json.loads(original)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise ValueError(f'Prompt file is not valid JSON: {error}') from error
        cls._validate(data)
        return cls(path, Path(backup_root), data, original, signature, mode)

    @staticmethod
    def _validate(data):
        if not isinstance(data, dict) or not isinstance(data.get('style'), str):
            raise ValueError('Prompt file must contain a string style.')
        scenes = data.get('scenes')
        if not isinstance(scenes, list) or not scenes:
            raise ValueError('Prompt file must contain at least one scene.')
        identifiers = set()
        for scene in scenes:
            if (not isinstance(scene, dict)
                    or not isinstance(scene.get('id'), str) or not scene['id']
                    or not isinstance(scene.get('title'), str)
                    or not isinstance(scene.get('description'), str)):
                raise ValueError('Every scene needs a string ID, title, and description.')
            if scene['id'] in identifiers:
                raise ValueError(f'Duplicate scene ID: {scene["id"]}')
            identifiers.add(scene['id'])

    @property
    def style(self):
        return self.data['style']

    @property
    def scenes(self):
        return tuple({'id': scene['id'], 'title': scene['title'],
                      'description': scene['description']}
                     for scene in self.data['scenes'])

    def set_style(self, value):
        if not isinstance(value, str):
            raise TypeError('style must be text')
        self.data['style'] = value

    def update_scene(self, identifier, title, description):
        if not isinstance(title, str) or not isinstance(description, str):
            raise TypeError('scene title and description must be text')
        scene = next((item for item in self.data['scenes']
                      if item['id'] == identifier), None)
        if scene is None:
            raise KeyError(identifier)
        scene['title'] = title
        scene['description'] = description

    def save(self):
        current, signature, _mode = _read_snapshot(self.path)
        if signature != self.signature or current != self.original:
            raise FileChangedError(
                'Prompt file changed outside the editor. Reopen it before saving.')
        self._validate(self.data)
        encoded = (json.dumps(self.data, indent=2, ensure_ascii=False) + '\n').encode()
        _private_backup(self.backup_root, self.path.name, self.original)
        # Recheck after the backup to narrow the window for a concurrent edit.
        current, signature, _mode = _read_snapshot(self.path)
        if signature != self.signature or current != self.original:
            raise FileChangedError(
                'Prompt file changed outside the editor. Reopen it before saving.')
        _atomic_replace(self.path, encoded, self.mode)
        self.original, self.signature, self.mode = _read_snapshot(self.path)


class PromptEditor:
    """Compact GTK editor; persistence stays in PromptDocument."""
    def __init__(self, document):
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk

        self.Gtk = Gtk
        self.document = document
        self.active_scene = None
        self.window = Gtk.Window(title='Gallery Prompts')
        self.window.set_default_size(900, 680)
        self.window.set_size_request(680, 520)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_icon_name('preferences-desktop-wallpaper')
        self.window.connect('delete-event', self.cancel)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        outer.set_border_width(18)
        self.window.add(outer)

        heading = Gtk.Label()
        heading.set_markup('<span size="x-large" weight="bold">Gallery prompts</span>')
        heading.set_xalign(0)
        outer.pack_start(heading, False, False, 0)

        introduction = Gtk.Label(
            label='Edit the shared look and wording for future generated gallery art. '
                  'Saving does not generate an image.')
        introduction.set_xalign(0)
        introduction.set_line_wrap(True)
        outer.pack_start(introduction, False, False, 0)

        style_frame = Gtk.Frame(label='Shared style')
        style_scroll, self.style_view = self._text_editor(150)
        style_frame.add(style_scroll)
        outer.pack_start(style_frame, False, True, 0)
        self._set_text(self.style_view, document.style)

        scene_frame = Gtk.Frame(label='Individual scene')
        scene_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scene_box.set_border_width(10)
        scene_frame.add(scene_box)

        chooser_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        chooser_label = Gtk.Label(label='Scene')
        chooser_label.set_xalign(0)
        self.scene_chooser = Gtk.ComboBoxText()
        for scene in document.scenes:
            self.scene_chooser.append(scene['id'], f"{scene['title']}  ·  {scene['id']}")
        self.scene_chooser.connect('changed', self.select_scene)
        chooser_row.pack_start(chooser_label, False, False, 0)
        chooser_row.pack_start(self.scene_chooser, True, True, 0)
        scene_box.pack_start(chooser_row, False, False, 0)

        title_label = Gtk.Label(label='Title')
        title_label.set_xalign(0)
        scene_box.pack_start(title_label, False, False, 0)
        self.title_entry = Gtk.Entry()
        scene_box.pack_start(self.title_entry, False, False, 0)

        description_label = Gtk.Label(label='Description')
        description_label.set_xalign(0)
        scene_box.pack_start(description_label, False, False, 0)
        description_scroll, self.description_view = self._text_editor(170)
        scene_box.pack_start(description_scroll, True, True, 0)
        outer.pack_start(scene_frame, True, True, 0)

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.status = Gtk.Label(
            label='Edits apply to future paintings and new theme designs.')
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        footer.pack_start(self.status, True, True, 0)
        self.cancel_button = Gtk.Button.new_with_mnemonic('_Cancel')
        self.cancel_button.connect('clicked', self.cancel)
        self.save_button = Gtk.Button.new_with_mnemonic('_Save')
        self.save_button.get_style_context().add_class('suggested-action')
        self.save_button.connect('clicked', self.save)
        footer.pack_end(self.save_button, False, False, 0)
        footer.pack_end(self.cancel_button, False, False, 0)
        outer.pack_end(footer, False, False, 0)

        self.scene_chooser.set_active(0)

    def _text_editor(self, minimum_height):
        editor = self.Gtk.TextView()
        editor.set_wrap_mode(self.Gtk.WrapMode.WORD_CHAR)
        editor.set_left_margin(8)
        editor.set_right_margin(8)
        editor.set_top_margin(8)
        editor.set_bottom_margin(8)
        scroll = self.Gtk.ScrolledWindow()
        scroll.set_policy(self.Gtk.PolicyType.AUTOMATIC, self.Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(minimum_height)
        scroll.add(editor)
        return scroll, editor

    @staticmethod
    def _text(editor):
        buffer = editor.get_buffer()
        return buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), True)

    @staticmethod
    def _set_text(editor, value):
        editor.get_buffer().set_text(value)

    def _store_active_scene(self):
        if self.active_scene is not None:
            self.document.update_scene(
                self.active_scene, self.title_entry.get_text(),
                self._text(self.description_view))

    def select_scene(self, _chooser):
        selected = self.scene_chooser.get_active_id()
        if selected is None or selected == self.active_scene:
            return
        self._store_active_scene()
        scene = next(scene for scene in self.document.scenes if scene['id'] == selected)
        self.active_scene = selected
        self.title_entry.set_text(scene['title'])
        self._set_text(self.description_view, scene['description'])

    def save(self, _button):
        self._store_active_scene()
        self.document.set_style(self._text(self.style_view))
        try:
            self.document.save()
        except (FileChangedError, OSError, ValueError) as error:
            self.status.set_text(str(error))
            self.status.get_style_context().add_class('error')
            return
        self.window.destroy()
        self.Gtk.main_quit()

    def cancel(self, *_arguments):
        self.window.destroy()
        self.Gtk.main_quit()
        return True

    def run(self):
        self.window.show_all()
        self.Gtk.main()


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--file', type=Path, default=DEFAULT_PROMPTS,
                        help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    try:
        document = PromptDocument.load(args.file)
        import gi
        gi.require_version('GLib', '2.0')
        from gi.repository import GLib
        GLib.set_prgname('oldbook-gallery-prompts')
        GLib.set_application_name('Gallery Prompts')
        PromptEditor(document).run()
    except (FileChangedError, OSError, RuntimeError, ValueError) as error:
        raise SystemExit(f'oldbook-gallery-prompts: {error}') from error


if __name__ == '__main__':
    main()
