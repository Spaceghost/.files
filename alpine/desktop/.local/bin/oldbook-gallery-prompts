#!/usr/bin/env python3
"""Edit the shared style and scene text used by the wallpaper gallery."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import time


REPO = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO / 'alpine/wallpapers'))
import prompt_catalog

DEFAULT_PROMPTS = REPO / 'alpine/wallpapers/prompts.json'
DEFAULT_BACKUPS = Path.home() / '.local/state/oldbook/prompt-backups'


class FileChangedError(RuntimeError):
    """The source no longer matches the version opened by the editor."""


def _stable_stat(info):
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
            info.st_ctime_ns, info.st_mode, info.st_uid)


def _read_snapshot(path):
    flags = os.O_RDONLY | os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    with os.fdopen(descriptor, 'rb') as source:
        before = os.fstat(source.fileno())
        if not stat.S_ISREG(before.st_mode):
            raise ValueError('prompt source must be a regular file')
        content = source.read()
        after = os.fstat(source.fileno())
    signature = _stable_stat(after) + (hashlib.sha256(content).digest(),)
    if _stable_stat(before) != _stable_stat(after) or len(content) != after.st_size:
        raise FileChangedError('Prompt file changed outside the editor while reading it.')
    return content, signature, stat.S_IMODE(after.st_mode)


def _write_all(descriptor, content):
    view = memoryview(content)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            raise OSError('could not write prompt data')
        view = view[written:]


def _private_backup(directory, source_name, content):
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(directory, 0o700)
    stamp = time.time_ns()
    digest = hashlib.sha256(content).hexdigest()[:12]
    path = directory / f'{source_name}.{stamp}-{digest}.bak'
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600)
    try:
        _write_all(descriptor, content)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    return path


def _atomic_replace(path, content, mode):
    temporary = path.with_name(f'.{path.name}.{os.getpid()}.{time.time_ns()}.tmp')
    descriptor = os.open(temporary,
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600)
    try:
        _write_all(descriptor, content)
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
    except Exception:
        os.close(descriptor)
        temporary.unlink(missing_ok=True)
        raise
    else:
        os.close(descriptor)
    try:
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise


class PromptDocument:
    def __init__(self, path, backup_root, data, original, signature, mode):
        self.path = path
        self.backup_root = backup_root
        self.data = data
        self.original = original
        self.signature = signature
        self.mode = mode

    @classmethod
    def load(cls, path, backup_root=DEFAULT_BACKUPS):
        path = Path(path).resolve()
        original, signature, mode = _read_snapshot(path)
        try:
            data = json.loads(original)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise ValueError(f'Prompt file is not valid JSON: {error}') from error
        cls._validate(data)
        return cls(path, Path(backup_root), data, original, signature, mode)

    @staticmethod
    def _validate(data):
        prompt_catalog.validate(data)

    @property
    def style(self):
        return self.data['style']

    @property
    def scenes(self):
        return self.entries('scenes')

    @property
    def insertions(self):
        return self.entries('insertions')

    def entries(self, bank):
        return tuple({'id': item['id'], 'title': item['title'],
                      'description': item['description'],
                      'enabled': item.get('enabled', True)}
                     for item in self.data.get(bank) or ())

    def set_style(self, value):
        if not isinstance(value, str):
            raise TypeError('style must be text')
        self.data['style'] = value

    def _entry(self, bank, identifier):
        item = next((item for item in self.data.get(bank) or ()
                     if item['id'] == identifier), None)
        if item is None:
            raise KeyError(identifier)
        return item

    def update_scene(self, identifier, title, description):
        self.update_entry('scenes', identifier, title, description)

    def update_entry(self, bank, identifier, title, description):
        if not isinstance(title, str) or not isinstance(description, str):
            raise TypeError('entry title and description must be text')
        item = self._entry(bank, identifier)
        item['title'] = title
        item['description'] = description

    def set_enabled(self, bank, identifier, enabled):
        """Switch one scene or insertion off without discarding its wording."""
        self._entry(bank, identifier)['enabled'] = bool(enabled)

    def selection_mode(self, bank):
        return prompt_catalog.selection_mode(self.data, bank)

    def set_selection_mode(self, bank, mode):
        if mode not in prompt_catalog.SELECTION_MODES:
            raise ValueError('Unknown selection mode: ' + str(mode))
        self.data[prompt_catalog.MODE_KEYS[bank]] = mode

    def save(self):
        current, signature, _mode = _read_snapshot(self.path)
        if signature != self.signature or current != self.original:
            raise FileChangedError(
                'Prompt file changed outside the editor. Reopen it before saving.')
        self._validate(self.data)
        encoded = (json.dumps(self.data, indent=2, ensure_ascii=False) + '\n').encode()
        _private_backup(self.backup_root, self.path.name, self.original)
        # Recheck after the backup to narrow the window for a concurrent edit.
        current, signature, _mode = _read_snapshot(self.path)
        if signature != self.signature or current != self.original:
            raise FileChangedError(
                'Prompt file changed outside the editor. Reopen it before saving.')
        _atomic_replace(self.path, encoded, self.mode)
        self.original, self.signature, self.mode = _read_snapshot(self.path)


class _Bank:
    """One switchable list of prompts: its mode, its entries and their text."""

    def __init__(self, editor, name, heading, note):
        Gtk = editor.Gtk
        self.editor = editor
        self.name = name
        self.active = None
        self.page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.page.set_border_width(14)

        caption = Gtk.Label(label=note)
        caption.set_xalign(0)
        caption.set_line_wrap(True)
        self.page.pack_start(caption, False, False, 0)

        mode_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        mode_label = Gtk.Label(label='When painting, pick')
        mode_label.set_xalign(0)
        self.mode = Gtk.ComboBoxText()
        for identifier, description in (
                ('shuffle', 'shuffle · every one before any repeat'),
                ('random', 'random · a free draw each time'),
                ('rotate', 'rotate · straight through the list in order')):
            self.mode.append(identifier, description)
        self.mode.set_active_id(editor.document.selection_mode(name))
        mode_row.pack_start(mode_label, False, False, 0)
        mode_row.pack_start(self.mode, True, True, 0)
        self.page.pack_start(mode_row, False, False, 0)

        chooser_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        chooser_label = Gtk.Label(label=heading)
        chooser_label.set_xalign(0)
        self.chooser = Gtk.ComboBoxText()
        self.entries = {entry['id']: dict(entry) for entry in editor.document.entries(name)}
        for entry in editor.document.entries(name):
            self.chooser.append(entry['id'], self._label(entry))
        self.chooser.connect('changed', self.select)
        chooser_row.pack_start(chooser_label, False, False, 0)
        chooser_row.pack_start(self.chooser, True, True, 0)
        self.page.pack_start(chooser_row, False, False, 0)

        self.enabled = Gtk.CheckButton(label='Use this one when painting')
        self.enabled.connect('toggled', self.toggled)
        self.page.pack_start(self.enabled, False, False, 0)

        title_label = Gtk.Label(label='Title')
        title_label.set_xalign(0)
        self.page.pack_start(title_label, False, False, 0)
        self.title = Gtk.Entry()
        self.page.pack_start(self.title, False, False, 0)

        description_label = Gtk.Label(label='Description')
        description_label.set_xalign(0)
        self.page.pack_start(description_label, False, False, 0)
        scroll, self.description = editor._text_editor(190)
        self.page.pack_start(scroll, True, True, 0)

        if self.entries:
            self.chooser.set_active(0)

    @staticmethod
    def _label(entry):
        mark = '' if entry.get('enabled', True) else '  (off)'
        return f"{entry['title'] or entry['id']}  ·  {entry['id']}{mark}"

    def store(self):
        """Copy the visible fields back into the document before moving on."""
        if self.active is None:
            return
        self.editor.document.update_entry(
            self.name, self.active, self.title.get_text(),
            self.editor._text(self.description))
        self.editor.document.set_enabled(self.name, self.active, self.enabled.get_active())

    def select(self, _chooser):
        selected = self.chooser.get_active_id()
        if selected is None or selected == self.active:
            return
        self.store()
        self.active = selected
        entry = next(item for item in self.editor.document.entries(self.name)
                     if item['id'] == selected)
        self.title.set_text(entry['title'])
        self.editor._set_text(self.description, entry['description'])
        self.enabled.set_active(entry.get('enabled', True))

    def toggled(self, _button):
        if self.active is None:
            return
        self.editor.document.set_enabled(self.name, self.active, self.enabled.get_active())
        entry = next(item for item in self.editor.document.entries(self.name)
                     if item['id'] == self.active)
        index = [item['id'] for item in self.editor.document.entries(self.name)].index(self.active)
        self.chooser.remove(index)
        self.chooser.insert(index, entry['id'], self._label(entry))
        self.chooser.set_active_id(self.active)

    def commit_mode(self):
        self.editor.document.set_selection_mode(self.name, self.mode.get_active_id())


class PromptEditor:
    """Compact GTK editor; persistence stays in PromptDocument."""
    def __init__(self, document):
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk

        self.Gtk = Gtk
        self.document = document
        self.window = Gtk.Window(title='Gallery Prompts')
        self.window.set_default_size(940, 760)
        self.window.set_size_request(700, 560)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_icon_name('preferences-desktop-wallpaper')
        self.window.connect('delete-event', self.cancel)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        outer.set_border_width(18)
        self.window.add(outer)

        heading = Gtk.Label()
        heading.set_markup('<span size="x-large" weight="bold">Gallery prompts</span>')
        heading.set_xalign(0)
        outer.pack_start(heading, False, False, 0)

        introduction = Gtk.Label(
            label='Edit the shared look and wording for future generated gallery art. '
                  'Switch individual scenes and Space Ghost insertions off without deleting '
                  'them. Saving does not generate an image.')
        introduction.set_xalign(0)
        introduction.set_line_wrap(True)
        outer.pack_start(introduction, False, False, 0)

        notebook = Gtk.Notebook()
        outer.pack_start(notebook, True, True, 0)

        style_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        style_page.set_border_width(14)
        style_note = Gtk.Label(
            label='Shared guidance applied to every painting and to new theme designs.')
        style_note.set_xalign(0)
        style_note.set_line_wrap(True)
        style_page.pack_start(style_note, False, False, 0)
        style_scroll, self.style_view = self._text_editor(260)
        style_page.pack_start(style_scroll, True, True, 0)
        self._set_text(self.style_view, document.style)
        notebook.append_page(style_page, Gtk.Label(label='Shared style'))

        self.scenes = _Bank(
            self, 'scenes', 'Scene',
            'Each scene is one painting idea. Turn any of them off to keep it out of the '
            'rotation without losing the text.')
        notebook.append_page(self.scenes.page, Gtk.Label(label='Scenes'))

        self.insertions = _Bank(
            self, 'insertions', 'Insertion',
            'Each insertion style is a different way Space Ghost enters the painting. One is '
            'combined with a scene every time, so the same scene never looks the same twice.')
        notebook.append_page(self.insertions.page, Gtk.Label(label='Space Ghost'))

        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.status = Gtk.Label(
            label='Edits apply to future paintings and new theme designs.')
        self.status.set_xalign(0)
        self.status.set_line_wrap(True)
        footer.pack_start(self.status, True, True, 0)
        self.cancel_button = Gtk.Button.new_with_mnemonic('_Cancel')
        self.cancel_button.connect('clicked', self.cancel)
        self.save_button = Gtk.Button.new_with_mnemonic('_Save')
        self.save_button.get_style_context().add_class('suggested-action')
        self.save_button.connect('clicked', self.save)
        footer.pack_end(self.save_button, False, False, 0)
        footer.pack_end(self.cancel_button, False, False, 0)
        outer.pack_end(footer, False, False, 0)

    def _text_editor(self, minimum_height):
        editor = self.Gtk.TextView()
        editor.set_wrap_mode(self.Gtk.WrapMode.WORD_CHAR)
        editor.set_left_margin(8)
        editor.set_right_margin(8)
        editor.set_top_margin(8)
        editor.set_bottom_margin(8)
        scroll = self.Gtk.ScrolledWindow()
        scroll.set_policy(self.Gtk.PolicyType.AUTOMATIC, self.Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(minimum_height)
        scroll.add(editor)
        return scroll, editor

    @staticmethod
    def _text(editor):
        buffer = editor.get_buffer()
        return buffer.get_text(buffer.get_start_iter(), buffer.get_end_iter(), True)

    @staticmethod
    def _set_text(editor, value):
        editor.get_buffer().set_text(value)

    def save(self, _button):
        for bank in (self.scenes, self.insertions):
            bank.store()
            bank.commit_mode()
        self.document.set_style(self._text(self.style_view))
        try:
            self.document.save()
        except (FileChangedError, OSError, ValueError) as error:
            self.status.set_text(str(error))
            self.status.get_style_context().add_class('error')
            return
        self.window.destroy()
        self.Gtk.main_quit()

    def cancel(self, *_arguments):
        self.window.destroy()
        self.Gtk.main_quit()
        return True

    def run(self):
        self.window.show_all()
        self.Gtk.main()


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--file', type=Path, default=DEFAULT_PROMPTS,
                        help=argparse.SUPPRESS)
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    try:
        document = PromptDocument.load(args.file)
        import gi
        gi.require_version('GLib', '2.0')
        from gi.repository import GLib
        GLib.set_prgname('oldbook-gallery-prompts')
        GLib.set_application_name('Gallery Prompts')
        PromptEditor(document).run()
    except (FileChangedError, OSError, RuntimeError, ValueError) as error:
        raise SystemExit(f'oldbook-gallery-prompts: {error}') from error


if __name__ == '__main__':
    main()
