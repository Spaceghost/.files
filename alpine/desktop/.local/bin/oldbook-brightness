#!/bin/sh
# Display brightness keys: step the kernel backlight, then show the reading on the desktop pill.
set -eu

action=${1:-}
root=${OLDBOOK_BACKLIGHT_ROOT:-/sys/class/backlight}
for device in "$root"/*; do
    [ -r "$device/brightness" ] && [ -r "$device/max_brightness" ] || continue
    current=$(cat "$device/brightness")
    maximum=$(cat "$device/max_brightness")
    step=$((maximum / 20))
    [ "$step" -gt 0 ] || step=1
    case "$action" in
        up) next=$((current + step)) ;;
        down) next=$((current - step)) ;;
        *) printf '%s\n' 'usage: oldbook-brightness {up|down}' >&2; exit 64 ;;
    esac
    [ "$next" -le "$maximum" ] || next=$maximum
    [ "$next" -ge 1 ] || next=1
    if printf '%s\n' "$next" > "$device/brightness" 2>/dev/null; then
        percent=$((next * 100 / maximum))
        # The pill replaces the old progress notification; without a daemon it stays quiet.
        if command -v oldbook-osd >/dev/null 2>&1; then
            oldbook-osd show --kind brightness --value "$percent"
        fi
        exit 0
    fi
    notify-send -u normal 'Brightness needs device permission' "Cannot write $device/brightness. Grant the active seat write access or install a seat-aware brightness control."
    exit 1
done
notify-send -u normal 'No backlight device' 'The kernel did not expose a backlight under /sys/class/backlight.'
exit 1
