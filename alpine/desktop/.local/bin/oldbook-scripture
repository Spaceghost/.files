#!/usr/bin/env python3
"""Choose and render the scripture shown on the desktop."""
import argparse
from datetime import date
import json
import fcntl
import os
from pathlib import Path
import subprocess
import signal
import select
import sqlite3
import sys
import textwrap
import time

REPO = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO / 'alpine/desktop/.local/lib/oldbook'))
import scripture
import scripture_history as history

ASSETS = REPO / 'alpine/assets/scripture'
STATE = Path.home() / '.local/state/oldbook/scripture'
SELECTION = STATE / 'selection.json'
TRANSLATION = STATE / 'translation'
WITNESS_SELECTION = STATE / 'witness.json'
PANEL_WIDTH = 52
STUDY_KINDS = ('reflection', 'study-note', 'inspiration', 'observation')
KIND_TITLES = {'reflection': 'Reflection', 'study-note': 'Study note',
               'inspiration': 'Inspiration', 'observation': 'Observation'}


def study_entries():
    from scripture_study import load_entries
    return load_entries(ASSETS)


def study_selection(bible, entry):
    records = bible.lookup(entry['reference'])
    if not records:
        raise RuntimeError('Study passage is unavailable: ' + entry['reference'])
    return dict(entry, **passage_document(bible, records), kind=entry.get('kind', 'reflection'))


def passage_document(bible, records):
    translation = getattr(bible, '_translation', None) or current_translation()
    metadata = next((item for item in scripture.available_translations(ASSETS)
                     if item['id'] == translation), {'id': translation})
    return {'reference': scripture.format_reference(records),
            'text': scripture.passage_text(records), 'passage_records': records,
            'edition': records[0].get('edition') or metadata.get('title', translation),
            'source_url': records[0].get('source_url', ''),
            'license': records[0].get('license') or metadata.get('license', ''),
            'translation': translation, 'translation_metadata': metadata,
            'passage_provenance': {'method': 'offline-library', 'translation_id': translation}}


def study_label(entry):
    kind = KIND_TITLES.get(entry.get('kind', 'reflection'), 'Reflection')
    figure = entry.get('figure')
    title = f'{figure} · {entry["title"]}' if figure else entry['title']
    return f'✦  {kind} · {title}  — {entry["reference"]}'


def study_choices(entries):
    labels = [study_label(entry) for entry in entries]
    choices = {}
    for entry, label in zip(entries, labels):
        if labels.count(label) > 1:
            label += ' · ' + entry['id']
        choices[label] = entry['id']
    return choices


def current_translation():
    try:
        name = TRANSLATION.read_text().strip()
    except OSError:
        return scripture.BUNDLED
    return name or scripture.BUNDLED


def set_translation(name):
    available = {item['id'] for item in scripture.available_translations(ASSETS)}
    if name not in available:
        raise RuntimeError(f'{name} is not installed; run '
                           f'oldbook-scripture-library install {name}')
    state_directory()
    TRANSLATION.write_text(name + '\n')
    return name


def translation_title(identifier):
    """The display name of whichever text is being read."""
    for item in scripture.available_translations(ASSETS):
        if item['id'] == (identifier or scripture.BUNDLED):
            return item['title']
    return 'King James Version'


def current_witness(quotes):
    try:
        selected = json.loads(WITNESS_SELECTION.read_text())
    except (OSError, ValueError):
        selected = {}
    if selected.get('date') == date.today().isoformat():
        match = next((entry for entry in quotes if entry['id'] == selected.get('id')), None)
        if match:
            return match
    return scripture.daily_witness(quotes)


def next_witness():
    quotes = scripture.load_witnesses(ASSETS)
    previous = current_witness(quotes)
    entry = quotes[(quotes.index(previous) + 1) % len(quotes)]
    state_directory()
    temporary = WITNESS_SELECTION.with_name(f'witness.json.{os.getpid()}.tmp')
    temporary.write_text(json.dumps({'id': entry['id'], 'date': date.today().isoformat()}) + '\n')
    temporary.replace(WITNESS_SELECTION)
    refresh_panel('witness')
    return 0


def witness(width=PANEL_WIDTH):
    """A remark about the faith from someone who did not share it."""
    quotes = scripture.load_witnesses(ASSETS)
    entry = current_witness(quotes)
    lines = ['${color1}' + entry['author'] + '${color2} · ' + entry['stance']]
    lines += ['${color}' + line for line in wrap('“' + entry['quote'] + '”', width, 6)]
    lines += ['${color2}' + line for line in wrap(entry['note'], width, 2)]
    print('\n'.join(lines))
    return 0


class _LazyBible:
    """Open the verse file only when a lookup actually needs it."""

    def __init__(self, include_extra=True, translation=None):
        self._bible = None
        self._include_extra = include_extra
        self._translation = translation or current_translation()

    def _load(self):
        if self._bible is None:
            self._bible = scripture.Bible.load(ASSETS, include_extra=self._include_extra,
                                               translation=self._translation)
        return self._bible

    def __getattr__(self, name):
        return getattr(self._load(), name)


def state_directory():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    return STATE


def mirror_selection(record):
    state_directory()
    with (STATE / 'selection.lock').open('a+') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # A slower panel process may arrive after a newer manual selection.
        # Always mirror the canonical pointer while holding the mirror lock.
        record = history.current() or record
        document = dict(record['document'], history_id=record['id'], chosen_utc=record['selected_utc'],
                        next_at=record['next_at'])
        content = json.dumps(document, indent=2, ensure_ascii=False) + '\n'
        try:
            if SELECTION.read_text() == content:
                return document
        except FileNotFoundError:
            pass
        temporary = SELECTION.with_name(f'{SELECTION.name}.{os.getpid()}.tmp')
        temporary.write_text(content)
        temporary.replace(SELECTION)
        return document


def write_selection(document):
    record = history.select(document)
    mirror_selection(record)
    refresh_panel()
    return record


def refresh_panel(identifier='scripture'):
    """Replace only an owned text card, bypassing its cached execpi text."""
    if identifier not in ('scripture', 'witness', 'ghost'):
        raise ValueError('No refreshable text card: ' + identifier)
    directory = Path.home() / '.local/state/oldbook/conky'
    if not directory.is_dir() or (directory / 'disabled').exists():
        return
    with (directory / 'layout.lock').open('a+') as lock:
        deadline = time.monotonic() + 5
        while True:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    raise RuntimeError('Passage saved; desktop layout is busy. Please select again.')
                time.sleep(.05)
        try:
            pids = json.loads((directory / 'pids.json').read_text())
            pid = int(pids[identifier])
        except (OSError, ValueError, KeyError):
            return
        descriptor = None
        try:
            config = directory / f'{identifier}.conf'
            if not config.is_file():
                return
            try:
                descriptor = os.pidfd_open(pid)
            except ProcessLookupError:
                # Preserve the known layout, and revive only this Scripture
                # card when its previously recorded process has exited.
                if identifier != 'scripture':
                    return
            if descriptor is not None:
                proc = Path('/proc') / str(pid)
                arguments = (proc / 'cmdline').read_bytes().split(b'\0')
                if not (proc.stat().st_uid == os.getuid()
                        and (proc / 'exe').resolve().name == 'conky'
                        and os.fsencode(config) in arguments):
                    raise RuntimeError('Passage saved; Scripture card process identity changed.')
            with (directory / f'{identifier}.log').open('ab') as log:
                replacement = subprocess.Popen(['conky', '-c', str(config)],
                    stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                    start_new_session=True)
            pids[identifier] = replacement.pid
            temporary = directory / f'pids.json.{os.getpid()}.tmp'
            temporary.write_text(json.dumps(pids, indent=2) + '\n')
            temporary.replace(directory / 'pids.json')
            if descriptor is not None:
                signal.pidfd_send_signal(descriptor, signal.SIGTERM)
                if not select.select([descriptor], [], [], 1)[0]:
                    signal.pidfd_send_signal(descriptor, signal.SIGKILL)
        except OSError:
            return
        finally:
            if descriptor is not None:
                os.close(descriptor)


def scripture_panel_running():
    directory = Path.home() / '.local/state/oldbook/conky'
    try:
        pid = int(json.loads((directory / 'pids.json').read_text())['scripture'])
        proc = Path('/proc') / str(pid)
        return (proc.stat().st_uid == os.getuid() and (proc / 'exe').resolve().name == 'conky'
                and os.fsencode(directory / 'scripture.conf') in (proc / 'cmdline').read_bytes().split(b'\0'))
    except (OSError, ValueError, KeyError):
        return False


def read_selection():
    try:
        return json.loads(SELECTION.read_text())
    except (OSError, ValueError):
        return {}


def select_reference(bible, reference):
    records = bible.lookup(reference)
    if not records:
        raise RuntimeError('No passage matches: ' + reference)
    write_selection(dict(passage_document(bible, records), kind='passage'))
    return scripture.format_reference(records)


def select_reflection(bible, identifier):
    entries = study_entries()
    entry = next((item for item in entries if item['id'] == identifier), None)
    if entry is None:
        raise RuntimeError('No reflection or study called: ' + identifier)
    write_selection(study_selection(bible, entry))
    return entry['id']


def initial_selection(bible):
    """Import the prior selection once, materializing study and source content."""
    selection = read_selection()
    if selection.get('kind') == 'passage' and selection.get('text'):
        return dict(selection, legacy_chosen_utc=selection['chosen_utc']) if selection.get('chosen_utc') else selection
    entries = study_entries()
    if selection.get('kind') in STUDY_KINDS and selection.get('id'):
        entry = next((item for item in entries if item['id'] == selection['id']), None)
        if entry:
            document = study_selection(bible, entry)
            if selection.get('chosen_utc'):
                document['legacy_chosen_utc'] = selection['chosen_utc']
            return document
    return study_selection(bible, scripture.daily_reflection(entries))


def following_selection(bible, selected):
    """Continue a passage in its collection, or rotate the complete study catalog."""
    if selected['kind'] in STUDY_KINDS:
        entries = study_entries()
        index = next((index for index, entry in enumerate(entries) if entry['id'] == selected['id']), -1)
        return study_selection(bible, entries[(index + 1) % len(entries)])
    if selected.get('translation') and selected['translation'] != getattr(bible, '_translation', selected['translation']):
        bible = _LazyBible(translation=selected['translation'])
    records = bible.lookup(selected['reference'])
    if not records:
        raise RuntimeError('The selected passage is not in the current collection')
    last = records[-1]
    collection = ('Torah' if last['book'].startswith('Torah ') else
                  'Talmud' if last['book'].startswith('Talmud ') else 'Bible')
    verses = [record for record in bible.verses
              if ('Torah' if record['book'].startswith('Torah ') else
                  'Talmud' if record['book'].startswith('Talmud ') else 'Bible') == collection]
    following = verses[(verses.index(last) + 1) % len(verses)]
    return dict(passage_document(bible, [following]), kind='passage')


def current(bible):
    """Read the durable selection and advance exactly once when its hour is due."""
    record = history.advance(lambda: initial_selection(bible),
                             lambda selected: following_selection(bible, selected))
    return mirror_selection(record)


def tick(bible):
    """Honor the saved deadline independently of Conky's cached rendering."""
    selected = current(bible)
    try:
        rendered = int((STATE / 'panel-entry').read_text())
    except (OSError, ValueError):
        rendered = None
    if rendered != selected['history_id'] or not scripture_panel_running():
        # Only panel() acknowledges produced text. A busy layout or failed
        # replacement stays pending for the next clock check.
        refresh_panel()
    return 0


def next_selection(bible):
    if history.current() is None:
        current(bible)
    record = history.advance(lambda: initial_selection(bible),
                             lambda selected: following_selection(bible, selected), force=True)
    mirror_selection(record)
    refresh_panel()
    document = record['document']
    return document.get('id') or document['reference']


def wrap(text, width, limit):
    lines = textwrap.wrap(text, width)
    if len(lines) > limit:
        lines = lines[:limit]
        lines[-1] = lines[-1].rstrip('.,;: ') + '…'
    return lines


def panel(bible, width=PANEL_WIDTH):
    """The desktop block: passage and citation, reflection, then practice."""
    entry = current(bible)
    lines = ['${color1}' + entry.get('reference', '')]
    if entry.get('edition'):
        lines.append('${color2}' + entry['edition'])
    lines += ['${color}' + line for line in wrap(entry.get('text', ''), width, 4)]
    if entry.get('kind') in STUDY_KINDS:
        lines += ['${color2}' + line for line in wrap(entry.get('reflection', ''), width, 3)]
        lines += ['${color1}Practice: ${color2}' + line
                  for line in wrap(entry.get('practice', ''), width, 2)[:1]]
        remainder = wrap(entry.get('practice', ''), width, 2)[1:]
        lines += ['${color2}' + line for line in remainder]
    print('\n'.join(lines))
    temporary = STATE / f'panel-entry.{os.getpid()}.tmp'
    temporary.write_text(str(entry['history_id']) + '\n')
    temporary.replace(STATE / 'panel-entry')
    return 0


def show(bible, reference, width=78):
    records = bible.lookup(reference)
    if not records:
        raise RuntimeError('No passage matches: ' + reference)
    print(scripture.format_reference(records))
    print(records[0].get('edition') or translation_title(getattr(bible, '_translation', None)))
    print()
    for record in records:
        for index, line in enumerate(textwrap.wrap(record['text'], width - 5)):
            prefix = f'{record["verse"]:>3}  ' if index == 0 else '     '
            print(prefix + line)
    return 0


def search(bible, query, limit):
    entries = scripture.search_reflections(study_entries(), query)
    for entry in entries[:limit]:
        print(f'{entry["kind"]}\t{entry["id"]}\t{entry["figure"]} · {entry["title"]}\t{entry["reference"]}')
    for record in bible.search(query, limit):
        reference = scripture.format_reference([record])
        print(f'verse\t{reference}\t{record["text"]}\t{reference}')
    return 0


def find(bible, include_all=False):
    """Bible-only by default; the expanded picker puts Bible matches last."""
    entries = study_entries() if include_all else []
    reflection_ids = study_choices(entries)
    lines = list(reflection_ids)
    bible_rows, torah_rows, talmud_rows = [], [], []
    for record in bible.verses:
        row = f"{record['book']} {record['chapter']}:{record['verse']}  {record['text']}"
        target = (torah_rows if record['book'].startswith('Torah ') else
                  talmud_rows if record['book'].startswith('Talmud ') else bible_rows)
        target.append(row)
    lines = (torah_rows + talmud_rows + lines + bible_rows) if include_all else bible_rows
    launcher = Path(__file__).resolve().parent / 'oldbook-fuzzel'
    result = subprocess.run([str(launcher), '--dmenu', '--prompt',
                             'All texts ❯ ' if include_all else 'Bible ❯ ',
                             '--match-mode=exact', '--no-sort', '--delayed-filter-ms=0',
                             '--lines', '14', '--width', '96'],
                            input='\n'.join(lines) + '\n', capture_output=True, text=True)
    chosen = result.stdout.rstrip('\n')
    if result.returncode != 0 or not chosen:
        return 0
    if chosen in reflection_ids:
        print(select_reflection(bible, reflection_ids[chosen]))
        return 0
    # A verse row starts with its own reference, before the two-space gap.
    print(select_reference(bible, chosen.split('  ', 1)[0]))
    return 0


def launch_inline(scope='bible', query='', translation=None):
    from scripture_bar_ipc import request
    if not request(scope, query, translation):
        helper = REPO / 'alpine/desktop/.local/bin/oldbook-scripture-bar'
        command = ['/usr/bin/python3', str(helper), '--activate', scope, '--query', query]
        if translation:
            command.extend(['--translation', translation])
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         start_new_session=True)
    return 0


def reflections(bible):
    entries = study_entries()
    choices = study_choices(entries)
    launcher = Path(__file__).resolve().parent / 'oldbook-fuzzel'
    result = subprocess.run([str(launcher), '--dmenu', '--prompt', 'Reflections & study ❯ ',
                             '--no-sort', '--lines', '14', '--width', '96'],
                            input='\n'.join(choices) + '\n', capture_output=True, text=True)
    chosen = result.stdout.rstrip('\n')
    if result.returncode == 0 and chosen in choices:
        print(select_reflection(bible, choices[chosen]))
    return 0


def figures():
    for name in scripture.figures(study_entries()):
        print(name)
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='panel',
                        choices=['panel', 'show', 'search', 'find', 'select',
                                 'select-reflection', 'reflections', 'figures', 'daily', 'bar',
                                 'witness', 'witness-next', 'next', 'refresh', 'translations', 'use',
                                 'history', 'history-list', 'history-show', 'history-use',
                                 'history-add', 'history-add-study', 'history-backup', 'tick'])
    parser.add_argument('query', nargs='*', help='A reference, reflection ID or search words.')
    parser.add_argument('--limit', type=int, default=25)
    parser.add_argument('--width', type=int, default=PANEL_WIDTH)
    parser.add_argument('--translation', help='Read from an installed text.')
    parser.add_argument('--all', action='store_true', help='include Torah, Talmud, reflections and study in the picker')
    parser.add_argument('--picker', action='store_true', help='explicitly use the separate recovery picker')
    parser.add_argument('--entry', type=int, help='History entry ID for additional material')
    parser.add_argument('--kind', choices=['note', 'research', 'generated'], default='note')
    parser.add_argument('--input', type=Path, help='UTF-8 text file for additional material')
    parser.add_argument('--metadata', type=Path, help='JSON metadata including sources, license and provenance')
    parser.add_argument('--json', action='store_true', help='Export complete history entry data as JSON')
    arguments = parser.parse_args()
    query = ' '.join(arguments.query).strip()

    if arguments.action == 'history':
        from scripture_history_reader import run
        return run(Path(__file__).resolve(), history.database_path())
    if arguments.action == 'history-list':
        for entry in history.entries(limit=arguments.limit):
            if arguments.json:
                print(json.dumps(history.get(entry['id']), ensure_ascii=False))
                continue
            print(f'{entry["id"]}\t{entry["selected_utc"]}\t{entry["document"]["reference"]}\t'
                  + entry['document'].get('title', ''))
        return 0
    if arguments.action == 'history-show':
        entry = history.get(int(query))
        print(json.dumps(entry, ensure_ascii=False, indent=2) if arguments.json else history.render(entry))
        return 0
    if arguments.action == 'history-backup':
        if not query:
            parser.error('history-backup needs a new destination filename')
        print(history.backup(query))
        return 0
    if arguments.action == 'history-use':
        entry = history.get(int(query))
        write_selection(entry['document'])
        return 0
    if arguments.action in ('history-add', 'history-add-study'):
        selected = arguments.entry
        if selected is None:
            active = history.current()
            if active is None:
                parser.error('No current history entry; select a passage first')
            selected = active['id']
        if arguments.action == 'history-add-study':
            entry = next((item for item in study_entries() if item['id'] == query), None)
            if entry is None:
                parser.error('No study entry ' + query)
            material = study_selection(_LazyBible(), entry)
            print(history.append(selected, material, kind='study'))
        else:
            material = json.loads(arguments.metadata.read_text()) if arguments.metadata else {}
            if not isinstance(material, dict):
                parser.error('Extra material metadata must be a JSON object')
            material['text'] = arguments.input.read_text() if arguments.input else query
            material.setdefault('provenance', {'method': 'user-supplied'})
            print(history.append(selected, material, kind=arguments.kind))
        return 0

    if arguments.action == 'figures':
        return figures()
    if arguments.action == 'witness':
        return witness(arguments.width)
    if arguments.action == 'witness-next':
        return next_witness()
    if arguments.action == 'refresh':
        refresh_panel(query or 'scripture')
        return 0
    if arguments.action == 'translations':
        for item in scripture.available_translations(ASSETS):
            mark = '*' if item['id'] == current_translation() else ' '
            print(f"{mark} {item['id']:16s} {item['collection']:18s} {item['title']}")
        return 0
    if arguments.action == 'use':
        print(set_translation(' '.join(arguments.query).strip()))
        return 0
    if arguments.action == 'bar':
        helper = REPO / 'alpine/desktop/.local/bin/oldbook-scripture-bar'
        os.execv('/usr/bin/python3', ['/usr/bin/python3', str(helper), *arguments.query])
    if arguments.action in ('find', 'reflections') and not arguments.picker:
        scope = ('reflections' if arguments.action == 'reflections' else
                 'all' if arguments.all else 'bible')
        return launch_inline(scope, query, arguments.translation)
    include_extra = arguments.action != 'find' or arguments.all
    bible = _LazyBible(include_extra=include_extra,
                       translation=arguments.translation)
    if arguments.action == 'tick':
        return tick(bible)
    if arguments.action == 'panel':
        return panel(bible, arguments.width)
    if arguments.action == 'find':
        return find(bible, arguments.all)
    if arguments.action == 'reflections':
        return reflections(bible)
    if arguments.action == 'daily':
        entry = scripture.daily_reflection(study_entries())
        return select_reflection(bible, entry['id']) and 0
    if arguments.action == 'next':
        print(next_selection(bible))
        return 0
    if not query:
        parser.error(f'{arguments.action} needs a reference, ID or search words')
    if arguments.action == 'show':
        return show(bible, query)
    if arguments.action == 'search':
        return search(bible, query, arguments.limit)
    if arguments.action == 'select-reflection':
        print(select_reflection(bible, query))
        return 0
    print(select_reference(bible, query))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (RuntimeError, OSError, ValueError, sqlite3.Error) as error:
        print(f'oldbook-scripture: {error}', file=sys.stderr)
        sys.exit(1)
