#!/usr/bin/env python3
"""Fetch a secret from 1Password, or prompt for it once through the launcher.

Every secret this desktop's own scripts need -- an API key to sign an
extension, a token for some remote service -- used to mean asking Jack to
paste it into a terminal or a chat, where it sits in shell history and
conversation logs. This is the one place that asks instead: `op` first, since
it is already the source of truth for these credentials, and a masked prompt
through fuzzel (this desktop's own launcher, so it already matches the theme)
when `op` is not signed in. Neither path ever echoes the value to a terminal,
a log file, or another process's argv -- only ever to the calling script's own
stdout pipe, exactly as if it had been typed by hand and never shown again.
"""
import argparse
import subprocess
import sys

TIMEOUT_SHORT = 5
TIMEOUT_OP = 15
TIMEOUT_PROMPT = 120


def op_signed_in():
    try:
        result = subprocess.run(['op', 'whoami'], capture_output=True,
                                text=True, timeout=TIMEOUT_SHORT)
    except (OSError, subprocess.SubprocessError):
        return False
    return result.returncode == 0


def op_field(item, field):
    """One field, read the way 1Password's own docs say to: a secret reference."""
    reference = f'op://{item}/{field}'
    result = subprocess.run(['op', 'read', reference], capture_output=True,
                            text=True, timeout=TIMEOUT_OP)
    if result.returncode:
        raise RuntimeError((result.stderr or 'op read failed').strip())
    return result.stdout.rstrip('\n')


def prompt_field(item, field):
    """A masked fuzzel prompt; the typed text is fuzzel's dmenu answer, nothing else.

    --prompt-only skips waiting on stdin (there is no candidate list; nothing
    the user types needs to match anything) and --password masks every
    keystroke, the same guarantee pinentry would give -- fuzzel is used here
    only because pinentry on this machine resolves to pinentry-curses, a
    terminal program with nothing to attach it to from a background script,
    where fuzzel is already the desktop's own graphical prompt.
    """
    label = f'{item} / {field}: '
    try:
        result = subprocess.run(
            ['fuzzel', '--dmenu', '--password', '--no-exit-on-keyboard-focus-loss',
             '--prompt-only=' + label],
            capture_output=True, text=True, timeout=TIMEOUT_PROMPT)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f'Timed out waiting for {item}/{field} at the prompt')
    except (OSError, subprocess.SubprocessError) as error:
        raise RuntimeError(f'Could not open the secret prompt: {error}')
    if result.returncode:
        raise RuntimeError(f'Prompt for {item}/{field} was cancelled')
    return result.stdout.rstrip('\n')


def fetch(item, field):
    if op_signed_in():
        return op_field(item, field)
    return prompt_field(item, field)


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    subparsers = parser.add_subparsers(dest='action', required=True)
    get = subparsers.add_parser('get', help='Print one secret value per requested field.')
    get.add_argument('item', help='1Password item name (and vault, as vault/item, '
                                  'if it is not unique) -- also just a label for the '
                                  'prompt when op is not signed in.')
    get.add_argument('--field', action='append', dest='fields', default=None,
                     help='Field to fetch; repeat for more than one. Defaults to '
                          "the single field named 'password'.")
    args = parser.parse_args()
    fields = args.fields or ['password']
    try:
        values = [fetch(args.item, field) for field in fields]
    except RuntimeError as error:
        print(f'oldbook-secret: {error}', file=sys.stderr)
        return 1
    sys.stdout.write('\n'.join(values) + '\n')
    return 0


if __name__ == '__main__':
    sys.exit(main())
