#!/usr/bin/env python3
"""Grow or shrink the focused window around its current center."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import subprocess


STEP = 40


def ipc(kind, command=None):
    args = ['swaymsg', '-r', '-t', kind]
    if command:
        args.append(command)
    result = subprocess.run(args, capture_output=True, text=True, timeout=3)
    data = json.loads(result.stdout)
    if kind == 'command' and any(not item.get('success') for item in data):
        raise RuntimeError(str(data))
    result.check_returncode()
    return data


def find_window(node, identity=None):
    matches = node.get('focused') if identity is None else node.get('id') == identity
    if matches and (node.get('app_id') or node.get('window')):
        return node
    for child in node.get('nodes', []) + node.get('floating_nodes', []):
        found = find_window(child, identity)
        if found:
            return found
    return None


def resize(direction):
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    session = hashlib.sha256(os.environ['SWAYSOCK'].encode()).hexdigest()[:16]
    # Coalesce rapid key repeats instead of continuing to resize after release.
    with (runtime / f'oldbook-resize-{session}.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        node = find_window(ipc('get_tree'))
        if not node:
            return
        rect = node['rect']
        amount = STEP if direction == 'grow' else -STEP
        width = max(1, rect['width'] + amount)
        height = max(1, rect['height'] + amount)
        criteria = f'[con_id={node["id"]}]'
        floating = node.get('type') == 'floating_con'
        commands = []
        if node.get('fullscreen_mode'):
            commands.append('fullscreen disable')
        if not floating:
            commands.append('floating enable')
        # Native resize set clamps both axes and preserves a floating center.
        commands.append(f'resize set {width} px {height} px')
        ipc('command', criteria + ' ' + ', '.join(commands))
        if not floating or node.get('fullscreen_mode'):
            # Enabling floating uses the application's natural geometry. Restore
            # the original center after a mode change and size constraints.
            actual = find_window(ipc('get_tree'), node['id'])
            if actual:
                size = actual['rect']
                x = rect['x'] + (rect['width'] - size['width']) // 2
                y = rect['y'] + (rect['height'] - size['height']) // 2
                ipc('command', criteria + f' move absolute position {x} px {y} px')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('direction', choices=('grow', 'shrink'))
    args = parser.parse_args()
    try:
        resize(args.direction)
    except (OSError, KeyError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        raise SystemExit(f'oldbook-resize: {error}')
