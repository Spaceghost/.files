#!/bin/sh
# Session services are owned once per UID, so `swaymsg reload` cannot duplicate them.
set -eu
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORMTHEME=qt6ct
export XCURSOR_THEME=simp1e-cursors-gruvbox-dark
export XCURSOR_SIZE=24

uid=$(id -u)
# Serialize reload startup. Close this descriptor in background children so the
# guard is released when setup finishes, not when the desktop session ends.
session_runtime="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/oldbook-session"
umask 077
mkdir -p "$session_runtime"
if [ -L "$session_runtime" ] || [ "$(stat -c %u "$session_runtime")" != "$uid" ]; then
    printf '%s\n' 'oldbook-session: unsafe runtime directory' >&2
    exit 1
fi
chmod 700 "$session_runtime"
exec 9>"$session_runtime/startup.lock"
flock -n 9 || exit 0

start_service() {
    name=$1
    shift
    # The service lock spans its lifetime, closing the fork/exec race before its
    # process name becomes visible. BusyBox flock is sufficient on Alpine.
    flock -n "$session_runtime/$name.lock" "$@" 9>&- &
}

has_comm() {
    pgrep -u "$uid" -x "$1" >/dev/null 2>&1
}

has_polkit_agent() {
    pgrep -u "$uid" -f '^/usr/libexec/polkit-gnome-authentication-agent-1([[:space:]]|$)' >/dev/null 2>&1
}

ensure_session_bus() {
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && return 0
    runtime=${XDG_RUNTIME_DIR:-}
    if [ -n "$runtime" ] && [ -S "$runtime/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime/bus"
        return 0
    fi
    command -v dbus-daemon >/dev/null 2>&1 || return 1
    if [ -n "$runtime" ]; then
        address="unix:path=$runtime/bus"
        dbus-daemon --session --address="$address" --fork --nopidfile 9>&- >/dev/null 2>&1 || [ -S "$runtime/bus" ] || return 1
        export DBUS_SESSION_BUS_ADDRESS="$address"
    else
        address=$(dbus-daemon --session --fork --print-address=1 --nopidfile 9>&-) || return 1
        export DBUS_SESSION_BUS_ADDRESS="$address"
    fi
}

if ! ensure_session_bus; then
    printf '%s\n' 'oldbook-session: no usable D-Bus session bus' >&2
fi
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE >/dev/null 2>&1 || true
    if command -v oldbook-gtk-settings >/dev/null 2>&1; then
        oldbook-gtk-settings >/dev/null 2>&1 || true
    fi
fi

if ! has_polkit_agent && [ -x /usr/libexec/polkit-gnome-authentication-agent-1 ]; then
    start_service polkit-agent /usr/libexec/polkit-gnome-authentication-agent-1
fi
if ! has_comm pipewire; then
    start_service pipewire pipewire
    attempts=0
    while ! has_comm pipewire && [ "$attempts" -lt 20 ]; do
        sleep 1
        attempts=$((attempts + 1))
    done
fi
if ! has_comm wireplumber && ! has_comm pipewire-media-session; then
    if command -v wireplumber >/dev/null 2>&1; then
        start_service wireplumber wireplumber
    elif command -v pipewire-media-session >/dev/null 2>&1; then
        start_service pipewire-media-session pipewire-media-session
    fi
fi
if [ -f /usr/share/pipewire/pipewire-pulse.conf ] && ! has_comm pipewire-pulse; then
    start_service pipewire-pulse pipewire-pulse
fi
# The helper checks the application bus owner, so reloads never raise its window.
if command -v oldbook-pithos >/dev/null 2>&1; then
    start_service pithos-start oldbook-pithos start
fi
if ! has_comm swaync; then
    start_service swaync swaync
fi
if ! has_comm swayidle; then
    start_service swayidle swayidle -w timeout 300 'oldbook-lock' timeout 600 'swaymsg "output * dpms off"' resume 'swaymsg "output * dpms on"' before-sleep 'oldbook-lock'
fi
# The bar imports this stylesheet, so it must exist before Waybar reads style.css.
# oldbook-waybar-dim owns its contents from then on.
waybar_state="${XDG_CONFIG_HOME:-$HOME/.config}/waybar/waybar-state.css"
mkdir -p "${waybar_state%/*}"
[ -f "$waybar_state" ] || printf '%s\n' '/* Written by oldbook-waybar-dim; edit style.css instead. */' > "$waybar_state"
if ! has_comm waybar; then
    start_service waybar waybar
fi
if command -v oldbook-firewall-ui >/dev/null 2>&1; then
    start_service firewall-ui oldbook-firewall-ui
fi

# The wallpaper service uses a flock; starting it after reload is safe.
art_state="${XDG_STATE_HOME:-$HOME/.local/state}/oldbook"
mkdir -p "$art_state"
if command -v oldbook-clipboard >/dev/null 2>&1; then
    oldbook-clipboard daemon 9>&- >>"$art_state/clipboard.log" 2>&1 &
fi
if command -v oldbook-workspaces >/dev/null 2>&1; then
    oldbook-workspaces daemon 9>&- >>"$art_state/workspaces.log" 2>&1 &
fi
# Keeps the dedicated local review window on workspace 10 without raising it.
if command -v oldbook-strata >/dev/null 2>&1; then
    oldbook-strata --daemon 9>&- >>"$art_state/strata.log" 2>&1 &
fi
# Fades the bar back while a window is fullscreen; it only rewrites the imported
# stylesheet when that state actually changes.
if command -v oldbook-waybar-dim >/dev/null 2>&1; then
    oldbook-waybar-dim 9>&- >>"$art_state/waybar-dim.log" 2>&1 &
fi
if command -v oldbook-notification-led >/dev/null 2>&1; then
    oldbook-notification-led 9>&- >>"$art_state/notification-led.log" 2>&1 &
fi
# Keeps GTK loaded so the show-desktop swipe starts moving immediately; it holds
# a per-session lock and exits with Sway, so a reload cannot stack copies.
if command -v oldbook-showdesktop >/dev/null 2>&1; then
    oldbook-showdesktop daemon 9>&- >>"$art_state/showdesktop.log" 2>&1 &
fi
# Record global window focus order and keep the carousel ready for Tab/swipes.
if command -v oldbook-carousel >/dev/null 2>&1; then
    oldbook-carousel daemon 9>&- >>"$art_state/carousel.log" 2>&1 &
fi
if command -v oldbook-wallpaper >/dev/null 2>&1; then
    oldbook-wallpaper refresh >>"$art_state/wallpaper.log" 2>&1 || true
    oldbook-wallpaper daemon 9>&- >>"$art_state/wallpaper.log" 2>&1 &
fi

# Desktop panels are refitted to each new wallpaper by oldbook-wallpaper itself.
if command -v oldbook-conky >/dev/null 2>&1; then
    oldbook-conky start 9>&- >>"$art_state/conky.log" 2>&1 &
fi
# The bar holds its own single-instance lock, so a reload can never stack copies.
if command -v oldbook-scripture-bar >/dev/null 2>&1; then
    start_service scripture-bar oldbook-scripture-bar
fi

# A fresh install pulls the offline scripture library once, in the background.
if command -v oldbook-scripture-library >/dev/null 2>&1; then
    start_service scripture-library oldbook-scripture-library bootstrap
fi

# One workspace caption per output; the daemon owns its instance lock.
if command -v oldbook-decoration >/dev/null 2>&1; then
    oldbook-decoration daemon 9>&- >>"$art_state/decoration.log" 2>&1 &
fi
