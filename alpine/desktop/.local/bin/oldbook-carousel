#!/usr/bin/python3 -S
"""Cycle every window, or browse them in the desktop carousel."""
import os
import sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), '../lib/oldbook'))
if __name__ == '__main__':
    from ui_command import fast_command
    if fast_command('carousel', sys.argv[1:]):
        sys.exit(0)
    # Daemon startup needs system GI packages. Hotkeys only need a socket.
    import site
    if sys.flags.no_site:
        site.main()
    from carousel import main
    main()
