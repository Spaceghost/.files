#!/usr/bin/env python3
"""Toggle one persistent Ghostty scratchpad terminal on the focused output."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import subprocess
import time

APP_ID = 'com.oldbook.dropdown'


def geometry(output, workspace):
    """Dock below the bar using Sway's actual reserved workspace area."""
    rect = output['rect']
    usable = workspace['rect']
    # The workspace inset also includes gaps; retain that small breathing room.
    y = max(rect['y'], usable['y'])
    width = round(rect['width'] * .94)
    height = min(round(rect['height'] * .52), rect['y'] + rect['height'] - y)
    x = rect['x'] + (rect['width'] - width) // 2
    return x, y, width, height


def ipc(kind, command=None):
    args = ['swaymsg', '-r', '-t', kind]
    if command:
        args.append(command)
    result = subprocess.run(args, check=True, capture_output=True, text=True, timeout=3)
    data = json.loads(result.stdout)
    if kind == 'command' and any(not entry.get('success') for entry in data):
        raise RuntimeError(str(data))
    return data


def terminal(node, workspace=None):
    if node.get('type') == 'workspace':
        workspace = node['name']
    if node.get('app_id') == APP_ID:
        return node, workspace
    for child in node.get('nodes', []) + node.get('floating_nodes', []):
        found = terminal(child, workspace)
        if found:
            return found
    return None


def toggle():
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    session = hashlib.sha256(os.environ['SWAYSOCK'].encode()).hexdigest()[:16]
    with (runtime / f'oldbook-dropdown-{session}.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        found = terminal(ipc('get_tree'))
        if not found:
            subprocess.Popen(['ghostty', '--class=' + APP_ID,
                              '--gtk-single-instance=false', '--title=Drop-down terminal',
                              '--window-decoration=none', '--resize-overlay=never',
                              '--background-opacity=0.84', '--background-opacity-cells=true',
                              '--window-padding-x=20', '--window-padding-y=16',
                              '--window-padding-balance=true', '--cursor-style=bar',
                              '--keybind=ctrl+shift+n=unbind'],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            # GTK, font and renderer initialization can take longer after login.
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                found = terminal(ipc('get_tree'))
                if found:
                    break
                time.sleep(0.05)
            if not found:
                raise RuntimeError('Ghostty did not open within fifteen seconds')
            # The for_window rule may already have hidden the new window.
            # Sway rejects floating enable on a hidden scratchpad container.
            if found[1] != '__i3_scratch':
                ipc('command', f'[con_id={found[0]["id"]}] floating enable, move scratchpad')
                found = found[0], '__i3_scratch'
        node, workspace = found
        criteria = f'[con_id={node["id"]}]'
        if workspace != '__i3_scratch':
            ipc('command', criteria + ' move scratchpad')
            return
        output = next(output for output in ipc('get_outputs') if output.get('focused'))
        workspace = next(item for item in ipc('get_workspaces') if item.get('focused'))
        x, y, width, height = geometry(output, workspace)
        # One transaction avoids displaying the old centered geometry for a frame.
        ipc('command', criteria + f' scratchpad show, resize set {width} px {height} px, '
            f'move absolute position {x} px {y} px, focus')


if __name__ == '__main__':
    try:
        toggle()
    except (OSError, KeyError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        raise SystemExit(f'oldbook-dropdown: {error}')
