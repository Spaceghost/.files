#!/usr/bin/env python3
"""Toggle persistent console and monitor windows on the focused workspace.

A shown window is sticky, so it follows every workspace switch on its output
rather than being left behind on the workspace that summoned it.
"""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import subprocess
import time

APP_ID = 'com.oldbook.dropdown'
DROPDOWN_MARK = 'oldbook-dropdown'
PROFILES = {
    'terminal': (APP_ID, 'Drop-down terminal', []),
    'monitor': ('com.oldbook.monitor', 'System monitor', ['btop']),
}


def geometry(output, workspace):
    """Fill the usable top edge below the bar like a console drawer."""
    rect = output['rect']
    usable = workspace['rect']
    x = usable['x']
    y = usable['y']
    width = usable['width']
    height = min(round(rect['height'] * .52), rect['y'] + rect['height'] - y)
    return x, y, width, height


def ipc(kind, command=None, require_success=True):
    args = ['swaymsg', '-r', '-t', kind]
    if command:
        args.append(command)
    result = subprocess.run(args, check=(kind != 'command' or require_success),
                            capture_output=True, text=True, timeout=3)
    data = json.loads(result.stdout)
    if (kind == 'command' and require_success and
            any(not entry.get('success') for entry in data)):
        raise RuntimeError(str(data))
    return data


def native_toggle(command):
    """Try the r5 native drawer command; let an r4 session fall back cleanly."""
    result = ipc('command', command, require_success=False)
    return bool(result) and all(entry.get('success') for entry in result)


def terminal(node, workspace=None, app_id=APP_ID):
    if node.get('type') == 'workspace':
        workspace = node['name']
    if node.get('app_id') == app_id:
        return node, workspace
    for child in node.get('nodes', []) + node.get('floating_nodes', []):
        found = terminal(child, workspace, app_id)
        if found:
            return found
    return None


def toggle(profile='terminal'):
    app_id, title, command = PROFILES[profile]
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    session = hashlib.sha256(os.environ['SWAYSOCK'].encode()).hexdigest()[:16]
    with (runtime / f'oldbook-dropdown-{profile}-{session}.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        found = terminal(ipc('get_tree'), app_id=app_id)
        if not found:
            if profile == 'monitor':
                launcher = ['foot', '--app-id=' + app_id, '--title=' + title, *command]
            else:
                launcher = ['ghostty', '--class=' + app_id,
                              '--gtk-single-instance=false', '--title=' + title,
                              '--window-decoration=none', '--resize-overlay=never',
                              '--background-opacity=0.84', '--background-opacity-cells=true',
                              '--window-padding-x=20', '--window-padding-y=16',
                              '--window-padding-balance=true', '--cursor-style=bar',
                            '--keybind=ctrl+shift+n=unbind']
            subprocess.Popen(launcher,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
            # GTK, font and renderer initialization can take longer after login.
            deadline = time.monotonic() + 15
            while time.monotonic() < deadline:
                found = terminal(ipc('get_tree'), app_id=app_id)
                if found:
                    break
                time.sleep(0.05)
            if not found:
                raise RuntimeError(f'{title} did not open within fifteen seconds')
            # The for_window rule may already have hidden the new window.
            # Sway rejects floating enable on a hidden scratchpad container.
            if found[1] != '__i3_scratch':
                ipc('command', f'[con_id={found[0]["id"]}] floating enable, move scratchpad')
                found = found[0], '__i3_scratch'
        node, workspace = found
        criteria = f'[con_id={node["id"]}]'
        # Ghostty publishes its requested app_id after the view first maps, so
        # Sway may miss the for_window mark. Sway marks are globally unique, so
        # assigning it here also hands native drawer control from one console
        # to whichever console is being toggled now.
        if DROPDOWN_MARK not in node.get('marks', []):
            ipc('command', criteria + f' mark --add {DROPDOWN_MARK}')
        focused_workspace = next(item for item in ipc('get_workspaces')
                                 if item.get('focused'))
        if workspace != '__i3_scratch':
            if (workspace == focused_workspace['name'] and
                    native_toggle(criteria + ' dropdown toggle')):
                return
            # Release the workspace before hiding, so a hidden window never
            # carries a stale flag back out of the scratchpad.
            ipc('command', criteria + ' sticky disable, move scratchpad')
            # Hide locally; recall a window left on another workspace immediately.
            if workspace == focused_workspace['name']:
                return
        output = next(output for output in ipc('get_outputs') if output.get('focused'))
        x, y, width, height = geometry(output, focused_workspace)
        # One transaction avoids displaying the old centered geometry for a frame.
        # Sticky keeps a shown window on the workspace being looked at: switching
        # workspaces carries it along instead of stranding it behind, so it stays
        # summonable everywhere and pins no workspace open by sitting on it.
        show = criteria + f' dropdown toggle, sticky enable, '
        layout = (f'resize set {width} px {height} px, '
                  f'move absolute position {x} px {y} px, focus')
        if native_toggle(show + layout):
            return
        ipc('command', criteria + ' scratchpad show, sticky enable, ' + layout)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('profile', nargs='?', choices=PROFILES, default='terminal')
    arguments = parser.parse_args()
    try:
        toggle(arguments.profile)
    except (OSError, KeyError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        raise SystemExit(f'oldbook-dropdown: {error}')
