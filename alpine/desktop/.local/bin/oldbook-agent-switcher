#!/usr/bin/env python3
"""Cycle through agent windows with an Alt-held popup."""
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib/oldbook'))
from agent_switcher import main


if __name__ == '__main__':
    os.umask(0o077)
    action = sys.argv[1] if len(sys.argv) == 2 else ''
    try:
        main(action)
    except (KeyError, OSError, ValueError, RuntimeError) as error:
        sys.exit(f'oldbook-agent-switcher: {error}')
