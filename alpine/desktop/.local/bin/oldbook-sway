#!/bin/sh
# TTY entrypoint. Prefer the tested parallel compositor; keep stock Sway available.
set -eu
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORMTHEME=qt6ct
export XCURSOR_THEME=simp1e-cursors-gruvbox-dark
export XCURSOR_SIZE=24
if [ -x /usr/bin/swayfx ] && [ -r "$HOME/.config/swayfx/config" ] && [ "${OLDBOOK_STOCK_SWAY:-0}" != 1 ]; then
    set -- /usr/bin/swayfx --config "$HOME/.config/swayfx/config" "$@"
else
    set -- /usr/bin/sway "$@"
fi
if [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec "$@"
fi
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
    exec "$@"
fi
exec dbus-run-session -- "$@"
