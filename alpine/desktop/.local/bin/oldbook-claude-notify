#!/usr/bin/env python3
"""Turn supported Claude Code hook events into content-free desktop notices."""
import json
import subprocess
import sys


ATTENTION_NOTIFICATIONS = {
    'permission_prompt',
    'idle_prompt',
    'elicitation_dialog',
    'elicitation_url_dialog',
    'agent_needs_input',
    'quota_auto_resume_stale',
    'quota_auto_resume_disabled',
}


def load_event():
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, UnicodeError):
        return None
    return payload if isinstance(payload, dict) else None


def notification(payload):
    """Urgency is a claim about regret, not about how much we care.

    Red is spent only where missing it costs something you cannot get back, so
    it is reserved for a permission request: that is Claude stopped, waiting,
    doing nothing until you answer. An attention notice is a nudge and finishing
    is news, and neither is worth the loudest colour the desktop owns. Sending
    everything critical is how a desktop teaches you to ignore critical.
    """
    event = payload.get('hook_event_name')
    if event == 'PermissionRequest':
        return 'critical', 'Claude • Waiting on you'
    if (event == 'Notification'
            and payload.get('notification_type') in ATTENTION_NOTIFICATIONS):
        return 'normal', 'Claude • Needs attention'
    if event == 'Stop':
        for field in ('background_tasks', 'session_crons'):
            if payload.get(field) != []:
                return None
        return 'low', 'Claude • Done'
    return None


def send_notification(urgency, title):
    try:
        subprocess.run(
            ['notify-send', '--app-name=Claude', f'--urgency={urgency}', title],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=2, check=False)
    except (OSError, subprocess.TimeoutExpired):
        pass


def main():
    payload = load_event()
    if payload is None:
        return
    details = notification(payload)
    if details is not None:
        send_notification(*details)


if __name__ == '__main__':
    main()
