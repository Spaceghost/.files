# A float has to hold still this long before the band puts it back, so a drag
# is corrected once on release instead of being fought at every polled frame,
# and no faster than the repeat interval if something keeps reasserting it.
BAND_SETTLE = 0.5
BAND_REPEAT = 1.5

# A strip released from a window, or grabbing one, crosses the screen rather
# than tracking it. The move is slower than window-following on purpose -- far
# enough to be read as travel -- and damped below one so it passes the band and
# settles back into it, which is what makes the arrival read as a landing
# instead of a stop. 0.82 rebounds about one part in ninety of the distance:
# four pixels on a four hundred pixel flight.
FLIGHT_RESPONSE = 0.18
FLIGHT_DAMPING = 0.82
# Half a pixel is under the rounding the surface is placed with, so a flight is
# over once it is inside one. The default fiftieth is right for a strip tracking
# a dragged window, where settling exactly matters more than settling soon; a
# rebound chased to that precision spends a third of a second inaudibly small.
FLIGHT_TOLERANCE = 0.5
# How near home the strip is, in logical pixels, when the band is photographed
# for its wave. The picture takes tens of milliseconds, so it is taken on the
# final approach; the wave leaves the outline further out than this
# (ripple.SHORE), so the strip in the picture is never in the water.
STRIKE_APPROACH = 6
# The impact is the first frame the strip reaches home, not the frame the
# rebound after it has died away. The flight spring is underdamped on purpose,
# and its settle -- inside half a pixel and nearly still -- comes 200 to 270 ms
# after the strip is first seen to arrive (measured at 60 Hz for flights of 60
# to 500 px); a wave that began at the settle started long after the bar had
# visibly landed. Jack: "the ripple happens too long after the bar moves." The
# strip has made contact once every coordinate is within this many logical
# pixels of its target or has already passed it.
STRIKE_CONTACT = 1.0
# How late the wave's first frame may be. The wave's clock starts at the
# contact itself whenever its first frame is drawn, so a picture that lands a
# frame or two after the strike shows the rings where they already are rather
# than starting them late; a wave a tenth of a second old is a ring under
# thirty pixels out, still reading as the strip's own. Later than that it
# would appear mid-band from nothing, so it is dropped instead; Jack: "If the
# ripple won't be immediate, don't show it at all."
STRIKE_BUDGET = 0.1

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
STATE = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'oldbook/decoration'
SETTINGS = CONFIG / 'oldbook/decoration.json'
RUNTIME = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')) / 'oldbook'
# Shared rather than built fresh per tick: it holds no state between calls,
# only the uid this session already runs as.
AGENT_RESOLVER = ApplicationResolver()


def position():
    return load_settings(SETTINGS, STATE / 'position')['position']


def set_position(value):
    settings = load_settings(SETTINGS, STATE / 'position')
    settings['position'] = value
    save_settings(SETTINGS, settings, STATE / 'position')


def launch(command):
    try:
        subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def design_descriptor(directory=THEMES):
    """The active theme's design block, or nothing at all if it will not read."""
    try:
        identity = (directory / 'current').read_text().strip()
        if not re.fullmatch(r'[a-z0-9][a-z0-9-]{0,63}', identity):
            return {}
        found = json.loads((directory / (identity + '.json')).read_text()).get('design', {})
    except (OSError, ValueError, AttributeError, TypeError):
        return {}
    return found if isinstance(found, dict) else {}


def design_font(directory=THEMES):
    """The active theme's caption typeface, or None to keep the terminal font."""
    font = design_descriptor(directory).get('font')
    return font.strip() if isinstance(font, str) and font.strip() else None


def design_opacity(directory=THEMES):
    """How transparent this theme makes its terminals, which is what a strip
    decorating a terminal should match. The theme generates the terminal
    configuration from this same number, so the two never drift apart."""
    value = design_descriptor(directory).get('opacity')
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    value = float(value)
    return value if 0 < value <= 1 else None


def design_radius(directory=THEMES):
    """The corner radius the compositor rounds this theme's windows with.

    `desktop_theme` writes the SwayFX `corner_radius` line from this same
    number, so reading it here keeps the strip's seam and the compositor's
    windows on one value across a theme switch -- the arrangement the terminal
    opacity already uses, and the only one available: SwayFX 0.6 will not tell
    a caller what a container's radius is, and will not let it set one.
    """
    return window_radius(design_descriptor(directory).get('radius'))


def components(color, alpha):
    """A '#rrggbb' string as cairo components at this alpha, or None."""
    text = str(color or '').lstrip('#')
    if len(text) != 6:
        return None
    try:
        red, green, blue = (int(text[index:index + 2], 16) / 255 for index in (0, 2, 4))
    except ValueError:
        return None
    return (red, green, blue, max(0.0, min(1.0, float(alpha))))


def appearance():
    config = configparser.ConfigParser(interpolation=None)
    config.read(CONFIG / 'foot/foot.ini')
    font = config.get('main', 'font', fallback='JetBrainsMono Nerd Font:size=9.5')
    family = font.split(':', 1)[0].split(',')[0]
    match = re.search(r':size=([0-9.]+)', font)
    size = float(match[1]) if match else 9.5
    # Ghost Observatory captions use the theme's design typeface; a theme
    # without one keeps the terminal font. A proportional face needs a point
    # more than the monospace terminal size to read at the same height.
    design = design_font()
    if design and design != family:
        family, size = design, size + 1
    return (family, min(40, max(5, size)), read_palette(),
            load_settings(SETTINGS, STATE / 'position'), design_opacity(),
            design_radius())


def queue_geometry_update(callback):
    """Apply coalesced IPC geometry before GTK paints the next frame."""
    from gi.repository import GLib
    # Ordinary idle work (200) waits behind layout/redraw (110/120) and can
    # starve under animation. IPC itself still runs ahead of this handoff.
    return GLib.idle_add(callback, priority=GLib.PRIORITY_HIGH_IDLE)


def daemon():
    # gtk4-layer-shell only takes effect when it precedes libwayland-client in
    # the global scope, which is the in-process equivalent of LD_PRELOAD and
    # what every other GTK4 surface here does. Loaded directly rather than
    # through showdesktop's helper: three lines of ctypes are not worth
    # importing the show-desktop animation and its workspace model for.
    import ctypes
    import ctypes.util
    ctypes.CDLL(ctypes.util.find_library('gtk4-layer-shell')
                or 'libgtk4-layer-shell.so.0', mode=ctypes.RTLD_GLOBAL)
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Gdk', '4.0')
    gi.require_version('Gtk4LayerShell', '1.0')
    from gi.repository import Gdk, Gio, GLib, Gtk, Gtk4LayerShell, Pango

    STATE.mkdir(parents=True, exist_ok=True)
    guard = (STATE / 'daemon.lock').open('a+')
    try:
        fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    Gtk.init()
    display = Gdk.Display.get_default()
    if display is None or not Gtk4LayerShell.is_supported():
        print('Workspace decoration needs the Wayland desktop.', file=sys.stderr)
        return 1
    loop = GLib.MainLoop()

    def load_css(provider, text):
        """GTK 4.12 replaced the byte-oriented loader with a string one."""
        if hasattr(provider, 'load_from_string'):
            provider.load_from_string(text)
        else:
            provider.load_from_data(text.encode(), -1)

    def add_click(widget, callback):
        """GTK4 delivers pointer buttons through a gesture, not an event signal.

        Button 0 means every button: the handler decides which ones it wants
        and claims only those, so an unclaimed press still reaches the widget's
        own click machinery exactly as returning False did under GTK3.
        """
        gesture = Gtk.GestureClick()
        gesture.set_button(0)
        # Ahead of the widget's own gesture, not behind it. A GTK4 button
        # claims the sequence for itself, and a middle or right click that
        # reaches it first never arrives here at all; GTK3 delivered the press
        # to the handler before the button acted on it. Capturing restores that
        # order, and a press this handler does not claim still travels on to
        # the button underneath.
        gesture.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        gesture.connect('pressed', callback)
        widget.add_controller(gesture)
        return gesture

    def children_of(box):
        child = box.get_first_child()
        while child is not None:
            # Read the sibling first: a handler may unparent this child.
            following = child.get_next_sibling()
            yield child
            child = following

    class Caption:
        def __init__(self, monitor, placement, animate_entry=True):
            self.monitor, self.edge = monitor, placement['edge']
            edge = self.edge
            self.attachment_mode = placement['mode']
            self.previous_geometry = None
            self.rendered_size = None
            self.motion_rect = None
            self.motion_target = None
            self.motion_velocity = {key: 0.0 for key in ('x', 'y', 'width', 'height')}
            self.frame_time = None
            self.tick_id = 0
            self.retiring = False
            # A mode change flies rather than cuts: one surface, positioned
            # freely from the top-left corner for the length of the move, then
            # handed back to the anchors that own it wherever it lands.
            self.flying = False
            self.contact_pending = False
            self.approach = None
            self.band_request = None
            self.output_rect = None
            self.animations = Gtk.Settings.get_default().get_property('gtk-enable-animations')
            self.alpha = 0.0 if self.animations and animate_entry else 1.0
            self.alpha_velocity = 0.0
            self.context = {'id': None, 'edge': edge, 'node': {}}
            self.tree = {}
            self.menu = None
            self.disposed = False
            self.icon_key = None
            self.window = Gtk.Window()
            self.window.set_decorated(False)
            self.window.set_opacity(self.alpha)
            self.css_name = 'workspace-decoration-' + str(id(self))
            self.window.set_name(self.css_name)
            self.window.set_can_focus(False)
            Gtk4LayerShell.init_for_window(self.window)
            Gtk4LayerShell.set_namespace(self.window, 'oldbook-decoration')
            Gtk4LayerShell.set_monitor(self.window, monitor)
            attached = self.attachment_mode == 'window'
            Gtk4LayerShell.set_layer(self.window, Gtk4LayerShell.Layer.TOP if attached
                                     else Gtk4LayerShell.Layer.OVERLAY)
            Gtk4LayerShell.set_keyboard_mode(self.window, Gtk4LayerShell.KeyboardMode.NONE)
            anchors = (('TOP', 'LEFT') if attached
                       else decoration_reserve.band_anchors(edge))
            for name in anchors:
                side = getattr(Gtk4LayerShell.Edge, name)
                Gtk4LayerShell.set_anchor(self.window, side, True)
                Gtk4LayerShell.set_margin(self.window, side,
                                          0 if attached else decoration_reserve.EDGE_MARGIN)
            # The caption itself never reserves anything: the band does that
            # once and keeps doing it, so no focus change can resize a window.
            # An attached caption follows a window that may be anywhere in the
            # output and needs the whole coordinate space; a workspace caption
            # keeps a zero zone so it still sits below the bar's reservation,
            # and steps back over its own band with a negative margin.
            Gtk4LayerShell.set_exclusive_zone(self.window, -1 if attached else 0)
            self.band = None
            orientation = Gtk.Orientation.HORIZONTAL if edge == 'bottom' else Gtk.Orientation.VERTICAL
            self.box = Gtk.Box(orientation=orientation, spacing=4)
            self.box.add_css_class('caption')
            self.box.set_vexpand(True)
            # The strip and the window it decorates are one shape along the
            # bottom, so the surface starts above the caption: the seam area
            # covers the window's last rows and fills the two corners the
            # compositor clipped out of them. It is empty and invisible in
            # every other placement.
            self.seam = 0
            self.fill = None
            self.input_shape = None
            self.content_size = None
            self.shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            self.fillets = Gtk.DrawingArea()
            self.fillets.set_draw_func(self.draw_seam)
            self.shell.append(self.fillets)
            self.shell.append(self.box)
            self.window.set_child(self.shell)
            self.brand = self.button('', 'Window actions', lambda button: self.popup(button))
            self.brand.add_css_class('brand')
            self.image = Gtk.Image.new_from_icon_name('application-x-executable-symbolic')
            self.brand.set_child(self.image)
            self.box.append(self.brand)
            self.title_button = Gtk.Button()
            self.title_button.set_can_focus(False)
            self.title_button.add_css_class('title-button')
            self.label = Gtk.Label()
            self.label.set_use_markup(False)
            if edge == 'bottom':
                self.label.set_ellipsize(Pango.EllipsizeMode.END)
                self.label.set_max_width_chars(1)
                self.label.set_hexpand(True)
                # Observatory captions read from the left, like an exhibit label.
                self.label.set_xalign(0.0)
            self.title_button.set_child(self.label)
            if edge == 'bottom':
                self.title_button.set_hexpand(True)
            else:
                self.title_button.set_vexpand(True)
            add_click(self.title_button, self.title_click)
            self.box.append(self.title_button)
            self.state_label = Gtk.Label()
            self.state_label.add_css_class('window-state')
            self.state_label.set_margin_start(4)
            self.state_label.set_margin_end(4)
            self.box.append(self.state_label)
            self.empty_controls = Gtk.Box(orientation=orientation, spacing=3)
            for action in launchers({}):
                control = self.button(action['label'], 'Open ' + action['label'],
                                      lambda button, action=action: self.run(dict(
                                          action, workspace=self.context.get('workspace'))))
                self.empty_controls.append(control)
            self.box.append(self.empty_controls)
            self.tile_button = self.button('▱', 'Float this window', lambda button: self.toggle_float())
            self.full_button = self.button('⛶', 'Fullscreen', lambda button: self.toggle_fullscreen())
            self.windows_button = self.button('▤', 'Choose a window', lambda button: self.popup(button, windows=True))
            self.more_button = self.button('⋯', 'Window actions and strip appearance', lambda button: self.popup(button))
            for button in (self.tile_button, self.full_button, self.windows_button, self.more_button):
                self.box.append(button)
            self.provider = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_display(display, self.provider,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_USER)
            # The accent wash behind the brand button follows the keyboard's
            # breath while you type. It rides its own provider above the styled
            # one so a pulse never reparses the whole caption stylesheet.
            self.breath_provider = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_display(display, self.breath_provider, 900)
            self.breath = air.Smoother(air.CAPTION_LOW, response=0.09, tolerance=1e-4)
            self.breath_painted = None
            self.accent = None
            self.previous_style = None
            self.previous_display = None
            self.measured = decoration_reserve.band_thickness(0)
            self.measured_key = None
            self.character_width = None
            self.powerline = False
            self.palette = {}
            self.shown_parts = []

        def set_band(self, thickness, matching=True, output_rect=None, usable_rect=None):
            """Step back over the reserved band so the strip stays where it was.

            The band is a reservation, not a shelf to sit on top of: the caption
            crosses it and draws inside it, which leaves the strip exactly where
            it has always been while the windows above it stop moving.

            Stepping over it was a negative margin, and gtk4-layer-shell cannot
            carry one -- the extent it asks the compositor for collapses to zero
            and the surface is handed an arbitrary default instead. So the
            caption declines every reservation and is placed from the raw output
            edge, with whatever the other panels hold back added into its
            margins. Declining is not reserving: a zone of -1 makes no claim.
            """
            if self.attachment_mode == 'window':
                return
            self.band_request = (thickness, matching, output_rect, usable_rect)
            if self.flying:
                # In flight the strip owns its own coordinates; the band is
                # applied again the moment it lands.
                return
            zone, margin = decoration_reserve.caption_offset(thickness, matching)
            insets = None
            if margin < 0:
                # Only the step over this caption's own band is rewritten. A
                # band on the other edge already declines every reservation on
                # purpose -- fullscreen borrows the bottom while the band stays
                # on the saved edge, and the borrowed strip is meant to span the
                # whole output rather than be pushed out of a reservation it is
                # not sitting in -- so that case keeps its plain margin.
                zone = -1
                if output_rect and usable_rect:
                    insets = decoration_reserve.caption_insets(
                        output_rect, usable_rect, self.edge, thickness, matching)
            state = (thickness, matching, tuple(sorted(insets.items())) if insets else None)
            if state == self.band:
                return
            self.band = state
            Gtk4LayerShell.set_exclusive_zone(self.window, zone)
            if insets is None:
                # Without the compositor's rectangles there is nothing to add
                # back, so a step-over falls to the ordinary gap: the strip sits
                # where it always does against the raw edge, which is right
                # whenever this caption's band is the only thing reserving it.
                side = getattr(Gtk4LayerShell.Edge,
                               'BOTTOM' if self.edge == 'bottom' else 'RIGHT')
                Gtk4LayerShell.set_margin(
                    self.window, side,
                    margin if margin >= 0 else decoration_reserve.EDGE_MARGIN)
                return
            for name in decoration_reserve.band_anchors(self.edge):
                Gtk4LayerShell.set_margin(self.window, getattr(Gtk4LayerShell.Edge, name),
                                          insets[name])

        def remeasure(self, style):
            """Size the band from a reference line rather than the live caption.

            A Nerd Font branch glyph is taller than plain Latin in the same face,
            so a band that followed what the caption happens to say would resize
            every window whenever the pointer crossed from a repository to a
            plain window. The reference holds every glyph class the strip can
            draw, so one measurement per appearance covers all of them.
            """
            reference = decoration_reserve.REFERENCE
            self.label.set_use_markup(False)
            if self.edge == 'bottom':
                self.label.set_text(reference)
                natural = self.box.measure(Gtk.Orientation.VERTICAL, -1)[1]
            else:
                self.label.set_text(vertical_title(reference, len(reference)))
                natural = self.box.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
            self.measured = decoration_reserve.band_thickness(natural)
            sample = self.label.create_pango_layout(decoration_reserve.SAMPLE)
            sample.set_font_description(Pango.FontDescription(f'{style[0]} {style[1]}'))
            self.character_width = sample.get_pixel_size()[0] / len(decoration_reserve.SAMPLE)

        def show_caption(self, parts):
            """Set the line once, in whichever form this strip is wearing."""
            self.shown_parts = list(parts)
            if self.powerline and parts:
                self.label.set_markup(window_context.markup(parts, self.palette))
                return
            self.label.set_use_markup(False)
            self.label.set_text(window_context.SEPARATOR.join(text for _, text in parts))

        def budget(self, placement):
            """How much line there is room for, in characters.

            Pango's ellipsis cuts whatever happens to be last, which is no way
            to choose what a person loses. Measuring the room first lets the
            caption drop whole ideas in a deliberate order instead, and leaves
            the ellipsis as the last resort it should be.
            """
            if self.edge != 'bottom' or not self.character_width:
                return None
            span = (placement['rect']['width'] if self.attachment_mode == 'window'
                    else self.monitor.get_geometry().width)
            controls = sum(child.measure(Gtk.Orientation.HORIZONTAL, -1)[1]
                           for child in children_of(self.box)
                           if child is not self.title_button and child.get_visible())
            return decoration_reserve.character_budget(span, self.character_width, controls + 48)

        def size_to_content(self):
            """Give the compositor the one dimension its anchors cannot supply.

            A workspace strip is anchored along the whole of its edge, so the
            span is the compositor's to choose, but the thickness is anchored
            at neither end. A layer surface that asks for zero there is asking
            to be told, and what it is told is an arbitrary default rather than
            the caption's own height. GTK3's layer-shell binding measured the
            window for us; GTK4's reads the window's default size instead, so
            the measurement belongs here.
            """
            if self.attachment_mode == 'window' or self.flying:
                return
            # Both numbers are given outright. gtk4-layer-shell requests the
            # window's default size verbatim, and a -1 there is not a size the
            # protocol can carry; the anchored span is the compositor's to
            # overrule anyway, so naming the output's own extent costs nothing.
            area = self.monitor.get_geometry()
            if self.edge == 'bottom':
                size = (max(1, area.width),
                        max(1, self.shell.measure(Gtk.Orientation.VERTICAL, -1)[1]))
            else:
                size = (max(1, self.shell.measure(Gtk.Orientation.HORIZONTAL, -1)[1]),
                        max(1, area.height))
            if size == self.content_size:
                return
            self.content_size = size
            # The thickness is stated as a request as well as a default. A
            # layer surface that leaves a dimension to the compositor is told
            # an arbitrary number for it, and any later change to the zone or
            # the margins recomputes the surface and forgets a default size --
            # a request is a floor the recomputation keeps. This is what an
            # attached caption already does through render_geometry().
            self.window.set_size_request(-1 if self.edge == 'bottom' else size[0],
                                         size[1] if self.edge == 'bottom' else -1)
            self.window.set_default_size(*size)

        def band_insets(self):
            """The margins the anchored placement is currently using."""
            request = self.band_request
            insets = None
            if request is not None:
                thickness, matching, output_rect, usable_rect = request
                _, margin = decoration_reserve.caption_offset(thickness, matching)
                if margin < 0 and output_rect and usable_rect:
                    insets = decoration_reserve.caption_insets(
                        output_rect, usable_rect, self.edge, thickness, matching)
            if insets is None:
                insets = {side: decoration_reserve.EDGE_MARGIN
                          for side in ('TOP', 'BOTTOM', 'LEFT', 'RIGHT')}
            return insets

        def workspace_extent(self, output_rect):
            """Where an anchored strip sits, in the free coordinates a flight uses.

            Anchored placement is the compositor's answer to this question and
            a strip in flight is positioned by margin from the top-left corner,
            so for the length of the move the answer has to be worked out here
            instead of asked for.
            """
            insets = self.band_insets()
            width = max(1, output_rect.get('width', 0))
            height = max(1, output_rect.get('height', 0))
            if self.edge == 'bottom':
                thickness = max(1, self.shell.measure(Gtk.Orientation.VERTICAL, -1)[1])
                span = max(1, width - insets['LEFT'] - insets['RIGHT'])
                return dict(x=insets['LEFT'], y=height - insets['BOTTOM'] - thickness,
                            width=span, height=thickness)
            thickness = max(1, self.shell.measure(Gtk.Orientation.HORIZONTAL, -1)[1])
            span = max(1, height - insets['TOP'] - insets['BOTTOM'])
            return dict(x=width - insets['RIGHT'] - thickness, y=insets['TOP'],
                        width=thickness, height=span)

        def anchor_free(self):
            """Hold the surface by one corner so a rectangle can be sprung."""
            for name in ('TOP', 'LEFT', 'BOTTOM', 'RIGHT'):
                side = getattr(Gtk4LayerShell.Edge, name)
                Gtk4LayerShell.set_anchor(self.window, side, name in ('TOP', 'LEFT'))
                Gtk4LayerShell.set_margin(self.window, side, 0)
            Gtk4LayerShell.set_exclusive_zone(self.window, -1)

        def anchor_band(self):
            """Give the edge back to the compositor once the strip has landed."""
            for name in ('TOP', 'LEFT', 'BOTTOM', 'RIGHT'):
                side = getattr(Gtk4LayerShell.Edge, name)
                Gtk4LayerShell.set_anchor(
                    self.window, side, name in decoration_reserve.band_anchors(self.edge))
                Gtk4LayerShell.set_margin(self.window, side, decoration_reserve.EDGE_MARGIN)
            self.band = None
            request = self.band_request
            if request is not None:
                self.set_band(*request)

        def begin_flight(self, placement, output_rect):
            """Carry one strip from where it is to where its new mode puts it.

            Attaching and detaching used to be a cut: the old caption was
            destroyed and a new one built at the destination, because
            crossfading two surfaces leaves the old one behind while the new
            one catches up. One surface has neither problem. It is held by its
            top-left corner for the length of the move -- the coordinates an
            attached strip already lives in -- and handed back to the anchors
            at the far end.
            """
            abandon_strike(self)
            departure = self.motion_rect
            if departure is None or self.attachment_mode != 'window':
                departure = self.workspace_extent(output_rect)
            attached = placement['mode'] == 'window'
            if attached and self.attachment_mode != 'window' and not self.flying:
                # Lifting the strip out of its dock disturbs the same water
                # as setting it down. Photograph its old outline before the
                # first moving frame; a slow capture is dropped by the same
                # budget as a landing, never by holding up the flight.
                prepare_strike(self, rect=departure)
            self.attachment_mode = placement['mode']
            self.flying = True
            # A return to the band waits for contact; a departure strikes on
            # its first moving frame, never again when it reaches the window.
            # Contact is watched against the way each coordinate sets out.
            self.contact_pending = not attached
            self.approach = None
            self.previous_geometry = None
            self.previous_display = None
            # The seam belongs to the mode, not to the strip: attached along
            # the bottom the caption climbs over the arc the compositor clipped
            # from its window's corners, and docked it has no seam at all.
            # Clearing the remembered style makes restyle() work that out again
            # for the mode being flown to, instead of carrying the old one
            # across and landing the wrong height.
            self.previous_style = None
            Gtk4LayerShell.set_layer(self.window, Gtk4LayerShell.Layer.TOP if attached
                                     else Gtk4LayerShell.Layer.OVERLAY)
            self.anchor_free()
            self.motion_rect = dict(departure)
            self.motion_velocity = {key: 0.0 for key in ('x', 'y', 'width', 'height')}
            if not attached:
                self.motion_target = self.workspace_extent(output_rect)
                self.approach = approach_signs(departure, self.motion_target, STRIKE_CONTACT)
            self.frame_time = None
            self.render_geometry()
            self.animate()

        def land(self):
            """Hand the edge back, now the strip has arrived and settled.

            The water was struck on the contact frame, before the rebound;
            by now the wave is already crossing the band. Only a flight that
            somehow settled without ever being seen to arrive strikes here.
            """
            self.flying = False
            if self.attachment_mode == 'window':
                # Taking hold of the window adds no second wave. Any dock
                # departure already rang on its first moving frame.
                self.contact_pending = False
                abandon_strike(self)
                return
            self.anchor_band()
            self.content_size = None
            self.size_to_content()
            if self.contact_pending:
                self.contact_pending = False
                strike(self)

        def attached_extent(self, rect):
            """The size an attached strip takes for the window it decorates.

            The span comes from the window; the thickness is measured from the
            strip's own contents. Kept apart from place() because a handoff
            has to state the size before it has anywhere to put it.
            """
            if self.edge == 'bottom':
                width = max(1, rect['width'])
                return width, max(1, self.shell.measure(Gtk.Orientation.VERTICAL, width)[1])
            height = max(1, rect['height'])
            return max(1, self.shell.measure(Gtk.Orientation.HORIZONTAL, height)[1]), height

        def place(self, placement, output_rect):
            if self.attachment_mode != 'window':
                return
            rect = placement['rect']
            geometry = (tuple(rect.get(key, 0) for key in ('x', 'y', 'width', 'height')),
                        tuple(output_rect.get(key, 0) for key in ('x', 'y')),
                        self.previous_style, self.seam)
            if geometry == self.previous_geometry:
                return
            x = rect['x'] - output_rect['x']
            y = rect['y'] - output_rect['y']
            width, height = self.attached_extent(rect)
            if self.edge == 'bottom':
                # The caption's own rows stay exactly where they have always
                # been; only the seam above them is new, so the surface starts
                # that much higher and is that much taller.
                y += rect['height'] - self.seam
            else:
                x += rect['width']
            self.motion_target = dict(x=x, y=y, width=width, height=height)
            if self.motion_rect is None or not self.animations:
                self.motion_rect = dict(self.motion_target)
                self.render_geometry()
            self.animate()
            self.previous_geometry = geometry

        def render_geometry(self):
            rect = {key: round(value) for key, value in self.motion_rect.items()}
            size = (max(1, rect['width']), max(1, rect['height']))
            # Extent first, then the margins that move it, with nothing in
            # between. A margin commits the layer surface immediately while a
            # resize waits for GTK's next frame, so anything done between the
            # two is time the strip spends at its old width in its new place.
            # Set together in one turn they reach the compositor as one change.
            if size != self.rendered_size:
                # GTK queues layout even when the size request repeats itself.
                # Moving a caption only needs new margins and a repaint.
                #
                # Both dimensions are requested, not just the anchored span.
                # A hover handoff renews the native surface, and whatever the
                # window cannot state at that moment the compositor decides
                # for it -- which is a two-hundred pixel square, shown for a
                # frame at the new position before the real size arrives. The
                # thickness here is the same measurement place() just took, so
                # stating it costs nothing and leaves nothing to guess.
                self.window.set_size_request(*size)
                self.window.set_default_size(*size)
                self.rendered_size = size
                self.refresh_input()
            Gtk4LayerShell.set_margin(self.window, Gtk4LayerShell.Edge.LEFT, rect['x'])
            Gtk4LayerShell.set_margin(self.window, Gtk4LayerShell.Edge.TOP, rect['y'])

        def draw_seam(self, widget, context, width, height):
            """Fill the two corners the compositor clipped out of the window.

            The rounding removes a quarter disc from each bottom corner and the
            desktop shows through it, which is the pinch between the window and
            its strip. Painting exactly that removed shape -- and only it, in
            the colour the caption's own first row already has -- squares the
            pair's outline without hiding a single row the window was drawing.
            """
            radius = min(self.seam, width // 2)
            if radius <= 0 or self.fill is None:
                return False
            context.set_source_rgba(*self.fill)
            context.new_path()
            context.move_to(0, 0)
            context.line_to(0, radius)
            context.line_to(radius, radius)
            context.arc(radius, 0, radius, math.pi / 2, math.pi)
            context.close_path()
            context.move_to(width, 0)
            context.line_to(width, radius)
            context.line_to(width - radius, radius)
            context.arc_negative(width - radius, 0, radius, math.pi / 2, 0)
            context.close_path()
            context.fill()
            return False

        def refresh_input(self):
            """Leave the seam rows to the window they are drawn over.

            The surface covers the window's last rows to close the seam, and a
            click there is aimed at the window. An input region that stops at
            the caption keeps the pointer on the window it belongs to, exactly
            as the band's empty region keeps a click off the screen edge.
            """
            size = self.rendered_size
            if size is None or (self.seam, size) == self.input_shape:
                return
            surface = self.window.get_surface()
            if surface is None:
                return
            try:
                import cairo
                region = None
                if self.seam > 0:
                    region = cairo.Region(cairo.RectangleInt(
                        0, self.seam, max(1, size[0]), max(1, size[1] - self.seam)))
                surface.set_input_region(region)
            except (ImportError, AttributeError, TypeError, ValueError):
                return
            self.input_shape = (self.seam, size)

        def animate(self):
            if self.animations and self.window.get_mapped() and not self.tick_id:
                self.frame_time = None
                self.tick_id = self.window.add_tick_callback(self.frame)

        def frame(self, widget, clock):
            now = clock.get_frame_time() / 1_000_000
            elapsed = 0 if self.frame_time is None else now - self.frame_time
            self.frame_time = now
            target_alpha = 0.0 if self.retiring else 1.0
            self.alpha, self.alpha_velocity = advance(
                self.alpha, self.alpha_velocity, target_alpha, elapsed,
                response=0.09, tolerance=0.002)
            self.window.set_opacity(self.alpha)
            settled = True
            if self.motion_target is not None and not self.retiring:
                self.motion_rect, self.motion_velocity, settled = advance_rect(
                    self.motion_rect, self.motion_velocity, self.motion_target,
                    elapsed,
                    response=FLIGHT_RESPONSE if self.flying else 0.045,
                    tolerance=FLIGHT_TOLERANCE if self.flying else 0.05,
                    damping=FLIGHT_DAMPING if self.flying else 1.0)
                if self.flying and self.attachment_mode == 'window' and elapsed > 0:
                    # Layout can hold up the first frame. Date departure from
                    # motion, not from the earlier request to change modes.
                    strike(self)
                if self.flying and self.attachment_mode != 'window':
                    if not settled:
                        # Nearly home: photograph the band now, so the wave
                        # can begin on the very frame the strip arrives.
                        remaining = max(abs(self.motion_rect[key] - self.motion_target[key])
                                        for key in ('x', 'y', 'width', 'height'))
                        if remaining <= STRIKE_APPROACH:
                            prepare_strike(self)
                    if (self.contact_pending and self.approach is not None
                            and contact(self.motion_rect, self.motion_target,
                                        self.approach, STRIKE_CONTACT)):
                        # This is the impact: the strip is home for the first
                        # time. The rebound and the settle that follow are the
                        # landing being read, not waited for.
                        self.contact_pending = False
                        strike(self)
                self.render_geometry()
                if settled and self.flying:
                    self.land()
            if not self.breathe(elapsed):
                settled = False
            if settled and self.alpha == target_alpha:
                self.tick_id = 0
                return False
            return True

        def breathe(self, elapsed):
            """Follow the shared breath; True once the accent has come to rest."""
            value, settled = self.breath.advance(breath_state['target'], elapsed)
            if self.accent is not None:
                painted = air.quantise(value)
                if painted != self.breath_painted:
                    self.breath_painted = painted
                    load_css(self.breath_provider,
                             f'#{self.css_name} .brand {{ background: alpha({self.accent}, '
                             f'{painted:.3f}); }}')
            return settled and breath_state['target'] == air.CAPTION_LOW

        def retire(self):
            if not self.animations:
                self.destroy()
                return
            self.retiring = True
            self.window.set_sensitive(False)
            # Its zone is already nothing, and changing one now would move a
            # fading strip off the edge it is anchored inside.
            retired.add(self)
            self.animate()
            # Also dispose when an output disappears and stops frame callbacks.
            GLib.timeout_add(220, lambda: (self.destroy(), False)[1])

        def button(self, label, hint, callback):
            button = Gtk.Button.new_with_label(label)
            button.set_can_focus(False)
            button.set_tooltip_text(hint)
            button.update_property([Gtk.AccessibleProperty.LABEL], [hint])
            button.connect('clicked', callback)
            add_click(button, self.secondary_click)
            return button

        def secondary_click(self, gesture, presses, x, y):
            if gesture.get_current_button() != 3:
                return
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            if gesture.get_current_event_state() & Gdk.ModifierType.SHIFT_MASK:
                launch(action_command(3, shifted=True))
            else:
                self.popup(gesture.get_widget())

        def title_click(self, gesture, presses, x, y):
            button = gesture.get_current_button()
            if button == 3:
                self.secondary_click(gesture, presses, x, y)
                return
            if button == 2:
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                self.toggle_float()
                return
            if button == 1:
                gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                self.popup(gesture.get_widget(), windows=bool(self.context.get('id')))

        def run(self, action):
            threading.Thread(target=execute, args=(action,), daemon=True).start()

        def toggle_float(self):
            context = dict(self.context)
            self.run(window_item(context, '', 'floating disable' if context.get('floating') else 'floating enable'))

        def toggle_fullscreen(self):
            context = dict(self.context)
            self.run(window_item(context, '', 'fullscreen disable' if context.get('fullscreen') else 'fullscreen enable'))

        def menu_entry(self, group, counter, command=None):
            """One uniquely named action per entry, disabled when it does nothing.

            GTK4 menus are models rather than widgets, so an item's sensitivity
            belongs to the action behind it: a disabled action is exactly the
            insensitive row `set_sensitive(False)` used to produce.
            """
            counter[0] += 1
            name = 'item%d' % counter[0]
            entry = Gio.SimpleAction.new(name, None)
            if command is None:
                entry.set_enabled(False)
            else:
                entry.connect('activate', lambda widget, parameter: self.run(command))
            group.add_action(entry)
            return 'menu.' + name

        def fill_menu(self, model, actions, group, counter):
            """Translate one action list into a model, separators and all.

            A `None` closes the current section: GTK4 draws the rule between
            sections itself, which is what the separator items used to be.
            """
            section = Gio.Menu()
            for action in actions:
                if action is None:
                    if section.get_n_items():
                        model.append_section(None, section)
                        section = Gio.Menu()
                    continue
                children = action.get('children')
                if children:
                    submenu = Gio.Menu()
                    self.fill_menu(submenu, children, group, counter)
                    section.append_submenu(action['label'], submenu)
                elif children is not None or not action.get('command'):
                    section.append(action['label'], self.menu_entry(group, counter))
                else:
                    section.append(action['label'], self.menu_entry(group, counter, action))
            if section.get_n_items():
                model.append_section(None, section)

        def popup(self, widget, windows=False):
            self.dismiss_menu()
            context = dict(self.context)
            group = Gio.SimpleActionGroup()
            counter = [0]
            model = Gio.Menu()
            heading = Gio.Menu()
            heading.append('Choose a window' if windows else
                           (context.get('title') or 'Workspace ' + context.get('workspace', ''))[:65],
                           self.menu_entry(group, counter))
            model.append_section(None, heading)
            # Kept as its own section so the asynchronous answer can replace it
            # in place, where GTK3 held an index into a list of widgets.
            applications = Gio.Menu()
            if not windows and context.get('id'):
                applications.append('Application actions…', self.menu_entry(group, counter))
                model.append_section(None, applications)
            self.fill_menu(model, window_items(self.tree) if windows
                           else menu_items(context, self.tree), group, counter)
            menu = Gtk.PopoverMenu.new_from_model(model)
            menu.add_css_class('decoration-menu')
            menu.set_has_arrow(False)
            menu.set_position(Gtk.PositionType.TOP if self.edge == 'bottom'
                              else Gtk.PositionType.LEFT)
            menu.insert_action_group('menu', group)
            menu.set_parent(widget)
            menu.connect('closed', self.menu_closed)
            self.menu = menu
            if not windows and context.get('id'):
                def discover():
                    try:
                        actions = application_items(context)
                    except Exception as error:
                        print('Application actions unavailable: ' + type(error).__name__, file=sys.stderr)
                        actions = []
                    GLib.idle_add(self.app_menu_ready, menu, applications, group, counter, actions)
                threading.Thread(target=discover, daemon=True).start()
            menu.popup()

        def app_menu_ready(self, menu, section, group, counter, actions):
            if self.disposed or self.menu is not menu:
                return False
            # An empty section draws nothing at all, which is the model's way
            # of hiding the placeholder when an application offers no actions.
            section.remove_all()
            if actions:
                submenu = Gio.Menu()
                self.fill_menu(submenu, actions, group, counter)
                section.append_submenu('Application actions', submenu)
            return False

        def menu_closed(self, menu):
            if self.menu is menu:
                self.menu = None
            # Defer disposal until GTK has finished delivering the activation.
            GLib.idle_add(lambda: (menu.unparent(), False)[1])

        def dismiss_menu(self):
            """Take down an open menu now, without waiting for its idle unparent."""
            menu, self.menu = self.menu, None
            if menu is None:
                return
            menu.popdown()
            menu.unparent()

        def restyle(self, style, square, opacity):
            if (style, square, opacity) == self.previous_style:
                return
            family, size, colors, settings, _theme, window_corner = style
            family = family.replace('\\', '\\\\').replace('"', '\\"')
            if colors['accent'] != self.accent:
                self.accent = colors['accent']
                self.breath_painted = None
            self.palette = colors
            self.powerline = bool(settings['powerline'])
            # Attached along the bottom the strip and its window are one shape:
            # square where they meet, rounded only where the pair ends, and the
            # window's clipped corners filled with the caption's own first-row
            # colour so the join has no seam, no gap and no second edge.
            seam = seam_overlap(self.attachment_mode, self.edge, window_corner)
            top, radius = corner_radii(settings['corner_radius'], square,
                                      bool(seam), window_corner)
            self.fill = components(colors['surface'], min(1, opacity + .16))
            if seam != self.seam:
                self.seam = seam
                self.fillets.set_size_request(-1, seam)
                self.previous_geometry = None
            self.fillets.set_visible(seam > 0)
            self.fillets.queue_draw()
            self.refresh_input()
            # A shadow that reaches up past a squared top edge would draw the
            # join it exists to remove; below and beside the pair it still lands.
            shade = ('0 4px 12px -2px' if seam else '0 3px 12px')
            # Ghost Observatory captions: roomier padding, medium-weight title.
            padding = '3px 9px' if self.edge == 'bottom' else '9px 3px'
            load_css(self.provider, f'''
                #workspace-decoration {{ background: transparent; }}
                #workspace-decoration .caption {{
                    background-image: linear-gradient(to bottom,
                        alpha({colors['surface']}, {min(1, opacity + .16):.3f}),
                        alpha({colors['background']}, {opacity:.3f}));
                    border: none;
                    outline: none;
                    border-radius: {top}px {top}px {radius}px {radius}px;
                    padding: {padding}; min-height: 28px;
                    box-shadow: {shade} alpha({colors['background_hard']}, .55);
                }}
                #workspace-decoration button {{
                    background: transparent; background-image: none;
                    border: none; outline: none; box-shadow: none;
                    border-radius: {min(8, radius)}px; padding: 2px 9px;
                    min-height: 22px; min-width: 16px; transition: background-color 140ms ease;
                }}
                #workspace-decoration button:hover {{ background: alpha({colors['accent']}, .16); }}
                #workspace-decoration button:active {{ background: alpha({colors['accent']}, .28); }}
                #workspace-decoration .brand {{ background: alpha({colors['accent']}, .09); }}
                #workspace-decoration .title-button {{ padding: 1px 14px; }}
                #workspace-decoration label, #workspace-decoration image {{
                    font-family: "{family}"; font-size: {size}pt; font-weight: 500;
                    color: {colors['foreground']}; text-shadow: none;
                }}
                #workspace-decoration .window-state {{
                    font-size: {max(7, size - 1.5)}pt; font-weight: 400; letter-spacing: 1px;
                    color: alpha({colors['foreground']}, .6);
                }}
                #workspace-decoration button:hover label, #workspace-decoration button:hover image {{
                    color: {colors['accent']};
                }}
                .decoration-menu {{ background: transparent; }}
                .decoration-menu > contents {{
                    background: {colors['background']}; color: {colors['foreground']};
                    border: 1px solid alpha({colors['accent']}, .3); border-radius: 12px;
                    padding: 6px; font-family: "{family}"; font-size: {size}pt;
                    box-shadow: 0 4px 16px alpha({colors['background_hard']}, .55);
                }}
                .decoration-menu modelbutton {{
                    padding: 5px 12px; border-radius: 4px; min-height: 0;
                }}
                .decoration-menu modelbutton:hover {{ background: alpha({colors['accent']}, .17); }}
                .decoration-menu modelbutton:disabled {{ color: alpha({colors['foreground']}, .55); }}
                .decoration-menu separator {{ background: alpha({colors['foreground']}, .12); margin: 5px 8px; }}
            '''.replace('#workspace-decoration', '#' + self.css_name))
            self.previous_style = (style, square, opacity)

        def update(self, context, tree, style, placement, output_rect):
            square = placement['square']
            self.context = dict(context, edge=self.edge)
            self.tree = tree
            self.output_rect = dict(output_rect)
            node = context.get('node') or {}
            terminal = terminal_source(node)
            # The strip belongs to the window it decorates, so it is as
            # transparent as that window is: the theme's terminal value for a
            # terminal, opaque for an application that is, and the saved
            # preference when there is no window to belong to.
            opacity = window_opacity(node, terminal is not None,
                                     style[4], style[3]['opacity'])
            parts = window_context.strip_segments(context, self.budget(placement))
            # Only a terminal can be an agent window, and resolving one costs a
            # tmux round trip: skip it outright for every ordinary application,
            # which is most windows most of the time.
            if style[3].get('agent_status', True) and terminal and node.get('id') is not None:
                identity = AGENT_RESOLVER.resolve_all([node]).get(node['id'], {})
                if identity.get('kind') in ('claude', 'codex'):
                    records = agent_status.load_records(
                        RUNTIME / (identity['kind'] + '-events'), time.time())
                    mark = agent_status.glyph(identity, records)
                    if mark:
                        parts = [*parts, ('agent', mark)]
            display_state = (tuple(context.get(key) for key in
                             ('id', 'title', 'app', 'workspace', 'floating', 'fullscreen')),
                             tuple(parts), style, square, opacity,
                             placement['rect']['width'], placement['rect']['height'])
            if display_state == self.previous_display:
                self.place(placement, output_rect)
                return
            self.restyle(style, square, opacity)
            occupied = bool(context.get('id'))
            app = context.get('app', '')
            if app != self.icon_key:
                self.icon_key = app
                icon = None
                try:
                    info = Gio.DesktopAppInfo.new(app if app.endswith('.desktop') else app + '.desktop') if app else None
                    icon = info.get_icon() if info else None
                except (GLib.Error, AttributeError, TypeError):
                    pass
                if icon:
                    self.image.set_from_gicon(icon)
                else:
                    self.image.set_from_icon_name('utilities-terminal-symbolic' if terminal else
                        ('application-x-executable-symbolic' if occupied else 'view-app-grid-symbolic'))
            title = context.get('title') or 'Empty workspace · ' + context.get('workspace', '')
            state = 'FULLSCREEN' if context.get('fullscreen') else ('FLOATING' if context.get('floating') else 'TILED')
            self.state_label.set_text(state if occupied and self.edge == 'bottom' else '')
            self.title_button.set_tooltip_text(title + '\n' + (context.get('app', '') + ' · ' + state if occupied else 'Choose an app to open')
                + '\n\nLeft: choose window · Middle: float/tile\nRight: window actions · Shift+Right: strip appearance')
            self.brand.set_tooltip_text((context.get('app') or 'Workspace') + ' · actions')
            self.tile_button.set_label('▦' if context.get('floating') else '▱')
            self.tile_button.set_tooltip_text('Tile this window' if context.get('floating') else 'Float this window')
            self.tile_button.update_property([Gtk.AccessibleProperty.LABEL],
                                             [self.tile_button.get_tooltip_text()])
            self.full_button.set_label('⤡' if context.get('fullscreen') else '⛶')
            self.full_button.set_tooltip_text('Leave fullscreen' if context.get('fullscreen') else 'Fullscreen')
            self.full_button.update_property([Gtk.AccessibleProperty.LABEL],
                                             [self.full_button.get_tooltip_text()])
            # Set the visible controls and the attachment geometry before the
            # window maps its first buffer. GTK4 widgets are visible as soon as
            # they are added, so only what must be hidden is named here.
            self.empty_controls.set_visible(not occupied and self.edge == 'bottom')
            attached = self.attachment_mode == 'window'
            span = placement['rect']['width' if self.edge == 'bottom' else 'height']
            compact = attached and span < (360 if self.edge == 'bottom' else 240)
            self.tile_button.set_visible(occupied and not compact)
            self.full_button.set_visible(occupied and not compact)
            self.windows_button.set_visible(not compact)
            self.more_button.set_visible(not attached or span >= 120)
            self.title_button.set_visible(not attached or span >= 80)
            self.state_label.set_visible(occupied and self.edge == 'bottom' and (not attached or span >= 520))
            # Size the band now the controls are in their final state, from the
            # reference line rather than whatever the caption happens to say.
            measured = (style[0], style[1], self.edge)
            if measured != self.measured_key:
                self.measured_key = measured
                self.remeasure(style)
            if self.edge == 'right':
                # A column of single characters has no room for segments; it
                # keeps the plain line and its own vertical budget.
                layout = self.label.create_pango_layout('M')
                family, size = style[:2]
                layout.set_font_description(Pango.FontDescription(f'{family} {size}'))
                height = max(1, layout.get_pixel_size()[1])
                span = (placement['rect']['height'] if self.attachment_mode == 'window'
                        else self.monitor.get_geometry().height)
                available = max(1, span - (110 if span < 240 else 260))
                self.shown_parts = list(parts)
                self.label.set_use_markup(False)
                self.label.set_text(vertical_title(
                    window_context.SEPARATOR.join(text for _, text in parts),
                    available // height))
            else:
                self.show_caption(parts)
            self.size_to_content()
            if self.flying and self.attachment_mode != 'window':
                # Re-aimed now the seam and the controls are those of the mode
                # being flown to. begin_flight has to pick a target before any
                # of that is known, and a strip aiming at last mode's thickness
                # would arrive and then jump.
                self.motion_target = self.workspace_extent(output_rect)
            self.place(placement, output_rect)
            self.window.present()
            self.animate()
            self.previous_display = display_state

        def destroy(self):
            if self.disposed:
                return
            self.disposed = True
            retired.discard(self)
            if self.tick_id:
                self.window.remove_tick_callback(self.tick_id)
                self.tick_id = 0
            self.dismiss_menu()
            Gtk.StyleContext.remove_provider_for_display(display, self.provider)
            Gtk.StyleContext.remove_provider_for_display(display, self.breath_provider)
            self.window.destroy()

        def handoff(self, placement):
            # Reuse the expensive GTK controls, the CSS and the native surface.
            #
            # GTK3 unmapped and unrealized here so the next present allocated a
            # fresh surface rather than showing the old width at the new
            # margins for a frame. Under GTK4 that trade is the wrong way
            # round: gtk4-layer-shell has no resize(), so a size only lands on
            # the next frame while a margin commits at once, and a surface
            # created without a stated extent is given the compositor's guess
            # -- a two hundred pixel square -- until its first frame arrives.
            # Renewing the surface therefore replaces one frame of a slightly
            # wrong width with one frame of a large opaque square. Keeping it
            # is the smaller artefact.
            if self.tick_id:
                self.window.remove_tick_callback(self.tick_id)
                self.tick_id = 0
            self.dismiss_menu()
            self.previous_display = None
            self.previous_geometry = None
            self.rendered_size = None
            self.input_shape = None
            self.content_size = None
            self.motion_rect = None
            self.motion_target = None
            self.motion_velocity = {key: 0.0 for key in ('x', 'y', 'width', 'height')}
            self.frame_time = None
            self.alpha, self.alpha_velocity = 1.0, 0.0
            self.window.set_opacity(1.0)
            return self

    class Reservation:
        """The band itself: an invisible surface whose only job is to hold space.

        It draws nothing, takes no input and never moves. Everything about the
        caption changes as the pointer travels — which window it belongs to,
        which edge it uses, how tall its text is — and none of that may reach
        the compositor's idea of the usable area, or the windows above resize
        and terminals re-flow their text under the pointer. So the reservation
        lives here instead, where nothing can disturb it.
        """

        def __init__(self, monitor, edge, thickness):
            self.monitor, self.edge, self.thickness = monitor, edge, 0
            self.window = Gtk.Window()
            self.window.set_decorated(False)
            self.window.set_name('workspace-decoration-band')
            self.window.set_can_focus(False)
            Gtk4LayerShell.init_for_window(self.window)
            Gtk4LayerShell.set_namespace(self.window, 'oldbook-decoration-band')
            Gtk4LayerShell.set_monitor(self.window, monitor)
            # Behind everything: it must never cover a window, only keep one out.
            Gtk4LayerShell.set_layer(self.window, Gtk4LayerShell.Layer.BACKGROUND)
            Gtk4LayerShell.set_keyboard_mode(self.window, Gtk4LayerShell.KeyboardMode.NONE)
            for name in decoration_reserve.band_anchors(edge):
                Gtk4LayerShell.set_anchor(self.window, getattr(Gtk4LayerShell.Edge, name), True)
            # GTK4 refuses to map a toplevel whose natural size is zero, and a
            # window holding no widgets at all has exactly that. One pixel in
            # each direction is enough to exist; the anchors stretch it along
            # the edge and the exclusive zone, not the surface, does the
            # reserving.
            # The reservation has to draw, even though it draws nothing. Its
            # background is transparent and it holds no widgets, so GTK4 finds
            # no content, never commits a sized buffer, and the layer surface
            # keeps whatever the compositor guessed for it -- with the
            # exclusive zone below never applied, which is the surface's whole
            # job. A drawing area with an empty draw function produces the
            # frame without putting a pixel on the screen. GTK3 painted the
            # toolkit's own background here and never had to be asked.
            area = Gtk.DrawingArea()
            area.set_draw_func(lambda widget, context, width, height: None)
            self.window.set_child(area)
            # An empty toplevel measures zero, and a layer surface that asks
            # for nothing is given an arbitrary default two hundred tall.
            self.window.set_size_request(1, 1)
            self.window.set_default_size(1, 1)
            # A window with no widgets still paints the toolkit's own background,
            # which on the screen's last row is a bright line across the desktop.
            # The band is a reservation, and a reservation is not a thing to see.
            self.provider = Gtk.CssProvider()
            load_css(self.provider,
                     '#workspace-decoration-band { background: transparent; border: none; }')
            Gtk.StyleContext.add_provider_for_display(
                display, self.provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)
            self.window.connect('realize', self.untouchable)
            self.set_thickness(thickness)
            self.window.present()

        def untouchable(self, _widget):
            """A one-pixel line at the screen edge is exactly where a person
            aims; an empty input region keeps their click on the window."""
            surface = self.window.get_surface()
            if surface is None:
                return
            try:
                import cairo
                surface.set_input_region(cairo.Region())
            except (ImportError, AttributeError, TypeError):
                pass

        def set_thickness(self, thickness):
            if thickness == self.thickness:
                return False
            self.thickness = thickness
            Gtk4LayerShell.set_exclusive_zone(self.window, thickness)
            return True

        def destroy(self):
            Gtk.StyleContext.remove_provider_for_display(display, self.provider)
            self.window.destroy()

    captions = {}
    bands = {}
    # The thickness each edge needs, remembered per edge rather than taken from
    # whatever caption exists now: fullscreen borrows the bottom while the band
    # stays on the saved edge, and a bottom caption's height is no measurement
    # of a vertical strip's width.
    measures = {}
    retired = set()
    # One breath for every caption on every output, polled in one place.
    air_watch = air.AirWatcher()
    breath_state = {'target': air.CAPTION_LOW, 'interval': 400,
                    'allow': air.read_preferences().get('caption', True)}
    last_tree = {}
    # Floating windows found inside the reservation: what each was last seen
    # doing, when it stopped changing, and when it was last put back.
    intruders = {}
    stop = threading.Event()
    style = appearance()
    pending_lock = threading.Lock()
    pending_tree = None
    tree_idle = False

    def deliver_tree(tree):
        nonlocal pending_tree, tree_idle
        with pending_lock:
            if stop.is_set():
                return
            pending_tree = tree
            if not tree_idle:
                tree_idle = True
                queue_geometry_update(apply_pending_tree)

    def apply_pending_tree():
        nonlocal pending_tree, tree_idle
        with pending_lock:
            tree, pending_tree = pending_tree, None
            tree_idle = False
        return apply(tree)

    def apply(tree):
        nonlocal last_tree
        if stop.is_set():
            return False
        if tree is not None:
            last_tree = tree
        contexts = output_contexts(last_tree)
        placements = output_placements(last_tree, style[3]['position'])
        watcher.set_attached(any(item['mode'] == 'window' for item in placements.values()))
        output_rects = {node['name']: node['rect'] for node in last_tree.get('nodes', [])
                        if node.get('type') == 'output' and 'rect' in node}
        monitors = {monitor.get_connector(): monitor
                    for monitor in display.get_monitors() if monitor.get_connector()}
        for name in list(captions):
            placement = placements.get(name)
            caption = captions[name]
            if (name in monitors and placement is not None
                    and caption.monitor == monitors[name]
                    and caption.edge == placement['edge']
                    and caption.attachment_mode != placement['mode']):
                # Attaching and detaching are the same strip in two places, so
                # it travels between them rather than being replaced. Only a
                # mode change on the same edge and output can be flown; an edge
                # or output change is a different strip in a different place.
                caption.begin_flight(placement, output_rects.get(name, {}))
                continue
            if (name not in monitors or placement is None or caption.edge != placement['edge']
                    or caption.attachment_mode != placement['mode']
                    or caption.monitor != monitors[name]):
                previous = captions.pop(name)
                for old in tuple(retired):
                    if old.monitor == previous.monitor:
                        old.destroy()
                previous.retire()
        for name, monitor in monitors.items():
            placement = placements.get(name)
            if placement is None:
                continue
            caption = captions.get(name)
            if (caption is not None and placement['mode'] == 'window'
                    and caption.context.get('id') != placement['window_id']):
                # A hover handoff needs the new position and buffer size in its
                # first frame. Reusing GTK's mapped surface briefly displays
                # the old width after its layer margins move. Renew the native
                # surface while keeping its prepared controls and stylesheet.
                captions[name] = caption.handoff(placement)
            if name not in captions:
                # Every caption built here is genuinely new -- a fresh output,
                # or an edge change -- and fades in. A mode change no longer
                # reaches this point: that strip already exists and is flying.
                captions[name] = Caption(monitor, placement)
        # The band is settled before the captions draw, so a new caption's first
        # frame already sits inside it, and again afterwards in case an
        # appearance change made the caption a different size.
        settle_bands(placements, monitors, output_rects)
        for name, monitor in monitors.items():
            placement = placements.get(name)
            if placement is None or name not in captions:
                continue
            captions[name].update(contexts.get(name, {'id': None, 'workspace': '', 'node': {}}),
                                  last_tree, style, placement, output_rects[name])
        settle_bands(placements, monitors, output_rects)
        guard_band(last_tree, output_rects)
        return False

    def guard_band(tree, output_rects):
        """Put settled floating windows back out of the band's reservation.

        The exclusive zone is the whole of the compositor's answer and it only
        arranges tiled windows. Nothing in Sway clamps a floating move, and a
        bottom reservation changes the workspace's height without moving its
        origin, which is the one case `arrange_workspace` does not re-fix
        floating coordinates for -- so a float already sitting there when the
        band appears is left on top of it with nothing to put it back.

        A correction waits for the window to hold still: a drag emits no events
        and is followed by polling, and correcting mid-drag would fight the
        pointer at frame rate. Waiting for the rectangle to settle turns that
        into one quiet move after the button comes up, and the repeat guard
        keeps an application that re-asserts its own position from turning into
        a loop.
        """
        # Only where a reservation actually exists, and only as thick as that
        # one is: an output with no band on it is holding nothing back, and a
        # window sitting there is not in anybody's way.
        edge = style[3]['position']
        regions = {name: decoration_reserve.band_region(
                       output_rects[name], edge, band.thickness)
                   for name, band in bands.items()
                   if name in output_rects and band.edge == edge}
        if not regions:
            intruders.clear()
            return
        now = time.monotonic()
        commands = []
        found = set()
        for item in band_corrections(tree, regions, edge):
            identity = item['id']
            found.add(identity)
            rect = tuple(item['rect'][key] for key in ('x', 'y', 'width', 'height'))
            seen, settled, corrected = intruders.get(identity, (None, now, 0.0))
            if seen != rect:
                intruders[identity] = (rect, now, corrected)
                continue
            if now - settled < BAND_SETTLE or now - corrected < BAND_REPEAT:
                continue
            intruders[identity] = (rect, settled, now)
            commands.append('[con_id={}] move absolute position {} px {} px'.format(
                identity, *item['position']))
        for identity in [key for key in intruders if key not in found]:
            intruders.pop(identity, None)
        if commands and power_source.allows('decoration-band-guard'):
            launch(['swaymsg', '-q', '; '.join(commands)])

    # One wave per output at a time. A second strike while the first is still
    # crossing would photograph the first and refract a refraction.
    ripples = {}
    # Photographs taken on the strip's final approach or departure, one per
    # output, waiting for the event that will show them.
    approaches = {}

    def output_name(caption):
        return caption.monitor.get_connector() if caption.monitor is not None else None

    def abandon_strike(caption):
        """Forget a photograph whose flight was abandoned or retargeted."""
        approaches.pop(output_name(caption), None)

    def prepare_strike(caption, rect=None):
        """Photograph the band at departure or on the final approach.

        The wave has to begin on the frame the strip arrives, and `grim` takes
        tens of milliseconds even for the band alone, so the picture is taken
        on the final approach -- the target has been known since the flight
        began -- and held until strike() asks for it. The strip is within a
        few pixels of home when the shutter goes; the wave leaves the outline a
        little way out (ripple.SHORE), so those pixels are never in the water.
        An explicit rectangle is the dock being left: capture starts before
        changing its geometry and strike() dates the wave from that departure.
        """
        output_rect = caption.output_rect
        name = output_name(caption)
        if rect is None:
            rect = caption.motion_target
        if (not output_rect or not name or rect is None or name in ripples
                or name in approaches or not ripple.allowed(animations=caption.animations)):
            return
        # Layer-shell margins are measured from the output, so everything here
        # is in the output's own coordinates rather than the compositor's.
        local = {'x': 0, 'y': 0, 'width': output_rect.get('width', 0),
                 'height': output_rect.get('height', 0)}
        area = ripple.region(local, caption.edge)
        # The wave's shape is read from decoration.json at every strike, so a
        # change there is heard by the next landing rather than the next daemon.
        settings = load_settings(SETTINGS, STATE / 'position')
        if not settings['ripple']['enabled']:
            return
        plan = ripple.plan({key: rect[key] for key in ('x', 'y', 'width', 'height')},
                           area, caption.edge, settings['ripple'], settings['corner_radius'])
        monitor = caption.monitor
        photograph = STATE / ('ripple-' + re.sub(r'[^A-Za-z0-9_-]', '_', name) + '.ppm')
        approach = {'ready': None, 'landed': None}
        approaches[name] = approach

        def release():
            ripples.pop(name, None)
            return False

        def present():
            """Show the wave, now that the picture and the contact are both here.

            The wave is dated from the contact, not from this call, so a
            picture that arrives a frame or two after the strike shows the
            rings where they already are. Past the budget it would appear
            mid-band from nothing and read as lag rather than as an impact,
            so the picture is dropped and nothing is shown at all.
            """
            approaches.pop(name, None)
            pixels, size = approach['ready']
            if time.monotonic() - approach['landed'] > STRIKE_BUDGET:
                return
            ripples[name] = True
            try:
                ripple.Ripple(monitor, area, plan, pixels, size,
                              on_done=release).start(started=approach['landed'])
            except Exception as error:
                print('ripple: ' + type(error).__name__ + ': ' + str(error), file=sys.stderr)
                release()

        approach['present'] = present

        def taken(pixels, size):
            # A flight retargeted or abandoned since the shutter went has
            # already forgotten this approach, and its picture with it.
            if stop.is_set() or approaches.get(name) is not approach:
                return False
            approach['ready'] = (pixels, size)
            if approach['landed'] is not None:
                present()
            return False

        def failed():
            if approaches.get(name) is approach:
                approaches.pop(name, None)
            return False

        def photograph_output():
            try:
                # area is in the output's own logical coordinates; grim's -g
                # wants the compositor's global ones, the same space
                # output_rect's own x/y are already in. Capturing exactly this
                # rectangle -- rather than the whole panel, cropped down after
                # -- is what actually cost the delay: measured live, capturing
                # the whole panel took roughly 150ms of a 165ms gap between
                # landing and the first visible frame; capturing just this
                # region measured at 67ms.
                geometry = ripple.geometry_string(
                    output_rect.get('x', 0) + area['x'], output_rect.get('y', 0) + area['y'],
                    area['width'], area['height'])
                ripple.capture(photograph, geometry=geometry)
                data = photograph.read_bytes()
                width, height, offset = ripple.parse_ppm(data)
                # grim already cropped to exactly this rectangle at the
                # output's own scale, so what it captured *is* the region:
                # crop() only still needs to reconcile grim's physical pixels
                # against area's logical size, from a zero origin.
                scale = monitor.get_scale_factor() if monitor is not None else 1
                local_area = {'x': 0, 'y': 0, 'width': area['width'], 'height': area['height']}
                pixels, span, thickness = ripple.crop(data, offset, width, height, local_area, scale)
            except Exception as error:
                print('ripple capture: ' + type(error).__name__, file=sys.stderr)
                GLib.idle_add(failed)
                return
            finally:
                photograph.unlink(missing_ok=True)
            GLib.idle_add(taken, pixels, (span, thickness))

        threading.Thread(target=photograph_output, daemon=True).start()

    def strike(caption):
        """Answer the strip's contact with the band with the wave prepared on
        the approach.

        Called on the frame the strip first reaches home, while the rebound is
        still to come. Nothing is photographed here. By now the picture is in
        hand, about to arrive, or was never taken because the flight was too
        short or the ripple is off; whatever arrives later than the budget is
        not shown.
        """
        approach = approaches.get(output_name(caption))
        if approach is None:
            return
        if approach['landed'] is None:
            approach['landed'] = time.monotonic()
        if approach['ready'] is not None:
            approach['present']()

    def usable_areas(tree):
        """What each output has left after every exclusive zone on it.

        Sway's visible workspace rectangle is that answer already, which is
        better than adding the reservations up here and disagreeing with the
        compositor about them.
        """
        areas = {}
        for output in tree.get('nodes', []):
            name = output.get('name', '')
            if output.get('type') != 'output' or not name or name.startswith('__'):
                continue
            workspace = focused_child(output)
            if workspace and isinstance(workspace.get('rect'), dict):
                areas[name] = workspace['rect']
        return areas

    def settle_bands(placements, monitors, output_rects=None):
        """One reservation per output, held whatever the captions are doing.

        A caption is the authority on the edge it is drawn along and on no
        other. Sizing the band from whichever caption happens to exist made
        entering fullscreen with a right-edge strip re-measure the right band
        from a bottom caption and quietly resize the windows beside it, which
        is the same bug in a different disguise.
        """
        for caption in captions.values():
            measures[caption.edge] = caption.measured
        edge = style[3]['position']
        thickness = decoration_reserve.band_measurement(measures, edge)
        plan = decoration_reserve.band_plan(placements, edge, thickness,
                                            style[3]['reserve_band'])
        for name in list(bands):
            wanted = plan.get(name)
            if (name not in monitors or wanted is None or bands[name].edge != wanted['edge']
                    or bands[name].monitor != monitors[name]):
                bands.pop(name).destroy()
        for name, wanted in plan.items():
            if name not in monitors:
                continue
            if name in bands:
                bands[name].set_thickness(wanted['thickness'])
            else:
                bands[name] = Reservation(monitors[name], wanted['edge'], wanted['thickness'])
        areas = usable_areas(last_tree)
        output_rects = output_rects or {}
        for name, caption in captions.items():
            band = bands.get(name)
            caption.set_band(band.thickness if band else 0,
                             bool(band and band.edge == caption.edge),
                             output_rects.get(name), areas.get(name))

    def refresh_appearance():
        nonlocal style
        style = appearance()
        apply(None)
        return True

    def follow_breath():
        """Track the keyboard's air; only the keystroke breath moves the caption."""
        reading = air_watch.poll() if breath_state['allow'] else None
        target = air.caption_alpha(reading)
        if target != breath_state['target']:
            breath_state['target'] = target
            for caption in tuple(captions.values()) + tuple(retired):
                caption.animate()
        interval = 50 if reading is not None else 400
        if interval != breath_state['interval']:
            breath_state['interval'] = interval
            GLib.timeout_add(interval, follow_breath)
            return False
        return True

    def refresh_breath_preference():
        breath_state['allow'] = air.read_preferences().get('caption', True)
        return True

    def quit_daemon():
        stop.set()
        loop.quit()
        return False

    watcher = TreeWatch(os.environ.get('SWAYSOCK', ''), deliver_tree)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, quit_daemon)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, quit_daemon)
    GLib.timeout_add(750, refresh_appearance)
    GLib.timeout_add(breath_state['interval'], follow_breath)
    GLib.timeout_add_seconds(5, refresh_breath_preference)
    watcher.start()
    from ui_priority import request_priority
    request_priority()
    # GTK4 compiles its renderer's shaders the first time anything is actually
    # drawn. Left alone that lands on the first caption the pointer asks for,
    # and the strip sits still through the move that requested it. Rendering
    # synthetic pixels offscreen pays for the pipeline up front, exactly as the
    # carousel does; the keeper holds the device open for the session.
    graphics_primer = None
    try:
        from graphics_warmup import warm_graphics
        graphics_primer = warm_graphics()
    except Exception as error:
        print('decoration graphics warmup:', error, file=sys.stderr)
    # The wave has its own first-use cost -- the GL context an area needs and
    # the program it runs -- and its whole job is to answer a landing on the
    # next frame. It is paid offscreen rather than by the first strip to dock,
    # but not during start-up. An idle at login is not idle: the pointer is
    # already moving, the first captions are being placed, and half a second
    # spent building a graphics context there is half a second in which the
    # strip does not answer. It is paid once the session has settled instead,
    # which is long before anything is dragged out of a window, and a landing
    # inside the first few seconds simply pays for itself.
    ripple_primer = {}

    def warm_ripple():
        try:
            ripple_primer['keeper'] = ripple.warm()
        except Exception as error:
            print('decoration ripple warmup:', error, file=sys.stderr)
        return False

    GLib.timeout_add_seconds(6, warm_ripple)
    # Realization and the first draw create driver worker pools that did not
    # exist at Gtk.init(). Promote those threads after warming too.
    request_priority()
    try:
        loop.run()
    finally:
        stop.set()
        watcher.close()
        for caption in captions.values():
            caption.destroy()
        for caption in tuple(retired):
            caption.destroy()
        for band in bands.values():
            band.destroy()
        if graphics_primer is not None:
            graphics_primer.close()
        if ripple_primer.get('keeper') is not None:
            ripple_primer['keeper'].close()
        guard.close()
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('mode', choices=('daemon', 'bottom', 'right', 'toggle', 'status',
                                         'settings'))
    args = parser.parse_args()
    if args.mode == 'daemon':
        return daemon()
    if args.mode == 'status':
        print(position())
    elif args.mode == 'settings':
        if not launch(action_command(3, shifted=True)):
            print('Decoration settings are unavailable.', file=sys.stderr)
            return 1
    else:
        value = args.mode if args.mode != 'toggle' else ('right' if position() == 'bottom' else 'bottom')
        set_position(value)
        print('Workspace decoration: ' + value)
    return 0


if __name__ == '__main__':
    sys.exit(main())
