#!/usr/bin/env python3
"""Emit content-free attention events for attributable AI notifications."""
import json
from urllib.parse import urlsplit

import dbus
import dbus.lowlevel
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib


NATIVE_NAMES = {
    'codex': 'codex',
    'claude': 'claude',
    'chatgpt': 'chatgpt',
}
DESKTOP_ENTRIES = {
    'codex': 'codex',
    'oldbook-codex': 'codex',
    'com.openai.codex': 'codex',
    'claude': 'claude',
    'com.anthropic.claude': 'claude',
    'chatgpt': 'chatgpt',
    'com.openai.chatgpt': 'chatgpt',
}
BROWSERS = {
    'firefox',
    'mozilla firefox',
    'chromium',
    'google chrome',
    'brave',
    'brave browser',
}
BROWSER_DESKTOP_ENTRIES = {
    'firefox',
    'org.mozilla.firefox',
    'chromium',
    'google-chrome',
    'com.google.chrome',
    'brave-browser',
    'com.brave.browser',
}
ORIGINS = {
    'chatgpt.com': 'chatgpt',
    'chat.openai.com': 'chatgpt',
    'claude.ai': 'claude',
}


def _identity(value):
    if not isinstance(value, (str, dbus.String)):
        return ''
    value = str(value).strip().casefold()
    return value[:-8] if value.endswith('.desktop') else value


def _origin_source(value):
    if not isinstance(value, (str, dbus.String)):
        return None
    value = str(value)
    if value != value.strip() or any(ord(character) < 32 for character in value):
        return None
    if '://' not in value:
        return ORIGINS.get(value.casefold().removesuffix('/'))
    try:
        parsed = urlsplit(value)
        if parsed.port not in (None, 443):
            return None
    except ValueError:
        return None
    if (parsed.scheme.casefold() != 'https' or parsed.username is not None
            or parsed.password is not None or parsed.path not in ('', '/')
            or parsed.query or parsed.fragment):
        return None
    return ORIGINS.get((parsed.hostname or '').casefold())


def source_for(app_name, hints):
    app = _identity(app_name)
    if app in NATIVE_NAMES:
        return NATIVE_NAMES[app]
    if not isinstance(hints, dict):
        return None
    desktop = _identity(hints.get('desktop-entry'))
    if desktop in DESKTOP_ENTRIES:
        return DESKTOP_ENTRIES[desktop]
    if app not in BROWSERS and desktop not in BROWSER_DESKTOP_ENTRIES:
        return None
    # The FDO protocol has no general web-origin field. Chromium supplies this
    # vendor hint only when the notification server advertises its capability;
    # never substitute a notification title or body when the hint is absent.
    return _origin_source(hints.get('x-kde-origin-name'))


def _observe(_connection, message):
    if (message.get_type() != dbus.lowlevel.MESSAGE_TYPE_METHOD_CALL
            or message.get_path() != '/org/freedesktop/Notifications'
            or message.get_interface() != 'org.freedesktop.Notifications'
            or message.get_member() != 'Notify'
            or str(message.get_signature()) != 'susssasa{sv}i'):
        return
    try:
        arguments = message.get_args_list()
        source = source_for(arguments[0], arguments[6])
    except (IndexError, TypeError, ValueError):
        return
    if source:
        print(json.dumps({'attention': True, 'source': source}, separators=(',', ':')),
              flush=True)


def _monitor(bus, rule):
    try:
        bus.call_blocking(
            'org.freedesktop.DBus',
            '/org/freedesktop/DBus',
            'org.freedesktop.DBus.Monitoring',
            'BecomeMonitor',
            'asu',
            ([rule], dbus.UInt32(0)),
            timeout=3,
        )
    except dbus.DBusException:
        bus.add_match_string(rule + ",eavesdrop='true'")
    return None


def main():
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus(private=True)
    bus.add_message_filter(_observe)
    rule = ("type='method_call',path='/org/freedesktop/Notifications',"
            "interface='org.freedesktop.Notifications',member='Notify'")
    _monitor(bus, rule)
    GLib.MainLoop().run()


if __name__ == '__main__':
    main()
