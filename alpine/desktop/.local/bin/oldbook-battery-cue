#!/usr/bin/env python3
"""Sound one cue as the battery falls past a threshold, and not once more.

Waybar already colours the battery module amber at 25 percent and red at 10, but
a panel module cannot run anything when it changes. This watches the same two
numbers and plays the low-battery cue exactly once per crossing: quiet while the
charge drifts down inside a band, silent again while charging, and armed afresh
once the battery climbs back above the warning.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import time

BIN = Path(__file__).resolve().parent
POWER = Path(os.environ.get('OLDBOOK_BATTERY_ROOT', '/sys/class/power_supply'))
WARNING = 25
CRITICAL = 10
REARM = 30
INTERVAL = 60


def state_path():
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not runtime:
        raise RuntimeError('XDG_RUNTIME_DIR is required')
    directory = Path(runtime) / 'oldbook'
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    return directory / 'battery-cue.json'


def batteries():
    if not POWER.is_dir():
        return []
    found = []
    for entry in sorted(POWER.iterdir()):
        try:
            if (entry / 'type').read_text().strip() != 'Battery':
                continue
            found.append((int((entry / 'capacity').read_text().strip()),
                          (entry / 'status').read_text().strip()))
        except (OSError, ValueError):
            continue
    return found


def reading():
    """The whole machine's charge: the lowest cell, and whether any is charging."""
    found = batteries()
    if not found:
        return None
    capacity = min(capacity for capacity, _ in found)
    charging = any(status in ('Charging', 'Full') for _, status in found)
    return {'capacity': capacity, 'charging': charging}


def band(capacity):
    if capacity <= CRITICAL:
        return 'critical'
    if capacity <= WARNING:
        return 'warning'
    return 'ok'


def read_state(path):
    try:
        document = json.loads(path.read_text())
    except (OSError, ValueError):
        return {'armed': True, 'band': 'ok'}
    return {'armed': bool(document.get('armed', True)),
            'band': document.get('band', 'ok')}


def write_state(path, state):
    temporary = path.with_name(path.name + f'.{os.getpid()}.tmp')
    temporary.write_text(json.dumps(state) + '\n')
    temporary.replace(path)


def decide(previous, current):
    """Return the new state and whether a cue is due."""
    if current['charging'] or current['capacity'] >= REARM:
        return {'armed': True, 'band': band(current['capacity'])}, False
    now = band(current['capacity'])
    order = ('ok', 'warning', 'critical')
    fell = order.index(now) > order.index(previous.get('band', 'ok'))
    due = fell and now != 'ok' and previous.get('armed', True)
    # Staying inside a band is quiet; the next band down speaks again.
    return {'armed': True, 'band': now}, due


def check(once=True):
    path = state_path()
    current = reading()
    if current is None:
        return False
    previous = read_state(path)
    state, due = decide(previous, current)
    write_state(path, state)
    if due:
        subprocess.run([str(BIN / 'oldbook-sound'), 'low-battery'],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=5, check=False)
    return due


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--once', action='store_true', help='check a single time and exit')
    parser.add_argument('--interval', type=float, default=INTERVAL)
    parser.add_argument('--status', action='store_true')
    arguments = parser.parse_args(argv)
    if arguments.status:
        print(json.dumps({'reading': reading(), 'state': read_state(state_path())}, indent=2))
        return 0
    if arguments.once:
        print('cue' if check() else 'quiet')
        return 0
    while True:
        try:
            check()
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
        time.sleep(max(5.0, arguments.interval))


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
    except RuntimeError as error:
        print(f'oldbook-battery-cue: {error}', file=sys.stderr)
        sys.exit(1)
