#!/usr/bin/env python3
"""Flash Caps Lock LEDs while attributable AI windows await a visit."""
import fcntl
import json
import os
from pathlib import Path
import re
import selectors
import signal
import socket
import stat
import struct
import subprocess
import sys
import time

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from mbp_intel.app_identity import ApplicationResolver
from mbp_intel.workspace_model import all_views


HEADER = struct.Struct('=6sII')
SWAY_GET_TREE = 4
SWAY_SUBSCRIBE = 2
SWAY_WINDOW_EVENT = (1 << 31) | 3
PANE_PATTERN = re.compile(r'%[0-9]+')
TTY_PATTERN = re.compile(r'/dev/(?:pts/[0-9]+|tty[0-9]+)')


class CapsLeds:
    def __init__(self, root):
        self.root = root
        self.ready = set()
        self.warned = set()

    def sync(self, enabled):
        nodes = set(self.root.glob('*:capslock'))
        self.ready.intersection_update(nodes)
        self.warned.intersection_update(nodes)
        for node in nodes:
            try:
                brightness = node / 'brightness'
                if node not in self.ready:
                    brightness.write_text('0\n')
                    self.ready.add(node)
                desired = (node / 'max_brightness').read_text().strip() if enabled else '0'
                if brightness.read_text().strip() != desired:
                    brightness.write_text(desired + '\n')
                self.warned.discard(node)
            except OSError as error:
                if node not in self.warned:
                    print(f'mbp-intel-notification-led: {node.name}: {error.strerror}', file=sys.stderr)
                    self.warned.add(node)


def attention_event(line):
    event = json.loads(line)
    if (not isinstance(event, dict) or event.get('attention') is not True
            or event.get('source') not in ('codex', 'claude', 'chatgpt')):
        return None
    return event['source']


def control_center_state(line):
    event = json.loads(line)
    visible = event.get('visible') if isinstance(event, dict) else None
    return visible if type(visible) is bool else None


class AttentionFlash:
    """Alternate at one hertz without resetting while any alert is pending."""
    def __init__(self):
        self.started = None

    def reconcile(self, pending, now):
        if pending and self.started is None:
            self.started = now
        elif not pending:
            self.started = None

    def enabled(self, now):
        return (self.started is not None
                and int((now - self.started) / 0.5) % 2 == 0)


class PendingWindows:
    """Track exact target windows and provider-level fallback alerts."""
    def __init__(self):
        self.windows = {}
        self.fallback = {}

    @property
    def pending(self):
        return bool(self.windows or self.fallback)

    @staticmethod
    def _candidates(source, applications):
        return {identifier: app for identifier, app in applications.items()
                if app.get('kind') == source}

    @staticmethod
    def _route_target(candidates, route):
        if not isinstance(route, dict):
            return None
        tty = route.get('tty')
        pane = route.get('tmux_pane')
        if tty:
            return next((identifier for identifier, app in candidates.items()
                         if app.get('tty') == tty), None)
        if pane:
            return next((identifier for identifier, app in candidates.items()
                         if app.get('tmux_pane') == pane), None)
        return None

    def add(self, source, applications, route=None):
        candidates = self._candidates(source, applications)
        target = self._route_target(candidates, route) if source == 'codex' else None
        if target is not None:
            if applications[target].get('focused'):
                self.windows.pop(target, None)
            else:
                self.windows[target] = source
            return
        if candidates:
            self.fallback.pop(source, None)
            for identifier, app in candidates.items():
                if app.get('focused'):
                    self.windows.pop(identifier, None)
                else:
                    self.windows[identifier] = source
            return
        self.fallback[source] = False

    def reconcile(self, applications):
        live = set(applications)
        self.windows = {identifier: source for identifier, source in self.windows.items()
                        if identifier in live}
        for source in list(self.fallback):
            candidates = self._candidates(source, applications)
            if candidates:
                self.fallback.pop(source, None)
                for identifier, app in candidates.items():
                    if not app.get('focused'):
                        self.windows[identifier] = source
        for identifier, app in applications.items():
            if not app.get('focused'):
                continue
            self.windows.pop(identifier, None)
            self.fallback.pop(app.get('kind'), None)

    def acknowledge_fallback(self):
        self.fallback.clear()

    def clear(self):
        self.windows.clear()
        self.fallback.clear()


def _read_exact(connection, size):
    chunks = bytearray()
    while len(chunks) < size:
        chunk = connection.recv(size - len(chunks))
        if not chunk:
            raise ConnectionError('Sway disconnected')
        chunks.extend(chunk)
    return bytes(chunks)


def receive_sway(connection):
    magic, length, kind = HEADER.unpack(_read_exact(connection, HEADER.size))
    if magic != b'i3-ipc' or length > 32 * 1024 * 1024:
        raise ValueError('invalid Sway IPC frame')
    return kind, json.loads(_read_exact(connection, length))


def send_sway(connection, kind, payload=''):
    body = payload.encode()
    connection.sendall(HEADER.pack(b'i3-ipc', len(body), kind) + body)


def request_tree(path):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(3)
        connection.connect(str(path))
        send_sway(connection, SWAY_GET_TREE)
        kind, tree = receive_sway(connection)
        if kind != SWAY_GET_TREE or not isinstance(tree, dict):
            raise ValueError('unexpected Sway tree response')
        return tree


def subscribe_sway(path):
    connection = socket.socket(socket.AF_UNIX)
    connection.settimeout(3)
    try:
        connection.connect(str(path))
        send_sway(connection, SWAY_SUBSCRIBE, '["window"]')
        kind, result = receive_sway(connection)
        if (kind != SWAY_SUBSCRIBE or not isinstance(result, dict)
                or result.get('success') is not True):
            raise ValueError('Sway rejected window subscription')
        connection.settimeout(None)
        return connection
    except Exception:
        connection.close()
        raise


def application_snapshot(tree, resolver):
    windows = all_views(tree)
    applications = resolver.resolve_all(windows)
    for window in windows:
        identity = applications.get(window.get('id'))
        if identity is not None:
            identity['focused'] = window.get('focused') is True
    return applications


def relevant_window_event(event):
    return (isinstance(event, dict)
            and event.get('change') in ('focus', 'close', 'new'))


def latest_codex_route(runtime, now=None):
    now = time.time() if now is None else now
    candidates = []
    for path in (runtime / 'mbp-intel/codex-events').glob('*.json'):
        try:
            info = path.stat(follow_symlinks=False)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
                continue
            event = json.loads(path.read_text())
            observed = event.get('observed_at')
            expires = event.get('valid_until')
            tty = event.get('tty')
            pane = event.get('tmux_pane')
            if (event.get('version') != 1
                    or event.get('event') not in ('turn-complete', 'approval-requested')
                    or type(observed) is not int or type(expires) is not int
                    or not now - 5 <= observed <= now + 2 or not now < expires
                    or (tty is not None
                        and (not isinstance(tty, str) or not TTY_PATTERN.fullmatch(tty)))
                    or (pane is not None
                        and (not isinstance(pane, str) or not PANE_PATTERN.fullmatch(pane)))):
                continue
            candidates.append((observed, info.st_mtime_ns,
                               {'tty': tty, 'tmux_pane': pane}))
        except (OSError, ValueError, AttributeError):
            continue
    return max(candidates, key=lambda item: item[:2],
               default=(None, None, None))[2]


def stop_subscriber(proc):
    proc.terminate()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
    proc.stdout.close()


def run(runtime, led_root, command, session_socket, sway_socket=None,
        control_command=None, resolver=None):
    info = runtime.stat()
    if not runtime.is_dir() or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError('XDG_RUNTIME_DIR must be an owned private directory')
    fd = os.open(runtime / 'mbp-intel-notification-led.lock',
                 os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        lock.truncate(0)
        lock.write(str(os.getpid()) + '\n')
        lock.flush()
        lights = CapsLeds(led_root)
        running = True

        def stop(_signum, _frame):
            nonlocal running
            running = False

        previous = {sig: signal.signal(sig, stop) for sig in (signal.SIGINT, signal.SIGTERM)}
        state = PendingWindows()
        flash = AttentionFlash()
        commands = {'attention': command}
        if control_command is not None:
            commands['control'] = control_command
        processes = {name: None for name in commands}
        buffers = {name: b'' for name in commands}
        retries = {name: 0 for name in commands}
        sway = None
        resolver = resolver or ApplicationResolver()
        center_visible = False

        def snapshot():
            if sway_socket is None:
                return {}
            applications = application_snapshot(request_tree(sway_socket), resolver)
            state.reconcile(applications)
            return applications

        try:
            lights.sync(False)
            with selectors.DefaultSelector() as selector, socket.socket(socket.AF_UNIX) as session:
                session.connect(str(session_socket))
                selector.register(session, selectors.EVENT_READ, 'session')
                if sway_socket is not None:
                    sway = subscribe_sway(sway_socket)
                    selector.register(sway, selectors.EVENT_READ, 'sway')
                    snapshot()
                while running and session_socket.exists():
                    now = time.monotonic()
                    for name, subscriber_command in commands.items():
                        if processes[name] is not None or now < retries[name]:
                            continue
                        try:
                            process = subprocess.Popen(
                                subscriber_command, stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, bufsize=0)
                            processes[name] = process
                            selector.register(process.stdout, selectors.EVENT_READ, name)
                        except OSError as error:
                            print(f'mbp-intel-notification-led: {name}: {error.strerror}',
                                  file=sys.stderr)
                            retries[name] = now + 2
                    for key, _ in selector.select(timeout=0.1):
                        name = key.data
                        if name == 'session':
                            running = False
                            break
                        if name == 'sway':
                            kind, event = receive_sway(sway)
                            if kind == SWAY_WINDOW_EVENT and relevant_window_event(event):
                                snapshot()
                            continue
                        process = processes[name]
                        data = os.read(key.fd, 65536)
                        if not data:
                            selector.unregister(process.stdout)
                            stop_subscriber(process)
                            processes[name] = None
                            buffers[name] = b''
                            retries[name] = time.monotonic() + 2
                            if name == 'attention':
                                state.clear()
                            elif name == 'control':
                                center_visible = False
                            continue
                        buffers[name] += data
                        while b'\n' in buffers[name]:
                            line, buffers[name] = buffers[name].split(b'\n', 1)
                            try:
                                if name == 'attention':
                                    source = attention_event(line)
                                    if source:
                                        state.add(source, snapshot(),
                                                  latest_codex_route(runtime)
                                                  if source == 'codex' else None)
                                        if center_visible:
                                            state.acknowledge_fallback()
                                else:
                                    visible = control_center_state(line)
                                    if visible is not None:
                                        center_visible = visible
                                        if center_visible:
                                            state.acknowledge_fallback()
                            except (ValueError, UnicodeError):
                                pass
                        if len(buffers[name]) > 65536:
                            buffers[name] = b''
                    flash.reconcile(state.pending, time.monotonic())
                    lights.sync(flash.enabled(time.monotonic()) if running else False)
        finally:
            if sway is not None:
                sway.close()
            for process in processes.values():
                if process is not None:
                    stop_subscriber(process)
            lights.sync(False)
            for sig, handler in previous.items():
                signal.signal(sig, handler)


def find_sway_socket(runtime):
    configured = os.environ.get('SWAYSOCK')
    candidates = [Path(configured)] if configured else sorted(
        runtime.glob(f'sway-ipc.{os.getuid()}.*.sock'),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    for path in candidates:
        try:
            info = path.stat()
            if path.is_socket() and info.st_uid == os.getuid():
                return path
        except OSError:
            continue
    raise RuntimeError('Sway IPC socket is unavailable')


def main():
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    display = os.environ.get('WAYLAND_DISPLAY')
    if not display:
        raise RuntimeError('start from a Wayland session')
    session_socket = runtime / display
    if not session_socket.is_socket():
        raise RuntimeError('Wayland session socket is unavailable')
    stream = Path(__file__).resolve().with_name('mbp-intel-ai-notification-stream')
    run(runtime, Path('/sys/class/leds'), [str(stream)], session_socket,
        find_sway_socket(runtime), ['swaync-client', '--subscribe'])


if __name__ == '__main__':
    try:
        main()
    except (KeyError, OSError, RuntimeError, ValueError) as error:
        sys.exit(f'mbp-intel-notification-led: {error}')
