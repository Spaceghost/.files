#!/usr/bin/env python3
"""Slide the focused workspace's windows off screen, and slide them back."""
from pathlib import Path
import sys
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib/oldbook'))
from showdesktop import main
if __name__ == '__main__':
    action = sys.argv[1] if len(sys.argv) > 1 else 'toggle'
    if action not in ('toggle', 'show', 'restore', 'daemon'):
        sys.exit('Usage: oldbook-showdesktop [toggle|show|restore|daemon]')
    main(action)
