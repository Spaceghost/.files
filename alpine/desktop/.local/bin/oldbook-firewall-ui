#!/usr/bin/env python3
"""Quietly start the application firewall GUI for an enabled OpenRC setup."""
import fcntl
import os
from pathlib import Path
import shutil
import socket
import stat
import subprocess
import sys


RUNLEVELS = Path("/etc/runlevels")
INITD = Path("/etc/init.d")
PROC = Path("/proc")


def services_enabled():
    for name in ("oldbook-firewall", "opensnitchd"):
        target = INITD / name
        found = False
        for link in RUNLEVELS.glob("*/" + name):
            try:
                if link.is_symlink() and target.is_file() and link.resolve(strict=True) == target.resolve(strict=True):
                    found = True
                    break
            except OSError:
                continue
        if not found:
            return False
    return True


def gui_running(uid):
    for process in PROC.iterdir():
        if not process.name.isdigit():
            continue
        try:
            if process.stat().st_uid != uid:
                continue
            arguments = (process / "cmdline").read_bytes().split(b"\0")
            # Native execution and the packaged Python entry point are both valid.
            if any(Path(os.fsdecode(value)).name == "opensnitch-ui" for value in arguments[:2]):
                return True
        except OSError:
            continue
    return False


def private_runtime(uid):
    value = os.environ.get("XDG_RUNTIME_DIR", "")
    root = Path(value)
    if not value or not root.is_absolute() or root.resolve(strict=True) != root:
        raise ValueError("XDG_RUNTIME_DIR must be an existing absolute directory without symlinks")
    metadata = root.lstat()
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != uid or stat.S_IMODE(metadata.st_mode) != 0o700:
        raise ValueError("XDG_RUNTIME_DIR must belong to this user and have mode 0700")
    root_descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        try:
            os.mkdir("opensnitch", 0o700, dir_fd=root_descriptor)
        except FileExistsError:
            pass
        descriptor = os.open("opensnitch", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
                             | os.O_CLOEXEC, dir_fd=root_descriptor)
    finally:
        os.close(root_descriptor)
    metadata = os.fstat(descriptor)
    if metadata.st_uid != uid:
        os.close(descriptor)
        raise ValueError("OpenSnitch runtime directory belongs to another user")
    os.fchmod(descriptor, 0o700)
    return root / "opensnitch", descriptor


def socket_listening(path, uid):
    try:
        metadata = path.lstat()
    except FileNotFoundError:
        return False
    if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != uid:
        raise ValueError("OpenSnitch socket path is not a socket owned by this user")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(0.2)
        try:
            connection.connect(str(path))
            return True
        except ConnectionRefusedError:
            return False


def main():
    if not services_enabled():
        return 0
    executable = shutil.which("opensnitch-ui")
    if executable is None:
        return 0
    uid = os.getuid()
    runtime, directory = private_runtime(uid)
    try:
        lock = os.open("ui-startup.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
                       0o600, dir_fd=directory)
    finally:
        os.close(directory)
    with os.fdopen(lock, "rb+") as guard:
        metadata = os.fstat(guard.fileno())
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != uid:
            raise ValueError("unsafe OpenSnitch startup lock")
        os.fchmod(guard.fileno(), 0o600)
        try:
            fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return 0
        address = runtime / "osui.sock"
        if gui_running(uid) or socket_listening(address, uid):
            return 0
        # Keep the lock for the GUI lifetime, including its process-startup gap.
        return subprocess.call([executable, "--background", "--socket", "unix://" + str(address)],
                               stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError) as error:
        print(f"oldbook-firewall-ui: {error}", file=sys.stderr)
        raise SystemExit(1)
