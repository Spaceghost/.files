#!/usr/bin/env python3
"""List, inspect, rebuild, and locally generate Scripture study entries."""
import argparse
import gzip
import hashlib
import json
import os
from pathlib import Path
import sqlite3
import sys

REPO = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO / 'alpine/desktop/.local/lib/oldbook'))
import scripture
import scripture_generation as generation
import scripture_study

DEFAULT_ASSETS = REPO / 'alpine/assets/scripture'
KJV_SOURCE_URL = 'https://api.getbible.net/v2/kjv.json'


def database_path(value):
    if value is not None:
        return Path(value)
    data = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share'))
    return data / 'oldbook/scripture/study.sqlite3'


def kjv_source(assets, reference):
    bible = scripture.Bible.load(assets, include_extra=False, translation=scripture.BUNDLED)
    records = bible.lookup(reference)
    if not records or records[0]['book'].startswith(('Torah ', 'Talmud ')):
        raise ValueError('No bundled KJV passage matches: ' + reference)
    first = records[0]
    chapter = [item for item in bible.verses
               if item['book'] == first['book'] and item['chapter'] == first['chapter']]
    text = '\n'.join(f"{item['book']} {item['chapter']}:{item['verse']}  {item['text']}"
                     for item in chapter)
    identifier = f"kjv-{scripture.normalise(first['book'])}-{first['chapter']}"
    source = {
        'id': identifier,
        'title': f"Bundled King James Version excerpt · {first['book']} {first['chapter']}",
        'url': KJV_SOURCE_URL,
        'license': 'Public domain',
        'text': text,
        'sha256': hashlib.sha256(text.encode()).hexdigest(),
    }
    return scripture.format_reference(records), source


def rebuild(assets, database):
    return scripture_study.load_entries(assets, database)


def parser():
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument('--assets', type=Path, default=DEFAULT_ASSETS)
    result.add_argument('--database', type=Path)
    commands = result.add_subparsers(dest='action', required=True)
    commands.add_parser('list', help='list curated and generated study entries')
    show = commands.add_parser('show', help='print one complete entry as JSON')
    show.add_argument('id')
    commands.add_parser('rebuild', help='atomically rebuild the SQLite read cache')
    generate = commands.add_parser('generate', help='generate with an installed local Ollama model')
    generate.add_argument('reference')
    generate.add_argument('--kind', choices=generation.KINDS, required=True)
    generate.add_argument('--endpoint', default=generation.DEFAULT_ENDPOINT)
    generate.add_argument('--model', default=generation.DEFAULT_MODEL)
    generate.add_argument('--timeout', type=float, default=60)
    generate.add_argument('--no-track', action='store_true',
                          help='save into --assets without staging the source artifact')
    return result


def main():
    arguments = parser().parse_args()
    assets = arguments.assets.resolve()
    database = database_path(arguments.database)
    if arguments.action == 'rebuild':
        entries = rebuild(assets, database)
        print(f'Verified/rebuilt {database}: {len(entries)} entries')
        return 0
    if arguments.action == 'generate':
        reference, primary = kjv_source(assets, arguments.reference)
        entry = generation.generate_entry(
            reference, arguments.kind, [primary], endpoint=arguments.endpoint,
            model=arguments.model, timeout=arguments.timeout)
        path = scripture_study.save_entry(
            assets, entry, database=database, track=not arguments.no_track)
        if arguments.no_track:
            print('Saved without staging: ' + str(path))
        else:
            print('Saved and staged: ' + str(path))
            print('Pending Fossil commit; review the staged source artifact before committing.')
        return 0
    entries = scripture_study.load_entries(assets, database)
    if arguments.action == 'list':
        for entry in entries:
            print('\t'.join((entry['id'], entry['kind'], entry['reference'], entry['title'])))
        return 0
    entry = next((item for item in entries if item['id'] == arguments.id), None)
    if entry is None:
        raise ValueError('No Scripture study entry called: ' + arguments.id)
    print(json.dumps(entry, ensure_ascii=False, indent=2, sort_keys=True))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError, sqlite3.Error,
            json.JSONDecodeError, gzip.BadGzipFile) as error:
        print(f'oldbook-scripture-study: {error}', file=sys.stderr)
        sys.exit(1)
