#!/bin/sh
set -eu

action=${1:-}
if command -v wpctl >/dev/null 2>&1; then
    case "$action" in
        up) wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+ ;;
        down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
        mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        mic-mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
        *) printf '%s\n' 'usage: oldbook-audio {up|down|mute|mic-mute}' >&2; exit 64 ;;
    esac
elif command -v pactl >/dev/null 2>&1; then
    case "$action" in
        up) pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
        down) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
        mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
        mic-mute) pactl set-source-mute @DEFAULT_SOURCE@ toggle ;;
        *) printf '%s\n' 'usage: oldbook-audio {up|down|mute|mic-mute}' >&2; exit 64 ;;
    esac
else
    notify-send -u critical 'Audio control unavailable' 'Neither wpctl nor pactl is installed.'
    exit 127
fi
