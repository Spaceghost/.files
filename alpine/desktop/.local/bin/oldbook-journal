#!/usr/bin/env python3
"""Read, add and back up the desktop's SQLite journal."""
from pathlib import Path
import sqlite3
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib/oldbook'))
from desktop_journal import main

if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, sqlite3.Error) as error:
        raise SystemExit(f'oldbook-journal: {error}')
