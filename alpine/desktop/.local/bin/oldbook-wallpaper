#!/usr/bin/env python3
"""Space Ghost gallery: rotate, browse and expose a Waybar status."""
import argparse
import datetime as dt
import fcntl
import hashlib
import html
import json
import os
import runpy
from pathlib import Path
import signal
import stat
import subprocess
import sys
import time

REPO = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO / 'alpine/wallpapers'))
from theme_catalog import available_themes, has_symlink, load_theme, safe_theme_id
sys.path.insert(0, str(REPO / 'alpine/desktop/.local/lib/oldbook'))
from workspace_defaults import choose_artwork
import background_fade as fade
from nocturne import nocturne_preference
import thumbnails

STATE = Path.home() / '.local/state/oldbook/wallpaper'
CURRENT = Path.home() / '.local/share/oldbook/current-wallpaper.png'
GENERATION = Path.home() / '.local/state/oldbook/wallpaper-generation'
MENU = Path(__file__).resolve().parent / 'oldbook-fuzzel'
# Picker rows are 40 logical pixels tall so a painting reads as a picture;
# thumbnails are rendered taller than the slot so HiDPI panels stay crisp.
PICKER_ROW_HEIGHT = 40
PICKER_THUMBNAIL_HEIGHT = 96


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f'.{os.getpid()}.tmp')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    temporary.replace(path)


def current_scope():
    config = json.loads((REPO / 'alpine/wallpapers/gallery.json').read_text())
    configured = config.get('workspace_rotations', [])
    if not configured:
        return 'global'
    response = subprocess.run(['swaymsg', '-s', sway_socket(), '-r', '-t', 'get_workspaces'],
                              capture_output=True, text=True, timeout=3, check=True)
    focused = next((ws for ws in json.loads(response.stdout) if ws.get('focused')), {})
    number = focused.get('num')
    return str(number) if number in configured else 'shared'


def state_path(scope):
    return STATE / 'state.json' if scope in ('global', 'shared') else STATE / 'workspaces' / f'{scope}.json'


def read_state(scope=None):
    try:
        return json.loads(state_path(scope or current_scope()).read_text())
    except (FileNotFoundError, ValueError):
        return {}


def load_gallery(repo=None):
    repo = (repo or REPO).resolve()
    config = json.loads((repo / 'alpine/wallpapers/gallery.json').read_text())
    themes = {theme['id']: theme['name'] for theme in available_themes(repo)}
    themes['none'] = 'Unthemed'
    rotation = set(config.get('rotation_themes', ['all']))
    if 'active' in rotation:
        rotation.remove('active')
        rotation.add(load_theme(repo)['id'])
    candidates = list(config['entries'])
    gallery = repo / 'alpine/assets/gallery'
    # Preserve the order of old flat artwork before appending new collections.
    sidecars = sorted(gallery.glob('*.json'))
    sidecars += sorted(path for path in gallery.rglob('*.json') if path.parent != gallery)
    for sidecar in sidecars:
        try:
            if has_symlink(sidecar, repo):
                continue
            entry = json.loads(sidecar.read_text())
            if isinstance(entry, dict) and entry.get('title'):
                entry.setdefault('id', sidecar.stem)
                entry.setdefault('file', str(sidecar.with_suffix('.png').relative_to(repo)))
                entry.setdefault('description', entry.get('note', ''))
                candidates.append(entry)
        except (ValueError, OSError):
            continue
    entries, seen = [], set()
    for candidate in candidates:
        if not isinstance(candidate, dict) or not isinstance(candidate.get('file'), str) or not candidate.get('id'):
            continue
        entry = dict(candidate)
        source = repo / entry['file']
        if has_symlink(source, repo):
            continue
        source = source.resolve()
        if not source.is_relative_to((repo / 'alpine/assets').resolve()):
            continue
        if not source.is_file() or entry['id'] in seen:
            continue
        if entry.get('sha256') and hashlib.sha256(source.read_bytes()).hexdigest() != entry['sha256']:
            print(f"Skipping changed artwork: {entry['file']}", file=sys.stderr)
            continue
        default_theme = config.get('legacy_theme', 'none')
        if source.is_relative_to(gallery):
            parts = source.relative_to(gallery).parts
            if len(parts) >= 2 and parts[0] == 'general':
                default_theme = 'none'
            elif len(parts) >= 3 and parts[0] == 'themes':
                default_theme = parts[1]
        theme = entry.get('theme', default_theme)
        if not safe_theme_id(theme):
            continue
        entry.update({'path': str(source), 'theme': theme,
                      'theme_name': themes.get(theme, entry.get('theme_name', theme)),
                      'rotate': 'all' in rotation or theme in rotation})
        entries.append(entry)
        seen.add(entry['id'])
    if not entries:
        raise RuntimeError('Gallery has no usable artwork')
    return entries, max(60, int(config.get('interval_seconds', 1200)))


def sway_socket():
    runtime = Path('/run/user') / str(os.getuid())
    candidates = []
    if os.environ.get('SWAYSOCK'):
        candidates.append(Path(os.environ['SWAYSOCK']))
    candidates.extend(sorted(runtime.glob(f'sway-ipc.{os.getuid()}.*.sock'),
                             key=lambda p: p.stat().st_mtime, reverse=True))
    for path in dict.fromkeys(candidates):
        try:
            info = path.lstat()
            if path.parent != runtime or info.st_uid != os.getuid() or not stat.S_ISSOCK(info.st_mode):
                continue
            response = subprocess.run(['swaymsg', '-s', str(path), '-r', '-t', 'get_outputs'],
                                      capture_output=True, text=True, timeout=3)
            outputs = json.loads(response.stdout)
            if response.returncode == 0 and any(o.get('active') and not o['name'].startswith(('HEADLESS', 'WL-')) for o in outputs):
                return str(path)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            continue
    raise RuntimeError('No owned active physical Sway session found')


def fade_duration(action):
    """The timer eases across slowly; a deliberate change answers quickly."""
    return fade.ROTATION_DURATION_MS if action == 'tick' else None


def crossfade_to(path, origin=None, duration=None):
    """True when this session's background daemon accepted the change.

    A brief wait catches an image the daemon cannot decode; a fade that is
    still running (or waiting for a powered-off display) is already accepted.
    """
    try:
        reply = fade.crossfade(path, duration, origin, ack_timeout=2.0, settle_timeout=1.0)
    except OSError:
        return False
    if reply is None:
        return False
    if not reply.get('ok'):
        print('oldbook-wallpaper: crossfade refused: ' + str(reply.get('error')), file=sys.stderr)
        return False
    return True


def apply(entry, origin=None, duration=None):
    socket = sway_socket()
    CURRENT.parent.mkdir(parents=True, exist_ok=True)
    temporary = CURRENT.with_name(CURRENT.name + f'.{os.getpid()}.tmp')
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(entry['path'])
    # The crossfade daemon owns the visible painting while it answers. Sway's
    # own background stays the fallback only: each `output bg` respawns swaybg
    # above the daemon's surface, so it is not refreshed after a fade.
    if not crossfade_to(entry['path'], origin, duration):
        # JSON quoting matches Sway's double-quoted string escaping, no shell involved.
        command = 'output * bg ' + json.dumps(entry['path']) + ' fill'
        response = subprocess.run(['swaymsg', '-s', socket, '-r', command],
                                  capture_output=True, text=True, timeout=5)
        results = json.loads(response.stdout)
        if response.returncode or not results or not all(item.get('success') for item in results):
            temporary.unlink(missing_ok=True)
            raise RuntimeError('Sway rejected wallpaper command')
    temporary.replace(CURRENT)
    relayout_panels()
    return socket


def panel_command(action):
    helper = REPO / 'alpine/desktop/.local/bin/oldbook-conky'
    if not helper.is_file():
        return
    try:
        subprocess.Popen(['/usr/bin/python3', str(helper), action], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def relayout_panels():
    """Refit the desktop panels to the calm areas of the artwork now on screen."""
    panel_command('layout')


def removable(entry):
    """Validate one gallery entry and return its image and sidecar paths."""
    gallery_root = (REPO / 'alpine/assets/gallery').resolve()
    image = Path(entry['path']).resolve()
    sidecar = image.with_suffix('.json')
    if not image.is_relative_to(gallery_root):
        raise RuntimeError('Only generated gallery artwork can be deleted; '
                           'curated images are listed in gallery.json')
    for path in (image, sidecar):
        if path.is_symlink() or (path.exists() and not path.is_file()):
            raise RuntimeError('Refusing to delete anything but regular gallery files')
    return image, sidecar


def remove_artwork(chosen):
    """Delete one or more gallery entries, stepping off any that is on screen."""
    if not chosen:
        return 0
    entries, _ = load_gallery()
    paths = [removable(entry) for entry in chosen]
    doomed = {entry['id'] for entry in chosen}
    surviving = [entry for entry in entries if entry['id'] not in doomed]
    # Move the desktop on first so it never points at a file that is gone.
    if read_state().get('id') in doomed and surviving:
        update('next')
    relative = []
    for image, sidecar in paths:
        for path in (image, sidecar):
            path.unlink(missing_ok=True)
            relative.append(str(path.relative_to(REPO.resolve())))
    # Keep the checkout consistent; the removal stays pending for review.
    try:
        subprocess.run(['fossil', 'rm', '--hard', '--', *relative], cwd=REPO,
                       stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        pass
    return len(chosen)


def delete_current(confirm=True):
    """Remove the artwork now on screen from the gallery, after moving on from it."""
    entries, _ = load_gallery()
    entry = next((item for item in entries if item['id'] == read_state().get('id')), None)
    if entry is None:
        raise RuntimeError('No current artwork to delete')
    removable(entry)
    if confirm:
        answer = gallery_menu('Delete "' + entry['title'] + '"? ',
                              ['Keep it', 'Delete this painting permanently'])
        if answer != 'Delete this painting permanently':
            return 0
    remove_artwork([entry])
    print('Deleted ' + entry['title'])
    return 0


def delete_many(entries, labels):
    """Tick several paintings, then remove them in one confirmed step."""
    marked = set()
    # Thumbnails already rendered by the gallery pages or its warm-up appear
    # beside their rows; this list never waits on rendering.
    row_icons = painting_icons(entries, labels, render=False)
    while True:
        menu_options = {'← Back to the gallery': ('back', None)}
        icons = {}
        done = f'󰩹  Delete {len(marked)} selected…' if marked else None
        if done:
            menu_options[done] = ('confirm', None)
        for index, label in enumerate(labels):
            option = ('[x] ' if index in marked else '[  ] ') + label
            option = unique_label(option, menu_options)
            menu_options[option] = ('toggle', index)
            if label in row_icons:
                icons[option] = row_icons[label]
        chosen = gallery_menu(f'Select images to delete ({len(marked)}) ❯ ',
                             list(menu_options.keys()), icons)
        action = menu_options.get(chosen)
        if action is None:
            return 0
        if action[0] == 'back':
            return 0
        if action[0] == 'confirm':
            break
        if action[0] == 'toggle':
            marked.symmetric_difference_update({action[1]})
            continue
    picked = [entries[index] for index in sorted(marked)]
    answer = gallery_menu(f'Permanently delete {len(picked)} painting(s)? ',
                          ['Keep them', f'Delete {len(picked)} permanently'])
    if answer != f'Delete {len(picked)} permanently':
        return 0
    removed = remove_artwork(picked)
    print(f'Deleted {removed} painting(s)')
    return 0


def switch_theme():
    """Apply an existing theme, rather than generating new artwork in its style."""
    active = current_theme_id()
    themes = available_themes(REPO)
    labels = {'← Back to the gallery': None}
    for theme in themes:
        mark = '●' if theme['id'] == active else '○'
        label = unique_label(f'{mark}  {theme["name"]}', labels)
        labels[label] = theme['id']
    chosen = gallery_menu('Switch theme ❯ ', list(labels.keys()))
    if chosen is None or labels.get(chosen) is None:
        return 0
    subprocess.Popen(['/usr/bin/python3', str(Path(__file__).resolve().parent / 'oldbook-theme'),
                      'use', labels[chosen], '--notify'], start_new_session=True)
    return 0


def current_theme_id():
    try:
        return (REPO / 'alpine/themes/current').read_text().strip() or 'none'
    except OSError:
        return 'none'


def update(action, selected=None, origin=None):
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'state.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        scope = current_scope()
        state = read_state(scope)
        try:
            changed_scope = (STATE / 'active-scope').read_text() != scope
        except FileNotFoundError:
            changed_scope = scope != 'global'
        if action == 'tick' and (changed_scope or scope == 'shared'):
            if not changed_scope and scope == 'shared':
                return
            action = 'refresh'
        if action == 'tick' and state.get('id') and CURRENT.exists():
            if state.get('paused') or time.time() < state.get('next_at', 0):
                if sway_socket() == state.get('socket'):
                    return
                action = 'refresh'
        entries, interval = load_gallery()
        if action == 'pause':
            state['paused'] = not state.get('paused', False)
            state['next_at'] = time.time() + interval
        else:
            # Manual browsing, explicit picks and refreshes retain every image.
            # Workspace rotations use the full gallery so a small active-theme
            # collection cannot collapse all six workspaces onto one picture.
            # The legacy global timer retains its theme filter.
            if selected is None and action == 'tick' and scope == 'global':
                entries = [entry for entry in entries if entry.get('rotate', True)] or entries
            index = next((i for i, entry in enumerate(entries) if entry['id'] == state.get('id')), -1)
            if selected is not None:
                index = next((i for i, entry in enumerate(entries) if entry['id'] == selected), None)
                if index is None:
                    raise RuntimeError('Selected artwork is unavailable or failed validation')
            elif action == 'prev':
                index = (index - 1) % len(entries)
            elif action == 'refresh' and index >= 0:
                pass
            else:
                occupied = set()
                if scope not in ('global', 'shared'):
                    for path in (STATE / 'workspaces').glob('*.json'):
                        if path != state_path(scope):
                            try:
                                occupied.add(json.loads(path.read_text()).get('id'))
                            except (OSError, ValueError):
                                pass
                chosen = None
                if selected is None and action == 'tick' and scope == 'global':
                    # After dark the timer leans toward nocturnes; every painting
                    # stays eligible and manual browsing is untouched.
                    chosen = nocturne_preference(entries, state.get('id'))
                if chosen is None:
                    chosen = choose_artwork([entry['id'] for entry in entries],
                                            state.get('id'), 1, occupied)
                index = next(i for i, entry in enumerate(entries) if entry['id'] == chosen)
            entry = entries[index]
            socket = apply(entry, origin, fade_duration(action))
            state.update({k: entry.get(k, '') for k in ('id', 'title', 'description', 'file', 'theme', 'theme_name')})
            deadline = state.get('next_at') if action == 'refresh' else None
            state.update({'next_at': deadline or time.time() + interval, 'socket': socket})
        state['interval_seconds'] = interval
        atomic_json(state_path(scope), state)
        if action != 'pause':
            (STATE / 'active-scope').write_text(scope)


def generation_status():
    """Only a held lock means busy; stale state after a killed process does not."""
    try:
        with (GENERATION / 'generation.lock').open() as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return None
            except BlockingIOError:
                try:
                    return json.load(lock)
                except ValueError:
                    return {'title': 'New artwork'}
    except FileNotFoundError:
        return None


def start_generation(theme='active', *, new_theme=None):
    GENERATION.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(GENERATION, 0o700)
    with (GENERATION / 'manual.log').open('a') as log:
        command = ['/usr/bin/python3', str(REPO / 'alpine/wallpapers/generate.py'),
                   '--manual', '--activate', '--theme', theme]
        if new_theme is not None:
            command += ['--new-theme=' + new_theme]
        subprocess.Popen(command, stdin=subprocess.DEVNULL,
                         stdout=log, stderr=subprocess.STDOUT, start_new_session=True)


def prompt_theme():
    try:
        phrase = subprocess.run([str(MENU), '--dmenu', '--prompt', 'Describe your theme · name generated ❯ ',
                                '--lines', '0', '--width', '62'],
                               input='', capture_output=True, text=True)
    except FileNotFoundError:
        return
    if phrase.returncode == 0 and phrase.stdout.strip():
        start_generation(new_theme=phrase.stdout.strip())


def edit_prompts():
    subprocess.Popen(['/usr/bin/python3', str(REPO / 'alpine/desktop/.local/bin/oldbook-gallery-prompts')],
                     start_new_session=True)


def current_thumbnail(height):
    """A cached thumbnail of the painting on screen, for the bar's badge."""
    if not height or height <= 0:
        return None
    try:
        source = CURRENT.resolve(strict=True)
    except OSError:
        return None
    path = thumbnails.thumbnail(source, height=height)
    return str(path) if path is not None else None


def status(thumbnail_height=None):
    state = read_state()
    title = state.get('title', 'Space Ghost gallery')
    minutes = max(1, int(state.get('interval_seconds', 1200)) // 60)
    mode = ('Paused · Moltar is holding this frame.' if state.get('paused') else
            f'Changes every {minutes} minutes · Zorak runs the projector.')
    tooltip = '<b>SPACE GHOST · GHOST GALLERY</b>\n\n'
    tooltip += '<b>' + html.escape(title) + '</b>\n' + html.escape(state.get('description', ''))
    tooltip += '\n\n' + html.escape(mode)
    if state.get('theme_name'):
        tooltip += '\nCollection: ' + html.escape(state['theme_name'])
    # GTK consumes Pango markup, so instructions need escaping just like titles.
    controls = ('Left: gallery & themes · Right: next artwork\n'
                'Middle: pause/resume · scroll: browse (↑ previous / ↓ next)\n'
                'Command/Super+click: generate & switch · new scene and mix\n'
                'Super+Shift+left: random complete theme · debut painting included\n'
                'Super+Shift+right: describe a complete theme · name generated\n'
                'Super+Shift+G: desktop panels on/off\n'
                'Shift+click: edit prompts · “Zorak, fix the script!”\n'
                'Other modified clicks use the left button.')
    tooltip += '\n\n<b>YOUR CONTROL ROOM</b>\n' + html.escape(controls)
    busy = generation_status()
    if busy is not None:
        tooltip = '<b>Space Ghost is painting…</b>\n' + html.escape(busy.get('title', 'New artwork')) + '\n\n' + tooltip
    report = {'text': '󰔟' if busy is not None else '󰸉', 'alt': title,
              'class': 'generating' if busy is not None else ('paused' if state.get('paused') else 'rotating'),
              'tooltip': tooltip}
    thumbnail = current_thumbnail(thumbnail_height)
    if thumbnail:
        report['thumbnail'] = thumbnail
    print(json.dumps(report))


def artwork_date(entry):
    """Prefer archived creation dates; old artwork can fall back to file mtime."""
    for key in ('generated_utc', 'created'):
        try:
            date = dt.datetime.fromisoformat(entry[key])
            if date.tzinfo is None:
                date = date.replace(tzinfo=dt.timezone.utc)
            return date.timestamp()
        except (KeyError, TypeError, ValueError, OverflowError):
            pass
    try:
        return Path(entry['path']).stat().st_mtime
    except (KeyError, OSError):
        return 0


def gallery_menu(prompt, options, icons=None):
    """Show one menu page; `icons` maps an option to an icon-theme name.

    Rows with an icon use Fuzzel's dmenu icon protocol and the private
    thumbnail theme; the returned selection is always the plain option text.
    """
    if not options:
        return None
    icons = {option: icons[option] for option in options if icons and icons.get(option)}
    command = [str(MENU), '--dmenu', '--no-sort', '--prompt', prompt,
               '--lines', str(min(9, len(options))), '--width', '48']
    if icons:
        command += ['--icon-theme', thumbnails.THEME, '--line-height', str(PICKER_ROW_HEIGHT)]
    rows = [option + '\0icon\x1f' + icons[option] if option in icons else option
            for option in options]
    try:
        result = subprocess.run(command, input='\n'.join(rows) + '\n', capture_output=True,
                                text=True)
    except FileNotFoundError:
        return None
    if result.returncode != 0:
        return None
    selected = result.stdout.rstrip('\n').split('\0', 1)[0]
    return selected if selected in options else None


def painting_icons(entries, labels, render=True):
    """Icon names for painting rows whose thumbnails exist, keyed by label.

    Rendering happens lazily for the rows on screen; `render=False` only reuses
    thumbnails that a previous page or the background warm-up already made.
    """
    icons = {}
    for entry, label in zip(entries, labels):
        path = entry.get('path')
        if not path:
            continue
        make = thumbnails.thumbnail if render else thumbnails.cached
        thumbnail = make(path, height=PICKER_THUMBNAIL_HEIGHT, digest=entry.get('sha256'))
        if thumbnail is not None:
            icons[label] = thumbnails.icon_name(thumbnail)
    if icons:
        try:
            thumbnails.icon_theme()
        except (OSError, RuntimeError) as error:
            print(f'Thumbnail icon theme unavailable: {error}', file=sys.stderr)
            return {}
    return icons


def warm_thumbnails(entries):
    """Render every painting's thumbnail in the background at low priority."""
    sources = [entry['path'] for entry in entries if entry.get('path')]
    if not sources:
        return
    try:
        subprocess.Popen(['nice', '-n', '19', '/usr/bin/python3', str(thumbnails.__file__),
                          '--quiet', '--height', str(PICKER_THUMBNAIL_HEIGHT), *sources],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def unique_label(base, seen):
    """Return a unique label for a mutable menu state."""
    candidate = base
    suffix = 2
    while candidate in seen:
        candidate = f'{base} ({suffix})'
        suffix += 1
    return candidate


def pick():
    entries, _ = load_gallery()
    entries = sorted(entries, key=lambda entry: (artwork_date(entry), str(entry['id'])), reverse=True)
    labels = []
    pickable = {}
    for i, entry in enumerate(entries):
        title = ' '.join((entry.get('title') or entry.get('id') or 'A painting').split())
        label = f'{i + 1:02d}  ' + title + (' · ' + entry['theme_name'] if entry.get('theme_name') else '')
        labels.append(label)
        pickable[label] = entry['id']
    generate_label = '✦  Generate new artwork & switch to it'
    controls = {'→  Next artwork': 'next', '←  Previous artwork': 'prev',
                '⏯  Pause / resume rotation': 'pause'}
    delete_label = '󰩹  Delete this painting permanently'
    delete_many_label = '󰩹  Delete several paintings…'
    theme_label = '󰸌  Switch theme · change the desktop look'
    panels_label = '󰕮  Desktop panels · switch on/off'
    refit_label = '󰃨  Refit desktop panels to this painting'
    help_label = '?  Help & gallery controls'
    deck_label = '󰊠  Open command deck · all desktop commands'
    edit_label = '✎  Edit artwork prompts · Shift+click'
    unthemed_label = '✦  Generate unthemed artwork & switch to it'
    existing_label = '✦  Paint in an existing theme…'
    themed_commands = {}
    for theme in sorted(available_themes(REPO), key=lambda t: t['name'].casefold()):
        label = theme['name']
        number = 2
        while label in themed_commands:
            label = f'{theme["name"]} ({number})'
            number += 1
        themed_commands[label] = theme['id']
    random_label = '✦  Random new theme'
    phrase_label = '✦  Create theme from prompt'
    actions = [theme_label, *controls, delete_label, delete_many_label, panels_label,
               refit_label, help_label, deck_label, edit_label, generate_label,
               random_label, phrase_label, existing_label, unthemed_label]
    try:
        active_name = load_theme(REPO)['name']
    except (OSError, ValueError, RuntimeError):
        active_name = 'Unthemed'
    page = 0
    # Four paintings leave room for both paging controls and all three actions.
    page_size = 4
    page_count = max(1, (len(entries) + page_size - 1) // page_size)
    warm_thumbnails(entries)
    while True:
        shown = slice(page * page_size, (page + 1) * page_size)
        options = labels[shown]
        icons = painting_icons(entries[shown], labels[shown])
        if page:
            options += ['← Newer images']
        if page + 1 < page_count:
            options += ['Older images →']
        options += [phrase_label, existing_label, 'Gallery actions…']
        selected = gallery_menu(
            f'Gallery {page + 1}/{page_count} · {active_name} ❯ ', options, icons)
        if selected not in options:
            return
        if selected == 'Older images →':
            page += 1
            continue
        if selected == '← Newer images':
            page -= 1
            continue
        if selected == 'Gallery actions…':
            selected = gallery_menu('Gallery actions ❯ ', ['← Back to images', *actions])
            if selected is None or selected == '← Back to images':
                continue
        if selected == existing_label:
            selected = gallery_menu('Paint in a theme · type to search ❯ ',
                                    ['← Back to images', *themed_commands])
            if selected is None or selected == '← Back to images':
                continue
            if selected in themed_commands:
                start_generation(themed_commands[selected])
            return
        break
    if selected is not None:
        if selected == random_label:
            start_generation(new_theme='')
        elif selected == phrase_label:
            prompt_theme()
        elif selected == generate_label:
            start_generation()
        elif selected == unthemed_label:
            start_generation('none')
        elif selected in pickable:
            update('pick', pickable[selected])
        elif selected in controls:
            update(controls[selected])
        elif selected == delete_label:
            delete_current()
        elif selected == delete_many_label:
            delete_many(entries, labels)
        elif selected == theme_label:
            switch_theme()
        elif selected == panels_label:
            panel_command('toggle')
        elif selected == refit_label:
            panel_command('layout')
        elif selected == help_label:
            subprocess.Popen(['foot', '--title=Ghost Gallery Help', '-e', 'less',
                              str(REPO / 'alpine/wallpapers/README.md')], start_new_session=True)
        elif selected == deck_label:
            subprocess.Popen(['/usr/bin/python3', str(REPO / 'alpine/desktop/.local/bin/oldbook-control')],
                             start_new_session=True)
        elif selected == edit_label:
            edit_prompts()


def daemon():
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'daemon.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        # Restore after compositor restart even when rotation is paused.
        refresh = True
        ipc = runpy.run_path(str(REPO / 'alpine/desktop/.local/bin/oldbook-workspaces'))
        import socket
        import select
        subscription = None
        last_error = None
        while True:
            try:
                if subscription is None:
                    subscription = socket.socket(socket.AF_UNIX)
                    subscription.settimeout(3)
                    subscription.connect(sway_socket())
                    ipc['send'](subscription, 2, '["workspace","output","shutdown"]')
                    ipc['receive'](subscription)
                update('refresh' if refresh else 'tick')
                refresh, last_error = False, None
                ready, _, _ = select.select([subscription], [], [], 30)
                if ready:
                    ipc['receive'](subscription)
            except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
                message = str(error)
                if message != last_error:
                    print(message, file=sys.stderr, flush=True)
                    last_error = message
                refresh = True
                if subscription is not None:
                    subscription.close()
                    subscription = None
                time.sleep(1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='status',
                        choices=['status', 'next', 'prev', 'pause', 'pick', 'daemon', 'refresh',
                                 'generate', 'new-theme', 'prompt-theme', 'select', 'edit-prompts', 'delete'])
    parser.add_argument('artwork_id', nargs='?', help='Exact gallery ID for select')
    parser.add_argument('--theme', default='active', help='For generate: active, none, or a theme ID.')
    parser.add_argument('--thumbnail-height', type=int, metavar='PIXELS',
                        help='For status: also report a cached thumbnail of this height.')
    parser.add_argument('--from', dest='origin', metavar='X,Y',
                        help='For next/prev/select/refresh: reveal the painting from this '
                             'logical output position instead of a plain crossfade.')
    args = parser.parse_args()
    origin = fade.parse_origin(args.origin) if args.origin else None
    if origin is not None and args.action not in ('next', 'prev', 'select', 'refresh'):
        parser.error('--from only applies to next, prev, select and refresh')
    if (args.action == 'select') != (args.artwork_id is not None):
        parser.error('select requires an artwork ID; other actions take no ID')
    if args.theme != 'active' and args.action != 'generate':
        parser.error('--theme only applies to generate')
    if args.thumbnail_height is not None and args.action != 'status':
        parser.error('--thumbnail-height only applies to status')
    if args.action == 'status':
        status(args.thumbnail_height)
    elif args.action == 'pick':
        pick()
    elif args.action == 'daemon':
        daemon()
    elif args.action == 'generate':
        start_generation(args.theme)
    elif args.action == 'new-theme':
        start_generation(new_theme='')
    elif args.action == 'prompt-theme':
        prompt_theme()
    elif args.action == 'edit-prompts':
        edit_prompts()
    elif args.action == 'delete':
        return delete_current(confirm=False)
    else:
        update(args.action, args.artwork_id, origin)


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(f'oldbook-wallpaper: {error}', file=sys.stderr)
        sys.exit(1)
