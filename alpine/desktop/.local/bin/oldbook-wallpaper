#!/usr/bin/env python3
"""Space Ghost gallery: rotate, browse and expose a Waybar status."""
import argparse
import fcntl
import hashlib
import html
import json
import os
import runpy
from pathlib import Path
import signal
import stat
import subprocess
import sys
import time

REPO = Path(__file__).resolve().parents[4]
sys.path.insert(0, str(REPO / 'alpine/wallpapers'))
from theme_catalog import available_themes, has_symlink, load_theme, safe_theme_id
sys.path.insert(0, str(REPO / 'alpine/desktop/.local/lib/oldbook'))
from workspace_defaults import choose_artwork

STATE = Path.home() / '.local/state/oldbook/wallpaper'
CURRENT = Path.home() / '.local/share/oldbook/current-wallpaper.png'
GENERATION = Path.home() / '.local/state/oldbook/wallpaper-generation'


def atomic_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + f'.{os.getpid()}.tmp')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    temporary.replace(path)


def current_scope():
    config = json.loads((REPO / 'alpine/wallpapers/gallery.json').read_text())
    configured = config.get('workspace_rotations', [])
    if not configured:
        return 'global'
    response = subprocess.run(['swaymsg', '-s', sway_socket(), '-r', '-t', 'get_workspaces'],
                              capture_output=True, text=True, timeout=3, check=True)
    focused = next((ws for ws in json.loads(response.stdout) if ws.get('focused')), {})
    number = focused.get('num')
    return str(number) if number in configured else 'shared'


def state_path(scope):
    return STATE / 'state.json' if scope in ('global', 'shared') else STATE / 'workspaces' / f'{scope}.json'


def read_state(scope=None):
    try:
        return json.loads(state_path(scope or current_scope()).read_text())
    except (FileNotFoundError, ValueError):
        return {}


def load_gallery(repo=None):
    repo = (repo or REPO).resolve()
    config = json.loads((repo / 'alpine/wallpapers/gallery.json').read_text())
    themes = {theme['id']: theme['name'] for theme in available_themes(repo)}
    themes['none'] = 'Unthemed'
    rotation = set(config.get('rotation_themes', ['all']))
    if 'active' in rotation:
        rotation.remove('active')
        rotation.add(load_theme(repo)['id'])
    candidates = list(config['entries'])
    gallery = repo / 'alpine/assets/gallery'
    # Preserve the order of old flat artwork before appending new collections.
    sidecars = sorted(gallery.glob('*.json'))
    sidecars += sorted(path for path in gallery.rglob('*.json') if path.parent != gallery)
    for sidecar in sidecars:
        try:
            if has_symlink(sidecar, repo):
                continue
            entry = json.loads(sidecar.read_text())
            if isinstance(entry, dict) and entry.get('title'):
                entry.setdefault('id', sidecar.stem)
                entry.setdefault('file', str(sidecar.with_suffix('.png').relative_to(repo)))
                entry.setdefault('description', entry.get('note', ''))
                candidates.append(entry)
        except (ValueError, OSError):
            continue
    entries, seen = [], set()
    for candidate in candidates:
        if not isinstance(candidate, dict) or not isinstance(candidate.get('file'), str) or not candidate.get('id'):
            continue
        entry = dict(candidate)
        source = repo / entry['file']
        if has_symlink(source, repo):
            continue
        source = source.resolve()
        if not source.is_relative_to((repo / 'alpine/assets').resolve()):
            continue
        if not source.is_file() or entry['id'] in seen:
            continue
        if entry.get('sha256') and hashlib.sha256(source.read_bytes()).hexdigest() != entry['sha256']:
            print(f"Skipping changed artwork: {entry['file']}", file=sys.stderr)
            continue
        default_theme = config.get('legacy_theme', 'none')
        if source.is_relative_to(gallery):
            parts = source.relative_to(gallery).parts
            if len(parts) >= 2 and parts[0] == 'general':
                default_theme = 'none'
            elif len(parts) >= 3 and parts[0] == 'themes':
                default_theme = parts[1]
        theme = entry.get('theme', default_theme)
        if not safe_theme_id(theme):
            continue
        entry.update({'path': str(source), 'theme': theme,
                      'theme_name': themes.get(theme, entry.get('theme_name', theme)),
                      'rotate': 'all' in rotation or theme in rotation})
        entries.append(entry)
        seen.add(entry['id'])
    if not entries:
        raise RuntimeError('Gallery has no usable artwork')
    return entries, max(60, int(config.get('interval_seconds', 1200)))


def sway_socket():
    runtime = Path('/run/user') / str(os.getuid())
    candidates = []
    if os.environ.get('SWAYSOCK'):
        candidates.append(Path(os.environ['SWAYSOCK']))
    candidates.extend(sorted(runtime.glob(f'sway-ipc.{os.getuid()}.*.sock'),
                             key=lambda p: p.stat().st_mtime, reverse=True))
    for path in dict.fromkeys(candidates):
        try:
            info = path.lstat()
            if path.parent != runtime or info.st_uid != os.getuid() or not stat.S_ISSOCK(info.st_mode):
                continue
            response = subprocess.run(['swaymsg', '-s', str(path), '-r', '-t', 'get_outputs'],
                                      capture_output=True, text=True, timeout=3)
            outputs = json.loads(response.stdout)
            if response.returncode == 0 and any(o.get('active') and not o['name'].startswith(('HEADLESS', 'WL-')) for o in outputs):
                return str(path)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            continue
    raise RuntimeError('No owned active physical Sway session found')


def apply(entry):
    socket = sway_socket()
    CURRENT.parent.mkdir(parents=True, exist_ok=True)
    temporary = CURRENT.with_name(CURRENT.name + f'.{os.getpid()}.tmp')
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(entry['path'])
    # JSON quoting matches Sway's double-quoted string escaping, no shell involved.
    command = 'output * bg ' + json.dumps(entry['path']) + ' fill'
    response = subprocess.run(['swaymsg', '-s', socket, '-r', command],
                              capture_output=True, text=True, timeout=5)
    results = json.loads(response.stdout)
    if response.returncode or not results or not all(item.get('success') for item in results):
        temporary.unlink(missing_ok=True)
        raise RuntimeError('Sway rejected wallpaper command')
    temporary.replace(CURRENT)
    return socket


def update(action, selected=None):
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'state.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        scope = current_scope()
        state = read_state(scope)
        try:
            changed_scope = (STATE / 'active-scope').read_text() != scope
        except FileNotFoundError:
            changed_scope = scope != 'global'
        if action == 'tick' and (changed_scope or scope == 'shared'):
            if not changed_scope and scope == 'shared':
                return
            action = 'refresh'
        if action == 'tick' and state.get('id') and CURRENT.exists():
            if state.get('paused') or time.time() < state.get('next_at', 0):
                if sway_socket() == state.get('socket'):
                    return
                action = 'refresh'
        entries, interval = load_gallery()
        if action == 'pause':
            state['paused'] = not state.get('paused', False)
            state['next_at'] = time.time() + interval
        else:
            # Manual browsing, explicit picks and refreshes retain every image.
            # Workspace rotations use the full gallery so a small active-theme
            # collection cannot collapse all six workspaces onto one picture.
            # The legacy global timer retains its theme filter.
            if selected is None and action == 'tick' and scope == 'global':
                entries = [entry for entry in entries if entry.get('rotate', True)] or entries
            index = next((i for i, entry in enumerate(entries) if entry['id'] == state.get('id')), -1)
            if selected is not None:
                index = next((i for i, entry in enumerate(entries) if entry['id'] == selected), None)
                if index is None:
                    raise RuntimeError('Selected artwork is unavailable or failed validation')
            elif action == 'prev':
                index = (index - 1) % len(entries)
            elif action == 'refresh' and index >= 0:
                pass
            else:
                occupied = set()
                if scope not in ('global', 'shared'):
                    for path in (STATE / 'workspaces').glob('*.json'):
                        if path != state_path(scope):
                            try:
                                occupied.add(json.loads(path.read_text()).get('id'))
                            except (OSError, ValueError):
                                pass
                chosen = choose_artwork([entry['id'] for entry in entries],
                                        state.get('id'), 1, occupied)
                index = next(i for i, entry in enumerate(entries) if entry['id'] == chosen)
            entry = entries[index]
            socket = apply(entry)
            state.update({k: entry.get(k, '') for k in ('id', 'title', 'description', 'file', 'theme', 'theme_name')})
            deadline = state.get('next_at') if action == 'refresh' else None
            state.update({'next_at': deadline or time.time() + interval, 'socket': socket})
        state['interval_seconds'] = interval
        atomic_json(state_path(scope), state)
        if action != 'pause':
            (STATE / 'active-scope').write_text(scope)


def generation_status():
    """Only a held lock means busy; stale state after a killed process does not."""
    try:
        with (GENERATION / 'generation.lock').open() as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return None
            except BlockingIOError:
                try:
                    return json.load(lock)
                except ValueError:
                    return {'title': 'New artwork'}
    except FileNotFoundError:
        return None


def start_generation(theme='active', *, new_theme=None):
    GENERATION.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(GENERATION, 0o700)
    with (GENERATION / 'manual.log').open('a') as log:
        command = ['/usr/bin/python3', str(REPO / 'alpine/wallpapers/generate.py'),
                   '--manual', '--activate', '--theme', theme]
        if new_theme is not None:
            command += ['--new-theme=' + new_theme]
        subprocess.Popen(command, stdin=subprocess.DEVNULL,
                         stdout=log, stderr=subprocess.STDOUT, start_new_session=True)


def edit_prompts():
    subprocess.Popen(['/usr/bin/python3', str(REPO / 'alpine/desktop/.local/bin/oldbook-gallery-prompts')],
                     start_new_session=True)


def status():
    state = read_state()
    title = state.get('title', 'Space Ghost gallery')
    minutes = max(1, int(state.get('interval_seconds', 1200)) // 60)
    mode = ('Paused · Moltar is holding this frame.' if state.get('paused') else
            f'Changes every {minutes} minutes · Zorak runs the projector.')
    tooltip = '<b>SPACE GHOST · GHOST GALLERY</b>\n\n'
    tooltip += '<b>' + html.escape(title) + '</b>\n' + html.escape(state.get('description', ''))
    tooltip += '\n\n' + html.escape(mode)
    if state.get('theme_name'):
        tooltip += '\nCollection: ' + html.escape(state['theme_name'])
    # GTK consumes Pango markup, so instructions need escaping just like titles.
    controls = ('Click: next · scroll: browse (↑ previous / ↓ next)\n'
                'Middle: pause/resume · right: gallery & themes\n'
                'Command/Super+click: generate & switch\n'
                'Shift+click: edit prompts · “Zorak, fix the script!”\n'
                'Modified clicks use the left button.')
    tooltip += '\n\n<b>YOUR CONTROL ROOM</b>\n' + html.escape(controls)
    busy = generation_status()
    if busy is not None:
        tooltip = '<b>Space Ghost is painting…</b>\n' + html.escape(busy.get('title', 'New artwork')) + '\n\n' + tooltip
    print(json.dumps({'text': '󰔟' if busy is not None else '󰸉', 'alt': title,
                      'class': 'generating' if busy is not None else ('paused' if state.get('paused') else 'rotating'),
                      'tooltip': tooltip}))


def pick():
    entries, _ = load_gallery()
    labels = [f'{i + 1:02d}  {e["title"]}'
              + (' · ' + e['theme_name'] if e.get('theme_name') else '')
              for i, e in enumerate(entries)]
    generate_label = '✦  Generate new artwork & switch to it'
    controls = {'→  Next artwork': 'next', '←  Previous artwork': 'prev',
                '⏯  Pause / resume rotation': 'pause'}
    help_label = '?  Help & gallery controls'
    deck_label = '󰊠  Open command deck · all desktop commands'
    edit_label = '✎  Edit artwork prompts · Shift+click'
    themed_commands = {'✦  Generate unthemed artwork & switch to it': 'none'}
    themed_commands.update({'✦  Generate ' + theme['name'] + ' artwork & switch to it': theme['id']
                            for theme in available_themes(REPO)})
    random_label = '✦  Random new theme'
    phrase_label = '✦  New theme from a phrase/title'
    options = [*labels, *controls, help_label, deck_label, edit_label, generate_label,
               random_label, phrase_label, *themed_commands]
    result = subprocess.run(['fuzzel', '--dmenu', '--prompt', 'Ghost Gallery ❯ ',
                             '--lines', str(min(28, len(options))), '--width', '62'],
                            input='\n'.join(options) + '\n', capture_output=True, text=True)
    selected = result.stdout.rstrip('\n')
    if result.returncode == 0:
        if selected == random_label:
            start_generation(new_theme='')
        elif selected == phrase_label:
            phrase = subprocess.run(['fuzzel', '--dmenu', '--prompt', 'Theme phrase/title ❯ ',
                                     '--lines', '0', '--width', '62'],
                                    input='', capture_output=True, text=True)
            if phrase.returncode == 0 and phrase.stdout.strip():
                start_generation(new_theme=phrase.stdout.strip())
        elif selected == generate_label:
            start_generation()
        elif selected in themed_commands:
            start_generation(themed_commands[selected])
        elif selected in labels:
            update('pick', entries[labels.index(selected)]['id'])
        elif selected in controls:
            update(controls[selected])
        elif selected == help_label:
            subprocess.Popen(['foot', '--title=Ghost Gallery Help', '-e', 'less',
                              str(REPO / 'alpine/wallpapers/README.md')], start_new_session=True)
        elif selected == deck_label:
            subprocess.Popen(['/usr/bin/python3', str(REPO / 'alpine/desktop/.local/bin/oldbook-control')],
                             start_new_session=True)
        elif selected == edit_label:
            edit_prompts()


def daemon():
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / 'daemon.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        # Restore after compositor restart even when rotation is paused.
        refresh = True
        ipc = runpy.run_path(str(REPO / 'alpine/desktop/.local/bin/oldbook-workspaces'))
        import socket
        import select
        subscription = None
        last_error = None
        while True:
            try:
                if subscription is None:
                    subscription = socket.socket(socket.AF_UNIX)
                    subscription.settimeout(3)
                    subscription.connect(sway_socket())
                    ipc['send'](subscription, 2, '["workspace","output","shutdown"]')
                    ipc['receive'](subscription)
                update('refresh' if refresh else 'tick')
                refresh, last_error = False, None
                ready, _, _ = select.select([subscription], [], [], 30)
                if ready:
                    ipc['receive'](subscription)
            except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
                message = str(error)
                if message != last_error:
                    print(message, file=sys.stderr, flush=True)
                    last_error = message
                refresh = True
                if subscription is not None:
                    subscription.close()
                    subscription = None
                time.sleep(1)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='status',
                        choices=['status', 'next', 'prev', 'pause', 'pick', 'daemon', 'refresh',
                                 'generate', 'select', 'edit-prompts'])
    parser.add_argument('artwork_id', nargs='?', help='Exact gallery ID for select')
    parser.add_argument('--theme', default='active', help='For generate: active, none, or a theme ID.')
    args = parser.parse_args()
    if (args.action == 'select') != (args.artwork_id is not None):
        parser.error('select requires an artwork ID; other actions take no ID')
    if args.theme != 'active' and args.action != 'generate':
        parser.error('--theme only applies to generate')
    if args.action == 'status':
        status()
    elif args.action == 'pick':
        pick()
    elif args.action == 'daemon':
        daemon()
    elif args.action == 'generate':
        start_generation(args.theme)
    elif args.action == 'edit-prompts':
        edit_prompts()
    else:
        update(args.action, args.artwork_id)


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(f'oldbook-wallpaper: {error}', file=sys.stderr)
        sys.exit(1)
