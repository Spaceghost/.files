{
  "positionX": "right",
  "positionY": "top",
  "layer": "top",
  "control-center-layer": "top",
  "layer-shell-cover-screen": false,
  "control-center-exclusive-zone": false,
  "control-center-margin-top": 50,
  "control-center-margin-bottom": 14,
  "control-center-margin-right": 14,
  "control-center-width": 380,
  "control-center-height": -1,
  "notification-window-width": 380,
  "notification-icon-size": 48,
  "timeout": 8,
  "timeout-low": 4,
  "fit-to-screen": true,
  "keyboard-shortcuts": false,
  "transition-time": 0,
  "image-visibility": "when-available",
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "backlight",
    "buttons-grid",
    "notifications"
  ],
  "scripts": {
    "ghost-urgent": {
      "exec": "~/.local/bin/oldbook-sound urgent-notification",
      "urgency": "Critical"
    },
    "claude-focus": {
      "exec": "~/.local/bin/oldbook-claude-notify-focus",
      "app-name": "^Claude$",
      "run-on": "action"
    },
    "focus-sender": {
      "exec": "~/.local/bin/oldbook-notify-focus",
      "app-name": ".*",
      "run-on": "action"
    }
  },
  "widget-config": {
    "title": {
      "text": "INCOMING TRANSMISSIONS",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Off the air"
    },
    "mpris": {
      "show-album-art": "when-available",
      "autohide": true,
      "loop-carousel": false
    },
    "volume": {
      "label": "\udb81\udd7e",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": false,
      "expand-per-app": false,
      "empty-list-label": "Nothing on the air",
      "expand-button-label": "\udb80\udd40",
      "collapse-button-label": "\udb80\udd43",
      "animation-type": "slide_down",
      "animation-duration": 180
    },
    "backlight": {
      "label": "\udb80\udcdf",
      "device": "gmux_backlight",
      "subsystem": "backlight",
      "min": 40
    },
    "buttons-grid": {
      "buttons-per-row": 3,
      "actions": [
        {
          "label": "Caffeinate",
          "type": "toggle",
          "command": "~/.local/bin/oldbook-caffeinate set",
          "update-command": "~/.local/bin/oldbook-caffeinate status"
        },
        {
          "label": "\udb80\udf3e  Lock",
          "command": "~/.local/bin/oldbook-lock"
        },
        {
          "label": "\udb80\udea0  Deck",
          "command": "~/.local/bin/oldbook-control"
        },
        {
          "label": "\udb82\udd28  Wi-Fi",
          "command": "~/.local/bin/oldbook-wifi menu"
        },
        {
          "label": "\udb83\ude09  Next art",
          "command": "~/.local/bin/oldbook-wallpaper next"
        },
        {
          "label": "\udb80\udfe4  Hold art",
          "type": "toggle",
          "command": "~/.local/bin/oldbook-wallpaper pause",
          "update-command": "~/.local/bin/oldbook-wallpaper status 2>/dev/null | grep -q 'class.: .paused' && echo true || echo false"
        },
        {
          "label": "\udb80\udf6d  Mic off",
          "type": "toggle",
          "command": "~/.local/bin/oldbook-audio mic-mute",
          "update-command": "wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED && echo true || echo false"
        },
        {
          "label": "\udb84\udcac  Cards",
          "type": "toggle",
          "command": "~/.local/bin/oldbook-conky toggle",
          "update-command": "~/.local/bin/oldbook-conky status 2>/dev/null | grep -q ^on && echo true || echo false"
        }
      ]
    },
    "notifications": {
      "vexpand": true
    }
  },
  "layer-shell": true
}
