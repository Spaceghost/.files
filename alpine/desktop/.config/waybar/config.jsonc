{
  "layer": "top",
  "position": "top",
  "height": 42,
  "spacing": 2,
  "margin-top": 10,
  "margin-left": 18,
  "margin-right": 18,
  "exclusive": true,
  "reload_style_on_change": true,
  "modules-left": [
    "custom/ghost",
    "cffi/art",
    "sway/workspaces",
    "custom/ai",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window",
    "mpris"
  ],
  "modules-right": [
    "group/telemetry",
    "group/transmission",
    "group/sound",
    "group/power",
    "custom/notifications",
    "clock",
    "tray"
  ],
  "custom/ghost": {
    "format": "\udb80\udea0",
    "tooltip-format": "<b>SPACE GHOST \u00b7 COAST TO COAST</b>\nYour local control room. Zorak is not the administrator.\n\nLeft: command deck \u00b7 Right: applications",
    "on-click": "~/.local/bin/oldbook-control",
    "on-click-right": "~/.local/bin/oldbook-menu"
  },
  "sway/workspaces": {
    "disable-scroll": false,
    "warp-on-scroll": false,
    "all-outputs": false,
    "format": "{value}",
    "disable-markup": true
  },
  "sway/mode": {
    "format": "\udb81\ude33 {}"
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 24,
    "icon": true,
    "icon-size": 14,
    "all-outputs": false,
    "tooltip": true,
    "on-click": "~/.local/bin/oldbook-control windows",
    "rewrite": {
      "": "TRANSMISSION STANDBY",
      "(.*) \u2014 Mozilla Firefox": "$1",
      "(.*) - Mozilla Firefox": "$1"
    }
  },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "\udb80\udfe4 {dynamic}",
    "dynamic-order": [
      "title",
      "artist"
    ],
    "dynamic-len": 23,
    "title-len": 23,
    "artist-len": 12,
    "max-length": 25,
    "status-icons": {
      "playing": "\udb80\udf86",
      "paused": "\udb80\udfe4",
      "stopped": "\udb81\udcdb"
    },
    "tooltip-format": "<b>{title}</b>\n{artist}\n{player} \u00b7 {status}\n\nLeft: play/pause \u00b7 Right: next \u00b7 Middle: previous"
  },
  "group/telemetry": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 220,
      "children-class": "drawer-child",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "disk"
    ]
  },
  "cpu": {
    "interval": 3,
    "format": "\udb80\udf5b {usage}%",
    "on-click": "foot --title=\"Ghost Reactor\" -e btop"
  },
  "memory": {
    "interval": 5,
    "format": "\udb81\ude1a {percentage}%",
    "tooltip-format": "<b>MEMORY</b>\n{used:0.1f} / {total:0.1f} GiB\nAvailable: {avail:0.1f} GiB",
    "on-click": "foot --title=\"Ghost Reactor\" -e btop"
  },
  "temperature": {
    "interval": 5,
    "critical-threshold": 82,
    "format": "\udb81\udd04 {temperatureC}\u00b0",
    "format-critical": "\udb83\ude01 {temperatureC}\u00b0",
    "tooltip-format": "<b>THERMAL CORE</b>\n{temperatureC}\u00b0C / {temperatureF}\u00b0F"
  },
  "disk": {
    "interval": 60,
    "path": "/",
    "format": "\udb80\udeca {percentage_used}%",
    "tooltip-format": "<b>ROOT STORAGE</b>\n{used} used \u00b7 {free} free",
    "on-click": "thunar"
  },
  "group/transmission": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 220,
      "children-class": "drawer-child",
      "transition-left-to-right": false
    },
    "modules": [
      "custom/link",
      "custom/radio",
      "custom/firewall"
    ]
  },
  "custom/link": {
    "exec": "~/.local/bin/oldbook-panel-status network",
    "return-type": "json",
    "interval": 3,
    "on-click": "~/.local/bin/oldbook-control network",
    "on-click-right": "foot --title=\"Transmission Status\" -e ~/.local/bin/oldbook-control network-report",
    "max-length": 14
  },
  "custom/radio": {
    "exec": "~/.local/bin/oldbook-panel-status radio",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/oldbook-control network"
  },
  "custom/firewall": {
    "exec": "~/.local/bin/oldbook-panel-status firewall",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.local/bin/oldbook-control firewall"
  },
  "group/sound": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 220,
      "children-class": "drawer-child",
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio#mic"
    ]
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\udb81\udd81",
    "format-icons": {
      "headphone": "\udb80\udecb",
      "headset": "\udb80\udece",
      "default": [
        "\udb81\udd7f",
        "\udb81\udd80",
        "\udb81\udd7e"
      ]
    },
    "tooltip-format": "<b>SPACE GHOST SOUND SYSTEM</b>\n{desc}\nVolume: {volume}%\n\nScroll: volume \u00b7 Left: mixer \u00b7 Right: mute\nHover to reveal microphone.",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "pavucontrol",
    "on-click-right": "~/.local/bin/oldbook-audio mute"
  },
  "pulseaudio#mic": {
    "format": "{format_source}",
    "format-source": "\udb80\udf6c {volume}%",
    "format-source-muted": "\udb80\udf6d off",
    "tooltip-format": "<b>MICROPHONE</b>\nClick to toggle microphone mute.",
    "on-click": "~/.local/bin/oldbook-audio mic-mute",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },
  "group/power": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 220,
      "children-class": "drawer-child",
      "transition-left-to-right": false
    },
    "modules": [
      "battery",
      "backlight",
      "idle_inhibitor"
    ]
  },
  "battery": {
    "bat": "BAT0",
    "interval": 20,
    "states": {
      "warning": 25,
      "critical": 10
    },
    "format": "{icon} {capacity}%",
    "format-charging": "\udb80\udc84 {capacity}%",
    "format-plugged": "\udb81\udea5 {capacity}%",
    "format-icons": [
      "\udb80\udc8e",
      "\udb80\udc7a",
      "\udb80\udc7c",
      "\udb80\udc7e",
      "\udb80\udc80",
      "\udb80\udc79"
    ],
    "tooltip-format": "<b>POWER RESERVE</b>\n{capacity}% \u00b7 {timeTo}\nPower draw: {power} W\n\nLeft: session controls\nHover for brightness and keep-awake.",
    "on-click": "~/.local/bin/oldbook-control power"
  },
  "backlight": {
    "format": "\udb80\udcdf {percent}%",
    "tooltip-format": "<b>MOONLIGHT</b>\nDisplay brightness: {percent}%\nScroll to adjust.",
    "on-scroll-up": "~/.local/bin/oldbook-brightness up",
    "on-scroll-down": "~/.local/bin/oldbook-brightness down"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "\udb80\udd76",
      "deactivated": "\udb83\udfaa"
    },
    "tooltip-format-activated": "<b>ON AIR</b>\nKeeping this display awake. Click to resume idle locking.",
    "tooltip-format-deactivated": "<b>OFF AIR</b>\nAutomatic idle locking is enabled. Click to keep awake."
  },
  "custom/notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "\udb84\udd6b",
      "none": "\udb80\udc9a",
      "dnd-notification": "\udb80\udc9b",
      "dnd-none": "\udb80\udc9b",
      "inhibited-notification": "\udb80\udc9b",
      "inhibited-none": "\udb80\udc9b",
      "dnd-inhibited-notification": "\udb80\udc9b",
      "dnd-inhibited-none": "\udb80\udc9b"
    },
    "tooltip": true,
    "tooltip-format": "<b>INCOMING TRANSMISSIONS</b>\nLeft: notification center\nRight: toggle Do Not Disturb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "restart-interval": 3
  },
  "clock": {
    "interval": 1,
    "format": "{:%a %H:%M}",
    "format-alt": "{:%d %b \u00b7 %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>\nClick: date and seconds \u00b7 Scroll: browse months",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color=\"#f7c1ff\"><b>{}</b></span>",
        "weekdays": "<span color=\"#9c8cae\">{}</span>",
        "today": "<span color=\"#ff8fcb\"><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_down",
      "on-scroll-down": "shift_up"
    },
    "timezone": "America/Los_Angeles"
  },
  "tray": {
    "icon-size": 15,
    "spacing": 8
  },
  "cffi/art": {
    "module_path": "/usr/lib/waybar/oldbook-art.so"
  },
  "custom/ai": {
    "exec": "~/.local/bin/oldbook-workspaces status",
    "return-type": "json",
    "interval": 2,
    "on-click": "~/.local/bin/oldbook-workspaces ai-next",
    "on-click-right": "~/.local/bin/oldbook-workspaces ai-menu"
  }
}
