{
  "session_prefix": "agent",
  "terminal": [
    "foot",
    "--app-id=oldbook-agent",
    "--title={title}",
    "-e"
  ],
  "workdirs": [
    "~",
    "~/.files",
    "~/src/*",
    "~/go"
  ],
  "remember_workdir": true,
  "lead": [
    "codex-best",
    "claude-best"
  ],
  "quick": "codex-best",
  "agents": [
    {
      "id": "codex-best",
      "title": "Codex",
      "enabled": true,
      "model": "gpt-6-astra",
      "effort": "ultra",
      "trust": true,
      "command": [
        "codex",
        "--search",
        "--dangerously-bypass-approvals-and-sandbox",
        "--model",
        "{model}",
        "-c",
        "model_reasoning_effort=\"{effort}\""
      ]
    },
    {
      "id": "claude-best",
      "title": "Claude",
      "enabled": true,
      "model": "claude-fable-5-1",
      "effort": "max",
      "trust": true,
      "command": [
        "claude",
        "--model",
        "{model}",
        "--effort",
        "{effort}",
        "--dangerously-skip-permissions",
        "--settings",
        "{\"sandbox\":{\"enabled\":false},\"skipDangerousModePermissionPrompt\":true}"
      ]
    },
    {
      "id": "codex",
      "title": "Codex",
      "enabled": true,
      "models": [
        "gpt-6-astra",
        "gpt-5.6-sol",
        "gpt-5.6-terra",
        "gpt-5.6-luna",
        "gpt-5.5",
        "gpt-5.3-codex-spark"
      ],
      "efforts": [
        "ultra",
        "max",
        "xhigh",
        "high",
        "medium",
        "low"
      ],
      "trust": true,
      "command": [
        "codex",
        "--search",
        "--dangerously-bypass-approvals-and-sandbox",
        "--model",
        "{model}",
        "-c",
        "model_reasoning_effort=\"{effort}\""
      ]
    },
    {
      "id": "claude",
      "title": "Claude",
      "enabled": true,
      "models": [
        "claude-fable-5-1",
        "claude-opus-5",
        "claude-sonnet-5",
        "claude-haiku-4-5-20251001"
      ],
      "efforts": [
        "max",
        "xhigh",
        "high",
        "medium",
        "low"
      ],
      "trust": true,
      "command": [
        "claude",
        "--model",
        "{model}",
        "--effort",
        "{effort}",
        "--dangerously-skip-permissions",
        "--settings",
        "{\"sandbox\":{\"enabled\":false},\"skipDangerousModePermissionPrompt\":true}"
      ]
    },
    {
      "id": "shell",
      "title": "Shell",
      "subtitle": "A plain tmux shell, here",
      "enabled": true,
      "command": [
        "zsh"
      ]
    },
    {
      "id": "alienware-codex",
      "title": "Codex on alienware",
      "subtitle": "Codex CLI over Tailscale SSH",
      "enabled": true,
      "host": "alienware",
      "command": [
        "codex",
        "--search",
        "--dangerously-bypass-approvals-and-sandbox",
        "-s",
        "danger-full-access"
      ],
      "transport": "tailscale-ssh"
    },
    {
      "id": "alienware-claude",
      "title": "Claude Code on alienware",
      "subtitle": "Claude Code over Tailscale SSH",
      "enabled": true,
      "host": "alienware",
      "command": [
        "claude",
        "--dangerously-skip-permissions",
        "--settings",
        "{\"sandbox\":{\"enabled\":false},\"skipDangerousModePermissionPrompt\":true}"
      ],
      "transport": "tailscale-ssh"
    },
    {
      "id": "alienware-ollama",
      "title": "Local model on alienware",
      "subtitle": "on the box with the GPU",
      "enabled": true,
      "host": "alienware",
      "model": "qwen3.5:27b-text",
      "command": [
        "ollama",
        "run",
        "{model}"
      ],
      "transport": "tailscale-ssh"
    },
    {
      "id": "alienware-ollama-small",
      "title": "Local model on alienware",
      "subtitle": "quicker to load",
      "enabled": true,
      "host": "alienware",
      "transport": "tailscale-ssh",
      "model": "qwen3.5:9b",
      "command": [
        "ollama",
        "run",
        "{model}"
      ]
    },
    {
      "id": "alienware-shell",
      "title": "Shell on alienware",
      "subtitle": "A plain login shell over Tailscale SSH",
      "enabled": true,
      "host": "alienware",
      "command": [
        "$SHELL",
        "-l"
      ],
      "transport": "tailscale-ssh"
    }
  ]
}
