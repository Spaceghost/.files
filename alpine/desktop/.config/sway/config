# Spaceghost / MBP Intel Sway session — MacBookPro11,5 internal panel (2880x1800, 2x).
# The deployer expands this overlay into HOME; wallpaper is supplied separately.
set $mod Mod4
set $term foot
set $menu ~/.local/bin/mbp-intel-menu
set $lock ~/.local/bin/mbp-intel-lock
set $wallpaper ~/.local/share/mbp-intel/wallpaper.png

# Palette and window chrome are switchable without changing shortcuts.
gaps inner 3
gaps outer 4
include ~/.config/sway/theme.conf
smart_gaps off
focus_follows_mouse yes
mouse_warping output
focus_on_window_activation smart

# Stable, native panel settings.  Do not apply an unverified external display mode.
output eDP-1 mode 2880x1800@60Hz scale 2 position 0 0
output * bg $wallpaper fill

input type:touchpad {
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    dwt enabled
    click_method clickfinger
    middle_emulation enabled
    accel_profile adaptive
    pointer_accel 0.2
}
include ~/.config/sway/gestures.conf

input type:keyboard {
    xkb_layout us
    xkb_options caps:escape
    xkb_capslock disabled
    xkb_numlock enabled
}

# Super+Enter is defined once in local.d/terminal.conf.
bindsym $mod+Shift+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+d exec ~/.local/bin/mbp-intel-control
bindsym $mod+g exec ~/.local/bin/mbp-intel-wallpaper pick
bindsym $mod+Shift+g exec ~/.local/bin/mbp-intel-conky toggle
bindsym $mod+slash exec ~/.local/bin/mbp-intel-scripture find
bindsym $mod+Ctrl+Right exec ~/.local/bin/mbp-intel-wallpaper next
bindsym $mod+Ctrl+Left exec ~/.local/bin/mbp-intel-wallpaper prev
bindsym $mod+Shift+p exec ~/.local/bin/mbp-intel-wallpaper pause
bindsym $mod+Shift+n exec swaync-client -t
bindsym $mod+i exec ~/.local/bin/mbp-intel-workspaces ai-next
bindsym $mod+n exec ~/.local/bin/mbp-intel-agents
bindsym $mod+Ctrl+n exec ~/.local/bin/mbp-intel-agents quick
bindsym $mod+Shift+i exec ~/.local/bin/mbp-intel-workspaces ai-menu
bindsym $mod+Shift+q kill
bindsym $mod+Ctrl+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Leave the Spaceghost session?' -B 'Log out' 'swaymsg exit'
bindsym $mod+Escape exec $lock
bindsym $mod+Shift+r mode "resize"

# Vim navigation is also directional on the physical arrow keys.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# The number reuses existing custom workspaces; the full label names new ones
# immediately, before the application naming service receives any event.
bindsym $mod+1 workspace number "1: Ghost"
bindsym $mod+2 workspace number "2: Orbit"
bindsym $mod+3 workspace number "3: Lab"
bindsym $mod+4 workspace number "4: Signal"
bindsym $mod+5 workspace number "5: Lounge"
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 exec ~/.local/bin/mbp-intel-strata
bindsym $mod+Shift+1 move container to workspace number "1: Ghost"
bindsym $mod+Shift+2 move container to workspace number "2: Orbit"
bindsym $mod+Shift+3 move container to workspace number "3: Lab"
bindsym $mod+Shift+4 move container to workspace number "4: Signal"
bindsym $mod+Shift+5 move container to workspace number "5: Lounge"
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number "10: Strata"

# STRATA uses the 0 key and workspace 10, after workspaces 1 through 9.
assign [app_id="^mbp-intel-strata$"] workspace number "10: Strata"
no_focus [app_id="^mbp-intel-strata$"]

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+Shift+space exec ~/.local/bin/mbp-intel-resize near-full
bindsym $mod+a focus parent
bindsym $mod+Shift+a focus child
# Super/Alt+Tab share the window carousel in local.d/window-switcher.conf.

# Caption only: middle click toggles tiled/floating. Left drag and right resize
# remain native; clicks in application content keep their usual meaning.
bindsym --release button2 floating toggle

bindsym Print exec ~/.local/bin/mbp-intel-screenshot full
bindsym Shift+Print exec ~/.local/bin/mbp-intel-screenshot area
bindsym Ctrl+Print exec ~/.local/bin/mbp-intel-screenshot window
bindsym XF86AudioRaiseVolume exec ~/.local/bin/mbp-intel-audio up
bindsym XF86AudioLowerVolume exec ~/.local/bin/mbp-intel-audio down
bindsym XF86AudioMute exec ~/.local/bin/mbp-intel-audio mute
bindsym XF86AudioMicMute exec ~/.local/bin/mbp-intel-audio mic-mute
bindsym XF86MonBrightnessUp exec ~/.local/bin/mbp-intel-brightness up
bindsym XF86MonBrightnessDown exec ~/.local/bin/mbp-intel-brightness down

mode "resize" {
    bindsym h resize shrink width 10 px or 5 ppt
    bindsym j resize grow height 10 px or 5 ppt
    bindsym k resize shrink height 10 px or 5 ppt
    bindsym l resize grow width 10 px or 5 ppt
    bindsym Left resize shrink width 10 px or 5 ppt
    bindsym Down resize grow height 10 px or 5 ppt
    bindsym Up resize shrink height 10 px or 5 ppt
    bindsym Right resize grow width 10 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

for_window [app_id="mbp-intel-agent"] floating enable, resize set width 1100 px height 700 px, move position center
for_window [app_id="mbp-intel-decoration-settings"] floating enable, move position center
for_window [app_id="pavucontrol"] floating enable, resize set width 900 px height 700 px, move position center
for_window [app_id="org.pwmt.zathura"] inhibit_idle fullscreen
for_window [title="Picture-in-Picture"] sticky enable, floating enable, resize set width 720 px height 405 px, move position 70 ppt 8 ppt

# mbp-intel-session is per-UID idempotent: reloads reuse the existing services.
# Pithos keeps playing with its window tucked away until the music bar opens it.
for_window [app_id="^(io[.]github[.]Pithos|pithos)$"] move scratchpad
for_window [class="^Pithos$"] move scratchpad

exec_always --no-startup-id ~/.local/bin/mbp-intel-session
include ~/.config/sway/local.d/*

# YouTube PiP is controlled from the launcher; its desktop mode uses a bottom layer.
for_window [app_id="mbp-intel-youtube"] floating enable, sticky enable, border pixel 0, resize set width 480 px height 270 px, move position 65 ppt 65 ppt
no_focus [app_id="mbp-intel-youtube"]
