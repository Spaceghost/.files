# Override for the Flatpak-exported 1Password entry.
#
# 1Password's Electron build submits its window through GPU-shared (dmabuf)
# buffers. On this MacBookPro11,5 the Radeon R9 M370X is driven by the legacy
# `radeon` kernel driver, and the buffers it hands the compositor are imported
# with the wrong pixel format and tiling: the window renders with red and blue
# swapped, interlaced text, horizontally sheared bands, and patches of stale
# video memory left over from other windows. Firefox and Foot on the same GPU
# render correctly, so the fault is specific to how Chromium allocates and
# presents these buffers, not to the driver or the compositor.
#
# --disable-gpu-compositing makes Chromium composite its window in software and
# hand the compositor an ordinary shared-memory buffer, which bypasses the
# broken path entirely. Measured over three cold starts each, the stock entry
# was corrupt every time while this one was pixel-identical every time.
# 1Password's interface is static enough that software compositing costs
# nothing noticeable. Remove the flag to test whether a later 1Password,
# Electron, Mesa or wlroots release has fixed the underlying bug.
[Desktop Entry]
Type=Application
Name=1Password
Exec=/usr/bin/flatpak run --branch=stable --arch=x86_64 --command=1password --file-forwarding com.onepassword.OnePassword --disable-gpu-compositing @@u %U @@
Icon=com.onepassword.OnePassword
Terminal=false
Categories=Utility;Security;
StartupWMClass=1Password
MimeType=x-scheme-handler/onepassword;
X-Flatpak=com.onepassword.OnePassword
