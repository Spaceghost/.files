#!/usr/bin/env python3
"""Build and verify the pinned Cascadia testing Codex APK without network."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import pwd
import shlex
import shutil
import subprocess


def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source-cache", type=Path, required=True)
    parser.add_argument("--work", type=Path, required=True, help="New build directory")
    args = parser.parse_args()
    if os.geteuid() == 0:
        parser.error("run as the build user; doas only creates network isolation")

    recipe = Path(__file__).resolve().parent
    manifest = json.loads((recipe / "manifest.json").read_text())
    source_cache = args.source_cache.resolve(strict=True)
    work = args.work.absolute()
    work.mkdir(parents=True, exist_ok=False)
    stage = work / "testing/codex"
    stage.mkdir(parents=True)
    distfiles = work / "distfiles"
    distfiles.mkdir()

    for name in ("APKBUILD", "alpine-adaptations.json", "verify-install"):
        shutil.copy2(recipe / name, stage / name)
    for source in manifest["sources"]:
        cached = source_cache / source["name"]
        if not cached.is_file() or digest(cached) != source["sha256"]:
            parser.error(f"source cache does not match manifest: {cached}")
        destination = distfiles / source["name"]
        try:
            os.link(cached, destination)
        except OSError:
            shutil.copy2(cached, destination)

    user = pwd.getpwuid(os.getuid()).pw_name
    abuild = [
        "abuild", "-d", "-K", "-P", str(work / "apks"),
        "-s", str(distfiles),
    ]
    isolated = [
        "doas", "-n", "unshare", "--net", "--", "su", user,
        "-s", "/bin/sh", "-c",
        "cd " + shlex.quote(str(stage)) + " && exec " + shlex.join(abuild),
    ]
    with (work / "build.log").open("w") as log:
        result = subprocess.run(isolated, stdout=log, stderr=subprocess.STDOUT)
    if result.returncode:
        raise SystemExit(f"build failed; see {work / 'build.log'}")

    packages = sorted((work / "apks/testing").glob("*/codex-*.apk"))
    if len(packages) != 1:
        raise SystemExit(f"expected one Codex APK, found {len(packages)}")
    package = packages[0]
    subprocess.run(["apk", "verify", str(package)], check=True)
    extracted = work / "extracted"
    extracted.mkdir()
    subprocess.run(
        ["apk", "extract", "--destination", str(extracted), str(package)],
        check=True,
    )
    subprocess.run([str(recipe / "verify-install"), str(extracted)], check=True)
    print(f"{digest(package)}  {package}")


if __name__ == "__main__":
    main()
