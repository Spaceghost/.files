# Maintainer: Oldbook local package <oldbook@localhost.invalid>
# shellcheck shell=sh disable=SC2034,SC2154
pkgname=codex
pkgver=0.153.4
pkgrel=0
pkgdesc="Native OpenAI Codex CLI, app server, helpers and responses proxy"
url="https://github.com/openai/codex"
arch="x86_64"
license="Apache-2.0"
depends="ca-certificates-bundle git zsh"
checkdepends="python3"
_target="x86_64-unknown-linux-musl"
_cli="codex-package-$_target.tar.gz"
_app="codex-app-server-package-$_target.tar.gz"
_proxy="codex-responses-api-proxy-$_target.tar.gz"
_proxy_bin="${_proxy%.tar.gz}"
source="
    https://github.com/openai/codex/releases/download/rust-v$pkgver/$_cli
    https://github.com/openai/codex/releases/download/rust-v$pkgver/$_app
    https://github.com/openai/codex/releases/download/rust-v$pkgver/$_proxy
    alpine-adaptations.json
    verify-install
    "
options="!net !strip !tracedeps"
builddir="$srcdir/$pkgname-$pkgver"
export SOURCE_DATE_EPOCH=1788564289

unpack() {
    mkdir -p "$builddir/cli" "$builddir/app-server" "$builddir/proxy"
    tar -xzf "$srcdir/$_cli" -C "$builddir/cli"
    tar -xzf "$srcdir/$_app" -C "$builddir/app-server"
    tar -xzf "$srcdir/$_proxy" -C "$builddir/proxy"
}

build() {
    _runtime="$builddir/stage/usr/lib/codex/$pkgver"
    mkdir -p "$_runtime" "$builddir/stage/usr/bin"
    cp -a "$builddir/cli" "$_runtime/cli"
    cp -a "$builddir/app-server" "$_runtime/app-server"
    cp -a "$builddir/proxy" "$_runtime/proxy"

    mv "$_runtime/proxy/$_proxy_bin" \
        "$_runtime/proxy/codex-responses-api-proxy"
    for _part in cli app-server; do
        _shell="$_runtime/$_part/codex-resources/zsh/bin/zsh"
        mv "$_shell" "$_shell.upstream-gnu"
        ln -s /bin/zsh "$_shell"
    done
    install -Dm0644 "$srcdir/alpine-adaptations.json" \
        "$_runtime/alpine-adaptations.json"

    ln -s "../lib/codex/$pkgver/cli/bin/codex" \
        "$builddir/stage/usr/bin/codex"
    ln -s "../lib/codex/$pkgver/cli/bin/codex-code-mode-host" \
        "$builddir/stage/usr/bin/codex-code-mode-host"
    ln -s "../lib/codex/$pkgver/app-server/bin/codex-app-server" \
        "$builddir/stage/usr/bin/codex-app-server"
    ln -s "../lib/codex/$pkgver/proxy/codex-responses-api-proxy" \
        "$builddir/stage/usr/bin/codex-responses-api-proxy"
}

check() {
    python3 "$srcdir/verify-install" "$builddir/stage"
}

package() {
    mkdir -p "$pkgdir"
    cp -a "$builddir/stage/." "$pkgdir/"
}

sha512sums="
