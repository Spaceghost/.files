#!/usr/bin/env python3
"""Verify a complete staged native Codex installation without network use."""

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


VERSION = "0.153.4"
TARGET = "x86_64-unknown-linux-musl"


def fail(message):
    raise SystemExit(f"verify-install: {message}")


def require_executable(path):
    if not path.is_file() or not os.access(path, os.X_OK):
        fail(f"missing executable {path}")


def check_metadata(runtime, part, variant, entrypoint):
    path = runtime / part / "codex-package.json"
    try:
        metadata = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"invalid package metadata {path}: {error}")
    expected = {
        "layoutVersion": 1,
        "version": VERSION,
        "target": TARGET,
        "variant": variant,
        "entrypoint": entrypoint,
        "resourcesDir": "codex-resources",
        "pathDir": "codex-path",
    }
    if metadata != expected:
        fail(f"unexpected package metadata {path}")


def run_check(path, argument, expected):
    env = os.environ.copy()
    with tempfile.TemporaryDirectory(prefix="codex-native-check-") as codex_home:
        env["CODEX_HOME"] = codex_home
        result = subprocess.run(
            [str(path), argument],
            stdin=subprocess.DEVNULL,
            text=True,
            capture_output=True,
            env=env,
            timeout=15,
            check=False,
        )
    output = result.stdout + result.stderr
    if result.returncode != 0 or expected not in output:
        fail(f"native launch failed for {path}: exit {result.returncode}")


def run_protocol_eof_check(path):
    env = os.environ.copy()
    with tempfile.TemporaryDirectory(prefix="codex-native-check-") as codex_home:
        env["CODEX_HOME"] = codex_home
        result = subprocess.run(
            [str(path), "--listen", "stdio"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
            timeout=15,
            check=False,
        )
    if result.returncode != 0:
        fail(f"helper protocol EOF check failed for {path}: exit {result.returncode}")


def main():
    if len(sys.argv) != 2:
        fail("usage: verify-install ROOT")
    root = Path(sys.argv[1]).resolve()
    runtime = root / f"usr/lib/codex/{VERSION}"
    if not runtime.is_dir():
        fail(f"missing runtime {runtime}")

    for path in runtime.rglob("*"):
        if {"node", "node_modules", "npm"}.intersection(path.parts):
            fail(f"npm/node payload is forbidden: {path}")

    check_metadata(runtime, "cli", "codex", "bin/codex")
    check_metadata(
        runtime,
        "app-server",
        "codex-app-server",
        "bin/codex-app-server",
    )

    checks = (
        ("app-server/bin/codex-code-mode-host", "--help", "codex-code-mode-host"),
        ("cli/codex-path/rg", "--version", "ripgrep"),
        ("app-server/codex-path/rg", "--version", "ripgrep"),
        ("cli/codex-resources/bwrap", "--version", "bubblewrap"),
        ("app-server/codex-resources/bwrap", "--version", "bubblewrap"),
    )
    for relative, argument, expected in checks:
        executable = runtime / relative
        require_executable(executable)
        run_check(executable, argument, expected)

    for part in ("cli", "app-server"):
        shell = runtime / part / "codex-resources/zsh/bin/zsh"
        if not shell.is_symlink() or os.readlink(shell) != "/bin/zsh":
            fail(f"private zsh must resolve through APK-managed /bin/zsh: {shell}")
        require_executable(shell.parent / "zsh.upstream-gnu")
        run_check(shell, "--version", "zsh ")

    adaptation = runtime / "alpine-adaptations.json"
    try:
        adaptation_data = json.loads(adaptation.read_text())
    except (OSError, json.JSONDecodeError) as error:
        fail(f"invalid Alpine adaptation metadata {adaptation}: {error}")
    if adaptation_data.get("private_zsh") != "/bin/zsh":
        fail(f"unexpected Alpine adaptation metadata {adaptation}")

    links = {
        "codex": f"../lib/codex/{VERSION}/cli/bin/codex",
        "codex-code-mode-host": f"../lib/codex/{VERSION}/cli/bin/codex-code-mode-host",
        "codex-app-server": f"../lib/codex/{VERSION}/app-server/bin/codex-app-server",
        "codex-responses-api-proxy": (
            f"../lib/codex/{VERSION}/proxy/codex-responses-api-proxy"
        ),
    }
    for name, expected in links.items():
        link = root / "usr/bin" / name
        if not link.is_symlink() or os.readlink(link) != expected:
            fail(f"unexpected stable launcher {link}")

    launcher_checks = (
        ("codex", "--version", f"codex-cli {VERSION}"),
        ("codex-code-mode-host", "--help", "codex-code-mode-host"),
        ("codex-app-server", "--help", "codex-app-server"),
        (
            "codex-responses-api-proxy",
            "--help",
            "codex-responses-api-proxy",
        ),
    )
    for name, argument, expected in launcher_checks:
        run_check(root / "usr/bin" / name, argument, expected)
    run_protocol_eof_check(root / "usr/bin/codex-code-mode-host")
    run_protocol_eof_check(runtime / "app-server/bin/codex-code-mode-host")

    print(f"verified Codex {VERSION} native CLI, app-server, helpers and proxy")


if __name__ == "__main__":
    main()
