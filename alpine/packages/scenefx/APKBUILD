# Contributor: omni <omni+alpine@hack.org>
# Maintainer: Oldbook local package <oldbook@localhost.invalid>
pkgname=scenefx
pkgver=0.5
pkgrel=1
pkgdesc="wlroots scene API with eye-candy effects, with blur damage compensation fixed"
url="https://github.com/wlrfx/scenefx"
arch="x86_64"
license="MIT"
subpackages="$pkgname-dev $pkgname-doc"
makedepends="glslang
	lcms2-dev
	libxkbcommon-dev
	meson
	pkgconf
	samurai
	wayland-protocols
	wlroots0.20-dev
	"
# No tests upstream. The pinned tarball travels beside this recipe, so the
# compile itself never reaches the network.
options="!check !net"
source="scenefx-$pkgver.tar.gz
	add-missing-include-for__always_inline.patch
	blur-damage-output-clip.patch
	blur-damage-coverage.patch
	"
builddir="$srcdir/$pkgname-$pkgver"
export SOURCE_DATE_EPOCH=1782624992

depends_dev="$pkgname=$pkgver-r$pkgrel"

build() {
	# Alpine community/scenefx 0.5-r0 configures the same options through
	# abuild-muon. This checkout uses meson instead: it is the project's own
	# build system, abuild-meson supplies Alpine's prefix, plain buildtype and
	# hardening flags, and nothing here depends on which of the two reads
	# meson.build. Enabling the auto features keeps colour management on,
	# exactly as the official package this replaces was built; it has to be the
	# --auto-features spelling, because abuild-meson already passes that option
	# and meson refuses to be given the same setting under both names.
	abuild-meson \
		--auto-features=enabled \
		-Dexamples=false \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

