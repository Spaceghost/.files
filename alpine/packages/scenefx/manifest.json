    {
      "filename": "blur-damage-output-clip.patch",
      "sha256": "b2fb6e7a2ff897353847c42d1fdf929edb3ba385cf7972a1759f94143d6bb2ee",
      "upstream_commit": "06fb6d8dac68485d1cac075baa60a15408a84666",
      "url": "https://github.com/wlrfx/scenefx/commit/06fb6d8dac68485d1cac075baa60a15408a84666",
      "purpose": "Clip the blur damage compensation to the output before publishing it, and treat an empty intersection as no compensation. Backported because the coverage fix makes this path run on nearly every frame."
    },
    {
      "filename": "blur-damage-coverage.patch",
      "sha256": "f5f4ea9f83e32e5e5cd6f5633824cd7e68af18375f4fdecf6f61094d556e0267",
      "upstream_commit": "3606f3d3bb4bb97e13228adc5190bf57fc687c88",
      "url": "https://github.com/wlrfx/scenefx/commit/3606f3d3bb4bb97e13228adc5190bf57fc687c88",
      "purpose": "Decide 'the whole output is damaged' by region coverage instead of the damage bounding box, so a small cursor rectangle far from another repaint no longer disables blur damage expansion and leaves smeared squares tracking the pointer."
    }
