# Maintainer: Oldbook local package <oldbook@localhost.invalid>
pkgname=hold-to-help
pkgver=0.1.0
pkgrel=0
pkgdesc="Theme-aware contextual shortcut guide for Sway and X11 desktops"
url="https://github.com/Spaceghost/.files"
arch="all"
license="GPL-3.0-or-later"
depends="python3 py3-qt6 py3-xlib xkbcomp dbus qt6-qtwayland layer-shell-qt"
makedepends="cmake ninja qt6-qtbase-dev layer-shell-qt-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
options="!net"
export SOURCE_DATE_EPOCH=1788739200
export PYTHONDONTWRITEBYTECODE=1

build() {
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=ON
    cmake --build build
}

check() {
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure
    python3 bin/hold-to-help --version
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}

sha512sums="
639b4560aa2ccb4b5464dceae168cabe6b283c9312b547eadfd0646d6e2c1c0520a2eb903eb4174d353444e2911f44997347122dea570a5f76a609fd3acd8319  hold-to-help-0.1.0.tar.gz
"
