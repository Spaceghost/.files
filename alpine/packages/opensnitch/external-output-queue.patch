+func TestExternalOutputQueueRequiresDNSRule(t *testing.T) {
+	nftest.SkipIfNotPrivileged(t)
+	t.Setenv("OPENSNITCH_EXTERNAL_OUTPUT_QUEUE", "1")
+
+	conn, newNS := nftest.OpenSystemConn(t)
+	defer nftest.CleanupSystemConn(t, newNS)
+	nftest.Fw.Conn = conn
+
+	addInterceptionRules(nftest.Fw, t)
+	if !nftest.Fw.AreRulesLoaded() {
+		t.Fatal("DNS interception rule should satisfy external output queue mode")
+	}
+
+	table := nftest.Fw.GetTable(exprs.TABLE_OPENSNITCH, exprs.NFT_FAMILY_INET)
+	input := nftest.Fw.GetChain(exprs.CHAIN_FILTER_INPUT, table, exprs.NFT_FAMILY_INET)
+	conn.FlushChain(input)
+	if !nftest.Fw.Commit() {
+		t.Fatal("failed to remove DNS interception rule")
+	}
+	if _, err := nftest.Fw.AddRule(
+		exprs.CHAIN_MANGLE_OUTPUT,
+		exprs.TABLE_OPENSNITCH,
+		exprs.NFT_FAMILY_INET,
+		0,
+		nftb.InterceptionRuleKey,
+		exprs.NewNoTrack(),
+	); err != nil {
+		t.Fatalf("failed to add stale output interception rule: %v", err)
+	}
+
+	if nftest.Fw.AreRulesLoaded() {
+		t.Error("stale output interception rule must not substitute for the DNS rule")
+	}
+}
