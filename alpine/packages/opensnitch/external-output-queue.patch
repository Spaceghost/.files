+func TestExternalOutputQueueSkipsNativeQueue(t *testing.T) {
+	t.Setenv("OPENSNITCH_EXTERNAL_OUTPUT_QUEUE", "1")
+	fw, err := nftb.Fw()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if err1, err2 := fw.QueueConnections(true, true); err1 != nil || err2 != nil {
+		t.Fatalf("external output queue should not require a native nftables connection: %v, %v", err1, err2)
+	}
+}
