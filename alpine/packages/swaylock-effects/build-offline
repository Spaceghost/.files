#!/usr/bin/env python3
"""Build the coexisting swaylock-effects APK with no network or package-state changes."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import pwd
import shlex
import shutil
import subprocess


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", type=Path, help="Upstream tarball; defaults to the pinned copy beside this recipe")
    parser.add_argument("--work", type=Path, required=True, help="New build directory")
    args = parser.parse_args()
    recipe = Path(__file__).resolve().parent
    manifest = json.loads((recipe / "manifest.json").read_text())
    if os.geteuid() == 0:
        parser.error("Run as your build user; doas only creates network isolation")
    work = args.work.absolute()
    work.mkdir(parents=True, exist_ok=False)
    source = args.source or recipe / manifest["source"]["filename"]
    if not source.is_file():
        # The pinned upstream tarball is a Fossil unversioned artifact, not a
        # versioned file; export it from the checkout's repository.
        source = work / manifest["source"]["filename"]
        subprocess.run(["fossil", "uv", "export", manifest["source"]["artifact"], str(source)],
                       cwd=recipe.parents[2], check=True)
    source = source.resolve(strict=True)
    if hashlib.sha256(source.read_bytes()).hexdigest() != manifest["source"]["sha256"]:
        parser.error("Source SHA-256 differs from the pinned upstream release")
    stage = work / "oldbook" / "oldbook-swaylock-effects"
    stage.mkdir(parents=True)
    shutil.copy2(recipe / "APKBUILD", stage / "APKBUILD")
    for patch in manifest["patches"]:
        shutil.copy2(recipe / patch, stage / patch)
    shutil.copy2(source, stage / manifest["source"]["filename"])
    user = pwd.getpwuid(os.getuid()).pw_name
    command = ["abuild", "-d", "-K", "-P", str(work / "apks"), "-s", str(work / "distfiles")]
    isolated = ["doas", "-n", "unshare", "--net", "--", "su", user, "-s", "/bin/sh",
                "-c", "cd " + shlex.quote(str(stage)) + " && exec " + shlex.join(command)]
    with (work / "build.log").open("w") as log:
        result = subprocess.run(isolated, stdout=log, stderr=subprocess.STDOUT)
    if result.returncode:
        raise SystemExit(f"Build failed; see {work / 'build.log'}")
    packages = sorted((work / "apks" / "oldbook").glob("*/*.apk"))
    if not packages:
        raise SystemExit("Build produced no APKs")
    for package in packages:
        print(f"{hashlib.sha256(package.read_bytes()).hexdigest()}  {package}")


if __name__ == "__main__":
    main()
