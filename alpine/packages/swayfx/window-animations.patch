+// Shared bounds check: no one wants a window to take longer than five seconds
+// to open, and a negative duration has no meaning.
+static struct cmd_results *parse_duration(int argc, char **argv,
+		const char *name, float *out) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, name, EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+
+	char *err;
+	float val = strtof(argc == 1 ? argv[0] : argv[1], &err);
+	if (*err) {
+		return cmd_results_new(CMD_INVALID, "%s float invalid", name);
+	}
+	if (val < 0 || val > 5000) {
+		return cmd_results_new(CMD_FAILURE, "%s value out of bounds", name);
+	}
+
+	*out = val;
+	refresh_animation_manager_timing();
+	return NULL;
+}
+
+struct cmd_results *cmd_animations(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "animations", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+
+	// parse_boolean already accepts enable/yes/on/true/1 and toggle; every
+	// other word is false, which matches i3 and makes "disable" work.
+	const char *value = argc == 1 ? argv[0] : argv[1];
+	config->animations_enabled = parse_boolean(value, config->animations_enabled);
+
+	refresh_animation_manager_timing();
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_animation_open_ms(int argc, char **argv) {
+	struct cmd_results *error =
+		parse_duration(argc, argv, "animation_open_ms", &config->animation_open_ms);
+	return error ? error : cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_animation_close_ms(int argc, char **argv) {
+	struct cmd_results *error =
+		parse_duration(argc, argv, "animation_close_ms", &config->animation_close_ms);
+	return error ? error : cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_animation_move_ms(int argc, char **argv) {
+	struct cmd_results *error =
+		parse_duration(argc, argv, "animation_move_ms", &config->animation_move_ms);
+	return error ? error : cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_animation_workspace_ms(int argc, char **argv) {
+	struct cmd_results *error =
+		parse_duration(argc, argv, "animation_workspace_ms", &config->animation_workspace_ms);
+	return error ? error : cmd_results_new(CMD_SUCCESS, NULL);
+}
+
+struct cmd_results *cmd_animation_workspace_style(int argc, char **argv) {
+	struct cmd_results *error = NULL;
+	if ((error = checkarg(argc, "animation_workspace_style", EXPECTED_AT_LEAST, 1))) {
+		return error;
+	}
+
+	const char *value = argc == 1 ? argv[0] : argv[1];
+	if (strcasecmp(value, "slide") == 0) {
+		config->animation_workspace_style = ANIMATION_WORKSPACE_SLIDE;
+	} else if (strcasecmp(value, "fade") == 0) {
+		config->animation_workspace_style = ANIMATION_WORKSPACE_FADE;
+	} else if (strcasecmp(value, "both") == 0) {
+		config->animation_workspace_style = ANIMATION_WORKSPACE_BOTH;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'animation_workspace_style slide|fade|both'");
+	}
+
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
