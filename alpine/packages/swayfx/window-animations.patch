+// Leading digits of a workspace name give its place in the strip. Names without
+// a number sit at the end, which keeps the slide direction stable for them.
+static int workspace_slide_index(struct sway_workspace *ws) {
+	if (!ws || !ws->name) {
+		return INT_MAX;
+	}
+	char *end;
+	long value = strtol(ws->name, &end, 10);
+	if (end == ws->name || value < 0 || value > INT_MAX) {
+		return INT_MAX;
+	}
+	return (int)value;
+}
+
+// +1 when the new workspace lives to the right of the old one, -1 otherwise.
+static int workspace_slide_direction(struct sway_workspace *old_ws,
+		struct sway_workspace *new_ws) {
+	int old_index = workspace_slide_index(old_ws);
+	int new_index = workspace_slide_index(new_ws);
+	if (old_index == new_index) {
+		return 1;
+	}
+	return new_index > old_index ? 1 : -1;
+}
+
+// Offset every scene node that belongs to this workspace by the current slide
+// position. Tiling and fullscreen layers are per workspace; floating containers
+// are parented to the root floating layer, so they carry their own base.
+static void workspace_apply_slide(struct sway_workspace *ws, int offset) {
+	wlr_scene_node_set_position(&ws->layers.tiling->node, offset, 0);
+	wlr_scene_node_set_position(&ws->layers.fullscreen->node, offset, 0);
+
+	for (int i = 0; i < ws->current.floating->length; i++) {
+		struct sway_container *floater = ws->current.floating->items[i];
+		if (floater->animation_state.slide_owner != ws) {
+			// First tick for this container: remember where it really sits.
+			floater->animation_state.slide_base_x = floater->scene_tree->node.x;
+			floater->animation_state.slide_owner = ws;
+		}
+		wlr_scene_node_set_position(&floater->scene_tree->node,
+			floater->animation_state.slide_base_x + offset,
+			floater->scene_tree->node.y);
+	}
+}
+
+static void workspace_slide_update_callback(void *data) {
+	struct sway_workspace *ws = data;
+	if (!ws || !ws->output) {
+		return;
+	}
+
+	int offset = get_animated_value(ws->animation_state.from_x,
+		ws->animation_state.to_x, &ws->animation_state.animation);
+	workspace_apply_slide(ws, offset);
+
+	if (config->animation_workspace_style != ANIMATION_WORKSPACE_SLIDE) {
+		workspace_fade_update_callback(ws);
+	}
+}
+
+// Settle the scene graph back to its real coordinates. Leaving a stale offset
+// behind would misplace every window on the workspace for good.
+static void workspace_slide_finish(struct sway_workspace *ws) {
+	if (!ws || !ws->animation_state.sliding) {
+		return;
+	}
+	workspace_apply_slide(ws, 0);
+	for (int i = 0; i < ws->current.floating->length; i++) {
+		struct sway_container *floater = ws->current.floating->items[i];
+		if (floater->animation_state.slide_owner == ws) {
+			floater->animation_state.slide_owner = NULL;
+		}
+	}
+	ws->animation_state.sliding = false;
+	ws->animation_state.from_x = 0;
+	ws->animation_state.to_x = 0;
+}
+
+static void workspace_slide_complete_callback(void *data) {
+	struct sway_workspace *ws = data;
+	workspace_slide_finish(ws);
+	workspace_fade_complete_callback(data);
+}
