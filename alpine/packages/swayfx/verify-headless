#!/usr/bin/env python3
"""Exercise the exact SwayFX renderer and effect parser without changing a session."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import tempfile
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--binary", type=Path, required=True)
parser.add_argument("--wallpaper", type=Path, required=True)
parser.add_argument("--output", type=Path, required=True, help="New evidence directory")
parser.add_argument("--render-device", default="/dev/dri/renderD128")
args = parser.parse_args()
binary = args.binary.resolve(strict=True)
wallpaper = args.wallpaper.resolve(strict=True)
effects = Path(__file__).resolve().parent / "mbp-intel-effects.conf"
output = args.output.absolute()
output.mkdir(parents=True, exist_ok=False)
config = output / "sway.conf"
config.write_text(f'''xwayland disable
output HEADLESS-1 mode 1440x900
output * bg "{wallpaper}" fill
font pango:JetBrainsMono Nerd Font 11
client.focused #dfb2ff #30104b #fff7ff #c9a3ff #dfb2ff
for_window [app_id="swayfx-proof"] floating enable, resize set 790 420, move position 70 155
include "{effects}"
''')
foot_config = output / "foot.ini"
foot_config.write_text('''[main]
font=JetBrainsMono Nerd Font:size=12
pad=24x24
[colors-dark]
alpha=0.78
background=10091d
foreground=f4eaff
regular5=c591ff
bright5=f3a0e7
''')
terminal_program = output / "terminal.py"
terminal_program.write_text('''import time
print("\\033[1;35mSPACE GHOST  /  SIGNAL FROM THE VOID\\033[0m\\n")
print("  Blur, softened corners, violet shadows.")
print("  Native musl. No network during either build.")
print("  Same source. Same signed APK. Same binary.\\n")
print("\\033[38;5;183m  I have 3 superpowers: flying, invisibility,")
print("  and making a package manager look dramatic.\\033[0m")
time.sleep(20)
''')
with tempfile.TemporaryDirectory(prefix="swayfx-runtime-") as runtime:
    env = os.environ.copy()
    env.update(XDG_RUNTIME_DIR=runtime, WLR_BACKENDS="headless", WLR_HEADLESS_OUTPUTS="1",
               WLR_RENDERER="gles2", WLR_RENDERER_ALLOW_SOFTWARE="1",
               WLR_RENDER_DRM_DEVICE=args.render_device)
    for key in ["SWAYSOCK", "WAYLAND_DISPLAY", "DISPLAY"]:
        env.pop(key, None)
    with (output / "compositor.log").open("w") as log:
        subprocess.run([str(binary), "--validate", "--config", str(config)], env=env,
                       stdout=log, stderr=log, check=True)
        compositor = subprocess.Popen([str(binary), "--debug", "--config", str(config)],
                                      env=env, stdout=log, stderr=log)
        terminal = None
        try:
            for _ in range(100):
                if compositor.poll() is not None:
                    raise RuntimeError("Compositor exited before IPC became available")
                sockets = list(Path(runtime).glob("sway-ipc*.sock"))
                displays = [p for p in Path(runtime).glob("wayland-*") if p.suffix != ".lock"]
                if sockets and displays:
                    env.update(SWAYSOCK=str(sockets[0]), WAYLAND_DISPLAY=displays[0].name)
                    break
                time.sleep(0.1)
            else:
                raise RuntimeError("Timed out waiting for headless compositor")

            def ipc(*command):
                result = subprocess.run(["swaymsg", *command], env=env, capture_output=True,
                                        text=True, check=True)
                return json.loads(result.stdout)

            version = ipc("-t", "get_version")
            if version.get("sway_original_version") != "1.12.0":
                raise RuntimeError("Expected SwayFX 0.6 based on Sway 1.12")
            subprocess.run(["foot", "--check-config", "--config", str(foot_config)],
                           env=env, stdout=log, stderr=log, check=True)
            terminal = subprocess.Popen(["foot", "--config", str(foot_config),
                                         "--app-id=swayfx-proof", "--title=Space Ghost / transmission",
                                         "python3", str(terminal_program)], env=env,
                                        stdout=log, stderr=log)
            time.sleep(2)
            if terminal.poll() is not None:
                raise RuntimeError("Preview client exited unexpectedly")
            tree = ipc("-t", "get_tree")
            outputs = ipc("-t", "get_outputs")
            if not outputs or outputs[0]["name"] != "HEADLESS-1":
                raise RuntimeError("No headless output")
            subprocess.run(["grim", str(output / "screenshot.png")], env=env, check=True)
            (output / "evidence.json").write_text(json.dumps({"version": version,
                "outputs": outputs, "tree": tree, "render_device": args.render_device}, indent=2) + "\n")
            # The socket may close before swaymsg reads the exit acknowledgement.
            subprocess.run(["swaymsg", "exit"], env=env, capture_output=True)
            compositor.wait(timeout=5)
            if compositor.returncode != 0:
                raise RuntimeError("Compositor did not exit cleanly")
        finally:
            if terminal and terminal.poll() is None:
                terminal.terminate()
                terminal.wait(timeout=5)
            if compositor.poll() is None:
                compositor.terminate()
                compositor.wait(timeout=5)
print(output / "screenshot.png")
