+bool container_has_bottom_titlebar(struct sway_container *con, bool current) {
+	if (!con || !con->view || !config->titlebar_bottom) {
+		return false;
+	}
+	struct sway_container_state *state = current ? &con->current : &con->pending;
+	if (state->border != B_NORMAL || state->fullscreen_mode != FULLSCREEN_NONE) {
+		return false;
+	}
+	enum sway_container_layout layout = L_NONE;
+	if (state->parent) {
+		layout = current ? state->parent->current.layout : state->parent->pending.layout;
+	} else if (state->workspace) {
+		list_t *floating = current ? state->workspace->current.floating : state->workspace->floating;
+		if (list_find(floating, con) != -1) {
+			return true;
+		}
+		layout = current ? state->workspace->current.layout : state->workspace->layout;
+	}
+	// Group headers are owned and positioned by their parent, even for a
+	// lone tab with a normal border. Keep their geometry and input unchanged.
+	return layout != L_TABBED && layout != L_STACKED;
+}
