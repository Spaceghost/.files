+struct cmd_results *cmd_titlebar_position(int argc, char **argv) {
+	struct cmd_results *error = checkarg(argc, "titlebar_position", EXPECTED_EQUAL_TO, 1);
+	if (error) {
+		return error;
+	}
+	if (strcmp(argv[0], "top") == 0) {
+		config->titlebar_bottom = false;
+	} else if (strcmp(argv[0], "bottom") == 0) {
+		config->titlebar_bottom = true;
+	} else {
+		return cmd_results_new(CMD_INVALID,
+			"Expected 'titlebar_position top|bottom'");
+	}
+	arrange_root();
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
