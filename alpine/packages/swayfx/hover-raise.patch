--- /dev/null
+++ b/sway/commands/mouse_raise_delay.c
@@ -0,0 +1,18 @@
+#include <errno.h>
+#include <stdlib.h>
+#include "sway/commands.h"
+
+struct cmd_results *cmd_mouse_raise_delay(int argc, char **argv) {
+	struct cmd_results *error = checkarg(argc, "mouse_raise_delay", EXPECTED_EQUAL_TO, 1);
+	if (error) {
+		return error;
+	}
+	char *end;
+	errno = 0;
+	long value = strtol(argv[0], &end, 10);
+	if (errno || end == argv[0] || *end || value < 0 || value > 60000) {
+		return cmd_results_new(CMD_INVALID, "Expected a delay from 0 to 60000 milliseconds");
+	}
+	config->mouse_raise_delay = value;
+	return cmd_results_new(CMD_SUCCESS, NULL);
+}
