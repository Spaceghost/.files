 struct seatop_default_event {
 	struct sway_node *previous_node;
+	struct sway_container *raise_hovered;
+	struct sway_workspace *raise_workspace;
+	struct wl_event_source *raise_timer;
+	struct wl_listener raise_focus_change;
+	double raise_x, raise_y, raise_width, raise_height;
+	int raise_delay;
 	uint32_t pressed_buttons[SWAY_CURSOR_PRESSED_BUTTONS_CAP];
 	size_t pressed_button_count;
 	struct gesture_tracker gestures;
 };
+
+// These timers use compositor hit testing, never raw keyboard/pointer logging.
+static void cancel_mouse_raise(struct seatop_default_event *e) {
+	if (e->raise_timer) {
+		wl_event_source_remove(e->raise_timer);
+		e->raise_timer = NULL;
+	}
+}
+
+static bool mouse_raise_matches(struct sway_seat *seat, struct sway_node *node) {
+	struct seatop_default_event *e = seat->seatop_data;
+	struct sway_container *con = e->raise_hovered;
+	return con && node == &con->node && seat_get_focus(seat) == node &&
+		!server.session_lock.lock && !seat->focused_layer && !e->pressed_button_count &&
+		!con->node.destroying && con->view && view_is_visible(con->view) &&
+		container_is_floating_or_child(con) && !container_is_fullscreen_or_child(con) &&
+		config->focus_follows_mouse != FOLLOWS_NO &&
+		config->mouse_raise_delay > 0 && config->mouse_raise_delay == e->raise_delay &&
+		con->pending.workspace == e->raise_workspace &&
+		con->pending.x == e->raise_x && con->pending.y == e->raise_y &&
+		con->pending.width == e->raise_width && con->pending.height == e->raise_height;
+}
+
+static int handle_mouse_raise_timeout(void *data) {
+	struct sway_seat *seat = data;
+	struct seatop_default_event *e = seat->seatop_data;
+	struct wlr_surface *surface = NULL;
+	double sx, sy;
+	struct sway_node *node = node_at_coords(seat,
+		seat->cursor->cursor->x, seat->cursor->cursor->y, &surface, &sx, &sy);
+	cancel_mouse_raise(e);
+	if (mouse_raise_matches(seat, node)) {
+		container_raise_floating(e->raise_hovered);
+		transaction_commit_dirty();
+	}
+	return 0;
+}
+
+static void update_mouse_raise(struct sway_seat *seat, struct sway_node *node) {
+	struct seatop_default_event *e = seat->seatop_data;
+	struct sway_container *con = node && node_is_view(node) ? node->sway_container : NULL;
+	if (con == e->raise_hovered) {
+		if (e->raise_timer && !mouse_raise_matches(seat, node)) {
+			cancel_mouse_raise(e);
+		}
+		return;
+	}
+	cancel_mouse_raise(e);
+	e->raise_hovered = con;
+	if (!con) {
+		return;
+	}
+	e->raise_workspace = con->pending.workspace;
+	e->raise_x = con->pending.x;
+	e->raise_y = con->pending.y;
+	e->raise_width = con->pending.width;
+	e->raise_height = con->pending.height;
+	e->raise_delay = config->mouse_raise_delay;
+	if (mouse_raise_matches(seat, node)) {
+		e->raise_timer = wl_event_loop_add_timer(server.wl_event_loop,
+			handle_mouse_raise_timeout, seat);
+		if (e->raise_timer) {
+			wl_event_source_timer_update(e->raise_timer, e->raise_delay);
+		}
+	}
+}
+
+static void handle_raise_focus_change(struct wl_listener *listener, void *data) {
+	(void)data;
+	struct seatop_default_event *e = wl_container_of(listener, e, raise_focus_change);
+	// A newer focus must never be undone, even if it changes away and back.
+	cancel_mouse_raise(e);
+}
+
+static void handle_raise_end(struct sway_seat *seat) {
+	struct seatop_default_event *e = seat->seatop_data;
+	cancel_mouse_raise(e);
+	wl_list_remove(&e->raise_focus_change.link);
+}
+
+static void handle_raise_unref(struct sway_seat *seat, struct sway_container *con) {
+	struct seatop_default_event *e = seat->seatop_data;
+	if (e->raise_hovered == con) {
+		cancel_mouse_raise(e);
+		e->raise_hovered = NULL;
+	}
+	if (e->previous_node == &con->node) {
+		e->previous_node = NULL;
+	}
+}
 
