# Maintainer: Oldbook local package <oldbook@localhost.invalid>
pkgname=swayfx
pkgver=0.6
pkgrel=2
_commit=fd71a6bdc061bd633b488ae7b83e8a6981d22f86
pkgdesc="SwayFX effects compositor alongside stock Sway"
url="https://github.com/wlrfx/swayfx"
arch="x86_64"
license="MIT"
depends="sway"
makedepends="meson samurai pkgconf scenefx-dev wlroots0.20-dev wayland-dev
    wayland-protocols pcre2-dev json-c-dev pango-dev cairo-dev libinput-dev
    libevdev-dev libdrm-dev libxcb-dev xcb-util-wm-dev eudev-dev pixman-dev
    libxkbcommon-dev"
source="swayfx-$pkgver.tar.gz
    bottom-titlebar.patch
    hover-raise.patch
    swayfx.desktop
    oldbook-effects.conf"
builddir="$srcdir/swayfx-$_commit"
options="!net"
export SOURCE_DATE_EPOCH=1785905137

build() {
    meson setup output \
        --prefix=/usr --sysconfdir=/etc --libdir=lib \
        --buildtype=plain --wrap-mode=nodownload \
        -Ddefault-wallpaper=false -Dman-pages=disabled \
        -Dswaybar=false -Dswaynag=false -Dtray=disabled \
        -Dgdk-pixbuf=disabled \
        -Dbash-completions=false -Dfish-completions=false -Dzsh-completions=false
    meson compile -C output
}

check() {
    output/sway/sway --version
    meson test -C output --print-errorlogs
}

package() {
    # Deliberately package only uniquely named paths; never replace /usr/bin/sway.
    install -Dm755 output/sway/sway "$pkgdir/usr/bin/swayfx"
    install -Dm644 "$srcdir/swayfx.desktop" "$pkgdir/usr/share/wayland-sessions/swayfx.desktop"
    install -Dm644 "$srcdir/oldbook-effects.conf" "$pkgdir/usr/share/swayfx/oldbook-effects.conf"
    install -Dm644 sway/sway.5.scd "$pkgdir/usr/share/doc/swayfx/swayfx.5.scd"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/swayfx/LICENSE"
}

