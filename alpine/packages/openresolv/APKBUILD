# Maintainer: MBP Intel local package <mbp-intel@localhost.invalid>
pkgname=openresolv
pkgver=3.17.4
pkgrel=1
pkgdesc="Native DNS provider management with an opt-in host PID lock bridge"
url="https://github.com/NetworkConfiguration/openresolv"
arch="noarch"
license="BSD-2-Clause"
checkdepends="python3"
subpackages="$pkgname-doc"
source="openresolv-$pkgver.tar.xz
    host-pid-lock.patch
    detect_init-remove-irrelevant.patch
    test-host-pid-lock.py"
options="!net"
export SOURCE_DATE_EPOCH=1766616122

build() {
    ./configure --build="$CBUILD" --host="$CHOST" \
        --prefix=/usr --sysconfdir=/etc --sbindir=/usr/sbin \
        --libexecdir=/usr/lib/resolvconf --rundir=/run
    make
}

check() {
    sh -n resolvconf
    python3 -B "$srcdir/test-host-pid-lock.py" "$builddir" -v
}

package() {
    make DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/openresolv/LICENSE"
}

