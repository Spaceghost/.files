# Maintainer: Oldbook local package <oldbook@localhost.invalid>
pkgname=oldbook-waybar-art
pkgver=1.0.0
pkgrel=13
pkgdesc="Space Ghost artwork controls and contextual hover help for Waybar"
url="https://github.com/Alexays/Waybar"
arch="all"
license="MIT"
depends="waybar"
makedepends="build-base pkgconf gtk+3.0-dev json-glib-dev"
source="art.c help.c help.h waybar_cffi_module.h LICENSE.Waybar"
builddir="$srcdir"
options="!check !net"
export SOURCE_DATE_EPOCH=1788739200

build() {
    # Library paths and build timestamps never enter the output.
    # shellcheck disable=SC2086
    ${CC:-cc} $CFLAGS -std=c11 -D_GNU_SOURCE -Wall -Wextra -Werror -fPIC -shared \
        -o oldbook-art.so art.c help.c $LDFLAGS $(pkg-config --cflags --libs gtk+-3.0 json-glib-1.0)
}

package() {
    install -Dm755 oldbook-art.so "$pkgdir/usr/lib/waybar/oldbook-art.so"
    install -Dm644 LICENSE.Waybar "$pkgdir/usr/share/licenses/$pkgname/LICENSE.Waybar"
}

