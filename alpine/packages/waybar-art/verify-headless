#!/usr/bin/env python3
"""Verify real artwork clicks in isolated Sway; all artwork actions go to a stub."""
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import tempfile
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--module', required=True, type=Path)
parser.add_argument('--output', required=True, type=Path)
parser.add_argument('--sway', default='/usr/bin/sway')
args = parser.parse_args()
module = args.module.resolve(strict=True)
base = Path(__file__).resolve().parent
out = args.output.absolute()
out.mkdir(parents=True, exist_ok=False)
runtime = out / 'runtime'
runtime.mkdir(mode=0o700)
env = dict(os.environ, XDG_RUNTIME_DIR=str(runtime), WLR_BACKENDS='headless',
           WLR_HEADLESS_OUTPUTS='1', WLR_RENDERER='pixman', NO_AT_BRIDGE='1',
           GTK_USE_PORTAL='0')
for key in ('SWAYSOCK', 'WAYLAND_DISPLAY', 'DISPLAY', 'DBUS_SESSION_BUS_ADDRESS'):
    env.pop(key, None)

# The exact synthetic device is disabled in every existing owned compositor
# BEFORE it exists. The compositor used below has no libinput backend.
name = f'oldbook-art-test-{os.getpid()}'
identifier = f'65261:49374:{name}'
existing = list((Path('/run/user') / str(os.getuid())).glob('sway-ipc*.sock'))
for socket in existing:
    response = subprocess.run(['swaymsg', '-s', str(socket), '-r',
                               f'input "{identifier}" events disabled'],
                              capture_output=True, text=True, check=True)
    if not all(entry.get('success') for entry in json.loads(response.stdout)):
        raise RuntimeError('Could not disable synthetic input in existing compositor')
subprocess.run(['doas', '-n', 'modprobe', 'uinput'], check=True)

for mode in ('client-header', 'private-code'):
    destination = out / ('pointer.h' if mode == 'client-header' else 'pointer.c')
    subprocess.run(['wayland-scanner', mode, str(base/'tests/pointer.xml'), str(destination)], check=True)
flags = shlex.split(subprocess.check_output(['pkg-config', '--cflags', '--libs', 'wayland-client'], text=True))
subprocess.run(['cc', '-I'+str(out), '-o', str(out/'pointer-input'),
                str(base/'tests/pointer-input.c'), str(out/'pointer.c'), *flags], check=True)

(out/'stub').write_text('#!/usr/bin/env python3\nimport json, pathlib, sys\n'
    f'p = pathlib.Path({str(out)!r})\n'
    'if sys.argv[1] == "status":\n'
    '    print(json.dumps({"text":"ART", "class":"rotating", "tooltip":"Click: next · scroll: browse\\nMiddle: pause · right: gallery\\nSuper + click: generate and switch"}))\n'
    'else:\n'
    '    with (p/"actions").open("a") as stream: stream.write(sys.argv[1]+"\\n")\n')
(out/'stub').chmod(0o755)
(out/'sway.conf').write_text('xwayland disable\noutput HEADLESS-1 mode 800x600\nseat seat0 fallback true\n')
config = {'layer':'top', 'position':'top', 'height':48,
    'modules-left':['cffi/art', 'custom/control'],
    'cffi/art':{'module_path':str(module), 'command':str(out/'stub')},
    'custom/control':{'format':'CONTROL', 'on-click':shlex.join([str(out/'stub'),'control'])}}
(out/'waybar.json').write_text(json.dumps(config))
(out/'style.css').write_text('* { font: 16px monospace; } #custom-art, #custom-control { min-width: 160px; min-height: 48px; background: #250a40; color: white; }')
processes = []
checks = []
with (out/'runtime.log').open('w') as log:
    try:
        keyboard = subprocess.Popen(['doas','-n','python3',str(base/'tests/uinput-keyboard.py'),name],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=log, text=True)
        processes.append(keyboard)
        if keyboard.stdout.readline().strip() != 'ready':
            raise RuntimeError('Synthetic keyboard failed to start')
        for socket in existing:
            inputs = json.loads(subprocess.check_output(['swaymsg','-s',str(socket),'-r','-t','get_inputs'],text=True))
            own = [item for item in inputs if item['identifier'] == identifier]
            if own and own[0].get('libinput',{}).get('send_events') != 'disabled':
                raise RuntimeError('Test keyboard was not disabled in existing compositor')
        sway = subprocess.Popen([args.sway,'--debug','-c',str(out/'sway.conf')],env=env,stdout=log,stderr=log)
        processes.append(sway)
        for _ in range(100):
            sockets = list(runtime.glob('sway-ipc*.sock'))
            displays = [p for p in runtime.glob('wayland-*') if p.suffix != '.lock']
            if sockets and displays:
                env.update(SWAYSOCK=str(sockets[0]), WAYLAND_DISPLAY=displays[0].name)
                break
            if sway.poll() is not None:
                raise RuntimeError('Headless compositor exited')
            time.sleep(.05)
        else:
            raise RuntimeError('No headless compositor socket')
        pointer = subprocess.Popen([str(out/'pointer-input')],env=env,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=log,text=True)
        processes.append(pointer)
        if pointer.stdout.readline().strip() != 'ready':
            raise RuntimeError('Virtual pointer failed to start')
        bar = subprocess.Popen(['dbus-run-session','--','waybar','-c',str(out/'waybar.json'),'-s',str(out/'style.css')],env=env,stdout=log,stderr=log)
        processes.append(bar)
        for _ in range(100):
            if 'Bar configured' in (out/'runtime.log').read_text():
                break
            if bar.poll() is not None:
                raise RuntimeError('Waybar exited')
            time.sleep(.05)
        else:
            raise RuntimeError('Waybar did not initialize')
        time.sleep(.1)

        def send(process, command):
            process.stdin.write(command+'\n')
            process.stdin.flush()
            if process.stdout.readline().strip() != 'ok':
                raise RuntimeError('Input device stopped')

        def check(label, expected, button=272, meta=None, x=50, scroll=None):
            before = (out/'actions').read_text().splitlines() if (out/'actions').exists() else []
            send(pointer, f'move {x} 24')
            time.sleep(.1)
            if meta:
                send(keyboard, f'press {meta}')
            try:
                if scroll:
                    send(pointer, f'scroll {scroll}')
                else:
                    send(pointer, f'press {button}')
                    send(pointer, f'release {button}')
                for _ in range(60):
                    after = (out/'actions').read_text().splitlines() if (out/'actions').exists() else []
                    if len(after) > len(before):
                        break
                    time.sleep(.05)
                if after[len(before):] != [expected]:
                    raise AssertionError(f'{label}: expected {[expected]}, got {after[len(before):]}')
                checks.append(label)
            finally:
                if meta:
                    send(keyboard, f'release {meta}')
            time.sleep(.5)  # Keep independent clicks outside GTK double-click interval.

        check('normal left click', 'next')
        check('left Command plus left click', 'generate', meta=125)
        check('right Command plus left click', 'generate', meta=126)
        check('right click gallery', 'pick', button=273)
        check('middle click pause', 'pause', button=274)
        check('scroll up previous', 'prev', scroll='up')
        check('scroll down next', 'next', scroll='down')
        check('modifier stays scoped to artwork', 'control', meta=125, x=240)
        check('normal click after modifier release', 'next')
        time.sleep(1)
        subprocess.run(['grim',str(out/'screenshot.png')],env=env,check=True)
        evidence = {'checks':checks,'paid_generation_calls':0,'input_device':identifier,
                    'live_compositors_protected':len(existing), 'module':str(module)}
        (out/'evidence.json').write_text(json.dumps(evidence,indent=2)+'\n')
        print(json.dumps(evidence,indent=2))
    finally:
        for process in reversed(processes):
            if process.poll() is None:
                if process in (keyboard, locals().get('pointer')):
                    process.stdin.close()
                else:
                    process.terminate()
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=5)
