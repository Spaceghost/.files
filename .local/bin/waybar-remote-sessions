#!/usr/bin/env bash
set -euo pipefail

mapfile -t peers < <(
  ss --no-header --tcp --numeric state established 'sport = :22' |
    awk '{print $5}' |
    sed -E 's/^\[//; s/\]:[0-9]+$//; s/:[0-9]+$//' |
    sort -u
)

count=${#peers[@]}
if (( count == 0 )); then
  jq -cn '{text:"", tooltip:"No remote SSH sessions", class:"disconnected"}'
  exit
fi

peer_list=$(IFS=', '; printf '%s' "${peers[*]}")
jq -cn --arg text "SSH ${count}" --arg tooltip "Remote SSH: ${peer_list}" \
  '{text:$text, tooltip:$tooltip, class:"connected"}'

