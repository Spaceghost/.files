#!/usr/bin/env python3
"""Detach narrower terminal UIs from one shared Neovim session."""

import fcntl
import os
import signal
import struct
import sys
import termios


def clients(socket):
    for name in os.listdir('/proc'):
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open(f'/proc/{pid}/cmdline', 'rb') as stream:
                args = [arg.decode(errors='replace') for arg in stream.read().split(b'\0') if arg]
            if len(args) != 4 or args[1:] != ['--server', socket, '--remote-ui']:
                continue
            tty = os.readlink(f'/proc/{pid}/fd/0')
            with open(tty, 'rb', buffering=0) as stream:
                _, columns, _, _ = struct.unpack('HHHH', fcntl.ioctl(stream, termios.TIOCGWINSZ, b'\0' * 8))
            if columns > 0:
                yield pid, columns
        except (OSError, ValueError):
            continue


def main():
    if len(sys.argv) != 2:
        sys.exit('Usage: nvim-width-fix SOCKET')
    socket = os.path.realpath(sys.argv[1])
    found = list(clients(socket))
    if len(found) < 2:
        print('No narrower Neovim UI to detach')
        return
    widest = max(columns for _, columns in found)
    narrow = [(pid, columns) for pid, columns in found if columns < widest]
    for pid, _ in narrow:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    if narrow:
        print(f'Detached {len(narrow)} narrow UI(s); widest is {widest} columns')
    else:
        print(f'All Neovim UIs are {widest} columns wide')


if __name__ == '__main__':
    main()
