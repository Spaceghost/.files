#!/bin/sh
# nvim-attach [--ssh] [HOST]: attach a Neovim UI to the persistent session on
# this machine, or on HOST.
#   * With mosh on both ends (default): `mosh HOST -- nvim-attach`, so the UI runs
#     on HOST inside a roaming, latency-hiding mosh session. Survives sleep, Wi-Fi
#     changes and IP moves; reconnects by itself.
#   * --ssh (or no mosh): forward HOST's socket over ssh and run the UI locally.
#     Needed when you want this machine's clipboard/fonts, or UDP is blocked.
# Detach with :detach (or close the terminal); the session keeps running.
# With no session reachable and no HOST, falls back to a plain `nvim`.
set -eu

PATH="$HOME/.local/nvim/bin:$HOME/.bin:/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH
use_ssh=0; here=0
while [ $# -gt 0 ]; do
    case "$1" in
        --ssh) use_ssh=1; shift ;;
        --here) here=1; shift ;;   # run the client in this terminal even inside Neovim
        *) break ;;
    esac
done
host="${1:-}"

# Inside the cockpit already: open the attach as a pane of this Neovim instead of
# nesting a client in the current shell. Spaceghost.shell.attach runs us again with --here.
if [ -n "${NVIM:-}" ] && [ "$here" = 0 ]; then
    nvim --server "$NVIM" --remote-expr "v:lua.Spaceghost.shell.attach('$(printf '%s' "$host" | sed "s/'/''/g")')" </dev/null >/dev/null
    exit $?
fi

if [ -z "$host" ]; then
    if sock="$(nvim-session ensure 2>/dev/null)"; then
        exec nvim --server "$sock" --remote-ui
    fi
    echo "nvim-attach: no local session; starting a plain nvim" >&2
    exec nvim
fi

# Remote over mosh: the UI runs on HOST; mosh keeps the connection alive for us.
if [ "$use_ssh" = 0 ] && [ -z "${SPACEGHOST_NO_MOSH:-}" ] && command -v mosh >/dev/null 2>&1 \
    && ssh -o BatchMode=yes "$host" 'command -v mosh-server' >/dev/null 2>&1; then
    # shellcheck disable=SC2016  # expands on the remote side
    exec mosh "$host" -- sh -c 'exec "$HOME/.bin/nvim-attach" --here'
fi

# Remote over ssh: the session's own ~/.bin/nvim-session reports (and starts) its socket.
remote_sock="$(ssh -o BatchMode=yes "$host" 'exec "$HOME/.bin/nvim-session" ensure')"
[ -n "$remote_sock" ] || { echo "nvim-attach: $host has no nvim-session" >&2; exit 1; }
local_dir="${XDG_RUNTIME_DIR:-/tmp}/nvim-attach"
mkdir -p "$local_dir"
local_sock="$local_dir/$(printf '%s' "$host" | tr -c 'A-Za-z0-9_.-' '_').sock"
rm -f "$local_sock"
ssh -o BatchMode=yes -o ExitOnForwardFailure=yes -o StreamLocalBindUnlink=yes -N -f \
    -L "$local_sock:$remote_sock" "$host"
cleanup() { pkill -f -- "-L $local_sock:" 2>/dev/null || true; rm -f "$local_sock"; }
trap cleanup EXIT INT TERM
tries=0
until [ -S "$local_sock" ]; do
    tries=$((tries + 1)); [ "$tries" -lt 50 ] || { echo "nvim-attach: forward to $host failed" >&2; exit 1; }
    sleep 0.1
done
nvim --server "$local_sock" --remote-ui
