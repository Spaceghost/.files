#!/bin/sh
# Keep committed .files history in sync through origin/base on every host.
# Working-tree edits are never committed, stashed, or discarded automatically.
set -eu

repo=${SPACEGHOST_SYNC_REPO:-"$HOME/.files"}
state=${SPACEGHOST_SYNC_STATE:-"${XDG_STATE_HOME:-$HOME/.local/state}/spaceghost-sync"}
mkdir -p "$state"
logfile=$state/sync.log
PATH="$HOME/.local/nvim/bin:$HOME/.bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export PATH
GIT_TERMINAL_PROMPT=0
GIT_ASKPASS=/bin/false
SSH_ASKPASS=/bin/false
GCM_INTERACTIVE=Never
export GIT_TERMINAL_PROMPT GIT_ASKPASS SSH_ASKPASS GCM_INTERACTIVE

log() {
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >> "$logfile"
    printf '%s\n' "spaceghost-sync: $*" >&2
}

# Git's libcurl resolver can fail while the host's system resolver works.
# Resolve afresh for each request; keep HTTPS hostname/certificate verification.
git_network() {
    address=''
    case $(git -C "$repo" remote get-url origin) in
        https://github.com/*)
            if command -v getent >/dev/null 2>&1; then
                address=$(getent ahostsv4 github.com 2>/dev/null | awk 'NR == 1 { print $1 }')
            fi ;;
    esac
    if [ -n "$address" ]; then
        git -C "$repo" -c "http.curloptResolve=github.com:443:$address" "$@"
    else
        git -C "$repo" "$@"
    fi
}

reload_apps() {
    [ "${SPACEGHOST_SYNC_NO_RELOAD:-0}" = 1 ] && return 0
    "$repo/.bin/spaceghost-reload" >> "$logfile" 2>&1
}

run_sync() {
    [ -d "$repo/.git" ] || { log "repository missing: $repo"; return 1; }
    exec 9> "$state/lock"
    flock -n 9 || return 0
    branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD) || {
        log 'checkout is detached; leaving it alone'; return 1;
    }
    [ "$branch" = base ] || { log "checkout is on $branch, not base; leaving it alone"; return 1; }
    git -C "$repo" rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && {
        log 'merge in progress; leaving it alone'; return 1;
    }
    [ ! -d "$(git -C "$repo" rev-parse --git-path rebase-merge)" ] || {
        log 'rebase in progress; leaving it alone'; return 1;
    }
    old=$(git -C "$repo" rev-parse HEAD)
    if ! git_network fetch -q origin base >> "$logfile" 2>&1; then
        log 'fetch failed; retrying next cycle (local apps still reload)'
        reload_apps || return 1
        return 1
    fi
    remote=$(git -C "$repo" rev-parse refs/remotes/origin/base)
    if [ "$old" != "$remote" ]; then
        if git -C "$repo" merge-base --is-ancestor "$old" "$remote"; then
            if ! git -C "$repo" merge --ff-only "$remote" >> "$logfile" 2>&1; then
                log 'incoming commit overlaps local edits; left both intact'; return 1
            fi
            log "pulled $(git -C "$repo" rev-parse --short HEAD)"
        elif git -C "$repo" merge-base --is-ancestor "$remote" "$old"; then
            : # Local branch is ahead; push below.
        elif [ -n "$(git -C "$repo" status --porcelain)" ]; then
            log 'commits diverged with local edits; left both intact'; return 1
        elif [ -z "$(git -C "$repo" merge-base "$old" "$remote" || true)" ]; then
            log 'unrelated histories; left both intact'; return 1
        else
            if ! git -C "$repo" rebase "$remote" >> "$logfile" 2>&1; then
                git -C "$repo" rebase --abort >> "$logfile" 2>&1 || true
                log 'commit conflict during rebase; left local commits intact'; return 1
            fi
            log "rebased local commits on $(git -C "$repo" rev-parse --short "$remote")"
        fi
    fi
    if [ "$(git -C "$repo" rev-parse HEAD)" != "$remote" ]; then
        if ! git_network push origin HEAD:refs/heads/base >> "$logfile" 2>&1; then
            log 'push raced with another host or failed; will retry'
            reload_apps || return 1
            return 1
        fi
        log "pushed $(git -C "$repo" rev-parse --short HEAD)"
    fi
    reload_apps || return 1

}

install_sync() {
    if [ -d /run/systemd/system ] && systemctl --user show-environment >/dev/null 2>&1; then
        units=$HOME/.config/systemd/user
        mkdir -p "$units"
        for name in spaceghost-sync.service spaceghost-sync.timer; do
            dest=$units/$name
            [ ! -e "$dest" ] || [ -L "$dest" ] || {
                log "keeping existing $dest; not replacing it"; return 1;
            }
            ln -sfn "$repo/.config/systemd/user/$name" "$dest"
        done
        systemctl --user daemon-reload
        systemctl --user enable spaceghost-sync.timer
        systemctl --user restart --no-block spaceghost-sync.timer
        log 'installed user timer (every two minutes)'
    else
        file=$state/crontab.install
        crontab -l > "$file" 2>/dev/null || :
        if ! grep -q '# spaceghost-sync$' "$file"; then
            # Keep HOME for cron to expand on the target host.
            # shellcheck disable=SC2016
            printf '%s\n' '*/2 * * * * "$HOME/.bin/spaceghost-sync" run >> "$HOME/.local/state/spaceghost-sync/cron.log" 2>&1 # spaceghost-sync' >> "$file"
            crontab "$file"
        fi
        log 'installed cron job (every two minutes)'
    fi
    run_sync
}

case ${1:-run} in
    run) run_sync ;;
    install) install_sync ;;
    status)
        git -C "$repo" status --short --branch
        tail -n 8 "$logfile" 2>/dev/null || true
        ;;
    *) printf '%s\n' 'usage: spaceghost-sync [run|install|status]' >&2; exit 2 ;;
esac
