# Sourced from ~/.bashrc by spaceghost-install. Neovim is the shell and the
# multiplexer (~/.files/docs/nvim-shell.md). Also valid POSIX sh for ~/.profile.
[ -n "${SPACEGHOST_SHELL_READY:-}" ] && return
SPACEGHOST_SHELL_READY=1
[ -d "$HOME/.local/bin" ] && case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
[ -d "$HOME/.local/nvim/bin" ] && case ":$PATH:" in *":$HOME/.local/nvim/bin:"*) ;; *) PATH="$HOME/.local/nvim/bin:$PATH" ;; esac
PATH="$HOME/.bin:$PATH"
export PATH
EDITOR="$HOME/.bin/nvim-remote"; VISUAL="$EDITOR"; export EDITOR VISUAL
ENV="$HOME/.ashrc"; export ENV
for spaceghost_dir in "$HOME/.files" "$HOME/.spaceghost"; do
    [ -r "$spaceghost_dir/.config/spaceghost/aliases.sh" ] || continue
    . "$spaceghost_dir/.config/spaceghost/theme.sh"
    . "$spaceghost_dir/.config/spaceghost/aliases.sh"
    break
done
unset spaceghost_dir
# Interactive, on a terminal, not already inside Neovim or tmux: attach to the session.
case "$-" in *i*)
    if [ -t 0 ] && [ -t 1 ] && [ -z "${NVIM:-}" ] && [ -z "${TMUX:-}" ] && [ -z "${SPACEGHOST_PLAIN_SHELL:-}" ] \
        && command -v nvim >/dev/null 2>&1; then
        exec "$HOME/.bin/nvim-attach"
    fi
    if [ -n "${BASH_VERSION:-}" ]; then
        command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"
        command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"
        if command -v starship >/dev/null 2>&1; then
            eval "$(starship init bash)"
        else
            PS1='✦ \w ❯ '
        fi
        command -v atuin >/dev/null 2>&1 && eval "$(atuin init bash)"
    fi ;;
esac
