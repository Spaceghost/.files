# Sourced from ~/.bashrc by spaceghost-install. Neovim is the shell and the
# multiplexer (~/.files/docs/nvim-shell.md). Also valid POSIX sh for ~/.profile.
case ":$PATH:" in *":$HOME/.bin:"*) ;; *) PATH="$HOME/.bin:$PATH" ;; esac
[ -d "$HOME/.local/nvim/bin" ] && case ":$PATH:" in *":$HOME/.local/nvim/bin:"*) ;; *) PATH="$HOME/.local/nvim/bin:$PATH" ;; esac
export PATH
EDITOR="$HOME/.bin/nvim-remote"; VISUAL="$EDITOR"; export EDITOR VISUAL
# Interactive, on a terminal, not already inside Neovim or tmux: attach to the session.
case "$-" in *i*)
    if [ -t 0 ] && [ -t 1 ] && [ -z "${NVIM:-}" ] && [ -z "${TMUX:-}" ] && [ -z "${SPACEGHOST_PLAIN_SHELL:-}" ] \
        && command -v nvim >/dev/null 2>&1; then
        exec "$HOME/.bin/nvim-attach"
    fi ;;
esac
